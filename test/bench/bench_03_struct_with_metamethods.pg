// Benchmark 3: Struct with __get/__set metamethods
// This tests the performance of metamethod calls (similar to proxies)

// Create a struct class with metamethods
class ProxyStruct
{
    init()
    {
        __x = 100
        __y = 200
    }

    __get(propName)
    {
        if (propName == "x")
            return __x
        if (propName == "y")
            return __y
        return 0
    }

    __set(propName, value)
    {
        if (propName == "x")
            __x = value
        else if (propName == "y")
            __y = value
    }
}

// var count = 2000

// Create proxy structs
var structs = []
for (var i = 0; i < count; i = i + 1)
{
    structs[i] = ProxyStruct()
}

__dprint("Created " + toString(count) + " proxy structs")

// Benchmark: iterate and read+write via metamethods
for (var i = 0; i < count; i = i + 1)
{
    var s = structs[i]

    // Read via __get
    var x = s.x
    var y = s.y

    // Write via __set
    s.x = x + 1
    s.y = y + 1
}

__dprint("Updated " + toString(count) + " proxy structs")
