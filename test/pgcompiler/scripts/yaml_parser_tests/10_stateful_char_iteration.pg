// Test 10: Character iteration with boolean state tracking (from lines 260-298)
// Tests the complex state machine for parsing inline objects

import "string"
import "algorithm"

fun parseKeyValuePairs(innerContent) {
    var result = {};
    var currentKey = "";
    var currentVal = "";
    var inQuote = false;
    var parsingKey = true;

    for (var i = 0; i < len(innerContent); i = i + 1) {
        var c = substring(innerContent, i, i + 1);

        if (c == "\"") {
            inQuote = not inQuote;
            if (not parsingKey) {
                currentVal = currentVal + c;
            }
        } else if (c == ":" and not inQuote and parsingKey) {
            parsingKey = false;
        } else if (c == "," and not inQuote) {
            // End of key-value pair
            if (currentKey != "") {
                result[trim(currentKey)] = trim(currentVal);
            }
            currentKey = "";
            currentVal = "";
            parsingKey = true;
        } else {
            if (parsingKey) {
                currentKey = currentKey + c;
            } else {
                currentVal = currentVal + c;
            }
        }
    }

    // Save the last pair
    if (currentKey != "") {
        result[trim(currentKey)] = trim(currentVal);
    }

    return result;
}

var test1 = "key1: value1, key2: value2";
var result1 = parseKeyValuePairs(test1);
__dprint("Test 1 - key1: " + result1["key1"]);
__dprint("Test 1 - key2: " + result1["key2"]);

var test2 = "name: \"Test, Component\", type: basic";
var result2 = parseKeyValuePairs(test2);
__dprint("Test 2 - name: " + result2["name"]);
__dprint("Test 2 - type: " + result2["type"]);

var test3 = "opacity: \"1.0f\"";
var result3 = parseKeyValuePairs(test3);
__dprint("Test 3 - opacity: " + result3["opacity"]);
