import "string"

// Test basic __get metamethod functionality

class ProxyClass
{
    init()
    {
        this.val = 0
    }
}

// Create a native function to act as __get
fun createGetMethod()
{
    return fun(self, propName) {
        __dprint("__get called with property: " + propName)

        if (propName == "x")
        {
            return 100
        }

        if (propName == "y")
        {
            self.val = 10
            return 200
        }

        return -1
    }
}

var obj = ProxyClass()
obj.__get = createGetMethod()

__dprint("Initial val = " + toString(obj.val))

// Test property access via dot notation
var x = obj.x
__dprint("x = " + toString(x))
__dprint("val after accessing x = " + toString(obj.val))

var y = obj.y
__dprint("y = " + toString(y))
__dprint("val after accessing y = " + toString(obj.val))

var z = obj.z
__dprint("z = " + toString(z))

