// Test string interning with release and retrack
// This tests that when a string is released and its pool slot is reused,
// the internedStrings map is properly cleared so we don't get stale references

// Phase 1: Create a string "result_A" and let it be released
{
  var temp = "A"
  var result = "result_" + temp
  __dprint(result)
  // result goes out of scope here and should be released
}

// Phase 2: Create another temporary string to potentially reuse the pool slot
{
  var temp2 = "temporary_string_to_fill_slot"
  var dummy = temp2 + "_suffix"
  // dummy is released here
}

// Phase 3: Try to create "result_A" again - this should create a NEW string,
// not reuse a stale interned entry pointing to the wrong pool slot
{
  var temp3 = "A"
  var result2 = "result_" + temp3
  __dprint(result2)
  // This should print "result_A", not garbage or wrong data
}

// Phase 4: Test with numeric strings that are more likely to have collisions
var x = 123
var str1 = "value_" + __toString(x)
__dprint(str1)

// Release str1 by going out of scope
{
  var y = 456
  var str_temp = "value_" + __toString(y)
  // str_temp released here
}

// Recreate a string with same content as str1
var z = 123
var str2 = "value_" + __toString(z)
__dprint(str2)

// Final test with loop creating and releasing many strings
for (var i = 0; i < 3; i++)
{
  var msg = "iter_" + __toString(i)
  __dprint(msg)
}

__dprint("done")
