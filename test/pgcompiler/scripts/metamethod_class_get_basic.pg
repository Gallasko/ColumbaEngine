import "string"

class Test
{
    init()
    {
        this.val = 0;
    }

    __get(name)
    {
        if (name == "example")
        {
            this.val = 42;
        }
        else
        {
            __dprint("Getter called with unknown property: " + name);
            return -1;
        }

        return this.val
    }
}

var testInstance = Test();

__dprint("Initial value: " + toString(testInstance.val)); // Should print 0
var exampleValue = testInstance.example; // Should trigger the getter
__dprint("Value after accessing 'example': " + toString(exampleValue)); // Should print 42
var randomValue = testInstance.randomProp; // Should print warning
__dprint("Value after accessing 'randomProp': " + toString(randomValue)); // Should print -1
__dprint("Final value: " + toString(testInstance.val)); // Should print 0