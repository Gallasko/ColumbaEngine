// Test 09: Shortname extraction with substring (from lines 824-838)
// Tests the component shortname extraction logic

import "string"
import "algorithm"

var components = [
    {"name": "TransformComponent", "shortname": ""},
    {"name": "RenderComponent", "shortname": "Render"},
    {"name": "PhysicsComponent", "shortname": ""}
];

for (var idx = 0; idx < len(components); idx = idx + 1)
{
    var schema = components[idx];
    var componentShortName = "";

    if (contain(schema, "shortname") and typeOf(schema["shortname"]) == "string" and len(schema["shortname"]) > 0)
    {
        componentShortName = schema["shortname"];
    }
    else
    {
        componentShortName = schema["name"];

        if (contains(componentShortName, "Component"))
        {
            var compIdx = indexOf(componentShortName, "Component");
            componentShortName = substring(componentShortName, 0, compIdx);
        }
    }

    __dprint("Component: " + schema["name"] + " -> Shortname: " + componentShortName);
}
