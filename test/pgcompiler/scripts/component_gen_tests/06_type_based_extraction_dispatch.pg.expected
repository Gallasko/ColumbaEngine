        if (key == "opacity")
            opacity = detail::extractFloatArg(args, i + 1);
        else if (key == "visible")
            visible = detail::extractBoolArg(args, i + 1);
        else if (key == "count")
            count = detail::extractIntArg(args, i + 1);
        else if (key == "ratio")
            ratio = detail::extractFloatArg(args, i + 1);

