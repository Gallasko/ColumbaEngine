import "string"

// Break in nested loops - should only break inner loop
var outer = 0;
var inner = 0;
while (outer < 3) {
    __dprint("outer: " + toString(outer));
    var j = 0;
    while (j < 5) {
        if (j == 2) {
            break; // Only breaks inner loop
        }
        __dprint("  inner: " + toString(j));
        inner = inner + 1;
        j = j + 1;
    }
    outer = outer + 1;
}
__dprint("total inner iterations: " + toString(inner));
