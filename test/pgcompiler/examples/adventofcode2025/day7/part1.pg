import "file"
import "string"
import "algorithm"

import "../common.pg"

var path = "test/pgcompiler/examples/adventofcode2025/day7/"
var files = ["aoc7small", "aoc7full"]

for (var file : files)
{
    var f = readFile(path + file)

    var lines = splitLines(f)

    var table = []

    for (var i = 0; i < len(lines); i++)
    {
        table.push([])

        var line = lines[i]

        for (var j = 0; j < strlen(line); j++)
        {
            if (line[j] == ".")
                table[i][j] = 0
            else if (line[j] == "^")
                table[i][j] = 1
            else if (line[j] == "S")
                table[i][j] = 2
        }
    }

    var res = 0

    for (var i = 0; i < len(table) - 1; i++)
    {
        for (var j = 0; j < len(table[i]); j++)
        {
            if (table[i][j] == 2 or table[i][j] == 3)
            {
                if (table[i + 1][j] == 0)
                    table[i + 1][j] = 3
                else if (table[i + 1][j] == 1)
                {
                    table[i + 1][j - 1] = 3
                    table[i + 1][j + 1] = 3

                    res++
                }
            }
        }
    }

    __dprint(res)
    // table.push([])
}
