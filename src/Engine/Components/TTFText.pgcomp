name: TTFText
shortname: TTFText
namespace: pg
base_class: Ctor

includes:
  - <string>
  - "pgconstant.h"

fields:
  - name: text
    type: std::string
    default: ""
    setter: event

  - name: textWidth
    type: float
    default: 0.0f
    serialize: false

  - name: textHeight
    type: float
    default: 0.0f
    serialize: false

  - name: fontPath
    type: std::string
    default: ""
    setter: event

  - name: scale
    type: float
    default: 1.0f
    setter: event

  - name: colors
    type: constant::Vector4D
    default: "{255.0f, 255.0f, 255.0f, 255.0f}"
    setter: event

  - name: wrap
    type: bool
    default: false
    setter: event

  - name: spacing
    type: float
    default: 0.0f
    setter: event

  - name: viewport
    type: size_t
    default: 0
    setter: event

  - name: changed
    type: bool
    default: false
    serialize: false

events:
  - TTFTextChangedEvent
