name: RoundedRect2DObject
namespace: pg
base_class: Component

includes:
  - "ECS/system.h"
  - "ECS/entitysystem.h"
  - "pgconstant.h"

fields:
  - name: cornerRadius
    type: float
    default: 0.0f
    setter: event

  - name: colors
    type: constant::Vector4D
    default: "{255.0f, 255.0f, 255.0f, 255.0f}"
    setter: event

constructors:
  - params: [cornerRadius]
  - params: [cornerRadius, colors]
    defaults: {colors: "{255.0f, 255.0f, 255.0f, 255.0f}"}

methods:
  - "void setOpacity(float alpha) { colors.w = alpha; if (ecsRef) ecsRef->sendEvent(RoundedRect2DObjectChangedEvent{entityId}); }"

events:
  - RoundedRect2DObjectChangedEvent
