name: Simple2DObject
namespace: pg
base_class: Component

includes:
  - "ECS/system.h"
  - "pgconstant.h"

enums:
  - name: Shape2D
    fields: [Triangle, Square, Circle, None]

fields:
  - name: shape
    type: Shape2D
    default: Triangle
    setter: event

  - name: colors
    type: constant::Vector4D
    default: "{255.0f, 255.0f, 255.0f, 255.0f}"
    setter: event

constructors:
  - params: [shape]
  - params: [shape, colors]

events:
  - Simple2DObjectChangedEvent

methods:
  - definition: "void setOpacity(float alpha) {
    colors.w = alpha;
    if (ecsRef)
    {
        ecsRef->sendEvent(Simple2DObjectChangedEvent{entityId});
    }
}"
