// article.pg - the writing tool for columbaengine.org.
//
//     release/PgCompilerBootstrap tools/writer/article.pg <command> ...
//
// See tools/writer/README.md. Ideas -> plan -> (code) -> draft/pick -> stitch -> share, every step
// recorded under <site>/writer/; Claude (claude -p, the author's subscription) reads and answers,
// this tool writes every file.

import "lib/util"
import "lib/config"
import "lib/claude"
import "lib/plan"
import "lib/ideas"
import "lib/record"
import "lib/steps_plan"
import "lib/steps_draft"
import "lib/steps_publish"
import "string"
import "algorithm"
import "os" as os

var USAGE = "usage: article <command>\n  ideas                 new ideas from recent work\n  ideas list            the ideas by status\n  idea \"<title>\"        add an idea of your own\n  decline <id>          drop an idea\n  plan <id> [--again]   a teaching plan for an idea\n  code <slug> <n>       the engine code chapter n needs\n  draft <slug> <n> [--again]\n                        chapter n in every voice\n  pick <slug> <n> <voice> [--replace]\n                        keep a draft\n  mine <slug> <n>       keep the chapter you wrote\n  stitch <slug>         the article written into the site\n  share <slug>          Reddit and X posts, printed to paste\n  status <slug>         where an article stands"

// The arguments after the command
fun commandArgs()
{
    var args = []
    var i = 3
    while (i < getArgCount())
    {
        push(args, getArg(i))
        i++
    }
    return args
}

fun usage()
{
    print(USAGE)
    os.exit(1)
}

fun main()
{
    var config = loadConfig()
    if (getArgCount() < 3)
    {
        usage()
    }
    var command = getArg(2)
    var args = commandArgs()

    if (command == "_ask")
    {
        // Internal, for the tests: one call with the theme schema
        if (len(args) != 2)
        {
            usage()
        }
        var schema = {type: "object", properties: {theme: {type: "string"}}, required: ["theme"]}
        var answer = askClaude(config, args[0], args[1], schema, "", [])
        print(answer.theme)
        return
    }

    if (command == "ideas" and len(args) == 0)
    {
        commandIdeas(config)
        return
    }
    if (command == "ideas" and len(args) == 1 and args[0] == "list")
    {
        commandIdeasList(config)
        return
    }
    if (command == "idea" and len(args) == 1)
    {
        commandIdea(config, args[0])
        return
    }
    if (command == "decline" and len(args) == 1)
    {
        commandDecline(config, args[0])
        return
    }

    if (command == "plan" and (len(args) == 1 or (len(args) == 2 and args[1] == "--again")))
    {
        commandPlan(config, args[0], len(args) == 2)
        return
    }

    if (command == "code" and len(args) == 2)
    {
        runCode(config, args[0], chapterArg(args[1]))
        return
    }
    if (command == "draft" and (len(args) == 2 or (len(args) == 3 and args[2] == "--again")))
    {
        commandDraft(config, args[0], chapterArg(args[1]), len(args) == 3)
        return
    }
    if (command == "pick" and (len(args) == 3 or (len(args) == 4 and args[3] == "--replace")))
    {
        commandPick(config, args[0], chapterArg(args[1]), args[2], len(args) == 4)
        return
    }
    if (command == "mine" and len(args) == 2)
    {
        commandMine(config, args[0], chapterArg(args[1]))
        return
    }

    if (command == "stitch" and len(args) == 1)
    {
        commandStitch(config, args[0])
        return
    }

    if (command == "share" and len(args) == 1)
    {
        commandShare(config, args[0])
        return
    }
    if (command == "status" and len(args) == 1)
    {
        commandStatus(config, args[0])
        return
    }

    usage()
}

main()
