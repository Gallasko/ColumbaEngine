// steps_publish.pg - article stitch / share / status: the kept chapters written into the site,
// the posts prepared, where an article stands.

import "string"
import "algorithm"
import "file"
import "json" as json
import "os" as os

// The share of `kept`'s non-empty lines not found, unchanged, among `draft`'s lines
fun editedShare(kept, draft)
{
    var draftLines = []
    for (var line : splitLines(draft))
    {
        push(draftLines, trim(line))
    }
    var total = 0
    var changed = 0
    for (var line : splitLines(kept))
    {
        var t = trim(line)
        if (t != "")
        {
            total = total + 1
            if (not has(draftLines, t))
            {
                changed = changed + 1
            }
        }
    }
    if (total == 0)
    {
        return 0.0
    }
    return toFloat(changed) / toFloat(total)
}

// A value for the article's header: a double-quoted string, escaped as JSON writes it (which YAML
// reads as the same string), so quotes, colons, # and new lines cannot break the header
fun yamlString(text)
{
    if (typeOf(text) != "string")
    {
        text = toString(text)
    }
    return json.stringify(text)
}

fun blogPath(slug)
{
    return "src/content/blog/" + slug + ".md"
}

// article stitch <slug>
fun commandStitch(config, slug)
{
    var opened = openArticle(config, slug)
    var record = opened.record
    var plan = opened.plan

    var missing = []
    var chapters = []
    for (var chapter : plan.chapters)
    {
        var entry = recordChapter(record, chapter.n)
        var text = fileText(chapterFile(config, slug, chapter.n, ""))
        if (typeOf(entry.kept) == "none" or typeOf(text) == "none")
        {
            push(missing, toString(chapter.n))
        }
        else
        {
            push(chapters, {chapter: chapter, entry: entry, text: trim(text)})
        }
    }
    if (len(missing) > 0)
    {
        fail("chapters not kept yet: " + join(missing, ", ") + " (article pick / article mine)")
    }

    // A chapter renamed or renumbered in plan.md since its text was kept: the text may now sit
    // under another chapter's heading
    var warnings = []
    for (var c : chapters)
    {
        var keptTitle = c.entry.keptTitle
        if (typeOf(keptTitle) == "string" and keptTitle != c.chapter.title)
        {
            push(warnings, "chapter " + toString(c.chapter.n) + " was kept as \"" + keptTitle + "\" and the plan now calls it \"" + c.chapter.title + "\": check " + nn(c.chapter.n) + ".md is the right text")
        }
    }

    var parts = []
    for (var c : chapters)
    {
        push(parts, "## " + toString(c.chapter.n) + ". " + c.chapter.title + "\n\n" + c.text)
    }
    var values = {plan: planText(plan), article: join(parts, "\n\n")}
    var schema = {type: "object", properties: {description: {type: "string"}, excerpt: {type: "string"}, tags: {type: "array", items: {type: "string"}}, findings: {type: "array", items: {type: "string"}}}, required: ["description", "excerpt", "tags", "findings"], allowEmpty: ["tags", "findings"]}
    var answer = askClaude(config, "stitch", fill(prompt(config, "stitch"), values), schema, "", [])

    var first = typeOf(record.published) != "table"
    var pubDate = today()
    var publishedTime = nowMs()
    if (not first)
    {
        pubDate = record.published.date
        publishedTime = record.published.time
    }

    var tags = []
    for (var tag : answer.tags)
    {
        push(tags, yamlString(tag))
    }
    var header = ["---", "title: " + yamlString(plan.title), "description: " + yamlString(answer.description), "pubDate: " + yamlString(pubDate)]
    if (not first)
    {
        push(header, "updatedDate: " + yamlString(today()))
    }
    push(header, "tags: [" + join(tags, ", ") + "]")
    push(header, "author: " + yamlString(config.author))
    push(header, "excerpt: " + yamlString(answer.excerpt))
    push(header, "---")

    var body = []
    for (var c : chapters)
    {
        push(body, "## " + c.chapter.title + "\n\n" + c.text)

        if (c.entry.kept == "mine")
        {
            c.entry.edited = none
        }
        else
        {
            var draft = fileText(chapterFile(config, slug, c.chapter.n, c.entry.kept))
            if (typeOf(draft) == "none")
            {
                c.entry.edited = none
            }
            else
            {
                c.entry.edited = editedShare(c.text, draft)
            }
        }
    }

    var relative = blogPath(slug)
    writeText(config.site + "/" + relative, join(header, "\n") + "\n\n" + join(body, "\n\n") + "\n")

    var texts = []
    for (var c : chapters)
    {
        push(texts, {n: c.chapter.n, title: c.chapter.title, text: c.text})
    }
    record.published = {path: relative, time: publishedTime, date: pubDate, description: answer.description, excerpt: answer.excerpt, title: plan.title, texts: texts}
    var findings = []
    for (var w : warnings)
    {
        push(findings, w)
    }
    for (var f : answer.findings)
    {
        push(findings, f)
    }
    push(record.checks, {time: nowMs(), findings: findings})
    addStep(record, "stitch", modelFor(config, "stitch"))
    saveRecord(config, record)

    var ideas = loadIdeas(config)
    var idea = findIdea(ideas, record.idea)
    if (typeOf(idea) == "table")
    {
        idea.status = "written"
        saveIdeas(config, ideas)
    }

    print("wrote " + config.site + "/" + relative)
    if (len(findings) == 0)
    {
        print("checks: nothing found")
    }
    else
    {
        print("checks:")
        for (var finding : findings)
        {
            print("  - " + finding)
        }
    }
}

// Where a post goes, as the first part of its tag: "r-<community>" for Reddit, "x" for X
fun placeOf(platform, where)
{
    if (platform == "reddit")
    {
        var name = where
        if (startsWith(toLowerCase(name), "r/"))
        {
            name = substring(name, 2, strlen(name))
        }
        return "r-" + slugOf(name)
    }
    return slugOf(platform)
}

fun recordTags(record)
{
    var tags = []
    for (var post : record.posts)
    {
        push(tags, post.tag)
    }
    return tags
}

// A tag for a post at `place`: <place>-<the slug, cut>-<k>, at most 40 characters, the first k
// not taken among the record's posts
fun tagFor(record, place)
{
    var taken = recordTags(record)
    var k = 1
    while (true)
    {
        var number = toString(k)
        var room = 40 - strlen(place) - strlen(number) - 2
        var short = record.slug
        if (strlen(short) > room)
        {
            short = substring(short, 0, room)
        }
        while (strlen(short) > 0 and endsWith(short, "-"))
        {
            short = substring(short, 0, strlen(short) - 1)
        }
        var tag = place + "-" + short + "-" + number
        if (short == "")
        {
            tag = place + "-" + number
        }
        if (not has(taken, tag))
        {
            return tag
        }
        k++
    }
}

// article share <slug>
fun commandShare(config, slug)
{
    var record = needRecord(config, slug)
    if (typeOf(record.published) != "table")
    {
        fail("stitch the article first (article stitch " + slug + ")")
    }
    var themes = readJson(config.writer + "/themes.json")
    var places = themes[record.theme]
    if (typeOf(places) != "array")
    {
        fail("no places for the theme '" + toString(record.theme) + "' in writer/themes.json")
    }

    var schema = {type: "object", properties: {title: {type: "string"}, text: {type: "string"}}, required: ["title", "text"], allowEmpty: ["title"]}
    var made = []
    for (var place : places)
    {
        var where = place.where
        if (typeOf(where) != "string")
        {
            where = ""
        }
        var tag = tagFor(record, placeOf(place.platform, where))
        var link = "https://columbaengine.org/blog/" + slug + "/?from=" + tag
        var limit = "a Reddit post: a title and a text of a few short paragraphs"
        if (place.platform == "x")
        {
            limit = "an X post: no title, the text at most 280 characters with the link included"
        }
        var values = {title: record.title, description: toString(record.published.description), excerpt: toString(record.published.excerpt), question: toString(record.reader.question), platform: place.platform, where: where, link: link, limit: limit}
        var answer = askClaude(config, "share", fill(prompt(config, "share"), values), schema, "", [])

        var text = trim(answer.text)
        if (not contains(text, link))
        {
            text = text + "\n\n" + link
        }
        if (place.platform == "x" and strlen(text) > 280)
        {
            fail("share: the X post is " + toString(strlen(text)) + " characters, over 280 (nothing recorded)")
        }
        var post = {platform: place.platform, where: where, tag: tag, title: trim(answer.title), text: text, time: nowMs()}
        push(record.posts, post)
        push(made, post)
    }

    addStep(record, "share", modelFor(config, "share"))
    saveRecord(config, record)

    for (var post : made)
    {
        var name = post.platform
        if (post.where != "")
        {
            name = name + " " + post.where
        }
        print("==================== " + name + "   (tag " + post.tag + ")")
        if (post.title != "")
        {
            print(post.title)
            print("")
        }
        print(post.text)
        print("")
    }
}

// article status <slug>
fun commandStatus(config, slug)
{
    var opened = openArticle(config, slug)
    var record = opened.record
    print(record.title + "   [" + toString(record.theme) + "]")
    for (var c : record.chapters)
    {
        var kept = "-"
        if (typeOf(c.kept) == "string")
        {
            kept = c.kept
        }
        var line = "  " + toString(c.n) + ". " + c.title + "   drafts: " + join(c.drafts, ", ") + "   kept: " + kept
        if (typeOf(c.edited) == "double" or typeOf(c.edited) == "int")
        {
            line = line + "   edited: " + toString(c.edited)
        }
        print(line)
    }
    if (typeOf(record.published) == "table")
    {
        print("published: " + record.published.path + " (" + record.published.date + ")")
    }
    if (len(record.checks) > 0)
    {
        var last = record.checks[len(record.checks) - 1]
        print("last checks:")
        if (len(last.findings) == 0)
        {
            print("  nothing found")
        }
        for (var finding : last.findings)
        {
            print("  - " + finding)
        }
    }
    if (len(record.posts) > 0)
    {
        print("posts:")
        for (var post : record.posts)
        {
            print("  " + post.platform + " " + post.where + "   " + post.tag + "   " + os.formatTime(post.time, "%Y-%m-%d"))
        }
    }
}
