// run.pg - the writing tool's tests.
//
// Usage (from the repo root):
//     release/PgCompilerBootstrap tools/writer/test/run.pg [group]
//
// The pure functions are called directly; each command runs as its own process against a fake
// `claude` (fake-claude.sh) in a temporary site folder, never the real site.

import "../lib/util"
import "../lib/config"
import "../lib/claude"
import "../lib/plan"
import "../lib/ideas"
import "../lib/record"
import "../lib/steps_plan"
import "../lib/steps_draft"
import "string"
import "algorithm"
import "file"
import "os" as os

var passed = 0
var failed = 0
var group = ""
if (getArgCount() > 2)
{
    group = getArg(2)
}

var repo = "/home/corse/Documents/PgEngine"
var tool = repo + "/tools/writer"
var fake = tool + "/test/fake-claude.sh"

fun check(name, condition)
{
    if (condition)
    {
        passed = passed + 1
    }
    else
    {
        failed = failed + 1
        print("FAIL " + name)
    }
}

fun checkEq(name, got, want)
{
    if (got == want)
    {
        passed = passed + 1
    }
    else
    {
        failed = failed + 1
        print("FAIL " + name + ": got [" + toString(got) + "] want [" + toString(want) + "]")
    }
}

fun wants(name)
{
    return group == "" or group == name
}

fun shq(text)
{
    return "'" + replace(text, "'", "'\\''") + "'"
}

// A temporary folder with nothing in it
fun bareSite()
{
    var r = os.call(["mktemp", "-d", "/tmp/claude-1000/writer-test-XXXXXX"])
    return trim(r.out)
}

// A temporary site whose config points `claude` at the fake
fun tempSite()
{
    var site = bareSite()
    var config = {}
    config.claude = fake
    config.engine = repo
    config.notes = site + "/notes"
    config.site = site
    config.author = "PigeonCodeur"
    config.models = {ideas: "opus", plan: "opus", draft: "sonnet", code: "sonnet", stitch: "opus", share: "sonnet"}
    os.makeDir(site + "/notes")
    writeJson(site + "/writer/config.json", config)
    return site
}

// The tool run as a command: `args` a list of strings, `env` shell assignments ("A=1 B=2")
fun runTool(site, args, env)
{
    var quoted = []
    for (var a : args)
    {
        push(quoted, shq(a))
    }
    var line = env + " ARTICLE_SITE=" + shq(site) + " " + repo + "/release/PgCompilerBootstrap " + tool + "/article.pg " + join(quoted, " ")
    var r = os.call(line)
    return r
}

// ---------------------------------------------------------------------------------------------
if (wants("foundations"))
{
    checkEq("slug plain", slugOf("Closing the gap with Lua"), "closing-the-gap-with-lua")
    checkEq("slug symbols", slugOf("  C++ & WASM: part 2!  "), "c-wasm-part-2")
    var long = ""
    var i = 0
    while (i < 80)
    {
        long = long + "a"
        i++
    }
    checkEq("slug long", strlen(slugOf(long + " b")), 60)
    checkEq("slug empty", slugOf("!!!"), "untitled")
    checkEq("nn 2", nn(2), "02")
    checkEq("nn 12", nn(12), "12")

    // First run: no writer/ at all
    var site = bareSite()
    var first = runTool(site, [], "")
    checkEq("no command exits 1", first.code, 1)
    check("no command prints usage", contains(first.out, "usage"))
    for (var name : ["config.json", "guide.md", "voices.md", "themes.json", "questions.md"])
    {
        check("first run writes " + name, fileExists(site + "/writer/" + name))
        check("first run lists " + name, contains(first.out, name))
    }

    // Second run: the author's guide is kept, nothing listed
    writeFile(site + "/writer/guide.md", "my own guide")
    var second = runTool(site, [], "")
    checkEq("guide kept", readFile(site + "/writer/guide.md"), "my own guide")
    check("nothing written again", not contains(second.out, "guide.md"))
}

// ---------------------------------------------------------------------------------------------
fun samplePlan()
{
    var plan = {title: "Integer keys", theme: "vm-performance", reader: "a developer", knows: "C++", learns: "how tables store keys", question: "why was it slow?"}
    plan.chapters = [{n: 1, title: "The symptom", answers: "what we saw", core: "tables", code: "none", visual: "none"}, {n: 2, title: "Two kinds of key", answers: "why it was slow", core: "int run, string keys", code: "ObjInstance::findInt", visual: "chart"}]
    return plan
}

if (wants("core"))
{
    var p = samplePlan()
    var text = planText(p)
    var back = parsePlan(text)
    check("plan reads back", back.ok)
    var bp = back.plan
    checkEq("plan title", bp.title, "Integer keys")
    checkEq("plan theme", bp.theme, "vm-performance")
    checkEq("plan question", bp.question, "why was it slow?")
    checkEq("plan chapters", len(bp.chapters), 2)
    var c2 = bp.chapters[1]
    checkEq("chapter 2 n", c2.n, 2)
    checkEq("chapter 2 title", c2.title, "Two kinds of key")
    checkEq("chapter 2 core", c2.core, "int run, string keys")
    checkEq("chapter 2 code", c2.code, "ObjInstance::findInt")

    var edited = parsePlan("# A title\n\n\ntheme: web\nreader:\nsome stray line\n\n## 1. First\nanswers: x\n\n## 2. Second\ncore: y\n")
    check("edited plan reads", edited.ok)
    var ep = edited.plan
    checkEq("empty key is empty", ep.reader, "")
    checkEq("edited chapters", len(ep.chapters), 2)
    var e2 = ep.chapters[1]
    checkEq("missing key is empty", e2.answers, "")

    var noTitle = parsePlan("theme: web\n## 1. First\n")
    check("no title fails", not noTitle.ok)
    check("no title says title", contains(noTitle.error, "title"))
    var noChapter = parsePlan("# T\ntheme: web\n")
    check("no chapter fails", not noChapter.ok)
    check("no chapter says chapter", contains(noChapter.error, "chapter"))

    checkEq("fill", fill("a {{x}} b {{y}}", {x: "1", y: "2"}), "a 1 b 2")

    var site = tempSite()
    var log = site + "/fake.log"
    var ok = runTool(site, ["_ask", "theme", "hello"], "FAKE_CLAUDE_LOG=" + shq(log))
    checkEq("ask exits 0", ok.code, 0)
    check("ask prints the answer", contains(ok.out, "vm-performance"))
    var last = readJson(site + "/writer/last-call.json")
    checkEq("last call step", last.step, "theme")
    var logged = readFile(log)
    check("log has json output", contains(logged, "arg: --output-format") and contains(logged, "arg: json"))
    check("log has tools", contains(logged, "arg: --tools"))
    check("never --bare", not contains(logged, "--bare"))
    check("prompt on stdin", contains(logged, "--- prompt\nhello"))
    check("guide in system prompt", contains(logged, "How these articles teach"))

    var failing = runTool(site, ["_ask", "theme", "hello"], "FAKE_CLAUDE_FAIL=1")
    checkEq("failed call exits 1", failing.code, 1)
    check("failed call names the step", contains(failing.out, "theme:"))

    var empty = runTool(site, ["_ask", "theme", "hello"], "FAKE_CLAUDE_VARIANT=empty")
    checkEq("empty answer exits 1", empty.code, 1)
    check("empty answer names the key", contains(empty.out, "theme"))
}

// ---------------------------------------------------------------------------------------------
// A site whose config's engine is a small git repo with two commits, and whose notes folder is empty
fun ideasSite()
{
    var site = tempSite()
    var engine = site + "/engine"
    os.makeDir(engine)
    var g = os.call(["git", "-C", engine, "init", "-q"])
    writeFile(engine + "/a.txt", "a")
    var c1 = os.call("cd " + shq(engine) + " && git add a.txt && git -c user.email=t@t -c user.name=t commit -q -m 'Tables: int keys are ints'")
    writeFile(engine + "/b.txt", "b")
    var c2 = os.call("cd " + shq(engine) + " && git add b.txt && git -c user.email=t@t -c user.name=t commit -q -m 'VM: fused compares'")
    var config = readJson(site + "/writer/config.json")
    config.engine = engine
    writeJson(site + "/writer/config.json", config)
    return site
}

fun countOf(text, piece)
{
    return len(split(text, piece)) - 1
}

if (wants("ideas"))
{
    var site = ideasSite()
    var log = site + "/fake.log"
    var env = "FAKE_CLAUDE_LOG=" + shq(log)

    var r = runTool(site, ["ideas"], env)
    checkEq("ideas exits 0", r.code, 0)
    var ideas = readJson(site + "/writer/ideas.json")
    checkEq("two ideas", len(ideas.ideas), 2)
    var first = ideas.ideas[0]
    var second = ideas.ideas[1]
    checkEq("id 1", first.id, 1)
    checkEq("id 2", second.id, 2)
    checkEq("status new", first.status, "new")
    check("lastScan set", ideas.lastScan.time > 0)
    // A literal "1. " does not lex (engine bug: a string starting with a digit and a dot)
    check("lists 1.", contains(r.out, toString(1) + ". "))
    check("lists 2.", contains(r.out, toString(2) + ". "))
    var logged = readFile(log)
    check("digest has the commits", contains(logged, "Tables: int keys are ints") and contains(logged, "VM: fused compares"))
    check("ideas may read", contains(logged, "arg: Read,Grep,Glob"))

    var again = runTool(site, ["ideas"], env)
    checkEq("ideas again exits 0", again.code, 0)
    check("nothing new", contains(again.out, "nothing new"))
    checkEq("no second call", countOf(readFile(log), "=== call ideas"), 1)

    // A new commit: the ideas known are in the prompt, so none is proposed twice
    var engine = site + "/engine"
    var wait = os.call(["sleep", "1.2"])
    writeFile(engine + "/c.txt", "c")
    var c3 = os.call("cd " + shq(engine) + " && git add c.txt && git -c user.email=t@t -c user.name=t commit -q -m 'Docs: imports'")
    var third = runTool(site, ["ideas"], env)
    checkEq("third scan exits 0", third.code, 0)
    var logged3 = readFile(log)
    check("known ideas in the prompt", contains(logged3, first.title))
    check("only the new commit", contains(logged3, "Docs: imports"))

    var mine = runTool(site, ["idea", "My own"], "")
    checkEq("idea exits 0", mine.code, 0)
    var after = readJson(site + "/writer/ideas.json")
    var own = findIdea(after, 5)
    check("own idea id 5", typeOf(own) == "table")
    if (typeOf(own) == "table")
    {
        checkEq("own idea title", own.title, "My own")
        checkEq("own idea question", own.question, "")
    }

    var d = runTool(site, ["decline", "2"], "")
    checkEq("decline exits 0", d.code, 0)
    var declined = findIdea(readJson(site + "/writer/ideas.json"), 2)
    checkEq("declined", declined.status, "declined")
    var listed = runTool(site, ["ideas", "list"], "")
    check("list shows declined", contains(listed.out, "declined"))
    check("list shows new", contains(listed.out, "new"))
    checkEq("decline 99", runTool(site, ["decline", "99"], "").code, 1)
}

// ---------------------------------------------------------------------------------------------
var PLANNED_SLUG = "why-integer-keys-made-tables-13x-faster"

// A site with two ideas and idea 1 planned
fun plannedSite()
{
    var site = ideasSite()
    var r = runTool(site, ["ideas"], "")
    var p = runTool(site, ["plan", "1"], "")
    return site
}

if (wants("plan"))
{
    var site = ideasSite()
    var ideasRun = runTool(site, ["ideas"], "")
    var r = runTool(site, ["plan", "1"], "")
    checkEq("plan exits 0", r.code, 0)
    var dir = site + "/writer/articles/" + PLANNED_SLUG
    var planFile = dir + "/plan.md"
    check("plan.md written", fileExists(planFile))
    var parsed = parsePlan(readFile(planFile))
    check("plan.md reads", parsed.ok)
    if (parsed.ok)
    {
        var pp = parsed.plan
        checkEq("three chapters", len(pp.chapters), 3)
        var third = pp.chapters[2]
        checkEq("chapter 3 is n 3", third.n, 3)
    }
    var record = readJson(dir + "/record.json")
    checkEq("record slug", record.slug, PLANNED_SLUG)
    checkEq("record chapters", len(record.chapters), 3)
    var rc = record.chapters[2]
    checkEq("record chapter 3", rc.n, 3)
    var step = record.steps[0]
    checkEq("record step", step.step, "plan")
    var idea = findIdea(readJson(site + "/writer/ideas.json"), 1)
    checkEq("idea planned", idea.status, "planned")
    checkEq("idea slug", idea.slug, PLANNED_SLUG)

    writeFile(planFile, readFile(planFile) + "\n## 4. A fourth chapter\nanswers: more\n")
    var before = readFile(planFile)
    var again = runTool(site, ["plan", "1"], "")
    checkEq("plan again exits 0", again.code, 0)
    check("plan again says it exists", contains(again.out, "exists"))
    checkEq("plan.md kept", readFile(planFile), before)
    var fresh = runTool(site, ["plan", "1", "--again"], "")
    checkEq("plan --again exits 0", fresh.code, 0)
    check("plan-new.md written", fileExists(dir + "/plan-new.md"))
    checkEq("plan.md still kept", readFile(planFile), before)

    checkEq("plan 99 fails", runTool(site, ["plan", "99"], "").code, 1)
    var d = runTool(site, ["decline", "2"], "")
    checkEq("plan of a declined idea fails", runTool(site, ["plan", "2"], "").code, 1)

    // The record follows the plan the author edited: a 4th chapter, the first three as they were
    var config = {writer: site + "/writer"}
    var rec = loadRecord(config, PLANNED_SLUG)
    var first = rec.chapters[0]
    first.kept = "story"
    var edited = loadPlan(config, PLANNED_SLUG)
    syncChapters(rec, edited)
    checkEq("synced to 4 chapters", len(rec.chapters), 4)
    var kept = rec.chapters[0]
    checkEq("chapter 1 kept as it was", kept.kept, "story")
    var fourth = rec.chapters[3]
    checkEq("chapter 4 title", fourth.title, "A fourth chapter")
}

// ---------------------------------------------------------------------------------------------
if (wants("draft"))
{
    var site = plannedSite()
    var slug = PLANNED_SLUG
    var dir = site + "/writer/articles/" + slug
    var log = site + "/fake.log"
    var env = "FAKE_CLAUDE_LOG=" + shq(log)
    writeText(dir + "/chapters/01.md", "Chapter one, kept by the author.")

    var r = runTool(site, ["draft", slug, "2"], env)
    checkEq("draft exits 0", r.code, 0)
    check("code written first", fileExists(dir + "/code/02.md"))
    var logged = readFile(log)
    var codeAt = indexOf(logged, "=== call code")
    var draftAt = indexOf(logged, "=== call draft")
    check("code call before the drafts", codeAt >= 0 and draftAt > codeAt)
    for (var voice : ["guide", "story", "brief"])
    {
        check("draft " + voice, fileExists(dir + "/chapters/02-" + voice + ".md"))
    }
    check("no 02.md", not fileExists(dir + "/chapters/02.md"))
    var rec = readJson(dir + "/record.json")
    var c2 = rec.chapters[1]
    checkEq("drafts recorded", join(c2.drafts, ","), "guide,story,brief")
    check("draft prompt has chapter 1", contains(logged, "Chapter one, kept by the author."))
    check("draft prompt has the code", contains(logged, "where an int key is looked up"))
    check("drafts have no tools", contains(logged, "arg: --tools\narg: \n"))

    writeFile(dir + "/chapters/02-guide.md", "changed by hand")
    var again = runTool(site, ["draft", slug, "2"], "")
    checkEq("draft again exits 0", again.code, 0)
    check("draft again skips", contains(again.out, "skipped"))
    checkEq("draft kept", readFile(dir + "/chapters/02-guide.md"), "changed by hand")
    var forced = runTool(site, ["draft", slug, "2", "--again"], "")
    checkEq("draft --again exits 0", forced.code, 0)
    check("draft rewritten", readFile(dir + "/chapters/02-guide.md") != "changed by hand")

    var pick = runTool(site, ["pick", slug, "2", "story"], "")
    checkEq("pick exits 0", pick.code, 0)
    checkEq("kept file is the story", readFile(dir + "/chapters/02.md"), readFile(dir + "/chapters/02-story.md"))
    var picked = readJson(dir + "/record.json")
    var pc = picked.chapters[1]
    checkEq("kept story", pc.kept, "story")

    writeFile(dir + "/chapters/02.md", "my own words")
    checkEq("pick over own text fails", runTool(site, ["pick", slug, "2", "guide"], "").code, 1)
    checkEq("own text kept", readFile(dir + "/chapters/02.md"), "my own words")
    var replaced = runTool(site, ["pick", slug, "2", "guide", "--replace"], "")
    checkEq("pick --replace exits 0", replaced.code, 0)
    checkEq("kept file is the guide", readFile(dir + "/chapters/02.md"), readFile(dir + "/chapters/02-guide.md"))
    checkEq("pick of an unknown voice fails", runTool(site, ["pick", slug, "2", "nosuch"], "").code, 1)

    checkEq("mine without the file fails", runTool(site, ["mine", slug, "3"], "").code, 1)
    writeText(dir + "/chapters/03.md", "Chapter three, all mine.")
    checkEq("mine exits 0", runTool(site, ["mine", slug, "3"], "").code, 0)
    var mineRec = readJson(dir + "/record.json")
    var m3 = mineRec.chapters[2]
    checkEq("kept mine", m3.kept, "mine")

    writeFile(dir + "/plan.md", readFile(dir + "/plan.md") + "\n## 4. Afterwards\nanswers: what is left\ncode: none\n")
    var fourth = runTool(site, ["draft", slug, "4"], "")
    checkEq("draft of a new chapter exits 0", fourth.code, 0)
    check("chapter 4 drafted", fileExists(dir + "/chapters/04-brief.md"))
    var four = readJson(dir + "/record.json")
    checkEq("record has 4 chapters", len(four.chapters), 4)
    checkEq("draft of a missing chapter fails", runTool(site, ["draft", slug, "9"], "").code, 1)
}

print(toString(passed) + " passed, " + toString(failed) + " failed")
if (failed > 0)
{
    os.exit(1)
}
