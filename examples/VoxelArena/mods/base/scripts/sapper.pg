// The sapper's brain (see brute.pg for what the game puts in `me` and what it reads back).
// It runs straight at the player, faster when far, and close enough it lights its fuse (the "fuse" attack,
// which ends in its own death: its keg goes off, see enemies/sapper.json).

import "math"

fun think(me)
{
    var p = me.params

    if (me.distance > p.engageRange and me.hunting == false)
    {
        me.move = "hold"
    }
    else if (me.distance <= p.fuseRange and abs(me.angle) < 60)
    {
        me.attack = "fuse"
    }
    else
    {
        me.move = "chase"

        if (me.distance > 8)
        {
            me.speed = 1.15
        }
    }
}
