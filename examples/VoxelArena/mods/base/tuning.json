// Every gameplay number of the game. Press F5 in game to reload this file (and the rest of the content).
// Distances are in metres (1 block = 1 m), speeds in m/s, times in seconds unless the name says frames.
// Frame counts are at 60 frames per second.
{
    "player": {
        "model": "base:player",
        "modelScale": 0.125,
        "weapon": "base:sword",
        // Terrain abilities on the keys ability1, ability2, ability3 (Q, E, F by default)
        "abilities": ["base:raise_wall", "base:dig_pit", "base:mine"],
        "hand": [0.42, 0.95, 0.3],

        "width": 0.6,
        "height": 1.8,
        "health": 100,
        "poise": 10,
        "hitstunFrames": 22,
        "respawnSeconds": 2.0,

        "walkSpeed": 5.6,
        "sprintSpeed": 8.6,
        "groundAccel": 70,
        "groundDecel": 55,
        "turnAccel": 110,
        "airAccel": 22,
        "airDecel": 3,
        "turnSpeed": 960,

        "gravity": 34,
        "fallGravityScale": 1.55,
        "jumpCutGravityScale": 2.8,
        "maxFallSpeed": 40,
        "jumpHeight": 2.2,
        "coyoteTime": 0.1,
        "jumpBuffer": 0.12,

        "stepHeight": 1.05,
        "stepSmoothing": 18,

        // Ledge assist: a jump whose feet end this close under a ledge's top climbs onto it
        "mantleHeight": 0.5,
        // Corner correction: a head that clips a block edge on the way up slides around it
        "cornerCorrection": 0.3,

        // Momentum: speed at takeoff is kept in the air and for a moment after landing, so sprint
        // jumps and roll jumps chain; above-run speed then bleeds off instead of braking at once
        "landingGrace": 0.15,
        "overspeedDecel": 14,

        // Big falls cost a short recovery (a slow, or a root with hardLandingMoveSpeed 0), unless a
        // dodge pressed in the air up to landingRollWindow seconds before landing rolls out of it
        "hardLandingSpeed": 19,
        "hardLandingFrames": 16,
        "hardLandingMoveSpeed": 0.4,
        "landingRollWindow": 0.35
    },

    "stamina": {
        "max": 100,
        "regen": 38,
        "regenDelay": 0.55,
        "sprintCost": 16,
        "minToAct": 1,
        "exhaustedRegenScale": 0.6
    },

    "dodge": {
        "frames": 27,
        "iframeStart": 1,
        "iframeEnd": 17,
        "recovery": 6,
        "speed": 17,
        "endSpeed": 8,
        "cost": 20,
        "attackFrom": 15,
        "jumpFrom": 21,
        "inAir": false
    },

    "camera": {
        "distance": 5.5,
        "minDistance": 1.6,
        "maxDistance": 10,
        "zoomStep": 0.6,
        "height": 1.85,
        "shoulder": 0.8,
        "sensitivity": 0.14,
        "minPitch": -65,
        "maxPitch": 70,
        "followSharpness": 16,
        "pullInSharpness": 40,
        "pullOutSharpness": 4,
        "collisionRadius": 0.25,
        "fov": 70
    },

    // V switches between third and first person
    "firstPerson": {
        "eyeHeight": 1.62,
        "minPitch": -85,
        "maxPitch": 85,
        "fov": 80,
        "weapon": [0.3, -0.34, 0.42],
        "rollDip": 0.7,
        "viewModelScale": 0.3
    },

    "feel": {
        "hitFlashFrames": 7,
        "hitstopScale": 1.0,
        "shakeDecay": 2.2,
        "shakeOffset": 0.35,
        "shakeAngle": 2.4,
        "shakeFrequency": 24,
        "knockbackFriction": 22,
        "landingShake": 0.15
    },

    // Key names are SDL's ("W", "Space", "Left Shift", "Left Alt"...); Mouse1 is the left button, Mouse3 the right.
    // Dodge and sprint share a key on purpose: tap to roll, keep holding to sprint out of the roll.
    "controls": {
        "forward": ["W", "Up"],
        "back": ["S", "Down"],
        "left": ["A", "Left"],
        "right": ["D", "Right"],
        "jump": ["Space"],
        "dodge": ["Left Shift"],
        "sprint": ["Left Shift"],
        "light": ["Mouse1", "J"],
        "heavy": ["Mouse3", "K"],
        "freeCursor": ["Left Alt"],
        "toggleView": ["V"],
        "ability1": ["Q"],
        "ability2": ["E"],
        "ability3": ["F", "Mouse2"]
    },

    // Pieces of the arena that lose their support fall, and crush what they land on
    "terrain": {
        "gravity": 30,
        "crushDamage": 30,
        "crushPerBlock": 3,
        "crushMax": 90,
        "crushPoise": 60,
        "crushShake": 0.6
    },

    "combat": {
        "inputBuffer": 0.2,
        "aimAssistAngle": 55,
        "aimAssistRange": 3.5
    }
}
