// Every gameplay number of the game. Press F5 in game to reload this file (and the rest of the content).
// Distances are in metres (1 block = 1 m), speeds in m/s, times in seconds unless the name says frames.
// Frame counts are at 60 frames per second.
{
    "player": {
        "model": "base:player",
        "modelScale": 0.125,
        "weapon": "base:sword",
        // Abilities on the keys ability1 .. ability8 (Q, E, G, R, 1, 2, 3, 4 by default); "" leaves a slot empty.
        // A slot can be a list: the first one the weapon in hand allows is there (weapon skills).
        // The terrain on Q E G, your spells on 1 2 3 ("spell:1"...), the weapon's skills on R and 4
        "abilities": ["base:raise_wall", "base:dig_pit", "base:mine", ["base:shadow_dash", "base:whirlwind", "base:volley", "base:sanctuary", "base:harvest"],
                      "spell:1", "spell:2", "spell:3", ["base:backflip", "base:leap_slam", "base:disengage", "base:radiance", "base:grim_vault"]],
        // The spells on 1 2 3 to begin with outside a run (ready-made, spells/); in a run, level ups give them. The spellbook (console: spellbook) makes others: a tool for mods
        "spells": ["base:firebolt", "base:ice_shards", "base:chain_lightning"],
        "hand": [0.42, 0.95, 0.3],

        "width": 0.6,
        "height": 1.8,
        "health": 100,
        "poise": 10,
        "hitstunFrames": 22,
        // A light hit's stagger can be rolled out of from this frame; a hit doing heavyHitPoise or more cannot
        "hitstunDodgeFrom": 6,
        "heavyHitPoise": 25,
        "respawnSeconds": 2.0,

        "walkSpeed": 5.6,
        "sprintSpeed": 8.6,
        "groundAccel": 70,
        "groundDecel": 55,
        "turnAccel": 110,
        "airAccel": 22,
        "airDecel": 3,
        "turnSpeed": 960,

        "gravity": 34,
        "fallGravityScale": 1.55,
        "jumpCutGravityScale": 2.8,
        "maxFallSpeed": 40,
        "jumpHeight": 2.2,
        "coyoteTime": 0.1,
        "jumpBuffer": 0.12,

        "stepHeight": 1.05,
        "stepSmoothing": 18,

        // Ledge assist: a jump whose feet end this close under a ledge's top climbs onto it
        "mantleHeight": 0.5,
        // Corner correction: a head that clips a block edge on the way up slides around it
        "cornerCorrection": 0.3,

        // Momentum: speed at takeoff is kept in the air and for a moment after landing (landingGrace), so
        // sprint jumps and roll jumps chain; then above-run speed bleeds off fast (overspeedDecel, m/s^2)
        "landingGrace": 0.15,
        "overspeedDecel": 45,

        // Big falls cost a short recovery (a slow, or a root with hardLandingMoveSpeed 0), unless a
        // dodge pressed in the air up to landingRollWindow seconds before landing rolls out of it
        "hardLandingSpeed": 19,
        "hardLandingFrames": 16,
        "hardLandingMoveSpeed": 0.4,
        "landingRollWindow": 0.35
    },

    "stamina": {
        "max": 100,
        "regen": 38,
        "regenDelay": 0.55,
        "sprintCost": 16,
        "minToAct": 1,
        "exhaustedRegenScale": 0.6
    },

    "dodge": {
        "frames": 27,
        "iframeStart": 1,
        "iframeEnd": 17,
        "recovery": 6,
        "speed": 17,
        "endSpeed": 8,
        "attackFrom": 15,
        "jumpFrom": 1,
        "inAir": false
    },

    "camera": {
        "distance": 5.5,
        "minDistance": 1.6,
        "maxDistance": 10,
        "zoomStep": 0.6,
        "height": 1.85,
        "shoulder": 0.8,
        "sensitivity": 0.14,
        "minPitch": -65,
        "maxPitch": 70,
        "followSharpness": 16,
        "pullInSharpness": 40,
        "pullOutSharpness": 4,
        "collisionRadius": 0.25,
        "fov": 70
    },

    // V switches between third and first person
    "firstPerson": {
        "eyeHeight": 1.62,
        "minPitch": -85,
        "maxPitch": 85,
        "fov": 80,
        "weapon": [0.3, -0.34, 0.42],
        "rollDip": 0.7,
        "viewModelScale": 0.3
    },

    "feel": {
        // The whole game's pace: every step plays this much slower (0.85) or faster, the same on every machine
        "gameSpeed": 0.85,
        "hitFlashFrames": 7,
        "hitstopScale": 1.0,
        "shakeDecay": 2.2,
        "shakeOffset": 0.35,
        "shakeAngle": 2.4,
        "shakeFrequency": 24,
        "knockbackFriction": 22,
        "landingShake": 0.15
    },

    // Key names are SDL's ("W", "Space", "Left Shift", "Left Alt"...); Mouse1 is the left button, Mouse3 the right.
    // Dodge and sprint share a key on purpose: tap to roll, keep holding to sprint out of the roll.
    "controls": {
        "forward": ["W", "Up"],
        "back": ["S", "Down"],
        "left": ["A", "Left"],
        "right": ["D", "Right"],
        "jump": ["Space"],
        "dodge": ["Left Shift"],
        "sprint": ["Left Shift"],
        "light": ["Mouse1", "J"],
        "heavy": ["Mouse3", "K"],
        "freeCursor": ["Left Alt"],
        "toggleView": ["F", "V"],
        "ability1": ["Q"],
        "ability2": ["E"],
        "ability3": ["G", "Mouse2"],
        "ability4": ["R"],
        "ability5": ["1"],
        "ability6": ["2"],
        "ability7": ["3"],
        "ability8": ["4"],
        "crouch": ["Left Ctrl", "C"],
        "nextWeapon": ["Tab"],
        "options": ["O"]
    },

    // A controller's buttons, by action, as the keys above: SDL's names (a, b, x, y, back, start, leftstick,
    // rightstick, leftshoulder, rightshoulder, dpup, dpdown, dpleft, dpright) and lefttrigger / righttrigger.
    // The left stick moves, the right one looks (the options' sensitivity and invert Y). Start is Esc (the options).
    // On a screen the d-pad or the left stick goes from button to button, A presses, B is Esc. The player rebinds them
    // in the game (Options, Controls, Controller), kept over these
    "gamepad": {
        "jump": "a",
        "dodge": "b",
        "sprint": "b",
        "light": "x",
        "heavy": "y",
        "ability4": "leftshoulder",
        "ability8": "rightshoulder",
        "ability5": "lefttrigger",
        "ability6": "righttrigger",
        "ability7": "dpup",
        "ability1": "dpleft",
        "ability2": "dpdown",
        "ability3": "dpright",
        "crouch": "leftstick",
        "toggleView": "rightstick",
        "nextWeapon": "back"
    },

    // In the air: a double jump, a jump off a wall you touch, an air dash (Shift; about to land, within
    // the player's landingRollWindow or under dashMinHeight, Shift is the landing roll), and a fast fall (crouch held)
    "air": {
        "jumps": 1,
        "jumpHeight": 1.3,
        "wallJumpPush": 7.5,
        "wallJumpHeight": 1.4,
        "wallReach": 0.25,
        "wallJumpLockFrames": 10,
        "dashFrames": 10,
        "dashSpeed": 16,
        "dashes": 1,
        "dashMinHeight": 1.5,
        "fastFallGravityScale": 3.0,
        "fastFallMaxSpeed": 55
    },

    // The roll and the air dash (and the landing roll, and rolling out of a hit) spend a dash charge,
    // not stamina: `charges` of them, one back every `recharge` seconds
    "dash": {
        "charges": 2,
        "recharge": 1.2
    },

    // Spells spend mana, not stamina: casting never stops a roll. Your weapon's hits give mana back:
    // fromWeapon for each point of damage its light and heavy attacks do (a weapon's "mana" can set its own)
    "mana": {
        "max": 100,
        "regen": 7,
        "regenDelay": 1.0,
        "fromWeapon": 0.3
    },

    // What fire and ice do to the arena (volt's is the blocks' "weakness")
    "elements": {
        "burnSeconds": 2.5,
        "spreadSeconds": 0.8,
        "iceLifetime": 8
    },

    // Pieces of the arena that lose their support fall, and crush what they land on
    // Enemies climb a wall they walk into, out of a pit or up a ledge, from a step up to maxHeight blocks: at speed m/s
    // for one sizeRef m tall (a bigger one climbs faster, a small one slower), slower the higher it is
    // (speed / (1 + deepSlow x (blocks - 1))). A hit knocks a climber off.
    "climb": {
        "maxHeight": 4,
        "speed": 1.6,
        "sizeRef": 1.8,
        "deepSlow": 0.35
    },

    "terrain": {
        "gravity": 30,
        "crushDamage": 30,
        "crushPerBlock": 3,
        "crushMax": 90,
        "crushPoise": 60,
        "crushShake": 0.6
    },

    "combat": {
        "inputBuffer": 0.2,
        "aimAssistAngle": 55,
        "aimAssistRange": 3.5,
        // Attacks aim up or down at their target (first person: with the view), at most this many degrees
        "maxAttackPitch": 60,
        // A light press this soon after a sprint ends is still the dash attack
        "dashAttackWindow": 0.15
    },
    // Enemies' tenacity: each stagger gives a stack (an elite one more, see an enemy's "tenacityGain"), each stack
    // takes 12% of the poise damage it takes and 8% of its staggers' length off, 6 at most; one falls off every 3 s
    "tenacity": {
        "poise": 0.12,
        "stagger": 0.08,
        "most": 6,
        "fallOff": 3,
        "elite": 1
    }
}
