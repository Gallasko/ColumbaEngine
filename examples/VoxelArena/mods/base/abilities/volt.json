    "status": "shock",
    "manaCost": 30,
    "cooldown": 1.0,
    "range": 24,
    "damage": 12,
    "poiseDamage": 6,
    "knockback": 1,
    "chains": 3,
    "chainRange": 6,
    "terrainDamage": 40
}
