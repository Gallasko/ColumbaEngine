// The items of an arena run: the shop sells them between waves (for `price` shards, times run.json's
// shop.priceScale for the wave and the item's rarity), and a present gives one free. Their numbers add up with each one
// taken, with no limit: an item stops coming only when one more would do nothing (armor at 70%, cooldowns and spell
// costs 70% off, crit at 100%; a tag item's cooldown and cost 80% off). most: how many one can have in a run, for
// the few where more would break the game (dash charges, status stacks, speed, attack speed, projectiles, horde).
// tiers: the rarities it comes at (run.json shop.rarities, by name; none: any). The items of whole numbers (a dash
// charge, a status stack, a projectile) are not made bigger by a rarity: they come as Rare only.
// damage 0.15 is 15% more, manaCost 0.15 is 15% cheaper spells, cooldown 0.2 is 20% shorter skill and spell
// cooldowns, speed 0.08 is 8% faster, armor 0.06
// takes 6% off the damage taken (70% at most), crit 0.06 is a 6% chance of a hit doing twice the
// damage, pickupRange in metres, regen in health a second, attackSpeed 0.1 makes the weapon's light and
// heavy attacks 10% quicker (their frames fewer, their lunges as far). horde 0.15 brings 15% more enemies,
// xpGain 0.15 gives 15% more XP from each shard, shardChance 0.1 gives each shard a kill drops a 10% chance
// of one more. horde and shardChance are for everyone in the run (they add up across the players; shardChance with
// diminishing returns, see run.json's shardFalloff).
//
// look: how the item shows on the player who has it. A piece worn on the body: { "model", "part" (head, body,
// arm_l, arm_r, leg_l, leg_r: it moves with it), "at" (where the model's bottom centre goes, in the player
// model's voxels: x 0..7 from its right arm to its left, y up, z 0..5 back to front), "yaw", "scale" (its
// voxels in m, 0.0625 by default) }, or a list of them; or a gem circling the player: { "orbit": [r, g, b], "icon" }, its
// colour and its shape: one of the UI's pixel icons (fire, ice, volt, clock, shield, skull, heart, sword... see Game/ui.cpp).
// The base mod's pieces are made by tools/make_looks.py, which prints where they go.
{
    "tough":      { "name": "Tough",        "text": "+25 max health",                       "maxHealth": 25,     "price": 10,
                    "look": [{ "model": "look_pauldron", "part": "arm_r", "at": [0.25, 11, 2.5] }, { "model": "look_pauldron", "part": "arm_l", "at": [6.75, 11, 2.5] }] },
    "keen":       { "name": "Keen edge",    "text": "+15% damage on all attacks and spells", "damage": 0.15,      "price": 14,
                    "look": { "model": "look_bracer", "part": "arm_r", "at": [0, 6, 2.5] } },
    "nimble":     { "name": "Nimble",       "text": "+1 dash charge",                        "dashCharges": 1,    "most": 3, "price": 14, "tiers": ["Rare"],
                    "look": [{ "model": "look_wing", "part": "leg_r", "at": [0.75, 1.5, 1.75] }, { "model": "look_wing", "part": "leg_l", "at": [6.25, 1.5, 1.75] }] },
    "focus":      { "name": "Focus",        "text": "Spells cost 15% less",                  "manaCost": 0.15,    "price": 12,
                    "look": { "model": "look_gem", "part": "head", "at": [3.5, 13.75, 5.25] } },
    "wellspring": { "name": "Wellspring",   "text": "+40% mana regeneration",                "manaRegen": 0.4,    "price": 12,
                    "look": { "model": "look_flask", "part": "body", "at": [5.25, 5, 0.75] } },
    "second_wind":{ "name": "Second wind",  "text": "+35% stamina regeneration",             "staminaRegen": 0.35,"price": 10,
                    "look": { "model": "look_scarf", "part": "body", "at": [3.5, 8, 2.5] } },
    "swift":      { "name": "Swift",        "text": "+8% move speed",                        "speed": 0.08,       "most": 5, "price": 12,
                    "look": [{ "model": "look_knee", "part": "leg_r", "at": [2, 3, 4.25] }, { "model": "look_knee", "part": "leg_l", "at": [5, 3, 4.25] }] },
    "quick":      { "name": "Quick hands",  "text": "-20% cooldown on all skills and spells", "cooldown": 0.2,     "price": 18,
                    "look": { "model": "look_hourglass", "part": "body", "at": [5, 5, 4.25] } },
    "leech":      { "name": "Leech",        "text": "Heal 2 on every hit",                   "lifeOnHit": 2,      "price": 16,
                    "look": { "model": "look_fangs", "part": "body", "at": [3.5, 8.5, 4.5] } },
    "potent":     { "name": "Potent",       "text": "Your statuses land 1 stack deeper",     "statusStacks": 1,   "most": 2, "price": 13, "tiers": ["Rare"],
                    "look": { "model": "look_vial", "part": "body", "at": [1.75, 5.25, 4.25] } },
    "plated":     { "name": "Plated",       "text": "Take 6% less damage",                   "armor": 0.06,       "price": 12,
                    "look": { "model": "look_plate", "part": "body", "at": [3.5, 7, 4.25] } },
    "precise":    { "name": "Precise",      "text": "+6% chance of a double damage hit",     "crit": 0.06,        "price": 12,
                    "look": { "model": "look_monocle", "part": "head", "at": [2.5, 11.5, 5.25] } },
    "magnet":     { "name": "Magnet",       "text": "Pick up shards 1.5 m further",          "pickupRange": 1.5,  "price": 6,
                    "look": { "model": "look_magnet", "part": "body", "at": [3.5, 8, 0.75] } },
    "mending":    { "name": "Mending",      "text": "Regenerate 0.6 health a second",        "regen": 0.6,        "price": 12,
                    "look": { "model": "look_bandage", "part": "arm_l", "at": [6.75, 6, 2.5] } },
    "frenzy":     { "name": "Frenzy",       "text": "+10% attack speed",                     "attackSpeed": 0.1,  "most": 6, "price": 14,
                    "look": { "model": "look_headband", "part": "head", "at": [3.5, 12.5, 2.5], "scale": 0.03125 } },

    // More risk, more reward: more enemies, and more out of each one
    "horde":      { "name": "Horde",        "text": "15% more enemies come",                 "horde": 0.15,       "most": 5, "price": 8,
                    "look": { "model": "look_horns", "part": "head", "at": [3.5, 15, 2.5] } },
    "scholar":    { "name": "Scholar",      "text": "+15% XP from each shard",               "xpGain": 0.15,      "price": 12,
                    "look": { "model": "look_book", "part": "body", "at": [3.5, 6.25, 0.5] } },
    "greed":      { "name": "Greed",        "text": "Enemies drop 7% more shards",           "shardChance": 0.07, "price": 14,
                    "look": { "model": "look_pouch", "part": "body", "at": [3.25, 5.25, 4.25] } },

    // Payoff items: more out of statuses and element combos (combos.json). comboDamage 0.4: combos do 40% more;
    // statusDuration 0.5: the statuses you leave last 50% longer; against: more damage to enemies with a status
    // ({ "burn": 0.3 }: 30% more to burning ones); burst: an enemy you kill with that status ("if") explodes,
    // `damage` (grown with the waves) to everyone within `radius`, leaving `status`. needs: offered only when
    // something of yours has one of these tags (a fire spell, a flame blade); needsElements: only with at least
    // that many elements among your tags (two make combos).
    "catalyst":   { "name": "Catalyst",     "comboDamage": 0.4,  "needsElements": 2, "price": 14, "look": { "orbit": [255, 255, 255] , "icon": "multiply" } },
    "kindling":   { "name": "Kindling",     "against": { "burn": 0.3 }, "needs": ["fire"], "price": 12, "look": { "orbit": [255, 72, 24] , "icon": "fire" } },
    "brittle":    { "name": "Brittle",      "against": { "chill": 0.3, "frozen": 0.3 }, "needs": ["ice"], "price": 12, "look": { "orbit": [120, 200, 255] , "icon": "ice" } },
    "pyre":       { "name": "Pyre",         "burst": { "if": "burn", "radius": 3, "damage": 14, "status": "burn" }, "needs": ["fire"], "price": 16,
                    "look": { "orbit": [255, 150, 30] , "icon": "nova" } },
    "long_fuse":  { "name": "Long fuse",    "statusDuration": 0.5, "needs": ["fire", "ice", "volt"], "price": 10, "look": { "orbit": [200, 150, 255] , "icon": "extend" } },

    // Trade-offs: something big for something lost. A rarity makes only the good side bigger: the downside (a
    // negative number, damageTaken) stays as written. healthScale -0.3: 30% less max health; damageTaken 0.2:
    // you take 20% more damage; a negative speed, manaCost or staminaRegen: slower, dearer spells, slower stamina.
    "glass_cannon": { "name": "Glass cannon", "damage": 0.35, "healthScale": -0.3, "most": 2, "price": 14,
                      "look": { "model": "look_heart", "part": "body", "at": [4.75, 8.25, 4.75] } },
    "juggernaut":   { "name": "Juggernaut",   "armor": 0.12, "maxHealth": 20, "speed": -0.12, "most": 2, "price": 14,
                      "look": [{ "model": "look_greaves", "part": "leg_r", "at": [2, 1.5, 4.25] }, { "model": "look_greaves", "part": "leg_l", "at": [5, 1.5, 4.25] }] },
    "cursed_coin":  { "name": "Cursed coin",  "shardChance": 0.25, "damageTaken": 0.2, "most": 3, "price": 10,
                      "look": { "model": "look_coin", "part": "head", "at": [0.75, 11.5, 2.5] } },
    "overclock":    { "name": "Overclock",    "cooldown": 0.25, "manaCost": -0.35, "staminaRegen": -0.3, "most": 2, "price": 16,
                      "look": { "model": "look_gear", "part": "arm_l", "at": [7.25, 8, 2] } },

    // More damage in the moment: hurtDamage under half health, airDamage in the air, executeDamage against an enemy
    // under 30% health, revengeDamage for 3 s after you take a hit
    "last_stand":   { "name": "Last stand",   "hurtDamage": 0.4,    "price": 12, "look": { "orbit": [220, 40, 40] , "icon": "shield" } },
    "sky_striker":  { "name": "Sky striker",  "airDamage": 0.35,    "price": 12, "look": { "orbit": [200, 240, 255] , "icon": "wind" } },
    "executioner":  { "name": "Executioner",  "executeDamage": 0.5, "price": 12, "look": { "orbit": [120, 20, 30] , "icon": "skull" } },
    "grudge":       { "name": "Grudge",       "revengeDamage": 0.4, "price": 12, "look": { "orbit": [255, 150, 60] , "icon": "empower" } },

    // Triggers. thorns 0.8: 80% of the damage an enemy deals you goes back to it. killHeal: health back for each kill.
    // dodgeGround: ground left where you start a roll ({ "radius", "duration", "perSecond", "element", "status" }).
    // proc: every `every`-th hit of your weapon also does `damage` to the enemy and jumps on to `chains` more
    // ({ "every", "chains", "damage", "element", "status" }). landing: a hard landing (a fast fall) hits every enemy
    // within `radius` for `damage`. Their damage grows with the waves, as the enemies' health does.
    "thorns":       { "name": "Thorns",       "thorns": 0.8, "price": 12,
                      "look": { "model": "look_thorns", "part": "arm_r", "at": [0, 8.5, 2.5] } },
    "soul_siphon":  { "name": "Soul siphon",  "killHeal": 2, "price": 12, "look": { "orbit": [160, 90, 230] , "icon": "heart" } },
    "ember_trail":  { "name": "Ember trail",  "price": 14,
                      "dodgeGround": { "radius": 1.6, "duration": 3, "perSecond": 10, "element": "fire", "status": "burn" },
                      "look": [{ "model": "look_anklet", "part": "leg_r", "at": [2, 1, 2.5], "scale": 0.03125 }, { "model": "look_anklet", "part": "leg_l", "at": [5, 1, 2.5], "scale": 0.03125 }] },
    "static_charge":{ "name": "Static charge","price": 16,
                      "proc": { "every": 5, "chains": 2, "damage": 14, "element": "volt", "status": "shock" },
                      "look": { "orbit": [255, 250, 140] , "icon": "bolt" } },

    // Unlocked by goals (achievements.json): new for the players who reach them
    "flint":        { "name": "Flint",        "price": 14,
                      "proc": { "every": 4, "chains": 1, "damage": 10, "element": "fire", "status": "burn" },
                      "look": { "orbit": [255, 120, 40] , "icon": "fire" } },
    "frost_trail":  { "name": "Frost trail",  "price": 14,
                      "dodgeGround": { "radius": 1.8, "duration": 3, "perSecond": 6, "element": "ice", "status": "chill" },
                      "look": { "orbit": [150, 220, 255] , "icon": "dash" } },
    "storm_trail":  { "name": "Storm trail",  "price": 14,
                      "dodgeGround": { "radius": 1.6, "duration": 3, "perSecond": 8, "element": "volt", "status": "shock" },
                      "look": { "orbit": [255, 235, 110] , "icon": "dash" } },
    "shatterburst": { "name": "Shatterburst", "burst": { "if": "frozen", "radius": 3.5, "damage": 18, "status": "chill" }, "needs": ["ice"], "price": 16,
                      "look": { "orbit": [190, 240, 255] , "icon": "nova" } },
    "thunderburst": { "name": "Thunderburst", "burst": { "if": "shock", "radius": 3, "damage": 14, "status": "shock" }, "needs": ["volt"], "price": 16,
                      "look": { "orbit": [255, 240, 120] , "icon": "nova" } },

    // Tag items: a boost for every spell and technique of yours with the tag. Spells have "spell", their
    // element and their shapes' ("projectile" for a bolt, "area" for a nova or a zone, "zone", "beam");
    // techniques have "technique", their own ("melee", "area", "dash", "heal"...) and "projectile" when
    // they shoot; the weapon's light and heavy attacks have "attack", its role ("melee", "ranged",
    // "support"), its type ("sword") and "projectile" when they shoot (they take damage, area and
    // projectile speed, and more projectiles: a bow's arrows, a staff's orbs, fanned out). A boost: damage, area, cooldown, cost (mana or stamina), duration, speed (projectile
    // speed), count (more projectiles: not scaled by rarity). Offered only when something of yours has the tag.
    "searing":    { "name": "Searing",      "tag": "fire",       "boost": { "damage": 0.2 },   "price": 12, "look": { "orbit": [255, 106, 61] , "icon": "fire" } },
    "frostbite":  { "name": "Frostbite",    "tag": "ice",        "boost": { "damage": 0.2 },   "price": 12, "look": { "orbit": [158, 232, 255] , "icon": "ice" } },
    "overcharge": { "name": "Overcharge",   "tag": "volt",       "boost": { "damage": 0.2 },   "price": 12, "look": { "orbit": [255, 225, 74] , "icon": "volt" } },
    "split_shot": { "name": "Split shot",   "tag": "projectile", "boost": { "count": 1 },      "most": 3, "price": 17, "tiers": ["Rare"], "look": { "orbit": [232, 232, 240] , "icon": "stacks" } },
    "fleet":      { "name": "Fleet",        "tag": "projectile", "boost": { "speed": 0.25 },   "most": 4, "price": 8, "look": { "orbit": [156, 240, 122] , "icon": "dash" } },
    "widening":   { "name": "Widening",     "tag": "area",       "boost": { "area": 0.2 },     "price": 12, "look": { "orbit": [255, 160, 74] , "icon": "enlarge" } },
    "lingering":  { "name": "Lingering",    "tag": "zone",       "boost": { "duration": 0.3 }, "price": 10, "look": { "orbit": [176, 122, 255] , "icon": "zone" } },
    "hastened":   { "name": "Hastened",     "tag": "spell",      "boost": { "cooldown": 0.15 },"price": 14, "look": { "orbit": [106, 168, 255] , "icon": "clock" } },
    "frugal":     { "name": "Frugal",       "tag": "spell",      "boost": { "cost": 0.2 },     "price": 10, "look": { "orbit": [90, 224, 200] , "icon": "drop" } },
    "honed":      { "name": "Honed",        "tag": "melee",      "boost": { "damage": 0.2 },   "price": 12, "look": { "orbit": [208, 72, 72] , "icon": "sword" } },
    "whetstone":  { "name": "Whetstone",    "tag": "attack",     "boost": { "damage": 0.15 },  "price": 12, "look": { "orbit": [168, 176, 192] , "icon": "keen" } },
    "drilled":    { "name": "Drilled",      "tag": "technique",  "boost": { "cooldown": 0.15 },"price": 14, "look": { "orbit": [200, 240, 80] , "icon": "target" } },
    "tireless":   { "name": "Tireless",     "staminaCost": 0.2,                                "price": 10, "look": { "orbit": [240, 192, 80] , "icon": "leap" } },
    "blessed":    { "name": "Blessed",      "tag": "heal",       "boost": { "damage": 0.25 },  "price": 12, "look": { "orbit": [255, 184, 224] , "icon": "plus" } }
}
