// The goals of the game: each one counts something over all of a player's runs ("stat", see the README), and when it
// reaches "goal" what it "unlocks" comes into that player's runs: weapons, spells, techniques, items, or a branch of
// one ("sword#0"). Anything a goal unlocks is locked until then; everything else is open from the first run.
// The achievements screen shows them in this order.
{
    // ---- The weapons
    "swift_blade":   { "name": "Swift blade", "text": "Clear 10 waves", "stat": "waves", "goal": 10,
                       "unlocks": ["dagger"] },
    "victor":        { "name": "Victor", "text": "Win a run", "stat": "wins", "goal": 1,
                       "unlocks": ["staff", "glass_cannon", "cursed_coin"] },
    "hard_won":      { "name": "Hard won", "text": "Win a run on Hard", "stat": "wins:level:2", "goal": 1,
                       "unlocks": ["scythe", "juggernaut"] },
    "veteran":       { "name": "Veteran", "text": "Win a run on Very hard", "stat": "wins:level:3", "goal": 1,
                       "unlocks": ["overclock", "last_stand"] },

    // ---- Each weapon's second technique: go far with it
