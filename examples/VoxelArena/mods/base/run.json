// The arena run (Enter at the title): 20 timed waves in a small pit. Enemies keep coming in from the
// edges all through a wave (their spawn point shows `warn` seconds first); what they drop are shards,
// both money and XP. Between waves, a shop: each player's own.
//
// duration, spawnRate (enemies a second), maxAlive (at once): [the first wave's, the last wave's],
// in between they grow evenly. More with more players: coopScale per extra player. healthGrowth:
// enemies have that much more health with each wave (0.06: 6%).
// pools: who comes, from wave `from` to wave `to`, picked by weight among the ones open.
// eliteFrom, eliteChance: from that wave on, that chance an enemy comes as an elite (tougher, harder
// hitting, three times the shards). bosses: wave -> boss; that wave lasts until it falls.
// xp: shards to level 2, and how many more for each level after; a level up gives a free stat pick.
// start: the weapon in hand and what is owned at the start (weapons, weapon skills, spell keywords,
// "element:fire"): a spell can only be cast with its element and every one of its keywords owned.
// shop: offers a time (stat items of upgrades.json, and the unlocks not owned yet, for their price),
// weaponPrice: what a weapon not in unlocks sells for (every mod's weapons are in the shop). The reroll's price (reroll, + rerollStep each time in a shop, + 1 every 2 waves), priceGrowth: every
// price this much higher each wave. levelChoices: stat items to pick from for a level up.
// Score: each enemy's "score" for the kill (twice for an elite), waveScore times the wave's number
// for getting through it, victoryScore for the last one.
// arena: the run's own arena (as arena.json); resetEachWave builds it anew before each wave.
// chooseWeapon: each player picks a weapon before the first wave (start.weapon is in hand until then),
// and none are for sale: the shop sells the skills of the weapon in hand instead.
// duel: in multiplayer, after the last wave, a final duel: the arena anew, everyone back up and in a
// ring `radius` m from its centre, `countdown` s with no harm done, then everyone for themselves, one life
// each. The last one standing wins; after `duration` s, the one with the most of their health left.
{
    "waves": 20,
    "duration": [60, 90],
    "spawnRate": [0.4, 1.8],
    "maxAlive": [5, 22],
    "healthGrowth": 0.06,
    "warn": 1.2,
    "eliteFrom": 7,
    "eliteChance": 0.08,
    "centre": [20, 4, 21],
    "spawnRadius": 16,
    "coopScale": 0.5,
    "pickupRange": 3.5,
    "resetEachWave": true,
    "chooseWeapon": true,
    "duel": { "enabled": true, "duration": 120, "countdown": 3, "radius": 9 },

    "pools": [
        { "enemy": "slime",   "from": 1,  "to": 6, "weight": 4 },
        { "enemy": "slime",   "from": 7,  "weight": 1.5 },
        { "enemy": "skulker", "from": 3,  "weight": 3 },
        { "enemy": "archer",  "from": 4,  "weight": 1.2 },
        { "enemy": "brute",   "from": 6,  "weight": 1 },
        { "enemy": "brute",   "from": 12, "weight": 1 },
        { "enemy": "archer",  "from": 14, "weight": 0.8 }
    ],
    "bosses": { "10": "chieftain", "20": "warden" },

    "xp": { "base": 10, "step": 6 },
    "start": { "weapon": "sword", "owned": ["element:fire", "bolt"] },
    "shop": {
        "slots": 4,
        "reroll": 2,
        "rerollStep": 2,
        "priceGrowth": 0.08,
        "levelChoices": 4,
        "unlocks": {
            "leap_slam": 22, "whirlwind": 22, "shadow_dash": 22, "backflip": 18,
            "volley": 22, "disengage": 18, "sanctuary": 24, "radiance": 24,
            "element:ice": 20, "element:volt": 20,
            "zone": 16, "nova": 16, "beam": 18,
            "multiply": 24, "extend": 12, "enlarge": 12, "chain": 20, "empower": 22
        }
    },

    "waveScore": 50,
    "victoryScore": 2000,

    // A 40 x 40 pit: four pillars to fight around, a raised platform, a boulder on a rope over the middle
    "arena": {
        "size": [40, 24, 40],
        "playerSpawn": [20, 4, 8],
        "shapes": [
            { "block": "bedrock", "from": [0, 0, 0], "to": [39, 0, 39] },
            { "block": "dirt",    "from": [1, 1, 1], "to": [38, 2, 38] },
            { "block": "grass",   "from": [1, 3, 1], "to": [38, 3, 38] },
            { "block": "arena_wall",  "from": [0, 1, 0], "to": [39, 6, 39], "hollow": true },
            { "block": "arena_brick", "from": [0, 7, 0], "to": [39, 7, 39], "hollow": true },

            { "block": "sand",  "from": [11, 3, 12], "to": [29, 3, 30] },
            { "block": "grass", "from": [13, 3, 14], "to": [27, 3, 28] },

            { "block": "stone", "from": [9, 4, 13],  "to": [10, 7, 14] },
            { "block": "stone", "from": [29, 4, 13], "to": [30, 7, 14] },
            { "block": "stone", "from": [9, 4, 28],  "to": [10, 7, 29] },
            { "block": "stone", "from": [29, 4, 28], "to": [30, 7, 29] },

            { "block": "planks", "from": [3, 4, 33], "to": [9, 5, 37] },
            { "block": "planks", "from": [3, 4, 32], "to": [9, 4, 32] },
            { "block": "brick",  "from": [31, 4, 33], "to": [36, 4, 36] },

            { "block": "stone",   "from": [15, 4, 21], "to": [15, 11, 21] },
            { "block": "stone",   "from": [25, 4, 21], "to": [25, 11, 21] },
            { "block": "planks",  "from": [15, 12, 21], "to": [25, 12, 21] },
            { "block": "rope",    "from": [20, 9, 21], "to": [20, 11, 21] },
            { "block": "boulder", "from": [19, 6, 20], "to": [21, 8, 22] }
        ]
    }
}
