// Blocks of the arena. Colours are 0-255. colorNoise jitters the brightness of each block a little.
// hardness: damage it takes to break (the mine ability does 40 a hit, the brute's slam 120).
// breakable: false for the arena's shell; unbreakable blocks also hold up whatever rests on them.
// flammable: fire sets it alight, it burns away and spreads. weakness: terrain damage of an element, scaled.
// texture: a png of textures/ (16 x 16 pixel art), drawn as painted: the colour is then only for the
// debris. One name for every face, or { "top", "side", "bottom" } (a face left out looks like the sides).
// shape: "cube" (the default), "cross" (the texture twice, crossed: grass, flowers) or "model" (a small
// voxel model of models/, its widest side across the block). Cross and model blocks are decorations:
// walked through, broken at a touch, gone with the block under them. Arenas sow them with "scatter".
{
    "bedrock":     { "color": [62, 62, 70],    "colorNoise": 0.10, "breakable": false, "texture": "bedrock" },
    "arena_wall":  { "color": [86, 88, 98],    "colorNoise": 0.06, "breakable": false, "texture": "arena_wall" },
    "arena_brick": { "color": [150, 72, 56],   "colorNoise": 0.06, "breakable": false, "texture": "arena_brick" },

    "stone":       { "color": [128, 132, 140], "colorNoise": 0.08, "hardness": 120, "weakness": { "volt": 4 }, "texture": "stone" },
    "dark_stone":  { "color": [86, 88, 98],    "colorNoise": 0.08, "hardness": 160, "weakness": { "volt": 3 }, "texture": "dark_stone" },
    "grass":       { "color": [106, 162, 74],  "colorNoise": 0.08, "hardness": 40,
                     "texture": { "top": "grass_top", "side": "grass_side", "bottom": "dirt" } },
    "dirt":        { "color": [134, 96, 64],   "colorNoise": 0.08, "hardness": 40, "texture": "dirt" },
    "sand":        { "color": [214, 196, 140], "colorNoise": 0.05, "hardness": 30, "texture": "sand" },
    "planks":      { "color": [168, 124, 76],  "colorNoise": 0.06, "hardness": 60, "flammable": true, "texture": "planks" },
    "brick":       { "color": [160, 78, 60],   "colorNoise": 0.06, "hardness": 140, "weakness": { "volt": 2 }, "texture": "brick" },
    "gold":        { "color": [232, 190, 72],  "colorNoise": 0.04, "hardness": 80, "texture": "gold" },

    // Raised by the raise_wall ability: quick to make, quick to smash
    "earth":       { "color": [150, 112, 74],  "colorNoise": 0.10, "hardness": 40, "texture": "earth" },
    // The rock trap: a boulder on a rope
    "boulder":     { "color": [112, 108, 116], "colorNoise": 0.10, "hardness": 200, "weakness": { "volt": 2 }, "texture": "boulder" },
    "rope":        { "color": [196, 170, 112], "colorNoise": 0.05, "hardness": 10, "flammable": true, "texture": "rope" },

    // Ice shards freeze a dug pit over with it
    "ice":         { "color": [178, 222, 246], "colorNoise": 0.04, "hardness": 30, "texture": "ice" },

    // The arenas': snow underfoot (the icefall), hay that catches at a spark (the stockade)
    "snow":        { "color": [228, 234, 242], "colorNoise": 0.04, "hardness": 30, "texture": "snow" },
    "hay":         { "color": [214, 184, 96],  "colorNoise": 0.10, "hardness": 20, "flammable": true, "texture": "hay" },

    // Decorations, sown over the grass. Tall grass burns, and the fire runs through a patch of it
    "tall_grass":    { "color": [106, 162, 74], "colorNoise": 0.12, "shape": "cross", "texture": "tall_grass", "flammable": true },
    "flower_red":    { "color": [214, 52, 48],  "colorNoise": 0.06, "shape": "cross", "texture": "flower_red" },
    "flower_yellow": { "color": [246, 206, 60], "colorNoise": 0.06, "shape": "cross", "texture": "flower_yellow" },
    "mushroom":      { "color": [200, 52, 44],  "shape": "model", "model": "mushroom" }
}
