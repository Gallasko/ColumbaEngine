// What each game event sounds and looks like. The game makes these events; this file decides.
// particles: count, speed (m/s), up (0 every way .. 1 upwards), size (m), life (s), gravity,
// color [r, g, b] or "event" (the colour of what broke). shake: camera trauma near the player.
// along: the particles are spread along a line event (a volt arc) instead of bursting from a point.
// Entries named after a status id ("base:burn") are how a fighter with it looks: tint [r, g, b]
// glows over its body, and the particles come every `every` seconds. "burning" is a block on fire.
{
    "hit":        { "sound": "hit",       "particles": { "count": 10, "speed": 5,   "up": 0.3, "size": 0.07, "life": 0.25, "gravity": 8,  "color": [255, 236, 190] } },
    "stagger":    { "sound": "hit_heavy", "particles": { "count": 18, "speed": 6.5, "up": 0.4, "size": 0.09, "life": 0.35, "gravity": 8,  "color": [255, 214, 120] } },
