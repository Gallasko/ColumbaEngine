// A bolt that bursts where it lands. Levels: a wider burst, harder, two of them. Branches: burning ground, or
// the burn on whoever it hits dealt at once (a payoff for fire weapons and techniques).
// In a run, level ups give spells and their next levels: each entry of "levels" is what that level
// adds to the recipe (keywords, as in keywords.json).
{
    "name": "Fireball",
    "text": "Shoots a fireball that explodes where it lands.",
    "recipe": ["fire", "bolt", "nova"],
    "levels": [["enlarge"], ["empower"], ["multiply"]],
    "branches": [
        { "name": "Meteor", "text": "The explosion leaves burning ground.", "keywords": ["zone"] },
        { "name": "Detonate", "text": "Burning enemies it hits take all their burn damage at once, plus 50%.", "detonate": 1.5 }
    ]
}
