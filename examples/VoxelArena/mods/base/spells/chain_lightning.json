// A beam that jumps on to more enemies. Levels: one more jump, harder, further.
// In a run, level ups give spells and their next levels: each entry of "levels" is what that level
// adds to the recipe (keywords, as in keywords.json).
{
    "name": "Chain lightning",
    "text": "A beam that jumps on to the enemies near the one it strikes.",
    "recipe": ["volt", "beam", "chain"],
    "levels": [["chain"], ["empower"], ["extend"]],
    "branches": [
        { "name": "Storm", "text": "Each strike bursts around the one it hits.", "keywords": ["nova"], "tags": ["area"] },
        { "name": "Quickened", "text": "Recharges a lot faster, and hits harder.", "boost": { "cooldown": 0.3, "damage": 0.2 } }
    ]
}
