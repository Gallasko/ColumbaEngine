// A wide burst of cold all around you. Levels: harder, wider, a second ring.
// In a run, level ups give spells and their next levels: each entry of "levels" is what that level
// adds to the recipe (keywords, as in keywords.json).
{
    "name": "Frost nova",
    "text": "An icy explosion around you that slows enemies.",
    "recipe": ["ice", "nova", "enlarge"],
    "levels": [["empower"], ["enlarge"], ["multiply"]],
    "branches": [
        { "name": "Permafrost", "text": "Leaves an icy area behind.", "keywords": ["zone"] },
        { "name": "Shatter", "text": "More damage and a bigger explosion.", "boost": { "damage": 0.4, "area": 0.2 } }
    ]
}
