// The arena: a 64 x 32 x 64 grid filled by these boxes, in order (a later box overwrites an earlier one).
// "from" and "to" are block coordinates, both included. "hollow" draws only the four walls.
{
    "size": [64, 32, 64],
    "playerSpawn": [32, 2, 20],

    "shapes": [
        { "block": "stone", "from": [0, 0, 0],   "to": [63, 0, 63] },
        { "block": "grass", "from": [1, 1, 1],   "to": [62, 1, 62] },
        { "block": "dark_stone", "from": [0, 1, 0], "to": [63, 4, 63], "hollow": true },
        { "block": "brick", "from": [0, 5, 0], "to": [63, 5, 63], "hollow": true },

        // A sand ring around the fighting pit
        { "block": "sand",  "from": [22, 1, 28], "to": [42, 1, 48] },
        { "block": "grass", "from": [24, 1, 30], "to": [40, 1, 46] },

        // Steps: one block high, walked up without jumping
        { "block": "planks", "from": [8, 2, 8],  "to": [14, 2, 14] },
        { "block": "planks", "from": [9, 3, 9],  "to": [13, 3, 13] },
        { "block": "planks", "from": [10, 4, 10], "to": [12, 4, 12] },
        { "block": "gold",   "from": [11, 5, 11], "to": [11, 5, 11] },

        // Pillars to hide behind and to test the camera against
        { "block": "stone", "from": [20, 2, 36], "to": [21, 6, 37] },
        { "block": "stone", "from": [44, 2, 36], "to": [45, 6, 37] },
        { "block": "stone", "from": [32, 2, 52], "to": [33, 8, 53] },

        // A low wall to jump onto (two blocks: needs a jump)
        { "block": "brick", "from": [46, 2, 12], "to": [56, 3, 13] },

        // A covered walkway for the camera to pull in under
        { "block": "dark_stone", "from": [6, 2, 44], "to": [6, 4, 56] },
        { "block": "dark_stone", "from": [10, 2, 44], "to": [10, 4, 56] },
        { "block": "planks", "from": [6, 5, 44], "to": [10, 5, 56] },

        // A dip one block deep: step down into it, walk back out
        { "block": "air",  "from": [50, 1, 46], "to": [54, 1, 50] },
        { "block": "dirt", "from": [50, 0, 46], "to": [54, 0, 50] }
    ],

    "spawns": [
        { "enemy": "dummy", "position": [27.5, 2, 26.5], "yaw": 180 },
        { "enemy": "dummy", "position": [37.5, 2, 26.5], "yaw": 180 },
        { "enemy": "brute", "position": [32.5, 2, 42.5], "yaw": 180 }
    ]
}
