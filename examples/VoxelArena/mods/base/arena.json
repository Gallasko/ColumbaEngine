// The arena: a 64 x 32 x 64 grid filled by these boxes, in order (a later box overwrites an earlier one).
// "from" and "to" are block coordinates, both included. "hollow" draws only the four walls.
// The ground is bedrock (y 0), two layers of dirt (y 1-2) and grass (y 3): you stand at y = 4.
{
    "size": [64, 32, 64],
    "playerSpawn": [32, 4, 20],

    "shapes": [
        { "block": "bedrock", "from": [0, 0, 0],   "to": [63, 0, 63] },
        { "block": "dirt",    "from": [1, 1, 1],   "to": [62, 2, 62] },
        { "block": "grass",   "from": [1, 3, 1],   "to": [62, 3, 62] },
        { "block": "arena_wall",  "from": [0, 1, 0], "to": [63, 6, 63], "hollow": true },
        { "block": "arena_brick", "from": [0, 7, 0], "to": [63, 7, 63], "hollow": true },

        // A sand ring around the fighting pit
        { "block": "sand",  "from": [22, 3, 28], "to": [42, 3, 48] },
        { "block": "grass", "from": [24, 3, 30], "to": [40, 3, 46] },

        // Steps: one block high, walked up without jumping
        { "block": "planks", "from": [8, 4, 8],  "to": [14, 4, 14] },
        { "block": "planks", "from": [9, 5, 9],  "to": [13, 5, 13] },
        { "block": "planks", "from": [10, 6, 10], "to": [12, 6, 12] },
        { "block": "gold",   "from": [11, 7, 11], "to": [11, 7, 11] },

        // Pillars to hide behind, to test the camera against, and to dig through
        { "block": "stone", "from": [20, 4, 36], "to": [21, 8, 37] },
        { "block": "stone", "from": [44, 4, 36], "to": [45, 8, 37] },
        { "block": "stone", "from": [32, 4, 52], "to": [33, 10, 53] },

        // A low wall to jump onto (two blocks: needs a jump)
        { "block": "brick", "from": [46, 4, 12], "to": [56, 5, 13] },

        // A covered walkway for the camera to pull in under
        { "block": "dark_stone", "from": [6, 4, 44], "to": [6, 6, 56] },
        { "block": "dark_stone", "from": [10, 4, 44], "to": [10, 6, 56] },
        { "block": "planks", "from": [6, 7, 44], "to": [10, 7, 56] },

        // The rock trap: a boulder hangs 3 m up from a beam on two thin pillars. Cut the rope (stand
        // about 5 m away, aim up over the boulder and mine) and it drops on whatever stands under it.
        // Break both pillars and the whole thing comes down
        { "block": "stone",   "from": [27, 4, 34], "to": [27, 12, 34] },
        { "block": "stone",   "from": [37, 4, 34], "to": [37, 12, 34] },
        { "block": "planks",  "from": [27, 13, 34], "to": [37, 13, 34] },
        { "block": "rope",    "from": [32, 10, 34], "to": [32, 12, 34] },
        { "block": "boulder", "from": [31, 7, 33], "to": [33, 9, 35] }
    ],

    "spawns": [
        { "enemy": "dummy", "position": [27.5, 4, 26.5], "yaw": 180 },
        { "enemy": "dummy", "position": [37.5, 4, 26.5], "yaw": 180 },
        { "enemy": "brute", "position": [32.5, 4, 42.5], "yaw": 180 }
    ]
}
