// beam.pg - a search that tries every task: no aim, no plan, only the game's rules.
//
// Every world of the search stands at the same month of its calendar. Each month, a world that is
// free to choose is branched into every choice the Life screen offers it then:
//   every work open to him (a walk twice: studied and gathered, or hunted),
//   every thing done at once (a buy, a sale, an answer that takes no time; then he chooses again,
//   twice at most in a month),
//   waiting the month out.
// A world whose life ends is branched into every place its coin may be left to (or none), and the
// next life begins, with each aim; past `lives` lives it is over. Then the month passes for every
// world, and the best are kept: the most tasks reached in the world, then the most grown (parts,
// coin, the town's levels, what the world knows, how near it stands to what it has not reached).
// A world has an aim, a class of the game's (or none): `width` is shared out among the aims, and
// an aimed world counts how near it stands to its class's door, and being in it. A door takes
// years to grow toward, which a month's look ahead would never see. Two worlds alike are kept once.
//
// A task reached by any world is reached, whatever becomes of that world: it was played month by
// month with the game's numbers. `everReached` keeps where (life.pg), and the line of its past.
//
// What is not a choice: rations are bought before a work that does not feed him, when he can pay
// (a boy who starves teaches nothing), and the days of a walk follow walks.pg's way.
// Imported by solver.pg, after life.pg, walks.pg and plan.pg.

import "algorithm"
import "string"
import "math"

fun beamGoals(hunt)
{
    var g = newGoals(true)
    g.hunt = hunt

    return g
}

// A work begun: what beginWork does, its costs taken and the rations it gives up front added from
// the row (they are forecast.atStart, row for row: checked over a life of choices) to spare a run
// of the rules a branch
fun beginFast(st, row)
{
    st.running = row.id
    st.monthsIn = 0
    st.months = row.months
    st.raises = row.raises
    st.raiseLevel = row.level

    giveYears(st, row.yearMonths)

    for (var c : asListOf(row.costs))
    {
        st.stats[c.stat] = statOf(st, c.stat) - c.amount
    }

    if (asInt(row.upFront) > 0)
    {
        st.stats.rations = statOf(st, "rations") + asInt(row.upFront)
    }

    touch(st)
    note(st, "begin " + row.id + " (" + toString(row.months) + " mo)")
}

// Rations for `months` of a work and what they eat (life.pg's rationsFor: his own and his
// familiars', less what a work that feeds him gives up front), bought from the market row as it
// stands (its price and what it brings, with the room he has for them)
fun provisionFast(st, buy, months, upFront)
{
    if (st.stats.rations == none or buy == none or not isOpen(buy))
    {
        return
    }

    var coin = 0
    var rations = 0
    var room = 1000

    for (var c : asListOf(buy.costs))
    {
        if (c.stat == "coin")
        {
            coin = coin + c.amount
        }
    }

    for (var g : asListOf(buy.gains))
    {
        if (g.stat == "rations")
        {
            rations = rations + g.amount
        }
    }

    for (var r : asListOf(buy.requires))
    {
        if (r.room == true)
        {
            room = r.current
        }
    }

    var need = rationsFor(st, months, upFront)
    var bought = 0

    while (statOf(st, "rations") < need and statOf(st, "coin") >= coin and room > 0 and bought < 8 and rations > 0)
    {
        st.stats.coin = statOf(st, "coin") - coin
        st.stats.rations = statOf(st, "rations") + rations
        room = room - rations
        bought = bought + 1
        reach(st, buy.id)
    }

    if (bought > 0)
    {
        touch(st)
        note(st, "bought rations x" + toString(bought))
    }
}

// Every choice of a world that is free to choose, each as a world of its own
fun expand(st, round)
{
    var grown = expandChildren(st, round)

    if (grown.final)
    {
        return grown.children
    }

    return prune(grown.children, expandKeep())
}

// No more of a world's children than could be kept for its aim
fun expandKeep()
{
    return larger(3, (beamWidth + len(aims) - 1) / len(aims)) * len(aims)
}

// A story is played (whole: dear as a walk, its months run) by a world it is for: one that aims at
// the class its row enters (or that aims at none, and is of none), and once a life, the first month
// it is open to him (and its fees held, walks.pg's withStoryFees). A story whose row is of no path
// (the outskirts) is every world's
fun storyHere(st, row)
{
    if (row.story == none or row.story == "")
    {
        return false
    }

    if (st.storyTried != none and st.storyTried[row.id] == st.lives)
    {
        return false
    }

    if (row.path == none or row.path == "" or st.aim == row.path)
    {
        return true
    }

    return st.aim == "" and classOf(st) == ""
}

// The rations a story's plan gives (the outskirts' lunch): his as the story begins, as a board's
// up front, so none is bought for its months
fun storyRations(st, row)
{
    var plan = storyPlanOf(st, row.story, [])

    for (var g : plan.gives)
    {
        if (g.stat == "rations")
        {
            return g.amount
        }
    }

    return 0
}

// A world's children, before they are pruned: {children, final (true: as they are, not pruned)}
fun expandChildren(st, round)
{
    var children = []

    // Nothing left in this life that the world has not reached: it only waits for its end
    if (st.coasting == true)
    {
        var rest = clone(st)
        rest.waiting = true
        push(children, rest)

        return {children: children, final: true}
    }

    seeTown(st)

    var rows = shapeOf(st)
    var buy = shapeById["buy.rations"]

    var alive = false

    for (var ar : rows)
    {
        // (the window in a var first: a field of a table a call has just built reads garbage)
        var arWin = windowOf(ar)

        if (not alive and unfound(st, ar.id) and ar.closed != true and ar.spent != true and ar.barred == "" and ar.pathOpen == true and ar.goto == "" and arWin.last >= st.month)
        {
            alive = true
        }
    }

    if (not alive)
    {
        st.coasting = true
        note(st, "nothing new left in this life: it runs to its end")

        var idle = clone(st)
        idle.waiting = true
        push(children, idle)

        return {children: children, final: true}
    }

    // How near he stands to the tasks no world has reached yet: by their minimums (reqs.pg), each
    // branch adding what its own work will bring (prospectDelta); or by the rows' own reach
    if (beamProspect == "reqs")
    {
        st.prospect = prospectOf(st)
    }
    else
    {
        st.prospect = prospectByReach(st, rows)
    }

    // How near he stands to the door of the class his world aims at
    // (what the nearest of them asks, kept with every branch: its own choice moves it)
    var aimNear = -1.0
    var doorReq = []

    if (st.aim != "" and classOf(st) == "")
    {
        for (var door : asListOf(entersOf[st.aim]))
        {
            var dr = shapeById[door]

            if (dr != none and dr.reach != none and dr.closed != true and toFloat(dr.reach) / 100.0 > aimNear)
            {
                aimNear = toFloat(dr.reach) / 100.0
                doorReq = []

                for (var rq : asListOf(dr.requires))
                {
                    if (rq.room != true and rq.stat != "age" and rq.needed > 0)
                    {
                        push(doorReq, {stat: rq.stat, needed: rq.needed})
                    }
                }
            }
        }
    }

    st.doorReq = doorReq

    // What a work new to him lacks only a basic for is not spent on another (reqs.pg)
    var keeps = gatherKeeps(st, rows)

    var walks = []

    // The stories it plays this month (storyHere): marked on the world before any child is made of
    // it, so that none of them plays one again in this life
    var stories = {}

    for (var sr : rows)
    {
        if (round == 0 and sr.months > 0 and isOpen(sr) and not spendsKept(st, sr, keeps) and storyHere(st, sr))
        {
            stories[sr.id] = 1

            if (st.storyTried == none)
            {
                st.storyTried = {}
            }

            st.storyTried[sr.id] = st.lives
        }
    }

    for (var row : rows)
    {
        if (row.months > 0 and isOpen(row) and not spendsKept(st, row, keeps))
        {
            if (row.zone != "")
            {
                // Judged before it is played (a walk is a hundred runs of the rules): see below
                push(walks, {row: row, hunt: false, est: walkEstimate(st, row, false)})

                if (zoneHasBeasts[row.zone] != none)
                {
                    push(walks, {row: row, hunt: true, est: walkEstimate(st, row, true)})
                }
            }
            else if (row.story != none and row.story != "")
            {
                // A story is played whole, by its plan, its months run as its days make them due
                // (walks.pg's storyBy): the world comes out of it that many months on. Only by a
                // world it is for, once a life (storyHere)
                if (stories[row.id] != none)
                {
                    var told = clone(st)
                    provisionFast(told, buy, row.months, asInt(row.upFront) + storyRations(told, row))

                    if (storyBy(told, row, beamGoals(false)) == "")
                    {
                        told.pendingNew = unfound(st, row.id)
                        push(children, told)
                    }
                }
            }
            else
            {
                var c = clone(st)
                provisionFast(c, buy, row.months, asInt(row.upFront))

                beginFast(c, row)
                c.pending = row.gains
                c.pendingNew = unfound(st, row.id)
                push(children, c)
            }
        }
    }

    if (round < 2)
    {
        for (var once : rows)
        {
            if (once.months == 0 and isOpen(once) and once.id != "buy.rations" and st.onceMonth[once.id] == none and not spendsKept(st, once, keeps))
            {
                var d = clone(st)
                d.onceMonth[once.id] = 1

                if (beginWork(d, once.id, beamGoals(false)) == "")
                {
                    push(children, d)
                }
            }
        }
    }

    // The walks worth playing: the best `walksPlayed` of them by what they could bring
    for (var played = 0; played < walksPlayed and len(walks) > 0; played = played + 1)
    {
        var bi = 0

        for (var j = 1; j < len(walks); j = j + 1)
        {
            if (walks[j].est > walks[bi].est)
            {
                bi = j
            }
        }

        var pick = walks[bi]
        removeAt(walks, bi)

        var walked = clone(st)

        if (walkBy(walked, pick.row, beamGoals(pick.hunt)) == "")
        {
            walked.pendingNew = unfound(st, pick.row.id)
            push(children, walked)
        }
    }

    // Earning what the tasks it nearly meets are short of (reqs.pg), on its first choice of a month,
    // and gathering the basics a work new to him is locked by
    if (round == 0 and beamEarn)
    {
        earnChildren(st, rows, children)
        gatherChildren(st, rows, children)
    }

    var waits = clone(st)
    waits.waiting = true
    push(children, waits)

    return {children: children, final: false}
}

// What a walk could bring, before it is played: new to the world, a place still to learn, beasts
// not fought yet (for a hunt), or only what it gathers
fun walkEstimate(st, row, hunt)
{
    var est = 50.0

    if (unfound(st, row.id))
    {
        est = est + 900.0
    }

    var studies = st.know["study." + row.zone]

    if (studies == none or studies < 10)
    {
        est = est + 300.0
    }

    if (hunt)
    {
        for (var m : zonesOfMob)
        {
            for (var z : zonesOfMob[m])
            {
                if (z == row.zone and st.know["fights." + m] == none)
                {
                    est = est + 200.0
                }
            }
        }
    }

    return est
}

// A life over: the next one, for each place his coin may be left to, and for none
fun afterDeath(st, cap)
{
    var out = []

    if (st.lives >= cap)
    {
        return out
    }

    var town = townOf(st)
    var gifts = [""]

    if (st.townKnown)
    {
        for (var place : town.places)
        {
            if (place.shown == true and place.level < place.most and (statOf(st, "coin") > 0 or len(place.leaves) > 0))
            {
                push(gifts, place.id)
            }
        }
    }

    for (var gift : gifts)
    {
        for (var aim : aims)
        {
            var c = clone(st)
            newLife(c, gift, town)
            c.aim = aim
            c.coasting = false
            c.earning = none
            push(out, c)
        }
    }

    return out
}

// How near he stands to what no world has reached: each row's own reach (the game's share of what it
// asks), the nearer the more, a class's door five times over
fun prospectByReach(st, rows)
{
    var prospect = 0.0

    for (var pr : rows)
    {
        if (everReached[pr.id] == none and pr.closed != true and pr.spent != true and pr.barred == "" and pr.reach != none)
        {
            var near = toFloat(pr.reach) / 100.0
            var wt = 1.0

            if (pr.enters == true)
            {
                wt = 5.0
            }

            prospect = prospect + 50.0 * wt * near * near
        }
    }

    return prospect
}

// Not reached yet: by any world (`scope` all), or by this one (world)
fun unfound(st, id)
{
    if (beamScope == "world")
    {
        return st.reached[id] == none
    }

    return everReached[id] == none
}

fun classOf(st)
{
    for (var p : pathFlag)
    {
        if (charValue(st, pathFlag[p]) > 0)
        {
            return p
        }
    }

    return ""
}

// What the work under way will bring of a stat at its term (0 when nothing is under way)
fun pendingOf(st, stat)
{
    if (st.running == "" or st.pending == none)
    {
        return 0
    }

    var n = 0

    for (var g : asListOf(st.pending))
    {
        if (g.stat == stat)
        {
            n = n + g.amount
        }
    }

    return n
}

// A stat as it will stand once the work under way is over
fun projected(st, stat)
{
    return charValue(st, stat) + pendingOf(st, stat)
}

// How near the world stands to its aim's door, with what the work under way will bring
fun doorNear(st)
{
    if (st.doorReq == none or len(st.doorReq) == 0)
    {
        return 0.0
    }

    var sum = 0.0

    for (var r : st.doorReq)
    {
        sum = sum + smaller(1.0, toFloat(projected(st, r.stat)) / toFloat(r.needed))
    }

    return sum / toFloat(len(st.doorReq))
}

// How grown a world is, beyond the tasks it has reached
fun grownOf(st)
{
    var g = 0

    for (var s : grownStats)
    {
        g = g + 10 * projected(st, s)
    }

    g = g + smaller(projected(st, "coin"), 300) / 2 + smaller(statOf(st, "vit"), 60)

    for (var t : st.town)
    {
        g = g + 40 * st.town[t]
    }

    for (var k : st.know)
    {
        g = g + 5 * smaller(st.know[k], 10)
    }

    if (classOf(st) != "")
    {
        g = g + 100
    }

    return g
}

fun beamScore(st)
{
    // A task is worth its points to the world that reached it first: once reached it leaves the
    // search for every world
    var s = toFloat(1000 * asInt(st.firsts) + grownOf(st))

    // (and with `score` both, a share for every task the world reached itself; `old`, only that)
    if (beamScoring == "both")
    {
        s = s + 500.0 * toFloat(st.reachedCount)
    }
    else if (beamScoring == "old")
    {
        s = toFloat(1000 * st.reachedCount + grownOf(st))
    }

    if (beamProspect == "reqs")
    {
        s = s + prospectDelta(st)
    }

    // Hunger ahead: the months of the work under way (or of waiting) he has no rations for cost
    // Vitality, five a month (resources.pg); one he will not live through is no world at all.
    // A month eats `eats` (his own and his familiars', at any work: a work that feeds him gave its
    // rations as he began it), and he eats first: the rations he holds last him that many months,
    // the last one begun
    if (st.stats.rations != none)
    {
        var ahead = 1

        if (st.running != "")
        {
            ahead = st.months - st.monthsIn
        }

        var eats = larger(1, eatsOf(st))
        var lasts = (statOf(st, "rations") + eats - 1) / eats
        var hungry = larger(0, ahead - lasts)

        if (hungry > 0)
        {
            if (statOf(st, "vit") - 5 * hungry <= 0)
            {
                s = s - 100000.0
            }
            else
            {
                s = s - 300.0 * toFloat(hungry)
            }
        }
    }

    // A task new to the world, under way: most of what reaching it is worth
    if (st.running != "" and st.pendingNew == true)
    {
        s = s + 900.0
    }

    // Gathering the basic that alone keeps a long work locked, new to him or a step to his aim's
    // door (reqs.pg's gatherChildren): a part of it. (A short one is soon done another way)
    if (st.earning != none and st.earning.long == true and (st.earning.door == true or unfound(st, st.earning.then)))
    {
        s = s + gatherWorth
    }

    if (st.prospect != none)
    {
        s = s + st.prospect
    }

    // The world's aim: near its class's door, then in it
    if (st.aim != "")
    {
        var cls = classOf(st)

        if (cls == st.aim)
        {
            s = s + 5000.0
        }
        else if (cls == "")
        {
            var near = doorNear(st)
            s = s + 3000.0 * near * near
        }
    }

    if (beamNoise > 0.0)
    {
        noiseSeed = (noiseSeed * 75 + 74) % 65537
        s = s + beamNoise * (toFloat(noiseSeed) / 32768.0 - 1.0)
    }

    return s
}

fun signatureOf(st)
{
    var s = st.aim + ":" + toString(st.lives) + ":" + st.running + ":" + toString(st.monthsIn) + ":" + toString(st.reachedCount) + ":" + toString(st.terms)

    for (var k : sigStats)
    {
        s = s + ":" + toString(statOf(st, k))
    }

    for (var t : st.town)
    {
        s = s + ":" + t + toString(st.town[t])
    }

    for (var kept : st.stash)
    {
        s = s + ":s." + kept + toString(st.stash[kept])
    }

    return s
}

// The best of the worlds, `width` shared out among the aims (a class each, and none), none twice
fun prune(list, width)
{
    if (len(list) <= 1)
    {
        return list
    }

    var scored = []

    for (var st : list)
    {
        push(scored, {st: st, score: beamScore(st), sig: signatureOf(st), aim: st.aim, used: false})
    }

    var share = larger(1, (width + len(aims) - 1) / len(aims))
    var perAim = {}
    var seen = {}
    var kept = []
    var looking = true

    while (looking)
    {
        var best = none

        for (var e : scored)
        {
            if (not e.used and (best == none or e.score > best.score))
            {
                best = e
            }
        }

        if (best == none)
        {
            looking = false
        }
        else
        {
            best.used = true

            var n = perAim[best.aim]

            if (n == none)
            {
                n = 0
            }

            if (seen[best.sig] == none and n < share)
            {
                seen[best.sig] = 1
                perAim[best.aim] = n + 1
                push(kept, best.st)
            }
        }
    }

    return kept
}

fun countReached()
{
    var n = 0

    for (var k : everReached)
    {
        n = n + 1
    }

    return n
}

// The search: until every world has lived its lives, or `minutes` are spent (0: no limit)
// What the search reads before a world moves: the tasks, the zones with beasts, the aims (a
// worker's too, before its first job)
fun beamPrepare(width)
{
    beamWidth = width

    if (len(tasks) == 0)
    {
        buildTasks()
    }

    for (var m : zonesOfMob)
    {
        for (var z : zonesOfMob[m])
        {
            zoneHasBeasts[z] = 1
        }
    }

    aims = [""]

    for (var p : pathFlag)
    {
        push(aims, p)
    }
}

fun beamRun(width, cap, minutes, seed)
{
    beamPrepare(width)

    // With workers (threads=N): each month's expansions and months are theirs, a world each
    var threaded = threadCount() > 0

    var pool = []

    for (var aim : aims)
    {
        var first = newWorld(seed)
        first.aim = aim
        push(pool, first)
    }
    var began = clockMs()
    var months = 0

    // How many tasks had been reached by each month: the rate the search still finds them at
    var foundBy = [0]

    while (len(pool) > 0)
    {
        if (minutes > 0 and clockMs() - began > minutes * 60000)
        {
            log("beam: the " + toString(minutes) + " minutes are spent, the search stops here")
            return
        }

        var moving = []
        var idle = []

        for (var st : pool)
        {
            st.waiting = false
            st.onceMonth = {}

            if (st.running == "" and not st.dead)
            {
                // What it is earning, the next term, without a choice
                if (continueRepeat(st))
                {
                    push(moving, st)
                }
                else
                {
                    push(idle, st)
                }
            }
            else
            {
                push(moving, st)
            }
        }

        for (var round = 0; round < 3 and len(idle) > 0; round = round + 1)
        {
            var nextIdle = []
            var grown = []

            if (threaded)
            {
                grown = expandAll(idle, round)
            }
            else
            {
                for (var free : idle)
                {
                    push(grown, expand(free, round))
                }
            }

            for (var children : grown)
            {
                for (var c : children)
                {
                    if (c.running == "" and not c.waiting and not c.dead and round < 2)
                    {
                        push(nextIdle, c)
                    }
                    else
                    {
                        push(moving, c)
                    }
                }
            }

            idle = prune(nextIdle, width)
        }

        for (var left : idle)
        {
            push(moving, left)
        }

        // The month is the same for all of them: the best few go on to live it
        moving = prune(moving, width * 3)

        var next = []

        if (threaded)
        {
            moving = monthAll(moving)
        }

        for (var w : moving)
        {
            if (not threaded and not w.dead)
            {
                monthPass(w)
            }

            if (w.dead)
            {
                for (var born : afterDeath(w, cap))
                {
                    push(next, born)
                }
            }
            else
            {
                push(next, w)
            }
        }

        pool = prune(next, width)
        months = months + 1

        if (len(pool) > 0)
        {
            beamBest = pool[0]
        }

        // Stalled: fewer than `beamStallFinds` tasks found over the last `beamStall` months of
        // the calendar (long enough to span a new life's childhood, whose tasks are all known)
        push(foundBy, countReached())

        if (beamStall > 0 and months >= beamStall and foundBy[months] - foundBy[months - beamStall] < beamStallFinds)
        {
            var stalled = toString(foundBy[months] - foundBy[months - beamStall])
            log("beam: " + stalled + " tasks found in the last " + toString(beamStall) + " months, the search stops here")
            return
        }

        if (months - (months / 12) * 12 == 0 and len(pool) > 0)
        {
            var lead = pool[0]
            var said = "beam: month " + toString(months) + ", life " + toString(lead.lives) + " at " + ageText(lead.month)
            said = said + ", " + toString(len(pool)) + " worlds, the best reached " + toString(lead.reachedCount)
            log(said + ", all of them " + toString(countReached()) + ", " + toString((clockMs() - began) / 1000) + " s")
        }
    }
}

var grownStats = ["str", "dex", "int", "arms", "discipline", "letters", "lore", "arcana", "stealth", "guile", "renown"]
var sigStats = ["str", "dex", "int", "vit", "arms", "discipline", "letters", "lore", "arcana", "stealth", "guile", "renown", "coin", "rations", "reagents"]

// And the basics, what is made of them and the familiars bound (economytable.pg, through life.pg)
for (var sigResource : resourceIds)
{
    push(sigStats, sigResource)
}

for (var sigKind : familiarKinds)
{
    push(sigStats, "fam." + sigKind.id)
}

