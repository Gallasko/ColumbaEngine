// Chronicle solver: the work handed to the workers (the host's `parallel`, threads=N)
// -----------------------------------------------------------------------------------
// A job is one world's expansion (beam.pg's expand), one world's month (life.pg's monthPass), one
// task for the planner (solver.pg's planTask), or one stage of the planner for a task (planStage:
// a stage skipped when a lower one has reached the task already, settle / settled, or when a
// search aimed at another task reached it on its way, "found.<id>"; a stage that does not reach it
// asks for the next, claimUpTo). Each runs alone in whichever worker takes it, from a
// copy of what the main script sends; the main script takes the answers back in the jobs' order:
//
// - the plan lines a job wrote that its answer leads to (keepLines: those of the worlds it hands
//   back and of its first finds, not of the worlds it dropped): a worker numbers them from
//   `workerBase` (life.pg's `planBase`); the main script adds them to its own `planLog` and numbers
//   the heads that point at them anew;
// - the tasks a job reached that no world had (life.pg's `jobFirsts`): the first, in the jobs'
//   order, is the one `everReached` keeps;
// - the states, stamped anew (the stamps of a worker are not the main script's).
//
// So a run is the same whatever the number of threads. It is not quite the run without threads: a
// job does not see what the others of its month found first (`st.firsts`).

import "algorithm"
import "life"
import "beam"

var workerBase = 1000000000

// ---- in a worker -----------------------------------------------------------------------------

var workerPrepared = false

// A job alone: the caches keyed by a stamp forgotten, the plan lines and first finds its own
fun jobStart()
{
    if (not workerPrepared)
    {
        beamPrepare(beamWidth)
        workerPrepared = true
    }

    characterStamp = -1
    shapeStamp = -1
    planLog = []
    planBase = workerBase
    jobFirsts = {}
    jobReaches = []
}

// What the host calls with a job, one function a kind (the host's report counts them apart)
fun expandJob(job)
{
    workerJob(job)
}

fun monthJob(job)
{
    workerJob(job)
}

fun planJob(job)
{
    workerJob(job)
}

fun stageJob(job)
{
    workerJob(job)
}

// The answer is left in `jobResult`
fun workerJob(job)
{
    jobStart()

    var out = none
    var spawn = []

    // The chance in the beam's choosing (seed > 1), from the world itself: not from the jobs before
    if (job.kind == "expand" or job.kind == "month")
    {
        noiseSeed = (7919 * (asInt(job.st.dice) + 31 * job.st.month) + 13) % 65537
    }

    if (job.kind == "expand")
    {
        touch(job.st)
        out = expand(job.st, job.round)
    }

    else if (job.kind == "month")
    {
        touch(job.st)
        monthPass(job.st)
        out = job.st
    }
    else if (job.kind == "plan")
    {
        if (plannerBase != none)
        {
            touch(plannerBase)
        }

        out = planTask(job.id)
    }
    else if (job.kind == "stage")
    {
        if (plannerBase != none)
        {
            touch(plannerBase)
        }

        // A lower stage has reached it already, or a search aimed at another task did on its
        // way: nothing this one could change
        var lower = settled(job.id)

        if ((lower >= 0 and lower < job.stage) or settled("found." + job.id) >= 0)
        {
            out = {id: job.id, stage: job.stage, ok: false, skipped: true, miss: none}
        }
        else
        {
            misses = {}

            var done = planStage(job.id, job.stage)

            // What its worlds reached that no world had, on the way, is reached for every task's
            // stages (its own stays the lowest stage's: settle, below)
            for (var met : jobFirsts)
            {
                if (met != job.id)
                {
                    settle("found." + met, 0)
                }
            }

            if (done != none)
            {
                settle(job.id, job.stage)
                out = {id: job.id, stage: job.stage, ok: true, how: done.how, head: done.w.planHead, reachedHow: done.w.reached[job.id], miss: none}
            }
            else
            {
                out = {id: job.id, stage: job.stage, ok: false, miss: misses[job.id]}

                // The task's next stage; more of them at once when workers have nothing to take
                // (the last tasks' tries side by side). Each stage is asked for once (claimUpTo)
                var last = tries + 1

                if (job.stage < last)
                {
                    var want = smaller(last, job.stage + 1 + idleWorkers())
                    var claimed = claimUpTo(job.id, want)

                    for (var nx = larger(claimed, job.stage) + 1; nx <= want; nx = nx + 1)
                    {
                        push(spawn, {kind: "stage", id: job.id, stage: nx})
                    }
                }
            }
        }
    }

    var firsts = []

    for (var id : jobFirsts)
    {
        push(firsts, {id: id, how: jobFirsts[id].how, head: jobFirsts[id].head})
    }

    // Only the lines the answer leads to go back: those of the worlds it hands back and of its
    // first finds. The worlds pruned, the planner's tries that came to nothing, wrote the rest
    var heads = []

    for (var f : firsts)
    {
        push(heads, f.head)
    }

    if (job.kind == "expand")
    {
        for (var child : out)
        {
            push(heads, child.planHead)
        }
    }
    else if (job.kind == "month")
    {
        push(heads, out.planHead)
    }
    else if (out != none and out.head != none)
    {
        push(heads, out.head)
    }

    var keep = keepLines(heads)

    for (var f2 : firsts)
    {
        f2.head = movedHead(f2.head, keep)
    }

    if (job.kind == "expand")
    {
        for (var child2 : out)
        {
            child2.planHead = movedHead(child2.planHead, keep)
        }
    }
    else if (job.kind == "month")
    {
        out.planHead = movedHead(out.planHead, keep)
    }
    else if (out != none and out.head != none)
    {
        out.head = movedHead(out.head, keep)
    }

    // (how soon a task was reached is kept without its line: the report says only when)
    for (var r : jobReaches)
    {
        r.at.head = -1
    }

    jobResult = {out: out, lines: planLog, firsts: firsts, reaches: jobReaches}

    if (len(spawn) > 0)
    {
        jobResult.spawn = spawn
        jobResult.spawnFunction = "stageJob"
    }
}

// The job's lines that `heads` lead back to, the others dropped: `planLog` is left with those only,
// in their order. What each line became (its new place, -1 for a line dropped), for movedHead.
// A head or a line pointing before the job (at the main script's lines) is left as it is
fun keepLines(heads)
{
    var count = len(planLog)
    var keep = []

    for (var i = 0; i < count; i = i + 1)
    {
        push(keep, -1)
    }

    for (var h : heads)
    {
        var at = h - workerBase

        while (at >= 0 and keep[at] == -1)
        {
            keep[at] = 0
            at = planLog[at].up - workerBase
        }
    }

    var kept = []

    // (a line points at one before it: its new place is known by then)
    for (var j = 0; j < count; j = j + 1)
    {
        if (keep[j] == 0)
        {
            keep[j] = len(kept)

            var line = planLog[j]
            push(kept, {up: movedHead(line.up, keep), text: line.text})
        }
    }

    planLog = kept

    return keep
}

fun movedHead(head, keep)
{
    if (head >= workerBase)
    {
        return workerBase + keep[head - workerBase]
    }

    return head
}

// ---- in the main script ----------------------------------------------------------------------

// What every worker holds before a call: what the search reads that the main script changes
var setupVersion = 0
var setupReached = -1
var setupTable = {}
var plannerBase = none

fun workerSetup()
{
    var reached = countReached()

    if (setupReached != reached)
    {
        var known = {}

        for (var k : everReached)
        {
            known[k] = 1
        }

        setupTable = {everReached: known, beamWidth: beamWidth, beamProspect: beamProspect, beamEarn: beamEarn,
                      beamScoring: beamScoring, beamScope: beamScope, beamNoise: beamNoise, walksPlayed: walksPlayed, gatherWorth: gatherWorth,
                      plannerBase: plannerBase}
        setupReached = reached
        setupVersion = setupVersion + 1
    }

    return setupTable
}

// The planner's start, for the workers too (the next call sends it)
fun setPlannerBase(st)
{
    plannerBase = st
    setupReached = -1
}

// A head numbered in a worker, numbered in the main script's planLog (its lines added from `base`)
fun fromWorker(head, base)
{
    if (head >= workerBase)
    {
        return base + head - workerBase
    }

    return head
}

// A job's answer taken in: its plan lines added, its first finds kept when no job before had them.
// The place its lines start at in planLog
fun mergeAnswer(answer)
{
    var base = len(planLog)

    for (var line : answer.lines)
    {
        push(planLog, {up: fromWorker(line.up, base), text: line.text})
    }

    for (var f : answer.firsts)
    {
        if (everReached[f.id] == none)
        {
            everReached[f.id] = {how: f.how, head: fromWorker(f.head, base)}
        }
    }

    for (var r : answer.reaches)
    {
        var at = r.at
        at.head = fromWorker(at.head, base)
        keepFastest(r.id, at)
    }

    return base
}

fun adopted(st, base)
{
    st.planHead = fromWorker(st.planHead, base)
    touch(st)

    return st
}

// An answer and those of the jobs it asked for, all of them, into `into`
fun allAnswers(answer, into)
{
    push(into, answer)

    if (answer.spawned != none)
    {
        for (var more : answer.spawned)
        {
            allAnswers(more, into)
        }
    }
}

fun runJobs(function, jobs)
{
    if (len(jobs) == 0)
    {
        return []
    }

    var setup = workerSetup()

    return parallel(function, jobs, setup, setupVersion)
}

// beam.pg's expand of each world, by the workers, a job a world: the children of each, in order.
// (Its walks as jobs of their own, asked for by the world's job, were tried: on four cores the
// copying cost more than the walks side by side gained)
fun expandAll(worlds, round)
{
    var jobs = []

    for (var w : worlds)
    {
        push(jobs, {kind: "expand", st: w, round: round})
    }

    var out = []

    for (var answer : runJobs("expandJob", jobs))
    {
        var base = mergeAnswer(answer)
        var children = []

        for (var c : answer.out)
        {
            push(children, adopted(c, base))
        }

        push(out, children)
    }

    return out
}

// The month of each living world, by the workers; the dead as they are. In order
fun monthAll(worlds)
{
    var jobs = []

    for (var w : worlds)
    {
        if (not w.dead)
        {
            push(jobs, {kind: "month", st: w})
        }
    }

    var answers = runJobs("monthJob", jobs)
    var out = []
    var at = 0

    for (var w2 : worlds)
    {
        if (w2.dead)
        {
            push(out, w2)
        }
        else
        {
            var answer = answers[at]
            at = at + 1

            push(out, adopted(answer.out, mergeAnswer(answer)))
        }
    }

    return out
}
