// life.pg - a world of Chronicle played month by month, as the Life screen plays it.
//
// Imported by solver.pg; run by ChronicleSolver, which lends the rule scripts (`rule`) and `clone`.
//
// Every number comes from the game's rules: this file only does what the C++ of the Life screen
// does between two runs of them (Scenes/lifescene.cpp), and must follow it when it changes:
//   onMonth      the month: age and world, resources.pg, death, the term of the work under way
//   beginWork    a work begun (its costs, the years it takes, the rations a work that feeds him
//                gives up front), or done at once when it takes no time
//   doAtOnce     what takes no month: a buy, a sale, a work for the town that takes none
//   raisePlace   a level of the town reached, the fund left to it spent
//   seeTown      the places that come onto the Town page stay seen
//   newLife      a death, the gift to a place, what the stash keeps, and the next life of the world
//   takeStats    what a script hands back becomes the character's; the town keys are the world's
// Left out: the deeds (none of achievements.pg gives anything), the log, the written time.
//
// A state is one table, cloned to try something without losing what was:
//   {world, lives, town {place: level}, fund {key: coin}, seen {place: 1}, know {key: n},
//    stash {basic: n} (what the stash keeps between lives),
//    month (his age in months), stats, done {id: terms}, running, monthsIn, months,
//    townKnown, dead, death, planHead (its last line in `planLog`), reached {id: "life 2, 14y3m"},
//    reachedCount, raises/raiseLevel (what the work under way raises), dice, stamp}
//
// What a state did is a line of `planLog` pointing at the line before it: a clone shares its past
// instead of copying it. Every task any state reaches is kept in `everReached`, with the line it
// was reached at, whatever becomes of that state.

import "algorithm"
import "string"
import "math"

// The economy's tables (the basics, what is made of them, the familiars): their ids, read here
// rather than written again
import "../rules/economytable"

fun smaller(a, b)
{
    if (a < b)
    {
        return a
    }

    return b
}

fun larger(a, b)
{
    if (a > b)
    {
        return a
    }

    return b
}

// What the Life screen makes of a number a script hands back: a whole number, cut toward zero
fun asInt(v)
{
    var t = typeOf(v)

    if (t == "int")
    {
        return v
    }

    if (t == "double" or t == "float")
    {
        return toInt(v)
    }

    if (t == "bool")
    {
        if (v)
        {
            return 1
        }

        return 0
    }

    return 0
}

fun statOf(st, stat)
{
    var v = st.stats[stat]

    if (v == none)
    {
        return 0
    }

    return v
}

fun doneOf(st, id)
{
    var v = st.done[id]

    if (v == none)
    {
        return 0
    }

    return v
}

fun ageOf(st)
{
    return toFloat(st.month) / 12.0
}

// "14y3m"
fun ageText(month)
{
    return toString(month / 12) + "y" + toString(month - (month / 12) * 12) + "m"
}

// A state that changed is stamped anew: what was asked of the rules for the one before is asked again
fun touch(st)
{
    stampNext = stampNext + 1
    st.stamp = stampNext
}

fun freshStats()
{
    return {str: 4, dex: 4, int: 4, vit: 35, vitmax: 35, arms: 0, discipline: 0, letters: 0, lore: 0,
            arcana: 0, stealth: 0, guile: 0, renown: 0, coin: 0}
}

// The first life of a new world: LifeSave's freshLife
fun newWorld(seed)
{
    var st = {world: 0, lives: 1, town: {}, fund: {}, seen: {}, know: {},
              month: 72, stats: freshStats(), done: {}, running: "", monthsIn: 0, months: 0,
              townKnown: false, dead: false, death: "", planHead: -1, reached: {}, reachedCount: 0, raises: "", raiseLevel: 0, aim: "", path: "",
              dice: seed, stamp: 0, terms: 0, stash: {}}
    touch(st)

    return st
}

// LifeSave::character: his stats, then the town and what the world knows. Kept while the state
// is the same (its stamp): every rule call asks for it, and the host copies what it is given
fun character(st)
{
    if (characterStamp == st.stamp)
    {
        return characterTable
    }

    characterTable = characterOf(st)
    characterStamp = st.stamp

    return characterTable
}

fun characterOf(st)
{
    return chronicleCharacter(st.stats, st.townKnown, st.town, st.fund, st.seen, st.know, st.stash)
}

fun note(st, text)
{
    push(planLog, {up: st.planHead, text: "L" + toString(st.lives) + " " + ageText(st.month) + "  " + text})
    st.planHead = planBase + len(planLog) - 1
}

// The lines of a state's past, the first first: from `head` back
fun planLines(head)
{
    var back = []
    var at = head

    while (at >= 0)
    {
        var line = planLog[at]
        push(back, line.text)
        at = line.up
    }

    var out = []

    for (var i = len(back) - 1; i >= 0; i = i - 1)
    {
        push(out, back[i])
    }

    return out
}

// A rule run that failed stops the solver: an answer it cannot trust is worse than none
fun checked(answer, what)
{
    if (not answer.ok)
    {
        log("RULES FAILED: " + what)

        for (var e : answer.errors)
        {
            log("  " + e)
        }
    }

    return answer
}

// windows.pg: every activity, shaped for him as he is. Kept while the state is the same
fun shapeOf(st)
{
    if (shapeStamp == st.stamp)
    {
        return shapeRows
    }

    var answer = rule("windows", {age: ageOf(st), character: character(st), done: st.done, world: st.world,
                                  lives: st.lives, running: st.running, activityId: ""}, ["activities"])
    checked(answer, "windows")

    shapeRows = answer.activities
    shapeStamp = st.stamp

    var byId = {}

    for (var row : shapeRows)
    {
        byId[row.id] = row

        // A story asks the fees of its plan besides (walks.pg's withStoryFees)
        if (row.story != none and row.story != "" and row.listed == true)
        {
            withStoryFees(st, row)
        }
    }

    shapeById = byId

    return shapeRows
}

fun rowOf(st, id)
{
    shapeOf(st)

    return shapeById[id]
}

fun forecastOf(st, id, monthsIn)
{
    var answer = rule("forecast", {age: ageOf(st), character: character(st), done: st.done, world: st.world,
                                   lives: st.lives, running: st.running, activityId: id, monthsIn: monthsIn}, ["forecast"])
    checked(answer, "forecast " + id)

    var f = answer.forecast

    return f
}

// LifeScene::takeStats and LifeSave::takeTown (the host's chronicleTakeStats: every value a whole
// number, "know." the world's knowledge, "stash." what the stash keeps, the town's levels, funds and
// places seen left to the solver)
fun takeStats(st, after)
{
    if (chronicleTakeStats(st.stats, st.know, st.stash, after))
    {
        st.townKnown = true
    }

    // What a draw left none of is gone from the stash, as LifeSave::takeTown erases it (the host
    // writes it as 0)
    var drained = false

    for (var held : st.stash)
    {
        if (st.stash[held] <= 0)
        {
            drained = true
        }
    }

    if (drained)
    {
        var kept = {}

        for (var left : st.stash)
        {
            if (st.stash[left] > 0)
            {
                kept[left] = st.stash[left]
            }
        }

        st.stash = kept
    }

    touch(st)
}

// LifeScene::giveYears: a year of his life for each twelve months begun, and the world's months
fun giveYears(st, months)
{
    for (var given = 0; given < months; given = given + 12)
    {
        st.month = st.month + 12
    }

    st.world = st.world + months
    touch(st)
}

// LifeScene::raisePlace: the level, and the fund that went into it: as much as the level asked of it
// (town.pg's `spends`, read with the place still one level below). What is over stays in the fund
fun raisePlace(st, place, level)
{
    var before = townOf(st)

    for (var shown : before.places)
    {
        if (shown.id == place and shown.level == level - 1)
        {
            for (var spent : shown.spends)
            {
                var key = place + "." + spent.stat

                if (spent.stat == "coin")
                {
                    key = place
                }

                var left = asInt(st.fund[key]) - spent.amount
                var kept = {}

                for (var k : st.fund)
                {
                    if (k != key)
                    {
                        kept[k] = st.fund[k]
                    }
                }

                if (left > 0)
                {
                    kept[key] = left
                }

                st.fund = kept
            }
        }
    }

    st.town[place] = level
    note(st, "RAISED " + place + " to " + toString(level))
    touch(st)
}

// town.pg, and LifeScene::seeTown: a place shown once stays shown
fun townOf(st)
{
    var answer = rule("town", {age: ageOf(st), character: character(st), done: st.done, world: st.world, lives: st.lives},
                      ["places", "start", "gift", "stash"])
    checked(answer, "town")

    return answer
}

fun seeTown(st)
{
    var town = townOf(st)
    var changed = false

    for (var place : town.places)
    {
        if (place.shown == true and st.seen[place.id] == none)
        {
            st.seen[place.id] = 1
            changed = true
        }
    }

    if (changed)
    {
        touch(st)
    }

    return town
}

// How his life ends, "" while it goes on: resources.pg's `death`, the first of its `mortal` stats
// he holds with none of it left. The list is read from the rules once; the check is made here,
// sparing a run of the script a month
fun deathOf(st)
{
    if (mortalStats == none)
    {
        var answer = rule("resources", {age: ageOf(st), character: character(st)}, ["death", "mortal", "shortAge", "longAge", "callingPlace", "primeStat"])
        checked(answer, "resources (death)")
        mortalStats = answer.mortal
        primeAges = {short: answer.shortAge, long: answer.longAge, place: answer.callingPlace, stat: answer.primeStat}
    }

    for (var m : mortalStats)
    {
        var held = st.stats[m.stat]

        if (held != none and held <= 0)
        {
            // lib.pg's primeEnd: his prime is longer in a town whose calling place stands, and
            // once his thirtieth year has settled it, it is what was settled
            var prime = primeAges.short

            if (charValue(st, "town." + primeAges.place) >= 1)
            {
                prime = primeAges.long
            }

            if (charValue(st, primeAges.stat) > 0)
            {
                prime = charValue(st, primeAges.stat)
            }

            if (st.month >= prime * 12)
            {
                return m.aged
            }

            return m.entry
        }
    }

    return ""
}

// The rations a coming month eats: his own, at any work, and every familiar's he has bound, fed or
// not (resources.pg's `eats`). It hangs on the familiars he holds only, so the rules are asked once
// for each such household and the answer is kept
fun eatsOf(st)
{
    var key = "f"

    for (var kind : familiarKinds)
    {
        key = key + ":" + toString(statOf(st, "fam." + kind.id))
    }

    var known = eatsKept[key]

    if (known != none)
    {
        return known
    }

    var answer = rule("resources", {age: ageOf(st), character: character(st)}, ["eats"])
    checked(answer, "resources (eats)")

    var eats = asInt(answer.eats)
    eatsKept[key] = eats

    return eats
}

// What a month brings of each basic or made resource while he works, as resources.pg's `month`
// says it: what his familiars make, fed, less what they eat of it (a gem weaver eats stone).
// Hungry, they make nothing. It hangs on the familiars he holds, what they are taught, the town's
// levels (a level's `more`) and whether each kind is fed, so the rules are asked once for each
// such household and the answer is kept: {stat: a month's change}, none for no change
fun madeAMonth(st)
{
    var key = ""
    var any = false

    for (var kind : familiarKinds)
    {
        var n = statOf(st, "fam." + kind.id)
        var fed = 1

        if (n > 0)
        {
            any = true

            for (var e : kind.eats)
            {
                if (statOf(st, e.stat) < n * e.amount)
                {
                    fed = 0
                }
            }
        }

        key = key + toString(n) + toString(fed) + ":"
    }

    if (not any)
    {
        return {}
    }

    for (var r : resourceIds)
    {
        key = key + toString(statOf(st, "more." + r)) + ","
    }

    for (var p : st.town)
    {
        key = key + p + toString(st.town[p]) + ","
    }

    var known = madeKept[key]

    if (known != none)
    {
        return known
    }

    // (his own ration is put back on top of what he holds, so what changes is the familiars' doing,
    // fed from all he holds as he eats first)
    var fedFrom = characterOf(st)

    if (fedFrom.rations != none)
    {
        fedFrom.rations = fedFrom.rations + economyKnobs.rationsAMonth
    }

    var answer = rule("resources", {age: ageOf(st), character: fedFrom}, ["month"])
    checked(answer, "resources (made)")

    var month = answer.month
    var after = month.after
    var made = {}

    for (var id : resourceIds)
    {
        var change = asInt(after[id]) - statOf(st, id)

        if (change != 0)
        {
            made[id] = change
        }
    }

    madeKept[key] = made

    return made
}

// The most he can hold of a stat, 0 for no limit, as resources.pg's ledger row says it: the
// base, and the stores he has raised for it (the stat "store.<stat>"). The answer is kept for
// each such store
fun limitOfStat(st, stat)
{
    var key = stat + ":" + toString(statOf(st, "store." + stat))
    var known = limitKept[key]

    if (known != none)
    {
        return known
    }

    var answer = rule("resources", {age: ageOf(st), character: character(st)}, ["rows"])
    checked(answer, "resources (limits)")

    var most = 0

    for (var row : answer.rows)
    {
        if (row.id == stat)
        {
            most = asInt(row.limit)
        }
    }

    limitKept[key] = most

    return most
}

// The rations `months` of a work eat, his own and his familiars', less what it gives up front when
// it feeds him (its `upFront`); and when it does not, a month more of them, so that he is not left
// without the month after it
fun rationsFor(st, months, upFront)
{
    var need = eatsOf(st) * months - upFront

    if (upFront <= 0)
    {
        need = need + eatsOf(st)
    }

    return need
}

// A basic resource or a thing made of them (economytable.pg)
fun isResource(stat)
{
    return resourceKeys[stat] != none
}

fun die(st, line)
{
    st.dead = true
    st.death = line
    note(st, "DIED: " + line)
}

// A term reached, for the work under way or for one done at once
fun reach(st, id)
{
    st.done[id] = doneOf(st, id) + 1
    st.terms = st.terms + 1

    if (st.reached[id] == none)
    {
        st.reached[id] = "life " + toString(st.lives) + ", " + ageText(st.month)
        st.reachedCount = st.reachedCount + 1
        note(st, "REACHED " + id)

        // How soon: a worker's job keeps its reaches apart, the main script takes them in order
        var at = {world: st.world, month: st.month, how: st.reached[id], head: st.planHead}

        if (planBase > 0)
        {
            push(jobReaches, {id: id, at: at})
        }
        else
        {
            keepFastest(id, at)
        }

        if (everReached[id] == none and jobFirsts[id] == none)
        {
            // A worker's job keeps its first finds apart: the main script takes them in order
            if (planBase > 0)
            {
                jobFirsts[id] = {how: st.reached[id], head: st.planHead}
            }
            else
            {
                everReached[id] = {how: st.reached[id], head: st.planHead}
            }

            st.firsts = asInt(st.firsts) + 1
        }
    }

    touch(st)
}

// The quickest the search has seen of a task: the soonest from the world's first month
// (`fastestWorld`, its months: `world`) and the youngest he was in the life he did it in
// (`youngest`, his age in months: `month`); each with `how` ("life 2, 14y3m") and `head`
fun keepFastest(id, at)
{
    var soonest = fastestWorld[id]

    if (soonest == none or at.world < soonest.world)
    {
        fastestWorld[id] = at
    }

    var young = youngest[id]

    if (young == none or at.month < young.month)
    {
        youngest[id] = at
    }
}

// LifeScene::onMonth
fun monthPass(st)
{
    if (st.dead)
    {
        return
    }

    st.month = st.month + 1
    st.world = st.world + 1
    touch(st)

    // He eats at any work: a work that feeds him gave its rations as he began it
    var answer = rule("resources", {age: ageOf(st), character: character(st)}, ["month"])
    checked(answer, "resources")

    var month = answer.month
    takeStats(st, month.after)

    var line = deathOf(st)

    if (line != "")
    {
        die(st, line)
        return
    }

    if (st.running == "")
    {
        return
    }

    st.monthsIn = st.monthsIn + 1

    if (st.monthsIn < st.months)
    {
        return
    }

    var id = st.running
    var f = forecastOf(st, id, st.monthsIn)

    if (st.monthsIn < f.months)
    {
        // It grew longer on the way (a bonus that holds now): its term is the forecast's
        st.months = f.months
        return
    }

    var raises = st.raises
    var level = st.raiseLevel

    takeStats(st, f.atTerm)
    reach(st, id)

    st.running = ""
    st.monthsIn = 0
    st.months = 0
    touch(st)

    st.raises = ""
    st.raiseLevel = 0
    note(st, "done " + id)

    if (raises != "")
    {
        raisePlace(st, raises, level)
    }
}

// LifeScene::doAtOnce
fun doAtOnce(st, row, f)
{
    giveYears(st, row.yearMonths)
    takeStats(st, f.atTerm)
    reach(st, row.id)
    note(st, "at once " + row.id)

    if (row.raises != "")
    {
        raisePlace(st, row.raises, row.level)
    }

    var line = deathOf(st)

    if (line != "")
    {
        die(st, line)
    }
}

// LifeScene::beginWork: "" when it was begun (or done), else why not
fun beginWork(st, id, goals)
{
    var row = rowOf(st, id)

    if (row == none)
    {
        return "no such activity"
    }

    if (row.goto != "")
    {
        return "only opens a page"
    }

    if (row.listed != true or row.locked == true)
    {
        return "not open to him"
    }

    var f = forecastOf(st, id, 0)

    if (f.months <= 0)
    {
        doAtOnce(st, row, f)
        return ""
    }

    if (st.running != "")
    {
        return "already at work"
    }

    // A story (its days chosen by its plan, its months run as they fall due), before a walk: no zone
    if (row.story != none and row.story != "")
    {
        return storyBy(st, row, goals)
    }

    if (row.zone != "")
    {
        return walkBy(st, row, goals)
    }

    st.running = id
    st.monthsIn = 0
    st.months = f.months
    st.raises = row.raises
    st.raiseLevel = row.level

    giveYears(st, row.yearMonths)
    takeStats(st, f.atStart)

    note(st, "begin " + id + " (" + toString(f.months) + " mo)")

    return ""
}

// LifeScene::beginAgain and newLife: what he held left to a place, and the next life of the world
fun newLife(st, gift, town)
{
    // What the gift takes of each thing he holds: the stash keeps only the rest
    var given = {}

    if (gift != "")
    {
        var coin = statOf(st, town.gift.stat)

        if (coin > 0)
        {
            st.fund[gift] = larger(0, asInt(st.fund[gift])) + coin
            given[town.gift.stat] = asInt(given[town.gift.stat]) + coin
        }

        for (var place : town.places)
        {
            if (place.id == gift)
            {
                for (var left : place.leaves)
                {
                    var key = gift + "." + left.stat
                    st.fund[key] = larger(0, asInt(st.fund[key])) + left.amount
                    given[left.stat] = asInt(given[left.stat]) + left.amount
                }
            }
        }

        note(st, "left " + toString(coin) + " coin to " + gift)
    }

    // What is left of the basics goes into the stash, for the lives after him: the gift is taken
    // first, and the stash keeps no more than its most of any one thing (town.pg's `stash`)
    for (var kept : town.stash)
    {
        var held = st.stats[kept.stat]

        if (held != none)
        {
            var rest = held - asInt(given[kept.stat])

            if (rest > 0)
            {
                st.stash[kept.stat] = smaller(kept.most, asInt(st.stash[kept.stat]) + rest)
            }
        }
    }

    st.lives = st.lives + 1
    st.month = 72
    st.stats = freshStats()
    st.done = {}
    st.running = ""
    st.monthsIn = 0
    st.months = 0
    st.townKnown = false
    st.dead = false
    st.death = ""
    st.terms = 0
    st.path = ""
    touch(st)

    // What the town gives a life at its birth
    var born = townOf(st)

    for (var given : born.start)
    {
        st.stats[given.stat] = statOf(st, given.stat) + given.amount
    }

    touch(st)
    note(st, "a new life begins")
}

var stampNext = 0
var characterStamp = -1
var characterTable = {}
var shapeStamp = -1
var shapeRows = []
var shapeById = {}
var planLog = []
var mortalStats = none
var primeAges = none
var everReached = {}

// In a worker's job (parallel.pg): its plan lines are numbered from `planBase`, and the tasks it
// reached first that no world had are in `jobFirsts`. The main script: 0 and empty
var planBase = 0
var jobFirsts = {}
var jobReaches = []

var fastestWorld = {}
var youngest = {}

// What resources.pg's `eats` said, by household (eatsOf)
var eatsKept = {}

// What resources.pg's `month` said a household of familiars makes (madeAMonth)
var madeKept = {}

// What resources.pg's ledger said is the most he can hold of a stat, by its stores (limitOfStat)
var limitKept = {}

// The ids of the basics and of what is made of them, and as keys
var resourceIds = []
var resourceKeys = {}

for (var lifeBasic : basicResources)
{
    push(resourceIds, lifeBasic.id)
    resourceKeys[lifeBasic.id] = 1
}

for (var lifeMade : madeResources)
{
    push(resourceIds, lifeMade.id)
    resourceKeys[lifeMade.id] = 1
}
