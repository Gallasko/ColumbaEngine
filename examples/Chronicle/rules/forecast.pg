// Chronicle rules: what an activity will do
// -----------------------------------------
// Input:  `age` (years), `character` (a table of stats and flags), `done` (activity id -> terms
//         completed, read by activitytable.pg), `activityId`, `monthsIn` (the months already spent
//         in it).
// Output: `forecast`:
//           atStart  every stat of the character once the activity's costs are taken: what
//                    beginning it leaves him with
//           atTerm   every stat of the character after the activity's gains, and after the
//                    effects of a step of its `after` list that this term reaches. The costs
//                    were taken when it began, so they are not taken again, but for an
//                    activity done at once (atStart is then where its gains land). A gain to
//                    a stat with a cap (lib.pg's `statCaps`) raises the cap with it; no gain
//                    goes past a stat's ceiling (lib.pg's `statCeilings`). A limit
//                    (lib.pg's `statLimits`) does not stop them: what an activity brings may
//                    go past it, activities.pg only refuses to begin one when there is no room
//           percent  monthsIn / months x 100 (100 for an activity done at once)
//           months   the activity's term
//           caption  "MONTH 3 OF 6 · STRENGTH 14 → 16 AT TERM"
//           gaps     [{stat, label, current, needed}]: the next milestone's asks for the path the
//                    activity leads toward, against the character as he is (atTerm says after)
//           entries  [{text, kind, figure, glyph}]: the log lines the term writes, the reached
//                    steps' after the activity's own
//           error    "" or "unknown activity"
// Run once per month tick; it keeps nothing between runs.

import "string"
import "math"
import "algorithm"
import "lib"
import "activitytable"
import "milestonetable"

var errors = []

var forecast = {atStart: {}, atTerm: {}, percent: 0, months: 0, caption: "", gaps: [], entries: [], error: ""}
var activity = byId(activities, activityId)

if (activity.id == "")
{
    forecast.error = "unknown activity"
}
else
{
    var months = activity.months
    var spent = clamp(monthsIn, 0, months)

    // Every stat as it is, less what beginning it takes
    var atStart = {}

    for (var k : character)
    {
        atStart[k] = character[k]
    }

    for (var c = 0; c < len(activity.costs); c++)
    {
        var cost = activity.costs[c]
        atStart[cost.stat] = clamp(statOf(character, cost.stat) - cost.amount, 0, statOf(character, cost.stat))
    }

    // Then the term's gains on top: of what is left once it is paid for when it is done at once,
    // of the character as he is when it was paid for at its start
    var atTerm = {}
    var base = character

    if (months <= 0)
    {
        base = atStart
    }

    for (var k : base)
    {
        atTerm[k] = base[k]
    }

    var figure = ""

    for (var g = 0; g < len(activity.gains); g++)
    {
        var gain = activity.gains[g]
        atTerm[gain.stat] = raised(statOf(base, gain.stat), gain.stat, gain.amount)

        // What raises a stat for good raises the most it can be with it
        if (gain.amount > 0 and capOf(gain.stat) != "")
        {
            atTerm[capOf(gain.stat)] = raised(mostOf(base, gain.stat), capOf(gain.stat), gain.amount)
        }

        if (figure != "")
        {
            figure = figure + " "
        }

        figure = figure + signed(gain.amount) + " " + toLowerCase(statShortName(gain.stat))
    }

    // An activity done at once writes what it cost with what it brought
    if (months <= 0)
    {
        for (var c = 0; c < len(activity.costs); c++)
        {
            figure = figure + " " + signed(0 - activity.costs[c].amount) + " " + toLowerCase(statShortName(activity.costs[c].stat))
        }
    }

    var caption = "MONTH " + toString(spent) + " OF " + toString(months)

    if (len(activity.gains) > 0)
    {
        var first = activity.gains[0]
        caption = caption + " · " + toUpperCase(statName(first.stat)) + " " + toString(statOf(base, first.stat)) + " → " + toString(atTerm[first.stat]) + " AT TERM"
    }

    // What the next milestone asks of the path this leads toward, against the character now
    var gaps = []
    var asks = asksOf(milestones, next.id)

    for (var a = 0; a < len(asks); a++)
    {
        var ask = asks[a]

        if (ask.path == activity.path)
        {
            push(gaps, {stat: ask.stat, label: ask.label, current: statOf(character, ask.stat), needed: ask.needed})
        }
    }

    // The line the term writes in the log
    var kind = "gain"

    if (len(activity.gains) == 1 and activity.gains[0].stat == "coin")
    {
        kind = "coin"
    }

    var entries = [{text: activity.name, kind: kind, figure: figure, glyph: activity.glyph}]

    // The steps this term reaches: their effects land with the gains, once
    for (var s = 0; s < len(activity.after); s++)
    {
        var step = activity.after[s]

        if (step.uses == activity.done + 1)
        {
            var effects = listOf(step, "effects")
            var stepFigure = ""

            for (var e = 0; e < len(effects); e++)
            {
                var effect = effects[e]
                atTerm[effect.stat] = lookup(atTerm, effect.stat, 0) + effect.amount

                if (atTerm[effect.stat] < 0)
                {
                    atTerm[effect.stat] = 0
                }

                if (stepFigure != "")
                {
                    stepFigure = stepFigure + " "
                }

                stepFigure = stepFigure + signed(effect.amount) + " " + toLowerCase(statShortName(effect.stat))
            }

            if (has(step, "entry"))
            {
                push(entries, {text: step.entry, kind: "milestone", figure: stepFigure, glyph: activity.glyph})
            }
        }
    }

    var percent = 100.0

    if (months > 0)
    {
        percent = spent * 100.0 / months
    }

    forecast = {atStart: atStart, atTerm: atTerm, percent: percent, months: months, caption: caption, gaps: gaps, entries: entries, error: ""}
}
