// Chronicle rules: what an activity will do
// -----------------------------------------
// Input:  `age` (years), `character` (a table of stats and flags), `activityId`, `monthsIn` (the
//         months already spent in it).
// Output: `forecast`:
//           atTerm   every stat of the character after the activity's gains
//           percent  monthsIn / months x 100
//           months   the activity's term
//           caption  "MONTH 3 OF 6 · STRENGTH 14 → 16 AT TERM"
//           gaps     [{stat, label, current, needed}]: the next milestone's asks for the path the
//                    activity leads toward, against the character as he is (atTerm says after)
//           entries  [{text, kind, figure, glyph}]: the log lines the term writes
//           error    "" or "unknown activity"
// Run once per month tick; it keeps nothing between runs.

import "string"
import "math"
import "algorithm"
import "lib"
import "activities"
import "milestones"

var errors = []

fun findActivity(id)
{
    for (var i = 0; i < len(activities); i++)
    {
        if (activities[i].id == id)
        {
            return activities[i]
        }
    }

    return {id: ""}
}

// What the next milestone (milestones.pg, at `age`) asks, every path.
fun nextAsks()
{
    for (var i = 0; i < len(milestones); i++)
    {
        if (milestones[i].id == next.id)
        {
            return milestones[i].asks
        }
    }

    return []
}

var forecast = {atTerm: {}, percent: 0, months: 0, caption: "", gaps: [], entries: [], error: ""}
var activity = findActivity(activityId)

if (activity.id == "")
{
    forecast.error = "unknown activity"
}
else
{
    var months = activity.months
    var spent = clamp(monthsIn, 0, months)

    // Every stat as it is, then the term's gains on top
    var atTerm = {}

    for (var k : character)
    {
        atTerm[k] = character[k]
    }

    var figure = ""

    for (var g = 0; g < len(activity.gains); g++)
    {
        var gain = activity.gains[g]
        atTerm[gain.stat] = statOf(character, gain.stat) + gain.amount

        if (figure != "")
        {
            figure = figure + " "
        }

        figure = figure + signed(gain.amount) + " " + toLowerCase(statShortName(gain.stat))
    }

    var caption = "MONTH " + toString(spent) + " OF " + toString(months)

    if (len(activity.gains) > 0)
    {
        var first = activity.gains[0]
        caption = caption + " · " + toUpperCase(statName(first.stat)) + " " + toString(statOf(character, first.stat)) + " → " + toString(atTerm[first.stat]) + " AT TERM"
    }

    // What the next milestone asks of the path this leads toward, against the character now
    var gaps = []
    var asks = nextAsks()

    for (var a = 0; a < len(asks); a++)
    {
        var ask = asks[a]

        if (ask.path == activity.path)
        {
            push(gaps, {stat: ask.stat, label: ask.label, current: statOf(character, ask.stat), needed: ask.needed})
        }
    }

    // The line the term writes in the log
    var kind = "gain"

    if (len(activity.gains) == 1 and activity.gains[0].stat == "coin")
    {
        kind = "coin"
    }

    var entries = [{text: activity.name, kind: kind, figure: figure, glyph: activity.glyph}]

    forecast = {atTerm: atTerm, percent: spent * 100.0 / months, months: months, caption: caption, gaps: gaps, entries: entries, error: ""}
}
