// Chronicle rules: the activities
// -------------------------------
// Imported by windows.pg (the game's run for the activities and the doors), forecast.pg and
// epitaph.pg. Never loaded itself.
// Input:  `age` (years), `character` (a table of stats and flags), `done` (a table: activity id
//         -> the terms already completed; an activity never done has no key), `activityId` (""
//         for every activity; the forecast's one id, to shape that one only), `world` (months
//         since the world's Year 0: the date a closing is written with), `running` (the id of
//         the activity he is at, "" for none), `lives` (the lives lived in this world, this one
//         counted: the places of the town read it). `character` also carries the town, which is
//         the world's and not his:
//         "town_known" (1 once a life has explored it), "town.<place id>" (the place's level) and
//         "fund.<place id>" (the coin left to the place by lives that ended), as towntable.pg says.
// Output: `activities`, one table per thing the character may spend months doing, in the order
//         the Life screen lists them:
//           id, group, name, glyph, months, rank ("" or caps), each ("" or caps), path ("" or the
//           path it belongs to, `paths` below), enters (true for the activity that makes him one
//           of a path), board (true when it feeds him), upFront (the rations beginning it gives:
//           its months' when it feeds him, 0 otherwise), upFrontLasts (the months those
//           rations last, his own and his familiars' share of them eaten, when that is fewer than
//           its months: 0 when they last the work), fromAge, finishBy,
//           gains [{stat, amount, label, name}] (at term; label: the stat's short name, for a
//           row; name: its full one, for a gloss),
//           costs [{stat, amount, label, name, held}] (taken when it begins; held: what he holds
//           of it now),
//           requires [{stat, label, current, needed, room, cost}] (current: the character's;
//           flat: eased and anyOf are weighed here and not passed on; `cost` marks what is one
//           of its costs, `room` what is room for a gain: neither is written on a tile),
//           needs (the requirements as the table writes them, with their eased and anyOf: for
//           the tools, tools/chronicle_graph.pg; the screen reads `requires`),
//           locked (true while a requirement is unmet),
//           done (the terms completed), uses (0 = as often as he likes), left (-1 = no limit),
//           spent (true once a limited activity has no use left),
//           closed (true once it can no longer finish by its `finishBy`),
//           pathOpen (true while its path is his, or open to him),
//           reach (0-100: how much of what it asks he has, on average),
//           listed (true while the screen has a row for it: its path open, neither spent nor
//           closed, he is of the age it shows from, has its share of what it asks, has done the
//           terms it shows after and what it follows, no event has shut it and, for a bind, he
//           has a slot free),
//           showAge, showFrom, showAfter (what it is listed by, as below),
//           tally (how often it was done and, for a limited one, what is left, as the row
//           writes it: "DONE 2", "DONE 0 · 1 LEFT"),
//           place ("" or the place of the town it is done at: the Town page lists it there, not
//           the Life page), trade ("" or "buy", "sell", "make": what kind of trade a row of the market
//           is), raises and level ("" and 0, or the place its term raises and the level
//           it raises it to), yearMonths (0, or the months of his life it takes at once when it
//           begins: its `years`), goto ("" or the page that confirming it opens, and nothing else),
//           zone ("" or the zone of expeditiontable.pg it is a walk to: beginning it opens the
//           on-site screen, and its months run once he is home),
//           story ("" or the story of storytable.pg it opens: beginning it opens the story on the
//           walk's on-site screen, and its months run there as its days add up to them; its
//           `months` are the story's, and its term comes with the story's last month),
//           until ("" or when it closes, as the row writes it: "CLOSES 5/11", the world's date
//           (month/year) of the last month he may begin it, or "CLOSES THIS MONTH"; said from
//           `closingShown` months before it), urgent (true from `closingUrgent` months before),
//           closesIn (-1, or the months he still has to begin it: said all along of what closes
//           before his prime does, and from `closingShown` months before of the rest),
//           caution ("" or what doing it closes for this life, for its gloss: the rows whose
//           `unless` names it; "One or the other: ..." when it is itself one of a choice; an
//           answer to an event says after it what leaving the event unanswered shuts),
//           event ("" or the event it answers), barred ("" or what shut it: the line of the
//           event he stood by, as the log wrote it that month; a row that is barred is not
//           listed),
//           after (its steps, as below),
//           steps [{label, reached}] (each step of its `bonus` on one of his parts or skills, as its
//           gloss says it: "With Strength 8: +2 firewood", "With Dexterity 9: 2 months, not 3";
//           reached: he has it. lib.pg's `bonusStepLabel`).
//
// `months: 0` is an activity done at once: it takes no time, and can be done while another runs.
//
// Optional fields of an activity:
//   fromAge: N       he may begin it from that age (default 7; 6 for what is done at a place of
//                    the town or raises one). Younger, it asks for the age.
//   fromMonths: N    and that many months past that birthday: `fromAge: 6, fromMonths: 8` is
//                    six years and eight months. Its row shows from that month too, unless it
//                    gives a `showAge`.
//   showAge: N       its row is listed from that age (default `fromAge`): before he may begin
//                    it, it stands locked, the age the first thing it asks.
//   showFrom: N      its row is listed once he has that much (in percent) of what it asks
//                    (default `reachShown`); 0 lists it whatever he has.
//                    The great step of each age (the way into a path, its proving, its mastery)
//                    carries both: it shows ahead, whatever he has, so he knows what the years
//                    he is in lead to. A proving and a mastery show from the milestone before;
//                    the three ways into a path show from his first day, locked: they are what
//                    a childhood is spent toward.
//   showAfter: N     its row is listed once N terms in all are done in this life, whatever else
//                    lists it: the first works of his sixth year come one at a time, in every
//                    life (a first one has the guide of achievements.pg to walk it through them).
//   follows: "id"    its row is listed once that activity is behind him: done once in this life,
//                    or closed to him for good (lib.pg's `behindHim`: nothing waits forever on
//                    what he missed, or on what an event shut). A list of ids: every one of
//                    them. The works of a class come this way, a few at a time and in an order.
//   idleBy: N        its row leaves the list the month he is N if he has never done it in this
//                    life: what he has used stays his. Nothing is said of it (a countdown would
//                    have him do it once to keep it): the work a child never took is cleared
//                    away from the top of the page.
//   event: "id"      it is one of the answers to an event of lib.pg's `lifeEvents` (the Flood, the
//                    Levy), and brings one of the flags that event is answered by. Who holds
//                    none of them the month the event is settled has stood by (resources.pg
//                    writes it): the rows the event names are shut, and it is counted.
//   finishBy: N      its term must fall at that age or before (default lib.pg's `lastAge`): an
//                    activity of 18 months with finishBy 25 is begun by 23.5 at the latest.
//   finishMonths: N  and that many months past that birthday, as `fromMonths`.
//   closingShown: N  its closing is said from N months before, and not sooner: a work of his
//                    sixth year closes at seven without counting down a whole year for it.
//                    -1: never said (the last two of the year, which are all there is to do).
//   unless: "id"     its row is not listed once that activity has been done in this life: one
//                    or the other, when the two name each other. A list of ids: any of them
//                    closes it (a fork of three; a task something else shuts, as the Boys' oath
//                    shuts the Watch). The gloss of what closes another says so in the loss's
//                    colour (its `caution`), and its term writes in the log what it closed
//                    (forecast.pg).
//   onlyWith: "stat" its row is not listed while he lacks that stat, whatever else lists it (a
//                    second calling is for a town whose Inn stands: "town.inn").
//   longPrime: true  its row is not listed unless his prime runs to lib.pg's `longAge` (a second
//                    calling: an Inn raised after his thirtieth year gives him none, `primeStat`).
//   firstWith: "stat" on a `lastResort`: with that stat held it is a way in like the others,
//                    from its age, and waits for no door to close (a deserter's Greenwood).
//                    lib.pg's `anyAge` for what old age does not close.
//   board: true      it feeds him: beginning it gives the rations of its months, economytable.pg's
//                    `rationsAMonth` for each (its `upFront`, taken with its costs: forecast.pg's
//                    `atStart`). He eats them as he eats any (resources.pg); leaving it before its
//                    term gives back those of the months not worked. One done at once gives none.
//   upFront: N       on a `board` work: the rations beginning it gives, in place of its months'
//                    (the mill's first month gives six, enough to carry him to his next work).
//   path, enters     a path's activities are listed once he is one of it (holds its flag); the
//                    one that enters it is listed until he is one of any. The paths exclude
//                    each other. The page says "class" for what the rules call a path.
//   lastResort: true an `enters` that is only for who missed every other one: it has no row
//                    while another way into a class can still be begun, nor while he is at one
//                    (`running`), nor once he is of a class. It is listed from the month the
//                    last of the others closes.
//   opens: "text"    what the log and a toast say the month its row comes into the list, in
//                    place of the "New: ..." every new row gets.
//   costs: [{stat, amount}]
//                    what it takes from him when it begins. He must hold that much to begin (it
//                    is listed in `requires`).
//   amount           every {stat, amount} of an activity (its gains, its costs, a bonus step's
//                    gains and `more`, an `after` step's gains and effects) may leave the
//                    amount out: it is 1. {stat: "arms"} brings, or takes, one.
//   uses: N          it can be done N times, then it is spent.
//   requires: [{stat, needed}]
//                    what he must hold to begin it. `needed` is 1 when the entry gives none:
//                    {stat: "letters"} asks that he has any. A stat "done.<activity id>" is
//                    the terms of that activity done in this life: {stat: "done.yard"} asks
//                    that he has trained at the yard once. An entry may carry:
//     label: "text"           what the row calls it, in place of the stat's name.
//     eased: {flag, needed, at}   with the flag held (at `at` or more: 1 when it gives none), it
//                             asks `needed` instead. A list of them: the least of those that hold.
//                             Its `needed` is always written: it is what the entry is eased to.
//     raised: {flag, needed}  the other way: with the flag held it asks `needed` when that is more.
//     anyOf: [flag]           one of the flags is enough: current is 1 when he holds any. A
//                             "done.<activity id>" among them is that activity done in this life.
//   bonus: [step]    what changes with a stat he holds, or with the town. A step is
//                    {stat, needed, ...}: with the stat at `needed` or more (1 when the step
//                    gives none) it replaces the activity's own gains, costs, months, rank, each, uses,
//                    fromAge, showAge, showFrom, finishBy, board or path with the ones it gives,
//                    and adds its `more` [{stat, amount}] to what the term brings. Every step
//                    that holds is applied, in order: the last one wins what two of them give,
//                    and what their `more` add adds up: two steps on one stat, the second gives
//                    the rest of what he brings at its stat (the berries: 3, then 3 more, for 6).
//   featured: true   the page wants it seen: its tile stands on a gold ground while he can
//                    choose it (exploring the town, which a life should not miss).
//   major: true      it turns his life (a class, the town): its tile is framed in gold and shows
//                    its mark, in every state.
//   about: "text"    what it does, and a line of the town's own, said under its name in its gloss
//                    in the place of its group.
//   whileNot: "stat" its row is not listed once he holds that stat ("town_known": exploring the
//                    town is for who does not know it).
//   whileUnknown: "kind"
//                    its row is not listed once that kind of familiar is his to bind (lib.pg's
//                    `kindKnown`: learned by the world, or taught by a level of the town that
//                    stands): what teaches a kind is for who does not know it.
//   place: "id"      it is done at a place of the town: once the town is known its row stands on
//                    the Town page, at that place (the market, the storehouse), and no longer on
//                    the Life page.
//                    A work that raises a place (`raises`) has no row: a click on the
//                    place's tile begins it.
//   trade: "buy", "sell" or "make"
//                    what kind of trade a row of the market is: "buy" for what he pays coin for,
//                    "sell" for what he is paid for. The Town page lists each kind on a line of
//                    its own, and its button says Buy or Sell; a buy with no `uses` limit has Buy
//                    all beside it, as a sale has Sell all. "make" is for what is made there
//                    (a remedy, a flask): its button says Make, and Make all beside it, unless
//                    it has a `uses` limit.
//   goto: "page"     confirming it opens that page ("town") and does nothing else: no term, no
//                    month, no line.
//   raises: "id", level: N
//                    its term raises that place of the town to level N. It is listed only while
//                    the place is one level below, once the town is known, and while the place
//                    is on the Town page for him (lib.pg's `placeShown`: the town grows with
//                    what he does). The works that
//                    raise a place are not written here: they are made from towntable.pg.
//   years: N         it takes N years of his life at once when it begins, on top of its months.
//   story: "id"      beginning it opens that story of storytable.pg (whose `row` names it back)
//                    on the walk's on-site screen: its days are chosen there, each month they add
//                    up to is run as it comes, and its term is the story's last month. Its
//                    `months` are the story's. A story keeps no record and is never walked again.
//
// An activity that brings a stat with a limit (lib.pg's `statLimits`) asks for room for it: one
// more requirement, {stat, label "Room for Rations", current (the room left), needed 1, room
// true}, after its costs. Full, it is locked; begun with any room left, it brings all it brings,
// past the limit if need be.
//   after: [step]    what changes with repetition. A step is {uses: N, ...}:
//                      rank, months, gains   replace the activity's own once N terms are done
//                                            (the last step reached wins);
//                      effects [{stat, amount}], entry "text"
//                                            happen once, at the term that makes it N
//                                            (forecast.pg applies them).
//
// No function here: lib.pg holds them all, ahead of every table (see there why).
//
// The numbers are the balance of res/chronicle/chronicle-balance (tasks.json): change them here,
// nothing in C++ moves. Buy Silence ("silence") is a stub: nothing comes after the robbery yet for
// silence to quiet; it is kept as the place a Guild's pursuit will hang from.

import "string"
import "math"
import "algorithm"
import "lib"
import "towntable"
import "expeditiontable"
import "economytable"

var errors = []

// His prime ends at thirty, or at fifty in a town whose Inn stood the month he reached thirty
// (lib.pg's `primeEnd`, `primeStat`): what no age of its own closes is his until then, and old age
// begins there. An Inn raised later reopens none of it
lastAge = primeEnd(character)

// A row is listed once he has, on average, this much (in percent) of what it asks: each
// requirement counts its share up to 100, costs and room are left out (they are bought, not
// grown). Further from it, the row stays hidden, so a boy is not shown a life of locked rows:
// the three ways into a path are the only ones he sees from the start (`showFrom: 0`), and the
// doors on the clock say what else is coming.
var reachShown = 75

// What a `bonus` step may replace of its activity
var bonusFields = ["gains", "costs", "months", "rank", "each", "uses", "fromAge", "showAge", "showFrom", "finishBy", "board", "path"]

// A row says when it closes once he has this many months left to begin it, or fewer, and says it
// as urgent from the second: so no row leaves the list without having said so.
var closingShown = 24
var closingUrgent = 6

// The paths a life may take, which the page calls his class: the flag that makes him one of it.
// The renegade's is the one left to who took none of the three in time
var paths = [
    {id: "warrior", name: "The Keep", flag: "keep_oath"},
    {id: "mage", name: "The Collegium", flag: "collegium"},
    {id: "thief", name: "The Hidden Hand", flag: "hidden_hand"},
    {id: "renegade", name: "The Greenwood", flag: "renegade"}
]

var activities = [
    // His sixth year, the opening of every life: short works, a month or two each, that shape
    // him before the town's own work is his at seven. The first four come one at a time
    // (`showAfter`), in every life: a first one has its guide to walk it through them. What he
    // gleans is all he eats until the market: the flour and the books pay the coin that buys
    // the rest there. A boy who holds no rations eats none, so the gleaning gives none up
    // front: what it brings at its term is his first rations.
    {id: "glean", group: "The sixth year", name: "Glean Behind the Reapers", glyph: "work", months: 1, rank: "", each: "", path: "",
     fromAge: 6, finishBy: 7, closingShown: 3, uses: 1,
     gains: [{stat: "rations", amount: 10}],
     requires: []},
    {id: "flour", group: "The sixth year", name: "Carry Flour to the Baker", glyph: "trade", months: 1, rank: "", each: "", path: "",
     fromAge: 6, finishBy: 7, closingShown: 3, uses: 1, showAfter: 1,
     gains: [{stat: "coin", amount: 6}],
     requires: []},
    // One or the other: his body or his mind (`unless`). The scribe's bench is where a boy sits
    // still and eats what the old man leaves: it is the one that builds his Vitality
    {id: "wheel", group: "One or the other", name: "Climb the Mill Wheel", glyph: "adventure", months: 1, rank: "", each: "", path: "",
     fromAge: 6, finishBy: 7, closingShown: 3, uses: 1, showAfter: 2, unless: "scribe",
     gains: [{stat: "str"}, {stat: "dex"}],
     requires: []},
    {id: "scribe", group: "One or the other", name: "Sit with the Old Scribe", glyph: "quill", months: 1, rank: "", each: "", path: "",
     fromAge: 6, finishBy: 7, closingShown: 3, uses: 1, showAfter: 2, unless: "wheel",
     gains: [{stat: "int"}, {stat: "vit", amount: 5}],
     requires: []},
    // The keepsake: a small book he is given for his trouble. Nothing asks for it yet
    {id: "tome", group: "The sixth year", name: "Carry Books for Father Anselm", glyph: "relic", months: 1, rank: "", each: "", path: "",
     fromAge: 6, finishBy: 7, closingShown: 3, uses: 1, showAfter: 3,
     about: "Father Anselm pays in coin, and in a small book of his own that he says a boy should keep.",
     gains: [{stat: "tome"}, {stat: "coin", amount: 4}],
     requires: []},
    // Three works of two months, open from his fourth month and over by his ninth: there is
    // time for two of them, and the one left closes
    {id: "knots", group: "Time for two of them", name: "Learn Knots from the Bargemen", glyph: "adventure", months: 2, rank: "", each: "", path: "",
     fromAge: 6, fromMonths: 4, finishBy: 6, finishMonths: 9, uses: 1,
     gains: [{stat: "dex"}, {stat: "int"}],
     requires: []},
    {id: "sacks", group: "Time for two of them", name: "Haul Sacks at the Mill", glyph: "work", months: 2, rank: "", each: "", path: "",
     fromAge: 6, fromMonths: 4, finishBy: 6, finishMonths: 9, uses: 1,
     gains: [{stat: "str"}],
     requires: [],
     costs: [{stat: "vit", amount: 5}]},
    {id: "sing", group: "Time for two of them", name: "Sing at the Chapel Door", glyph: "academy", months: 2, rank: "", each: "", path: "",
     fromAge: 6, fromMonths: 4, finishBy: 6, finishMonths: 9, uses: 1,
     gains: [{stat: "int"}, {stat: "renown"}],
     requires: []},
    // A month to know the town: its page opens, with the market his coin is for and the places
    // he can build. For this life: the places stay raised from one life to the next, but every
    // boy has to be taken to the market once. No age closes it, so that none goes without
    {id: "tomarket", group: "The sixth year", name: "Go to the Market", glyph: "town", months: 1, rank: "ONCE", each: "", path: "",
     fromAge: 6, fromMonths: 8, finishBy: anyAge, uses: 1,
     whileNot: "town_known", featured: true, major: true,
     about: "Opens the Town page: a market for his coin, and places he can build that stay for his next lives. Bellmoor has nine streets, and ten opinions about each.",
     gains: [{stat: "town_known"}],
     requires: []},
    {id: "harvest", group: "The sixth year", name: "Bring in the Harvest", glyph: "work", months: 2, rank: "", each: "", path: "",
     fromAge: 6, fromMonths: 9, finishBy: 7, closingShown: -1, uses: 1,
     gains: [{stat: "str"}, {stat: "dex"}, {stat: "int"}],
     requires: []},
    // The last month before he is seven: the mill takes him on, and feeds him: its six rations are
    // his as he begins, so he does not go hungry the month he starts. From there the town's work
    // is his
    {id: "helping", group: "Work", name: "Start Helping Out", glyph: "work", months: 1, rank: "", each: "AT THE MILL", path: "",
     fromAge: 6, fromMonths: 11, finishBy: 7, closingShown: -1, board: true, upFront: 6, uses: 1,
     gains: [],
     requires: []},
    // The town's work for a child. The carters take anyone, at any age: their row is the one
    // that always stands. The others leave the list when he has never taken them by ten or so
    // (`idleBy`): what he has done once stays his, the rest is cleared from the top of the page.
    // Some go better for a boy with the part for them (their `bonus`): a strong one carries for the
    // carters in two months, a deft one runs the messages as fast, and brings more home from the
    // kitchen and the baker.
    {id: "carters", group: "Work", name: "Carry for the Carters", glyph: "work", months: 3, rank: "", each: "RATIONS UP FRONT", path: "", board: true,
     gains: [{stat: "coin", amount: 6}],
     requires: [],
     bonus: [{stat: "str", needed: 9, months: 2}]},
    {id: "mill", group: "Work", name: "Help at the Mill", glyph: "work", months: 6, rank: "", each: "", path: "", idleBy: 10,
     gains: [{stat: "str"}, {stat: "vit", amount: 5}, {stat: "coin", amount: 8}],
     requires: [],
     after: [{uses: 2, months: 9, gains: [{stat: "coin", amount: 6}]}],
     bonus: [{stat: "town.mill", more: [{stat: "coin", amount: 4}]}]},
    {id: "messages", group: "Work", name: "Run Messages", glyph: "town", months: 3, rank: "", each: "", path: "", fromAge: 7, fromMonths: 4, idleBy: 10,
     gains: [{stat: "dex"}, {stat: "coin", amount: 3}],
     requires: [],
     after: [{uses: 2, gains: [{stat: "coin", amount: 5}]}],
     bonus: [{stat: "dex", needed: 9, months: 2}]},
    // What the first berries he scavenges are for: six of them, which are his to bring, baked into
    // pies on the square. Its row stands from seven with none held (a cost is a requirement, and a
    // requirement is not what lists a row), locked until he has them
    {id: "pies", group: "Work", name: "Bake Berry Pies with the Baker", glyph: "trade", months: 2, rank: "", each: "", path: "", fromAge: 7, uses: 2,
     about: "The baker on the square has the oven and the flour, but not the berries. Those are his to bring.",
     costs: [{stat: "berries", amount: 6}],
     gains: [{stat: "coin", amount: 6}, {stat: "dex"}],
     requires: [],
     bonus: [{stat: "dex", needed: 9, more: [{stat: "coin", amount: 3}]}]},
    // What feeds him until the market is his to buy at: the rations of its months as he begins
    // it, and more to take away at its term
    {id: "kitchen", group: "Work", name: "Help in the Kitchen", glyph: "trade", months: 3, rank: "", each: "RATIONS UP FRONT", path: "", board: true, fromAge: 7, fromMonths: 8, idleBy: 10,
     gains: [{stat: "rations", amount: 6}],
     requires: [],
     costs: [{stat: "water", amount: 3}, {stat: "firewood", amount: 2}],
     bonus: [{stat: "dex", needed: 8, more: [{stat: "rations", amount: 2}]}]},
    {id: "market", group: "Work", name: "Help at the Market", glyph: "trade", months: 6, rank: "", each: "", path: "", fromAge: 8, idleBy: 11,
     gains: [{stat: "guile"}, {stat: "coin", amount: 8}],
     requires: [],
     after: [{uses: 2, gains: [{stat: "coin", amount: 12}]}]},
    {id: "smithy", group: "Work", name: "Work the Smithy", glyph: "forge", months: 9, rank: "", each: "", path: "", fromAge: 9, idleBy: 13,
     gains: [{stat: "str"}, {stat: "coin", amount: 18}],
     requires: [{stat: "str", needed: 8}],
     costs: [{stat: "firewood", amount: 6}],
     bonus: [{stat: "town.smithy", fromAge: 8}, {stat: "town.smithy", needed: 3, more: [{stat: "coin", amount: 6}]}]},
    // A chain off the smithy that ends in a fork. A month at the master's elbow, once he has
    // worked the smithy, shows him the forge; with that he may learn to temper, or he may drive
    // for the carters: one or the other (`unless`). The first leaves him a smith's apprentice,
    // whom the Keep takes with less Arms; the second knows the roads, and every walk of his is
    // a day shorter each way (lib.pg's `walkTravel`). The month at the forge closes when the
    // tempering it leads to can no longer follow it
    {id: "forge", group: "Work", name: "Watch the Master Temper a Blade", glyph: "forge", months: 1, rank: "", each: "A LEAD", path: "", fromAge: 9, finishBy: 12, finishMonths: 9, uses: 1,
     about: "A month of holding the tongs and being told to hold them still. He is shown the colour the steel must be, once.",
     gains: [{stat: "forge_seen"}],
     requires: [{stat: "done.smithy", label: "Worked the smithy"}]},
    {id: "temper", group: "Work", name: "Learn to Temper", glyph: "forge", months: 3, rank: "", each: "A BLUNT BLOW", path: "", fromAge: 10, finishBy: 13, uses: 1, unless: "drive",
     about: "Straw, then blue, then the water. The master's apprentices are known at the Keep, which asks them for less.",
     gains: [{stat: "arms"}, {stat: "smith_apprentice"}],
     requires: [{stat: "forge_seen"}, {stat: "str", needed: 9}]},
    {id: "drive", group: "Work", name: "Drive for the Carters", glyph: "work", months: 3, rank: "", each: "A DAY SHORTER, EVERY WALK", path: "", fromAge: 10, finishBy: 13, uses: 1, unless: "temper",
     about: "The reins, at last, and every lane within three days of Bellmoor. Whoever knows the roads is a day sooner anywhere, and a day sooner home.",
     gains: [{stat: "coin", amount: 8}, {stat: "roads_known"}],
     requires: [{stat: "dex", needed: 7}]},
    // A lead: a month and a little coin for something worth knowing, and no more. The bargemen
    // know the pond above the mill: with their tale it is his to walk at nine, a year sooner
    // (expeditiontable.pg's `sooner`). It is not sold to who is ten already
    {id: "bargemen", group: "Work", name: "Hear the Bargemen's Tale", glyph: "adventure", months: 1, rank: "", each: "MILL POND A YEAR SOONER", path: "", fromAge: 9, fromMonths: 4, finishBy: 10, closingShown: 3, uses: 1,
     about: "The bargemen tie up below the mill and talk for anyone who brings ale. What lives in the reeds above the weir is their favourite story.",
     gains: [{stat: "bargemen_tale"}],
     requires: [],
     costs: [{stat: "coin", amount: 2}]},
    // The way to the pond above the mill, a month of his life once the Hedgerows are known 2 of 4
    // (expeditiontable.pg's ladder says so on the walk). Found once for the world, as the town is
    // explored once: Mill Pond asks it, and no later life is offered it again (`whileNot`). No
    // row before then, and no age closes it
    {id: "pond", group: "Work", name: "Explore the Nearby Pond", glyph: "adventure", months: 1, rank: "ONCE", each: "OPENS MILL POND", path: "", finishBy: anyAge, uses: 1, showFrom: 100,
     whileNot: "know.found.millpond",
     about: "A gap in the hedge, a path through the nettles, and still water at the end of it. The mill is just below.",
     gains: [{stat: "know.found.millpond"}],
     requires: [{stat: "know.study.hedgerows", label: "The Hedgerows known 2 of 4", needed: walkKnobs.studyLevels[1]}]},
    {id: "night", group: "Work", name: "Work the Night Market", glyph: "trade", months: 6, rank: "", each: "", path: "", fromAge: 13, fromMonths: 9, finishBy: 18, uses: 2,
     gains: [{stat: "guile"}, {stat: "coin", amount: 12}],
     requires: [{stat: "guile"}],
     after: [{uses: 2, effects: [{stat: "night_contacts"}], entry: "The night market knows his face"}]},

    // What is bought on the spot is bought in town: these stand on its page, at the market, once
    // the town is known, and nowhere before
    {id: "buy.rations", group: "Market", name: "Buy rations", glyph: "trade", months: 0, rank: "", each: "AT THE MARKET", path: "", finishBy: anyAge, showFrom: 100,
     place: "market", trade: "buy",
     gains: [{stat: "rations", amount: 6}],
     requires: [{stat: "town_known", label: "The town"}],
     costs: [{stat: "coin", amount: 5}],
     bonus: [{stat: "town.market", gains: [{stat: "rations", amount: 8}]}]},
    {id: "buy.reagents", group: "Market", name: "Buy reagents", glyph: "trade", months: 0, rank: "", each: "AT THE COLLEGIUM", path: "mage",
     place: "market", trade: "buy",
     gains: [{stat: "reagents", amount: 2}],
     requires: [],
     costs: [{stat: "coin", amount: 6}],
     bonus: [{stat: "town.collegium", path: ""}]},
    // A boy's first blade is bought, not handed to him: the market sells one from two months
    // past his seventh birthday, once (the first step toward the Keep a boy of seven can take), and the practice with it comes into his training the day he holds it (below).
    // No age closes it: a man who never held one may still begin there. Where the yard has
    // stocked its racks nobody buys one: the yard lends it (`whileNot`)
    {id: "buy.blade", group: "Market", name: "Buy a Wooden Blade", glyph: "swordsmanship", months: 0, rank: "", each: "AT THE MARKET", path: "", fromAge: 7, fromMonths: 2, finishBy: anyAge, showFrom: 100, uses: 1,
     place: "market", trade: "buy", whileNot: "town.yard",
     about: "A blade of ash, blunt, and a hand too long for him. With it he can practice: the work comes into his training the day he holds one.",
     gains: [{stat: "wooden_blade"}],
     requires: [{stat: "town_known", label: "The town"}],
     costs: [{stat: "coin", amount: 8}]},
    // Two small things a boy buys that each open one task: the work of a childhood comes a few
    // at a time, and some of it is found at the market. A snare wire before the rabbits on the
    // common (they close at eleven, so the wire is sold until there is time for them)...
    {id: "buy.wire", group: "Market", name: "Buy a Snare Wire", glyph: "adventure", months: 0, rank: "", each: "AT THE MARKET", path: "", fromAge: 9, fromMonths: 8, finishBy: 10, finishMonths: 10, showFrom: 100, uses: 1,
     place: "market", trade: "buy",
     about: "A coil of brass wire, enough for a few loops. With it he can learn to snare rabbits on the common: the work comes into his streets the day he holds it.",
     gains: [{stat: "snare_wire"}],
     requires: [{stat: "town_known", label: "The town"}],
     costs: [{stat: "coin", amount: 2}]},
    // ...and a primer of the herbal before the herbal itself (sold until his prime ends, when the
    // herbal closes)
    {id: "buy.primer", group: "Market", name: "Buy a Herbal Primer", glyph: "study", months: 0, rank: "", each: "AT THE MARKET", path: "", fromAge: 10, fromMonths: 6, showFrom: 100, uses: 1,
     place: "market", trade: "buy",
     about: "A few pages of leaves and roots, copied badly and sold dear. With it, and his letters, he can learn the herbal: the work comes into his study the day he holds it.",
     gains: [{stat: "herbal_primer"}],
     requires: [{stat: "town_known", label: "The town"}],
     costs: [{stat: "coin", amount: 4}]},
    {id: "buy.sword", group: "Market", name: "Buy a Sword", glyph: "swordsmanship", months: 0, rank: "", each: "AT THE MARKET", path: "", finishBy: anyAge, showFrom: 100, uses: 1,
     place: "market", trade: "buy",
     gains: [{stat: "arms"}],
     requires: [{stat: "town.market", label: "The market charter", needed: 3}],
     costs: [{stat: "coin", amount: 40}]},
    {id: "buy.horse", group: "Market", name: "Buy a Horse", glyph: "adventure", months: 0, rank: "", each: "AT THE MARKET", path: "", finishBy: anyAge, showFrom: 100, uses: 1,
     place: "market", trade: "buy",
     gains: [{stat: "renown"}],
     requires: [{stat: "town.market", label: "The market charter", needed: 3}],
     costs: [{stat: "coin", amount: 80}]},

    // What opens a walk outside the town says so, plainly: the walk itself is a row of the
    // Adventure group, made from expeditiontable.pg below (so is the hedges' task, among the
    // works of a child)
    {id: "bow", group: "Training", name: "Learn the Bow at the Yard", glyph: "adventure", months: 3, rank: "", each: "OPENS THE HOLLOW WOODS", path: "", fromAge: 13, uses: 1,
     gains: [{stat: "dex"}, {stat: "bow_learned"}],
     requires: [{stat: "str", needed: 7}]},

    // The wooden blade, in three short steps. It is bought at the market first (above), or lent
    // by a yard that has its racks: the practice has no row before that. Two months of it teach
    // him which end to hold, and open a choice, the edge or the point (the group after this one).
    // It closes at no age of its own. Who has the basics already (the yard gives them too) has
    // the point of Arms and no more
    {id: "blades", group: "Training", name: "Practice with the Wooden Blade", glyph: "swordsmanship", months: 2, rank: "", each: "OPENS THE EDGE OR THE POINT", path: "", fromAge: 7, fromMonths: 2, uses: 1,
     about: "Two months of a post in the ground and a blade that stings his own shins. Once he has the basics there is an edge to learn, or a point: not both.",
     gains: [{stat: "arms"}, {stat: "blade_basics"}],
     requires: [{stat: "wooden_blade", label: "A wooden blade, or a yard that lends one", anyOf: ["wooden_blade", "town.yard"]}],
     bonus: [{stat: "blade_basics", gains: [{stat: "arms"}]}]},
    // The yard is not a place a boy walks into: he has watched its tourney from the rail and
    // come away with an enthusiasm for it, or he comes with the basics of the blade. Either is
    // enough. The tourney is for who has no blade: a month at nine, and it has no row once he
    // has the basics (`whileNot`). The enthusiasm is a thing he holds, in his ledger: his first
    // term at the yard takes it (a cost of the yard, while he holds any: its `bonus`), and gives
    // him the basics if he came without them
    {id: "spectate", group: "Training", name: "Watch the Tourney at the Yard", glyph: "training", months: 1, rank: "", each: "OPENS THE YARD", path: "", fromAge: 9, fromMonths: 2, uses: 1,
     whileNot: "blade_basics",
     about: "A day of blunt steel and a month of talking about it. He comes away wanting nothing else: with that the sergeants let a boy train at the yard.",
     gains: [{stat: "yard_enthusiasm"}],
     requires: []},
    {id: "yard", group: "Training", name: "Train at the Yard", glyph: "training", months: 6, rank: "", each: "", path: "", fromAge: 10, showAge: 9,
     gains: [{stat: "str"}, {stat: "arms"}, {stat: "blade_basics"}],
     requires: [{stat: "str", needed: 9},
                {stat: "yard_enthusiasm", label: "An enthusiasm for the yard, or the basics of the blade", anyOf: ["yard_enthusiasm", "blade_basics"]}],
     bonus: [{stat: "blade_basics", gains: [{stat: "str"}, {stat: "arms"}]},
             {stat: "yard_enthusiasm", costs: [{stat: "yard_enthusiasm"}]}],
     after: [{uses: 2, months: 9}, {uses: 3, months: 12}]},
    {id: "watch", group: "Training", name: "Carry for the Watch", glyph: "gate", months: 12, rank: "", each: "", path: "", fromAge: 10, finishBy: 13, uses: 1,
     unless: "oath",
     gains: [{stat: "arms"}, {stat: "str"}, {stat: "watch_known"}],
     requires: [{stat: "str", needed: 8}]},
    {id: "edric", group: "Training", name: "Train under Sergeant Edric", glyph: "training", months: 12, rank: "", each: "", path: "", fromAge: 13, fromMonths: 3, finishBy: 18, uses: 2,
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "str"}],
     requires: [{stat: "str", needed: 10}, {stat: "arms", needed: 2, eased: {flag: "watch_known", needed: 1}}],
     after: [{uses: 2, effects: [{stat: "edric_support"}], entry: "Sergeant Edric will speak for him at the Keep"}],
     bonus: [{stat: "town.yard", needed: 3, fromAge: 12}]},

    // What the yard keeps for who has done both: learned the edge or the point (the group after
    // this one), and a term under its sergeants (`done.<id>`). No row before that. It is a thing
    // he holds from then on, in his ledger; nothing in a fight reads it yet
    {id: "breathing", group: "Training", name: "Learn the Yard's Breathing", glyph: "training", months: 3, rank: "", each: "SECOND WIND", path: "", fromAge: 10, uses: 1,
     about: "In on the step, out on the blow, and never held. The sergeants teach it last, to a boy who has shown he will stay.",
     gains: [{stat: "discipline"}, {stat: "yard_breathing"}],
     requires: [{stat: "slash_learned", label: "Practiced slashes, or thrusts", anyOf: ["slash_learned", "thrust_learned"]},
                {stat: "done.yard", label: "Trained at the yard"}]},

    // One or the other (`unless`), once he has the basics: each is a stat, a point of Arms and
    // something to do in a fight besides striking (expeditiontable.pg's `walkTechniques`). The
    // one he leaves is gone for this life
    {id: "slashes", group: "The edge or the point", name: "Practice Slashes", glyph: "strength", months: 3, rank: "", each: "TEACHES THE SLASH", path: "", fromAge: 7, fromMonths: 2, uses: 1, unless: "stabs",
     about: "The whole arm, and the shoulder behind it. In a fight, a Slash bites deeper than a strike and misses more.",
     gains: [{stat: "str"}, {stat: "arms"}, {stat: "slash_learned"}],
     requires: [{stat: "blade_basics", label: "The basics of the blade"}]},
    {id: "stabs", group: "The edge or the point", name: "Practice Thrusts", glyph: "dexterity", months: 3, rank: "", each: "TEACHES THE THRUST", path: "", fromAge: 7, fromMonths: 2, uses: 1, unless: "slashes",
     about: "The feet first, then the point, straight. In a fight, a Thrust seldom misses and bites a little less than a strike.",
     gains: [{stat: "dex"}, {stat: "arms"}, {stat: "thrust_learned"}],
     requires: [{stat: "blade_basics", label: "The basics of the blade"}]},

    {id: "letters", group: "Study", name: "Learn Your Letters", glyph: "quill", months: 6, rank: "", each: "READ THE BEAST", path: "", finishBy: 14,
     gains: [{stat: "letters"}, {stat: "int"}],
     requires: [],
     after: [{uses: 3, gains: [{stat: "letters"}]}],
     costs: [{stat: "firewood", amount: 2}],
     bonus: [{stat: "town.chapel", months: 4}, {stat: "int", needed: 8, months: 4}]},
    {id: "chapel", group: "Study", name: "Serve at the Chapel", glyph: "study", months: 9, rank: "", each: "", path: "", fromAge: 9, fromMonths: 6, finishBy: 15, uses: 2,
     gains: [{stat: "letters"}, {stat: "discipline"}],
     requires: [{stat: "letters"}]},
    {id: "choir", group: "Study", name: "Choir of Saint Orun", glyph: "study", months: 12, rank: "", each: "", path: "", fromAge: 9, fromMonths: 10, finishBy: 12, uses: 1,
     gains: [{stat: "letters"}, {stat: "discipline"}, {stat: "choir"}],
     requires: [{stat: "letters"}]},
    {id: "chronicle", group: "Study", name: "Read the Old Chronicle", glyph: "study", months: 9, rank: "", each: "", path: "", fromAge: 10, fromMonths: 4, finishBy: 16, uses: 2,
     gains: [{stat: "lore"}, {stat: "int", amount: 2}],
     requires: [{stat: "letters"}]},
    {id: "copy", group: "Study", name: "Copy for Father Anselm", glyph: "quill", months: 9, rank: "", each: "", path: "", fromAge: 13, fromMonths: 6, finishBy: 18, uses: 2,
     gains: [{stat: "letters"}, {stat: "lore"}, {stat: "coin", amount: 8}],
     requires: [{stat: "letters", needed: 2}],
     after: [{uses: 2, effects: [{stat: "library_access"}], entry: "Father Anselm opens the chapel library to him"}]},
    // The Church or what it forbids: one or the other, and the first fork a later life is built
    // on. The keys are Father Anselm's trust, which the Collegium counts; the shelf is read by
    // who will go after Harrow. Whoever looted the flood is not given the keys
    {id: "keys", group: "Study", name: "Take the Sacristan's Keys", glyph: "study", months: 3, rank: "", each: "BLESSING", path: "", fromAge: 12, finishBy: 13, uses: 1, unless: ["shelf", "flood.salvage"],
     about: "The chapel at five in the morning, the candles, the offices said aloud to nobody. Father Anselm gives his keys to very few.",
     gains: [{stat: "discipline"}, {stat: "anselm_trust"}],
     requires: [{stat: "letters", needed: 2}]},
    {id: "shelf", group: "Study", name: "Read the Forbidden Shelf", glyph: "magic", months: 3, rank: "", each: "SPARK", path: "", fromAge: 12, finishBy: 13, uses: 1, unless: "keys",
     about: "The top shelf of the chapel library has a lock, and the lock has been broken for years. Nobody will thank him for what he reads there.",
     gains: [{stat: "lore"}, {stat: "forbidden_read"}],
     requires: [{stat: "letters", needed: 2}]},
    // Three kinds of familiar are learned from books and a hearth rather than from a fight: the
    // world keeps what is learned (the stat "know.fam.<id>"), so the next life can bind them. A
    // kind that is his already, learned or taught by a level of the town, is not studied again.
    // The gem weaver is the Old Grey's secret too, but the gems the town's higher levels ask must
    // not wait on a boss: a reader with some lore learns it in the middle of a life
    {id: "research.imp", group: "Study", name: "Read of the Well Spirits", glyph: "study", months: 3, rank: "", each: "LEARNS A KIND OF FAMILIAR", path: "", fromAge: 9, uses: 1,
     whileUnknown: "imp",
     about: "The chapel keeps a book of the things that live in wells, and what they ask to be fetched.",
     gains: [{stat: "know.fam.imp"}],
     requires: [{stat: "letters"}]},
    {id: "research.brownie", group: "Study", name: "Learn the Kitchen Charms", glyph: "study", months: 2, rank: "", each: "LEARNS A KIND OF FAMILIAR", path: "", fromAge: 8, uses: 1,
     whileUnknown: "brownie",
     about: "The cook knows a charm or two for the hearth, and what to leave out for whoever keeps it.",
     gains: [{stat: "know.fam.brownie"}],
     requires: [{stat: "done.kitchen", label: "Helped in the kitchen"}]},
    {id: "research.weaver", group: "Study", name: "Study the Stone-Weavers' Craft", glyph: "study", months: 4, rank: "", each: "LEARNS A KIND OF FAMILIAR", path: "", fromAge: 14, uses: 1,
     whileUnknown: "weaver",
     about: "An old mason's book tells of the spiders of the deep rock, and of the gems they spin from stone. Reading it means trying it, with a little stone and water.",
     costs: [{stat: "stone", amount: 5}, {stat: "water", amount: 5}],
     gains: [{stat: "know.fam.weaver"}],
     requires: [{stat: "letters", needed: 2}, {stat: "lore"}]},
    // The herbal: nothing for his stats, and a thing to do on every walk from then on (he brews
    // a remedy where he stands, expeditionlib.pg)
    {id: "herbal", group: "Study", name: "Learn the Herbal", glyph: "study", months: 2, rank: "", each: "BREW ON A WALK", path: "", fromAge: 10, fromMonths: 6, uses: 1,
     about: "Which leaf, which root, how long over the fire. On a walk where he can camp, two wortleaf become a remedy on the spot.",
     gains: [{stat: "herbal"}],
     requires: [{stat: "letters"}, {stat: "herbal_primer", label: "A herbal primer, from the market"}]},
    {id: "mara", group: "Study", name: "Lessons with Mara", glyph: "magic", months: 12, rank: "", each: "RIME", path: "", fromAge: 15, fromMonths: 4, finishBy: 17, uses: 1,
     gains: [{stat: "lore", amount: 2}, {stat: "discipline"}, {stat: "mara_student"}],
     requires: [{stat: "lore"}, {stat: "letters"}]},

    // The first step toward the Hidden Hand a boy of seven can take, as the blade is toward the
    // Keep and his letters toward the Collegium: a month at the fair watching who lifts what. It
    // brings a point of Stealth, and the Boys know him for it as well as for roaming the town
    {id: "cutpurse", group: "The streets", name: "Watch the Cutpurses at the Fair", glyph: "guild", months: 1, rank: "", each: "A LEAD", path: "", fromAge: 7, fromMonths: 6, finishBy: 10, uses: 1,
     about: "A month at the autumn fair, watching the quick hands work the crowd. He learns to stand where nobody looks, and the Bellmoor Boys learn his face.",
     gains: [{stat: "stealth"}, {stat: "cutpurses_seen"}],
     requires: []},

    {id: "roam", group: "The streets", name: "Roam Bellmoor", glyph: "adventure", months: 6, rank: "", each: "", path: "", fromAge: 8, finishBy: 14, uses: 2,
     gains: [{stat: "dex"}, {stat: "lore"}],
     requires: []},
    {id: "hunters", group: "The streets", name: "Follow the Hunters", glyph: "adventure", months: 9, rank: "", each: "TRACK AND SKIN", path: "", fromAge: 10, fromMonths: 2, finishBy: 15, uses: 2,
     gains: [{stat: "stealth"}, {stat: "vit", amount: 5}, {stat: "dex"}, {stat: "hunter_trained"}],
     requires: [{stat: "dex", needed: 8, eased: {flag: "snare_set", needed: 7}}]},
    {id: "boys", group: "The streets", name: "Run with the Bellmoor Boys", glyph: "town", months: 12, rank: "", each: "", path: "", fromAge: 10, fromMonths: 8, finishBy: 14, uses: 1,
     gains: [{stat: "stealth"}, {stat: "guile"}, {stat: "street_known"}],
     requires: [{stat: "dex", needed: 8}, {stat: "done.roam", label: "Roamed Bellmoor, or watched its cutpurses", anyOf: ["done.roam", "cutpurses_seen"]}]},
    // For who means to live by quick hands: the roofs make them quicker, and the town talks of it
    {id: "rooftops", group: "The streets", name: "Race the Rooftops", glyph: "dexterity", months: 6, rank: "", each: "STEP ASIDE IN A FIGHT", path: "", fromAge: 11, fromMonths: 10, finishBy: 18, uses: 3,
     about: "From the tanners' sheds to the chapel roof and back, against whoever dares. The town watches from below, and remembers who won.",
     gains: [{stat: "dex"}, {stat: "renown"}, {stat: "rooftop_runner"}],
     requires: [{stat: "dex", needed: 7}]},

    // A deadline, a chain, and the fork that first shuts a class. The snares close at eleven. The
    // tunnel is found by who has roamed the town twice, and the smuggler works through it. The
    // Boys ask for an oath or are turned in, one or the other: the oath shuts the Watch to him,
    // turning them in shuts the Hidden Hand
    {id: "snare", group: "The streets", name: "Snare Rabbits on the Common", glyph: "adventure", months: 2, rank: "", each: "SNARES ON A WALK", path: "", fromAge: 9, finishBy: 11, uses: 1,
     about: "A loop of wire, a bent sapling, and two months of learning where rabbits will not go. On a walk where he can camp, a snare is a day for a ration.",
     gains: [{stat: "dex"}, {stat: "snare_set"}],
     requires: [{stat: "dex", needed: 6}, {stat: "snare_wire", label: "A snare wire, from the market"}]},
    {id: "tunnel", group: "The streets", name: "Find the Tunnel under the Wall", glyph: "gate", months: 1, rank: "", each: "A LEAD", path: "", fromAge: 10, fromMonths: 10, uses: 1,
     about: "Every boy in Bellmoor has heard there is one. He has walked the town twice over and knows which cellar it must be.",
     gains: [{stat: "tunnel_found"}],
     requires: [{stat: "done.roam", label: "Roamed Bellmoor, twice", needed: 2}]},
    {id: "smuggler", group: "The streets", name: "Carry for the Smuggler", glyph: "guild", months: 3, rank: "", each: "", path: "", fromAge: 11, finishBy: 14, uses: 1,
     about: "Sacks one way, sacks the other, and never a word about either. The smuggler teaches one trick, and it is not a clean one.",
     gains: [{stat: "guile"}, {stat: "coin", amount: 8}, {stat: "smuggler_runner"}],
     requires: [{stat: "tunnel_found"}, {stat: "dex", needed: 8}]},
    {id: "oath", group: "The streets", name: "Take the Boys' Oath", glyph: "guild", months: 1, rank: "", each: "A DIRTY KICK", path: "", fromAge: 12, finishBy: 14, uses: 1, unless: "turnin",
     about: "A thumb cut on a roof at midnight, and a name he does not give the Watch from then on. The Watch does not forget which boys those are.",
     gains: [{stat: "stealth"}, {stat: "boys_sworn"}],
     requires: [{stat: "done.boys", label: "Ran with the Bellmoor Boys"}]},
    {id: "turnin", group: "The streets", name: "Turn the Boys In", glyph: "gate", months: 1, rank: "", each: "BRACE IN A FIGHT", path: "", fromAge: 12, finishBy: 14, uses: 1, unless: "oath",
     about: "A word to the sergeant, a purse, and a welcome at the gatehouse. No one who lives by quick hands will ever trust him.",
     gains: [{stat: "renown"}, {stat: "coin", amount: 8}, {stat: "watch_known"}],
     requires: [{stat: "done.boys", label: "Ran with the Bellmoor Boys"}]},

    // The Flood, the month he is eleven, in every life: the year to answer it (an answer may be
    // begun in any month but the last: `finishMonths` is ten and its own month), and one answer
    // (each `unless` the other two). Its rows show whatever he has (`showFrom: 0`): what he
    // cannot do he sees he cannot. Doing nothing is an answer too, and the worst: an event that
    // goes by unanswered shuts the rows lib.pg's `lifeEvents` names for it, and only those: no
    // class and no calling. Every event has an answer that asks nothing of him, so that
    // standing by is his own doing
    {id: "flood.sandbags", group: "The Flood", name: "Haul Sandbags at the Mill", glyph: "work", months: 1, rank: "", each: "THE FLOOD", path: "", fromAge: 11, finishBy: 11, finishMonths: 11, showFrom: 0, uses: 1, event: "flood",
     unless: ["flood.rescue", "flood.salvage"],
     about: "The Bell is over its banks and the wheel is under water. The miller remembers who stood in it with him: the mill's wheel costs half as much to mend, this life.",
     gains: [{stat: "str"}, {stat: "mill_saved"}],
     requires: [{stat: "str", needed: 7}]},
    {id: "flood.rescue", group: "The Flood", name: "Pull Folk from the Water", glyph: "vitality", months: 1, rank: "", each: "THE FLOOD", path: "", fromAge: 11, finishBy: 11, finishMonths: 11, showFrom: 0, uses: 1, event: "flood",
     unless: ["flood.sandbags", "flood.salvage"],
     about: "The low streets are a river, with people on the roofs. It is cold work and the town talks of it for years: the Master-at-Arms has heard.",
     gains: [{stat: "renown"}, {stat: "flood_hero"}],
     requires: [{stat: "dex", needed: 7}],
     costs: [{stat: "vit", amount: 5}]},
    {id: "flood.salvage", group: "The Flood", name: "Salvage the Wreck", glyph: "gold", months: 1, rank: "", each: "THE FLOOD", path: "", fromAge: 11, finishBy: 11, finishMonths: 11, showFrom: 0, uses: 1, event: "flood",
     unless: ["flood.sandbags", "flood.rescue"],
     about: "What the water took from the warehouses it left on the common, and nobody is counting. Father Anselm hears of it. So does the Hidden Hand.",
     gains: [{stat: "coin", amount: 15}, {stat: "guile"}, {stat: "flood_looted"}],
     requires: []},

    // The Lord's Levy, called the spring before he is fifteen, in every life, settled the month
    // the classes open: nine months to begin an answer, and one answer. To march is six months
    // and the Keep's good word; the scutage is paid at once and changes nothing; who hides is a
    // deserter, the Keep is shut to him, and the Greenwood takes him at sixteen like any other
    // class (its `firstWith`)
    {id: "levy.march", group: "The Lord's Levy", name: "March with the Levy", glyph: "swordsmanship", months: 6, rank: "", each: "THE LEVY", path: "", fromAge: 14, fromMonths: 9, finishBy: 15, finishMonths: 11, showFrom: 0, uses: 1, event: "levy",
     unless: ["levy.pay", "levy.hide"],
     about: "Six months behind the Lord's banner, with a spear too heavy for him. The Keep asks less Arms of who served, and the sergeants teach the levies one blow: the heavy cut.",
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "coin", amount: 10}, {stat: "levy_served"}],
     requires: [{stat: "str", needed: 9}]},
    {id: "levy.pay", group: "The Lord's Levy", name: "Pay the Scutage", glyph: "gold", months: 0, rank: "", each: "THE LEVY", path: "", fromAge: 14, fromMonths: 9, finishBy: 15, finishMonths: 5, showFrom: 0, uses: 1, event: "levy",
     unless: ["levy.march", "levy.hide"],
     about: "Twenty coin to the Lord's clerk, and another boy marches in his place. Nothing closes, and nothing opens.",
     gains: [{stat: "levy_paid"}],
     requires: [],
     costs: [{stat: "coin", amount: 20}]},
    {id: "levy.hide", group: "The Lord's Levy", name: "Hide in the Greenwood", glyph: "adventure", months: 3, rank: "", each: "THE LEVY", path: "", fromAge: 14, fromMonths: 9, finishBy: 15, finishMonths: 8, showFrom: 0, uses: 1, event: "levy",
     unless: ["levy.march", "levy.pay"],
     about: "Three months under the trees while the levy is counted without him. The Keep has no place for a deserter. The Greenwood does, at sixteen, with the other doors.",
     gains: [{stat: "stealth"}, {stat: "deserter"}],
     requires: []},

    {id: "keep", group: "A class", name: "Swear Service to the Keep", glyph: "seal", months: 18, rank: "", each: "RATIONS UP FRONT", path: "warrior", enters: true, board: true, fromAge: 16, showAge: 7, showFrom: 0, finishBy: 20, uses: 1,
     major: true,
     about: "Makes him a man of the Keep, for life: it feeds him, its works open, and the other classes close. The oath is short. The sergeants say it is the last short thing about the Keep.",
     gains: [{stat: "keep_oath"}, {stat: "renown"}, {stat: "arms"}],
     unless: "levy.hide",
     requires: [{stat: "str", needed: 12, eased: [{flag: "edric_support", needed: 11}, {flag: "town.yard", at: 2, needed: 11}]},
                {stat: "arms", needed: 3, eased: [{flag: "smith_apprentice", needed: 2}, {flag: "levy_served", needed: 2}]}, {stat: "discipline", needed: 2}],
     costs: [{stat: "coin", amount: 10}]},
    // Its term is a story (storytable.pg's `collegium`), lived day by day: each course paid at
    // its door, the class his only if he passes its examinations. Who dropped out of it is not
    // taken back (`whileNot`). It asks the coin of the first days' fees (a requirement: nothing is
    // taken up front)
    {id: "collegium", group: "A class", name: "Enter the Collegium", glyph: "academy", months: 24, rank: "", each: "RATIONS UP FRONT", path: "mage", enters: true, board: true, fromAge: 16, showAge: 7, showFrom: 0, finishBy: 20, uses: 1,
     major: true, story: "collegium", whileNot: "dropout.collegium",
     about: "Sixteen days of lectures, an element to choose and two examinations, each course paid at its door. Who passes is a scholar of the Collegium for life: it feeds him, its works open, and the other classes close. Nobody will say what the top floor is for.",
     gains: [],
     requires: [{stat: "int", needed: 12, eased: [{flag: "town.collegium", at: 3, needed: 11}, {flag: "anselm_trust", needed: 11}]}, {stat: "letters", needed: 3}, {stat: "lore", needed: 2, eased: {flag: "mara_student", needed: 1}},
                {stat: "coin", needed: 6}],
     costs: []},
    {id: "hand", group: "A class", name: "Earn the Hidden Hand's Trust", glyph: "guild", months: 18, rank: "", each: "RATIONS UP FRONT", path: "thief", enters: true, board: true, fromAge: 16, showAge: 7, showFrom: 0, finishBy: 21, uses: 1,
     major: true,
     about: "Makes him one of the Hidden Hand, for life: it feeds him, its works open, and the other classes close. The Hand has no door, no sign and no members. Ask anyone.",
     gains: [{stat: "hidden_hand"}, {stat: "favors"}, {stat: "stealth"}],
     unless: "turnin",
     requires: [{stat: "dex", needed: 12}, {stat: "stealth", needed: 2},
                {stat: "guile", needed: 2, eased: [{flag: "smuggler_runner", needed: 1}, {flag: "flood_looted", needed: 1}]},
                {stat: "street_known", label: "Known on the street or at the night market", anyOf: ["street_known", "night_contacts", "boys_sworn"]}],
     costs: [{stat: "coin", amount: 15}]},
    // Past every door: the class of who took none of the three in time, and of no one else. It
    // has no row until the last of the others has closed on a man of no class, by its age;
    // from that month it asks nothing of him
    // but to be sixteen, and it is open until old age
    {id: "greenwood", group: "A class", name: "Take to the Greenwood", glyph: "adventure", months: 12, rank: "", each: "RATIONS UP FRONT", path: "renegade", enters: true, lastResort: true, board: true, fromAge: 16, uses: 1,
     firstWith: "deserter",
     opens: "Every class has shut its door on him: the Greenwood takes who is left",
     major: true,
     about: "Makes him an outlaw of the Greenwood, for life: the wood feeds him, and its works open. It asks no letters, no oath and no questions. It is the questions that people come for.",
     gains: [{stat: "renegade"}, {stat: "stealth"}],
     requires: []},

    // The works of a class come a few at a time and in an order (`follows`): its bread the day
    // he is of it, with the great step of his years locked ahead of him, and each of the others
    // once the one before it is behind him. The Keep: its service, then the patrols, then the
    // tourney, and from the tourney the Master-at-Arms and the duel, the merchant road after the
    // duel: no work opens more than two

    {id: "serve", group: "The Keep", name: "Serve at the Keep", glyph: "swordsmanship", months: 12, rank: "", each: "RATIONS UP FRONT", path: "warrior", board: true, fromAge: 18,
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "coin", amount: 12}],
     requires: [],
     after: [{uses: 2, gains: [{stat: "arms"}, {stat: "coin", amount: 8}], effects: [{stat: "renown"}], entry: "The Keep speaks well of his service"}],
     bonus: [{stat: "pardoned", path: "", fromAge: 25}]},
    {id: "patrol", group: "The Keep", name: "Patrol the North Road", glyph: "gate", months: 9, rank: "", each: "", path: "warrior", follows: "serve", fromAge: 18, finishBy: 25, uses: 2,
     gains: [{stat: "renown"}, {stat: "coin", amount: 22}, {stat: "vit", amount: 5}],
     requires: [{stat: "arms", needed: 5}, {stat: "vit", needed: 50}],
     bonus: [{stat: "town.gate", needed: 2, board: true, each: "RATIONS UP FRONT"}, {stat: "pardoned", path: "", fromAge: 25, finishBy: 30}]},
    {id: "tourney", group: "The Keep", name: "Spring Tourney", glyph: "reputation", months: 6, rank: "", each: "", path: "warrior", follows: "patrol", fromAge: 19, finishBy: 23, uses: 1,
     gains: [{stat: "renown"}, {stat: "coin", amount: 20}],
     requires: [{stat: "arms", needed: 5}],
     bonus: [{stat: "arms", needed: 7, gains: [{stat: "renown", amount: 2}, {stat: "coin", amount: 20}, {stat: "tourney_victor"}]}]},
    {id: "escort", group: "The Keep", name: "Escort the Merchant Road", glyph: "adventure", months: 12, rank: "", each: "", path: "warrior", follows: "duel", fromAge: 20, finishBy: 27, uses: 2,
     gains: [{stat: "coin", amount: 35}, {stat: "renown"}],
     requires: [{stat: "arms", needed: 5}, {stat: "discipline", needed: 3}]},
    {id: "master", group: "The Keep", name: "Train with the Master-at-Arms", glyph: "training", months: 18, rank: "", each: "RATIONS UP FRONT", path: "warrior", follows: "tourney", board: true, fromAge: 19, uses: 1,
     gains: [{stat: "arms", amount: 2}, {stat: "discipline"}],
     requires: [{stat: "arms", needed: 5}, {stat: "discipline", needed: 3}, {stat: "renown", needed: 2, eased: {flag: "flood_hero", needed: 1}}]},
    {id: "campaign", group: "The Keep", name: "Join the Border Campaign", glyph: "swordsmanship", months: 24, rank: "", each: "RATIONS UP FRONT", path: "warrior", board: true, fromAge: 21, showAge: 16, showFrom: 0, finishBy: 26, uses: 1,
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "vit", amount: 5}, {stat: "renown", amount: 2}, {stat: "coin", amount: 50}, {stat: "veteran"}],
     requires: [{stat: "arms", needed: 6}, {stat: "discipline", needed: 4}, {stat: "renown", needed: 3}],
     costs: [{stat: "coin", amount: 10}]},
    {id: "lead", group: "The Keep", name: "Lead the Watch", glyph: "reputation", months: 18, rank: "", each: "RATIONS UP FRONT", path: "warrior", board: true, fromAge: 24, uses: 1,
     gains: [{stat: "renown", amount: 2}, {stat: "discipline"}, {stat: "watch_commander"}],
     requires: [{stat: "veteran"}, {stat: "arms", needed: 7}, {stat: "discipline", needed: 5}]},
    {id: "captain", group: "The Keep", name: "Take the Captain's Chain", glyph: "seal", months: 24, rank: "", each: "RATIONS UP FRONT", path: "warrior", board: true, fromAge: 26, showAge: 21, showFrom: 0, uses: 1,
     gains: [{stat: "captain"}, {stat: "coin", amount: 80}],
     requires: [{stat: "watch_commander"}, {stat: "arms", needed: 8}, {stat: "discipline", needed: 6}, {stat: "renown", needed: 7, eased: [{flag: "town.gate", at: 3, needed: 6}, {flag: "captain_favour", needed: 6}]}],
     costs: [{stat: "coin", amount: 20}]},

    // A chain off the patrols, and a deadline: the Keep stays a straight ladder, and its choices
    // come with its second calling
    {id: "tracks", group: "The Keep", name: "Follow the Ambush Tracks", glyph: "adventure", months: 1, rank: "", each: "A LEAD", path: "warrior", fromAge: 21, uses: 1,
     about: "The second patrol finds what the first did not: wheel ruts leaving the road, and boot prints beside them.",
     gains: [{stat: "bandit_trail"}],
     requires: [{stat: "done.patrol", label: "Patrolled the North Road, twice", needed: 2}]},
    {id: "raid", group: "The Keep", name: "Raid the Greenwood Camp", glyph: "swordsmanship", months: 6, rank: "", each: "", path: "warrior", fromAge: 21, finishBy: 26, uses: 1,
     gains: [{stat: "renown", amount: 2}, {stat: "coin", amount: 30}, {stat: "band_broken"}],
     requires: [{stat: "bandit_trail"}, {stat: "arms", needed: 6}]},
    {id: "duel", group: "The Keep", name: "Duel for the Captain's Favour", glyph: "reputation", months: 3, rank: "", each: "", path: "warrior", follows: "tourney", fromAge: 22, finishBy: 24, uses: 1,
     about: "Three months of dawn in the lists, before the one man whose word makes a captain. The chain asks less Renown of whoever he has watched win.",
     gains: [{stat: "arms"}, {stat: "renown"}, {stat: "captain_favour"}],
     requires: [{stat: "arms", needed: 6}],
     costs: [{stat: "coin", amount: 10}]},

    // The Collegium: its study and its copying, then the workings and the Black Treatise once
    // he has studied; the night offices and Magister Orin after a first working; the Harrow
    // fragments after the treatise, and the lecture and the apothecary after the fragments
    {id: "scribework", group: "The Collegium", name: "Copy Paid Manuscripts", glyph: "quill", months: 6, rank: "", each: "RATIONS UP FRONT", path: "mage", board: true, fromAge: 18,
     gains: [{stat: "coin", amount: 30}],
     requires: [{stat: "letters", needed: 4}]},
    {id: "study", group: "The Collegium", name: "Study at the Collegium", glyph: "academy", months: 12, rank: "", each: "RATIONS UP FRONT", path: "mage", board: true, fromAge: 18,
     gains: [{stat: "lore"}, {stat: "letters"}],
     requires: [],
     costs: [{stat: "coin", amount: 10}],
     after: [{uses: 2, gains: [{stat: "lore"}]}]},
    {id: "workings", group: "The Collegium", name: "Practice Minor Workings", glyph: "magic", months: 6, rank: "", each: "", path: "mage", follows: "study", fromAge: 18,
     gains: [{stat: "arcana"}],
     requires: [{stat: "arcana"}, {stat: "lore", needed: 3}],
     costs: [{stat: "reagents", amount: 2}],
     after: [{uses: 2, months: 9}]},
    // The Collegium's own drill: the hours kept, the offices said, the mind held to one thing
    {id: "vigil", group: "The Collegium", name: "Keep the Night Offices", glyph: "academy", months: 6, rank: "", each: "RATIONS UP FRONT", path: "mage", follows: "workings", board: true, fromAge: 18, uses: 4,
     about: "Up at the second bell, every night of a season, to say the offices in a cold hall. Nobody has ever enjoyed it. That is the point.",
     gains: [{stat: "discipline"}],
     requires: []},
    {id: "treatise", group: "The Collegium", name: "Copy the Black Treatise", glyph: "quill", months: 12, rank: "", each: "", path: "mage", follows: "study", fromAge: 19, finishBy: 25, uses: 1,
     gains: [{stat: "lore", amount: 2}, {stat: "black_treatise"}],
     requires: [{stat: "letters", needed: 4}, {stat: "lore", needed: 4}],
     costs: [{stat: "coin", amount: 20}]},
    {id: "orin", group: "The Collegium", name: "Assist Magister Orin", glyph: "magic", months: 18, rank: "", each: "RATIONS UP FRONT", path: "mage", follows: "workings", board: true, fromAge: 19, finishBy: 26, uses: 1,
     gains: [{stat: "arcana"}, {stat: "discipline"}, {stat: "orin_known"}],
     requires: [{stat: "arcana", needed: 2}, {stat: "letters", needed: 4}],
     costs: [{stat: "reagents", amount: 3}]},
    {id: "fragments", group: "The Collegium", name: "Examine the Harrow Fragments", glyph: "relic", months: 12, rank: "", each: "", path: "mage", follows: "treatise", fromAge: 20, uses: 1,
     gains: [{stat: "lore"}, {stat: "harrow_fragments"}],
     requires: [{stat: "lore", needed: 5, eased: {flag: "forbidden_read", needed: 4}}, {stat: "library_access", label: "The chapel library or the Collegium", anyOf: ["library_access", "collegium"]}],
     bonus: [{stat: "town.harrow", showFrom: 0}]},
    {id: "harrow", group: "The Collegium", name: "Expedition to Harrow", glyph: "adventure", months: 18, rank: "", each: "RATIONS UP FRONT", path: "mage", board: true, fromAge: 21, showAge: 16, showFrom: 0, finishBy: 26, uses: 1,
     gains: [{stat: "arcana"}, {stat: "lore"}, {stat: "harrow_truth"}, {stat: "harrow_relic"}],
     requires: [{stat: "harrow_fragments"}, {stat: "lore", needed: 6}, {stat: "arcana", needed: 3}],
     costs: [{stat: "coin", amount: 20}, {stat: "rations", amount: 8}, {stat: "reagents", amount: 4}],
     bonus: [{stat: "town.harrow", needed: 2, months: 12}]},
    {id: "relic", group: "The Collegium", name: "Study the Harrow Relic", glyph: "relic", months: 18, rank: "", each: "RATIONS UP FRONT", path: "mage", board: true, fromAge: 23, uses: 1,
     gains: [{stat: "arcana", amount: 2}, {stat: "discipline"}],
     requires: [{stat: "harrow_relic"}, {stat: "arcana", needed: 4, eased: {flag: "mill_engine", needed: 3}}],
     costs: [{stat: "reagents", amount: 5}],
     bonus: [{stat: "town.harrow", showFrom: 0}]},
    {id: "ritual", group: "The Collegium", name: "Perform the Harrow Working", glyph: "magic", months: 24, rank: "", each: "RATIONS UP FRONT", path: "mage", board: true, fromAge: 26, showAge: 21, showFrom: 0, uses: 1,
     gains: [{stat: "mage_of_harrow"}],
     requires: [{stat: "harrow_truth"}, {stat: "arcana", needed: 6}, {stat: "lore", needed: 7, eased: {flag: "demon_spoken", needed: 6}},
                {stat: "discipline", needed: 4, eased: {flag: "magister", needed: 3}}],
     costs: [{stat: "reagents", amount: 10}]},

    // The Church or the demons: one or the other, at twenty, and the fork the hidden truth hangs
    // from. Orders are for who holds Father Anselm's trust and never read the forbidden shelf.
    // Each opens its own account of the curse. Then a chain off the Black Treatise that needs a
    // place of the town as its key, two works that compete for the same years, and the
    // Magister's examination
    {id: "orders", group: "The Collegium", name: "Take Orders in the Church", glyph: "study", months: 12, rank: "", each: "", path: "mage", fromAge: 20, finishBy: 23, uses: 1, unless: ["demon", "shelf", "plague.sell"],
     about: "A year of vows, and a collar under the scholar's gown. The Church opens its vault to its own, and to no one who has read what it forbids.",
     gains: [{stat: "discipline"}, {stat: "lore"}, {stat: "renown"}, {stat: "ordained"}],
     requires: [{stat: "anselm_trust"}, {stat: "letters", needed: 4}, {stat: "discipline", needed: 3}]},
    {id: "demon", group: "The Collegium", name: "Seek the Demon Scholar", glyph: "magic", months: 12, rank: "", each: "", path: "mage", fromAge: 20, finishBy: 23, uses: 1, unless: "orders",
     about: "There is one in the old town who was a scholar before he was anything else, and still keeps hours. He tells the other account of the curse, to who can find his door.",
     gains: [{stat: "lore", amount: 2}, {stat: "demon_spoken"}],
     requires: [{stat: "lore", needed: 5, eased: {flag: "forbidden_read", needed: 4}}, {stat: "stealth", needed: 1}],
     costs: [{stat: "coin", amount: 15}]},
    {id: "churchvault", group: "The Collegium", name: "Read the Church's Vault", glyph: "study", months: 6, rank: "", each: "", path: "mage", fromAge: 21, uses: 1,
     gains: [{stat: "lore", amount: 2}, {stat: "engines_seen"}],
     requires: [{stat: "ordained"}, {stat: "lore", needed: 5}]},
    {id: "demon2", group: "The Collegium", name: "Return to the Demon Scholar", glyph: "magic", months: 6, rank: "", each: "", path: "", fromAge: 22, uses: 1,
     gains: [{stat: "arcana"}, {stat: "lore"}, {stat: "other_account"}],
     requires: [{stat: "demon_spoken", label: "Spoke with a demon, or a guest of the woodfolk", anyOf: ["demon_spoken", "woodfolk_guest"]}, {stat: "lore", needed: 6}],
     costs: [{stat: "reagents", amount: 10}]},
    {id: "glyphs", group: "The Collegium", name: "Decipher the Margin Glyphs", glyph: "quill", months: 3, rank: "", each: "A LEAD", path: "mage", fromAge: 20, uses: 1,
     gains: [{stat: "glyphs_read"}],
     requires: [{stat: "black_treatise"}, {stat: "lore", needed: 4}]},
    {id: "cellar", group: "The Collegium", name: "Open the Old Mill Cellar", glyph: "relic", months: 1, rank: "", each: "", path: "mage", fromAge: 21, uses: 1,
     about: "The glyphs name a door under the mill, and the loft a life before him raised is what stands over it. What turns down there is not the wheel.",
     gains: [{stat: "arcana"}, {stat: "mill_engine"}],
     requires: [{stat: "glyphs_read"}, {stat: "town.mill", label: "The mill loft, in town", needed: 2}]},
    {id: "lecture", group: "The Collegium", name: "Lecture at the Collegium", glyph: "academy", months: 12, rank: "", each: "", path: "mage", follows: "fragments", fromAge: 21, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 30}, {stat: "renown"}],
     requires: [{stat: "lore", needed: 5}, {stat: "letters", needed: 4}]},
    {id: "apothecary", group: "The Collegium", name: "Brew for the Apothecary", glyph: "vitality", months: 9, rank: "", each: "", path: "mage", follows: "fragments", fromAge: 21, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 25}, {stat: "arcana"}],
     requires: [{stat: "arcana", needed: 2}],
     costs: [{stat: "wortleaf", amount: 4}]},
    {id: "exam", group: "The Collegium", name: "Sit the Magister's Examination", glyph: "academy", months: 3, rank: "", each: "", path: "mage", fromAge: 24, finishBy: 26, uses: 1,
     about: "Three days of questions and three months of waiting for them. The Harrow Working asks less Discipline of a Magister.",
     gains: [{stat: "renown"}, {stat: "magister"}],
     requires: [{stat: "lore", needed: 6}, {stat: "arcana", needed: 3}, {stat: "discipline", needed: 3}],
     costs: [{stat: "coin", amount: 10}]},

    // The Hidden Hand: its errands, then the informants and the hidden ways; Old Vey and what kind
    // of thief he is after the informants; the gate and the clerk after the hidden ways: no work
    // opens more than two (and a choice)
    {id: "run", group: "The Hidden Hand", name: "Run for the Hand", glyph: "work", months: 6, rank: "", each: "", path: "thief", fromAge: 18,
     gains: [{stat: "favors"}, {stat: "coin", amount: 18}],
     requires: [],
     after: [{uses: 3, gains: [{stat: "coin", amount: 20}]}],
     bonus: [{stat: "hand_marked", more: [{stat: "favors", amount: 1}]}, {stat: "freelance", gains: [{stat: "coin", amount: 18}]}]},
    {id: "network", group: "The Hidden Hand", name: "Cultivate Informants", glyph: "town", months: 6, rank: "", each: "", path: "thief", follows: "run", fromAge: 18,
     gains: [{stat: "favors", amount: 2}],
     requires: [],
     costs: [{stat: "coin", amount: 8}],
     bonus: [{stat: "hand_marked", more: [{stat: "favors", amount: 1}]}]},
    {id: "drill", group: "The Hidden Hand", name: "Practice the Hidden Ways", glyph: "training", months: 9, rank: "", each: "", path: "thief", follows: "run", fromAge: 18, uses: 3,
     gains: [{stat: "stealth"}, {stat: "guile"}],
     requires: [],
     costs: [{stat: "coin", amount: 6}]},
    {id: "vey", group: "The Hidden Hand", name: "Learn from Old Vey", glyph: "guild", months: 12, rank: "", each: "", path: "thief", follows: "network", fromAge: 18, finishBy: 24, uses: 1,
     gains: [{stat: "stealth", amount: 2}, {stat: "guile"}],
     requires: [],
     costs: [{stat: "favors", amount: 2}]},
    {id: "smuggle", group: "The Hidden Hand", name: "Smuggle Through the North Gate", glyph: "gate", months: 9, rank: "", each: "", path: "thief", follows: "drill", fromAge: 19, finishBy: 27, uses: 3,
     gains: [{stat: "coin", amount: 35}, {stat: "favors", amount: 2}],
     requires: [{stat: "stealth", needed: 4, eased: {flag: "smuggler_runner", needed: 3}}, {stat: "guile", needed: 4}],
     bonus: [{stat: "hand_marked", more: [{stat: "favors", amount: 1}]}, {stat: "freelance", gains: [{stat: "coin", amount: 35}]}]},
    {id: "blackmail", group: "The Hidden Hand", name: "Blackmail a Guild Clerk", glyph: "skull", months: 9, rank: "", each: "", path: "thief", follows: "drill", fromAge: 19, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 45}, {stat: "guild_clerk"}],
     requires: [{stat: "guile", needed: 5, eased: {flag: "plague_profiteer", needed: 4}}],
     costs: [{stat: "favors"}],
     bonus: [{stat: "freelance", more: [{stat: "coin", amount: 20}]}]},
    {id: "rob", group: "The Hidden Hand", name: "Rob the Counting House", glyph: "gold", months: 18, rank: "", each: "", path: "thief", fromAge: 21, showAge: 16, showFrom: 0, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 100}, {stat: "guild_ledgers"}, {stat: "guild_enemy"}],
     requires: [{stat: "stealth", needed: 6}, {stat: "guile", needed: 5}],
     costs: [{stat: "favors", amount: 3}],
     bonus: [{stat: "freelance", more: [{stat: "coin", amount: 20}]}]},
    {id: "silence", group: "The Hidden Hand", name: "Buy Silence", glyph: "gold", months: 0, rank: "", each: "", path: "thief", fromAge: 22, uses: 1,
     gains: [{stat: "heat_reduced"}],
     requires: [{stat: "guild_enemy"}],
     costs: [{stat: "coin", amount: 40}],
     bonus: [{stat: "hand_marked", costs: []}]},
    {id: "plan", group: "The Hidden Hand", name: "Plan the Bellmoor Job", glyph: "time", months: 12, rank: "", each: "", path: "thief", fromAge: 23, uses: 1,
     gains: [{stat: "great_job_planned"}],
     requires: [{stat: "guild_ledgers"}, {stat: "guile", needed: 6}],
     costs: [{stat: "favors", amount: 2}]},
    {id: "crew", group: "The Hidden Hand", name: "Gather the Crew", glyph: "guild", months: 12, rank: "", each: "", path: "thief", fromAge: 24, uses: 1,
     gains: [{stat: "crew_ready"}],
     requires: [{stat: "great_job_planned"}],
     costs: [{stat: "favors", amount: 3}, {stat: "coin", amount: 25}]},
    {id: "vault", group: "The Hidden Hand", name: "Empty the Bellmoor Vault", glyph: "gold", months: 24, rank: "", each: "RATIONS UP FRONT", path: "thief", board: true, fromAge: 26, showAge: 21, showFrom: 0, uses: 1,
     gains: [{stat: "coin", amount: 200}, {stat: "master_thief"}],
     requires: [{stat: "crew_ready"}, {stat: "stealth", needed: 8, eased: {flag: "vey_heir", needed: 7}}, {stat: "guile", needed: 7}]},

    // What kind of thief he is: the Hand's man, or his own (one or the other, at nineteen). The
    // mark makes every favor one more and silence free; his own name pays better and earns no
    // favor but the informants'. Then a chain that steals from the Collegium, two jobs that
    // compete for the same years, and Old Vey's last summons
    {id: "mark", group: "The Hidden Hand", name: "Take the Hand's Mark", glyph: "guild", months: 3, rank: "", each: "", path: "thief", follows: "network", fromAge: 19, finishBy: 21, uses: 1, unless: "ownname",
     about: "A small scar where a sleeve covers it. From then on the Hand pays its debts to him first: every favor is one more, and silence costs him nothing.",
     gains: [{stat: "guile"}, {stat: "hand_marked"}],
     requires: [{stat: "favors", needed: 2}],
     costs: [{stat: "favors", amount: 2}]},
    {id: "ownname", group: "The Hidden Hand", name: "Keep Your Own Name", glyph: "adventure", months: 3, rank: "", each: "", path: "thief", follows: "network", fromAge: 19, finishBy: 21, uses: 1, unless: "mark",
     about: "No mark, no master, and a larger share of every job. The Hand owes nothing to a man who is not its own: only his informants still do.",
     gains: [{stat: "stealth"}, {stat: "freelance"}],
     requires: [{stat: "guile", needed: 3}]},
    {id: "rumour", group: "The Hidden Hand", name: "Hear of the Collegium's Reagents", glyph: "town", months: 1, rank: "", each: "A LEAD", path: "thief", fromAge: 20, uses: 1,
     gains: [{stat: "reagent_run"}],
     requires: [{stat: "done.network", label: "Cultivated informants, twice", needed: 2}]},
    {id: "stores", group: "The Hidden Hand", name: "Steal from the Collegium Stores", glyph: "magic", months: 6, rank: "", each: "", path: "thief", fromAge: 20, finishBy: 24, uses: 2,
     gains: [{stat: "reagents", amount: 6}, {stat: "coin", amount: 20}, {stat: "collegium_thief"}],
     requires: [{stat: "reagent_run"}, {stat: "stealth", needed: 5}]},
    {id: "fix", group: "The Hidden Hand", name: "Fix the Spring Tourney", glyph: "reputation", months: 6, rank: "", each: "", path: "thief", fromAge: 22, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 45}, {stat: "favors"}, {stat: "tourney_fixed"}],
     requires: [{stat: "guile", needed: 5}],
     costs: [{stat: "coin", amount: 20}]},
    {id: "nightrun", group: "The Hidden Hand", name: "Run the Night Market", glyph: "trade", months: 9, rank: "", each: "", path: "thief", fromAge: 22, finishBy: 25, uses: 1,
     gains: [{stat: "coin", amount: 30}, {stat: "guile"}],
     requires: [{stat: "night_contacts"}, {stat: "guile", needed: 4}]},
    {id: "summons", group: "The Hidden Hand", name: "Answer Vey's Last Summons", glyph: "guild", months: 1, rank: "", each: "", path: "thief", fromAge: 24, finishBy: 25, uses: 1,
     about: "The old man sends for one of them, once, and does not wait long. The vault asks less Stealth of whoever he named.",
     gains: [{stat: "stealth"}, {stat: "favors"}, {stat: "vey_heir"}],
     requires: [{stat: "done.vey", label: "Learned from Old Vey"}]},

    // The renegade's years. The numbers are a first guess, not the balance's: he starts late and
    // with little, so what he lives on is easy to come by and his two great steps ask less.
    // The deer and the burners first, the outlaws once he has poached, the road after them
    {id: "poach", group: "The Greenwood", name: "Poach the Lord's Deer", glyph: "adventure", months: 6, rank: "", each: "", path: "renegade", fromAge: 20,
     gains: [{stat: "rations", amount: 12}, {stat: "stealth"}],
     requires: [],
     after: [{uses: 2, gains: [{stat: "rations", amount: 12}]}]},
    {id: "burners", group: "The Greenwood", name: "Winter with the Charcoal Burners", glyph: "forge", months: 6, rank: "", each: "RATIONS UP FRONT", path: "renegade", board: true, fromAge: 20,
     gains: [{stat: "coin", amount: 8}],
     requires: []},
    {id: "outlaws", group: "The Greenwood", name: "Train with the Outlaws", glyph: "training", months: 9, rank: "", each: "RATIONS UP FRONT", path: "renegade", follows: "poach", board: true, fromAge: 20, uses: 3,
     gains: [{stat: "arms"}, {stat: "stealth"}],
     requires: []},
    {id: "waylay", group: "The Greenwood", name: "Waylay the Merchant Road", glyph: "gold", months: 9, rank: "", each: "", path: "renegade", follows: "outlaws", fromAge: 21, uses: 3,
     gains: [{stat: "coin", amount: 40}, {stat: "renown"}, {stat: "arms"}],
     requires: [{stat: "arms", needed: 2}, {stat: "stealth", needed: 3}],
     bonus: [{stat: "peoples_outlaw", gains: [{stat: "coin", amount: 30}, {stat: "renown", amount: 2}, {stat: "arms"}]},
             {stat: "feared", gains: [{stat: "coin", amount: 55}, {stat: "arms"}]}]},
    {id: "gaol", group: "The Greenwood", name: "Break a Man out of the Keep's Gaol", glyph: "gate", months: 12, rank: "", each: "", path: "renegade", fromAge: 23, showAge: 20, showFrom: 0, uses: 1,
     gains: [{stat: "renown", amount: 2}, {stat: "band"}],
     requires: [{stat: "arms", needed: 3}, {stat: "stealth", needed: 4}],
     costs: [{stat: "coin", amount: 15}]},
    {id: "woodking", group: "The Greenwood", name: "Hold the Greenwood", glyph: "seal", months: 24, rank: "", each: "RATIONS UP FRONT", path: "renegade", board: true, fromAge: 26, showAge: 23, showFrom: 0, uses: 1,
     unless: "pardon",
     gains: [{stat: "wood_king"}, {stat: "coin", amount: 60}],
     requires: [{stat: "band"}, {stat: "arms", needed: 5}, {stat: "stealth", needed: 5},
                {stat: "renown", needed: 4, eased: {flag: "peoples_outlaw", needed: 3}, raised: {flag: "feared", needed: 5}}]},

    // Who the band robs: one or the other, at twenty-one. Then a chain through the charcoal
    // burners that reaches the woodfolk, two works that compete for the same years, and the
    // Lord's pardon: a quiet end at the Keep, at the price of the Greenwood's own
    {id: "spare", group: "The Greenwood", name: "Spare the Village Carts", glyph: "town", months: 3, rank: "", each: "", path: "renegade", fromAge: 21, finishBy: 23, uses: 1, unless: "toll",
     about: "The band lets the village carts by and takes from the merchants alone. The road pays less and the villages talk: the Greenwood asks less Renown of the man they sing about.",
     gains: [{stat: "renown"}, {stat: "peoples_outlaw"}],
     requires: [{stat: "done.waylay", label: "Waylaid the merchant road"}]},
    {id: "toll", group: "The Greenwood", name: "Take the Toll from All", glyph: "gold", months: 3, rank: "", each: "", path: "renegade", fromAge: 21, finishBy: 23, uses: 1, unless: "spare",
     about: "Everything that rolls pays. The road is worth more and nobody sings about it: the Greenwood asks more Renown of a man it only fears.",
     gains: [{stat: "coin", amount: 15}, {stat: "feared"}],
     requires: [{stat: "done.waylay", label: "Waylaid the merchant road"}]},
    {id: "shrine", group: "The Greenwood", name: "Find the Burners' Old Shrine", glyph: "relic", months: 1, rank: "", each: "A LEAD", path: "renegade", fromAge: 21, uses: 1,
     gains: [{stat: "forest_shrine"}],
     requires: [{stat: "done.burners", label: "Wintered with the charcoal burners"}]},
    {id: "woodfolk", group: "The Greenwood", name: "Meet the Woodfolk", glyph: "adventure", months: 6, rank: "", each: "", path: "renegade", fromAge: 22, uses: 1,
     about: "They were in the wood before the town had a name, and they are not what the Church says they are. A guest of theirs may go where a scholar goes, and the Harrow road costs him half to clear.",
     gains: [{stat: "lore"}, {stat: "stealth"}, {stat: "woodfolk_guest"}],
     requires: [{stat: "forest_shrine"}, {stat: "stealth", needed: 4}],
     costs: [{stat: "rations", amount: 6}]},
    {id: "barn", group: "The Greenwood", name: "Burn the Lord's Tithe Barn", glyph: "forge", months: 6, rank: "", each: "", path: "renegade", fromAge: 23, finishBy: 26, uses: 1, unless: "pardon",
     gains: [{stat: "renown", amount: 2}, {stat: "barn_burned"}],
     requires: [{stat: "arms", needed: 4}, {stat: "stealth", needed: 4}]},
    {id: "pilgrims", group: "The Greenwood", name: "Guide Pilgrims Through the Wood", glyph: "adventure", months: 6, rank: "", each: "", path: "renegade", fromAge: 23, finishBy: 26, uses: 1,
     gains: [{stat: "coin", amount: 20}, {stat: "renown"}],
     requires: [{stat: "lore", needed: 1}]},
    {id: "pardon", group: "The Greenwood", name: "Answer the Lord's Pardon", glyph: "seal", months: 1, rank: "", each: "", path: "renegade", fromAge: 24, finishBy: 25, uses: 1, unless: ["barn", "plague.sell"],
     about: "The Lord offers it once, to an outlaw the town speaks well of. He may serve at the Keep and walk its patrols from twenty-five. The Greenwood will not be his to hold.",
     gains: [{stat: "pardoned"}],
     requires: [{stat: "renown", needed: 3}],
     costs: [{stat: "renown", amount: 2}]},

    // The Plague Year, the month he is twenty-three, in every life and for every class: nine
    // months to begin an answer, one answer
    {id: "plague.tend", group: "The Plague Year", name: "Tend the Sick", glyph: "vitality", months: 3, rank: "", each: "THE PLAGUE", path: "", fromAge: 23, finishBy: 23, finishMonths: 11, showFrom: 0, uses: 1, event: "plague", unless: ["plague.shut", "plague.sell"],
     about: "The chapel is a sickhouse and there are not enough hands. It costs him some of his own health, and the chapel's windows cost him nothing to glaze, this life.",
     gains: [{stat: "renown"}, {stat: "lore"}, {stat: "plague_stayed"}],
     requires: [{stat: "letters", label: "Letters, or Lore", anyOf: ["letters", "lore"]}],
     costs: [{stat: "vit", amount: 5}]},
    {id: "plague.shut", group: "The Plague Year", name: "Shut Your Door", glyph: "town", months: 0, rank: "", each: "THE PLAGUE", path: "", fromAge: 23, finishBy: 23, finishMonths: 8, showFrom: 0, uses: 1, event: "plague", unless: ["plague.tend", "plague.sell"],
     about: "A bar across the door and a year's flour in the cellar. Nothing is lost, and nothing is gained.",
     gains: [{stat: "plague_shut"}],
     requires: []},
    {id: "plague.sell", group: "The Plague Year", name: "Sell Remedies Dear", glyph: "gold", months: 3, rank: "", each: "THE PLAGUE", path: "", fromAge: 23, finishBy: 23, finishMonths: 11, showFrom: 0, uses: 1, event: "plague", unless: ["plague.tend", "plague.shut"],
     about: "Wortleaf is worth its weight this year. The Church will not ordain a man who sold it so, nor the Lord pardon him. A guild clerk finds him easier to believe.",
     gains: [{stat: "coin", amount: 40}, {stat: "plague_profiteer"}],
     requires: [],
     costs: [{stat: "wortleaf", amount: 6}]},

    // The Old Lord Dies, the month he is twenty-seven: nine months, one answer. Three of them ask
    // what only a class gives: who holds none sees them and can do none, which shows what
    // another life could do here. The fourth asks nothing and brings nothing: he kneels with
    // the rest of the town, and has answered
    {id: "lord.keep", group: "The Old Lord Dies", name: "Stand for the Keep at the Succession", glyph: "seal", months: 3, rank: "", each: "THE SUCCESSION", path: "", fromAge: 27, finishBy: 27, finishMonths: 11, showFrom: 0, uses: 1, event: "lord", unless: ["lord.church", "lord.seize", "lord.kneel"],
     gains: [{stat: "renown", amount: 2}, {stat: "kingmaker"}],
     requires: [{stat: "veteran"}, {stat: "renown", needed: 5}]},
    {id: "lord.church", group: "The Old Lord Dies", name: "Petition the Church to Hold the Keep", glyph: "study", months: 3, rank: "", each: "THE SUCCESSION", path: "", fromAge: 27, finishBy: 27, finishMonths: 11, showFrom: 0, uses: 1, event: "lord", unless: ["lord.keep", "lord.seize", "lord.kneel"],
     gains: [{stat: "lore"}, {stat: "renown"}, {stat: "church_candidate"}],
     requires: [{stat: "ordained", label: "Ordained, or a Magister", anyOf: ["ordained", "magister"]}],
     costs: [{stat: "coin", amount: 20}]},
    {id: "lord.seize", group: "The Old Lord Dies", name: "Seize the Interregnum", glyph: "gold", months: 3, rank: "", each: "THE SUCCESSION", path: "", fromAge: 27, finishBy: 27, finishMonths: 11, showFrom: 0, uses: 1, event: "lord", unless: ["lord.keep", "lord.church", "lord.kneel"],
     gains: [{stat: "coin", amount: 60}, {stat: "interregnum"}],
     requires: [{stat: "band", label: "A band of his own, or the Bellmoor job planned", anyOf: ["band", "great_job_planned"]}]},
    {id: "lord.kneel", group: "The Old Lord Dies", name: "Kneel to the Heir", glyph: "town", months: 0, rank: "", each: "THE SUCCESSION", path: "", fromAge: 27, finishBy: 27, finishMonths: 8, showFrom: 0, uses: 1, event: "lord", unless: ["lord.keep", "lord.church", "lord.seize"],
     about: "A knee in the mud of the Keep's yard, among everyone else's. Nothing closes, and nothing opens.",
     gains: [{stat: "heir_sworn"}],
     requires: []},

    // A second calling, from twenty-nine, in a town whose Inn stands (`onlyWith`; his prime runs
    // to fifty there, lib.pg's `primeEnd`, unless he was thirty before it stood: `longPrime`):
    // two ways for each class, one or the other, each a year, each asking what the class's own
    // years gave. Its path is the class's: he sees his
    // two, locked, from the day he is of the class (`showAge`), as a child sees the classes.
    // No event left unanswered shuts them. Then five works a calling, in the
    // same shape: its bread, its choice, its moment, and a work of two years from forty-two.
    // The Greenwood has none yet
    {id: "castellan", group: "A second calling", name: "Take the Castellan's Keys", glyph: "seal", months: 12, rank: "", each: "", path: "warrior", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "cross", major: true,
     about: "The warrior who stays. The keys of Bellmoor's walls, its militia and its gates are his, and everything he does from here feeds the town.",
     gains: [{stat: "discipline"}, {stat: "renown"}, {stat: "castellan"}],
     requires: [{stat: "veteran"}, {stat: "arms", needed: 6}, {stat: "discipline", needed: 4}],
     costs: [{stat: "coin", amount: 20}]},
    {id: "cross", group: "A second calling", name: "Take the Cross", glyph: "swordsmanship", months: 12, rank: "", each: "", path: "warrior", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "castellan", major: true,
     about: "The warrior who leaves. He is the Church's sword on the marches, and whatever the woodfolk are, he is sent against them.",
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "crusader"}],
     requires: [{stat: "veteran"}, {stat: "arms", needed: 6}, {stat: "renown", needed: 3}]},
    {id: "harrowstudy", group: "A second calling", name: "Found the Harrow Study", glyph: "relic", months: 12, rank: "", each: "", path: "mage", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "chair", major: true,
     about: "The mage who studies the curse itself: its relics, its two accounts, and at last its seals. The slowest calling, and the dearest.",
     gains: [{stat: "lore"}, {stat: "curse_breaker"}],
     requires: [{stat: "collegium"}, {stat: "lore", needed: 7}, {stat: "arcana", needed: 4}],
     costs: [{stat: "coin", amount: 40}]},
    {id: "chair", group: "A second calling", name: "Take the Elemental Chair", glyph: "magic", months: 12, rank: "", each: "", path: "mage", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "harrowstudy", major: true,
     about: "The mage who makes spells: he binds the elements one by one, and writes down what he bound. In a fight, Frostbind costs a beast its next move.",
     gains: [{stat: "arcana"}, {stat: "spellwright"}],
     requires: [{stat: "collegium"}, {stat: "arcana", needed: 5}],
     costs: [{stat: "coin", amount: 30}]},
    {id: "contract", group: "A second calling", name: "Take the Black Contract", glyph: "skull", months: 12, rank: "", each: "", path: "thief", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "seachart", major: true,
     about: "Contracts against named people of the town. Each is paid in coin, and each is someone Bellmoor will miss.",
     gains: [{stat: "stealth"}, {stat: "assassin"}],
     requires: [{stat: "hidden_hand"}, {stat: "stealth", needed: 6}, {stat: "guile", needed: 5}],
     costs: [{stat: "favors", amount: 2}]},
    {id: "seachart", group: "A second calling", name: "Buy the Sea Chart", glyph: "adventure", months: 12, rank: "", each: "", path: "thief", fromAge: 29, showAge: 16, finishBy: 33, showFrom: 0, uses: 1, onlyWith: "town.inn", longPrime: true, unless: "contract", major: true,
     about: "Far roads, maps, and what lies at the end of them. On any walk, whoever scouts ahead finds a beast two days sooner.",
     gains: [{stat: "dex"}, {stat: "adventurer"}],
     requires: [{stat: "hidden_hand"}, {stat: "dex", needed: 9}],
     costs: [{stat: "coin", amount: 60}]},
    {id: "militia", group: "Defender of Bellmoor", name: "Drill the Militia", glyph: "training", months: 9, rank: "", each: "", path: "warrior", fromAge: 31, uses: 3,
     gains: [{stat: "discipline"}, {stat: "coin", amount: 12}],
     requires: [{stat: "castellan"}]},
    {id: "walls", group: "Defender of Bellmoor", name: "Raise the Walls", glyph: "gate", months: 12, rank: "", each: "", path: "warrior", fromAge: 32, uses: 1,
     gains: [{stat: "walls_raised"}],
     requires: [{stat: "castellan"}],
     costs: [{stat: "stone", amount: 30}, {stat: "ashwood", amount: 20}, {stat: "coin", amount: 40}]},
    {id: "gates.open", group: "Defender of Bellmoor", name: "Open the Gates to the Refugees", glyph: "gate", months: 3, rank: "", each: "", path: "warrior", fromAge: 35, finishBy: 38, uses: 1, unless: "gates.close",
     gains: [{stat: "renown", amount: 2}, {stat: "bellmoor_shield"}],
     requires: [{stat: "castellan"}],
     costs: [{stat: "rations", amount: 20}]},
    {id: "gates.close", group: "Defender of Bellmoor", name: "Close the Gates", glyph: "gate", months: 3, rank: "", each: "", path: "warrior", fromAge: 35, finishBy: 38, uses: 1, unless: "gates.open",
     gains: [{stat: "coin", amount: 20}, {stat: "shut_gate"}],
     requires: [{stat: "castellan"}]},
    {id: "siege", group: "Defender of Bellmoor", name: "Hold Bellmoor Against the Siege", glyph: "seal", months: 24, rank: "", each: "RATIONS UP FRONT", path: "warrior", fromAge: 42, showAge: 31, showFrom: 0, board: true, uses: 1, onlyWith: "castellan", major: true,
     gains: [{stat: "coin", amount: 100}, {stat: "wall_held"}],
     requires: [{stat: "castellan"}, {stat: "arms", needed: 8}, {stat: "discipline", needed: 7}, {stat: "renown", needed: 6}, {stat: "walls_raised"}]},
    {id: "marches", group: "Crusader", name: "March to the Marches", glyph: "swordsmanship", months: 12, rank: "", each: "", path: "warrior", fromAge: 31, uses: 3,
     gains: [{stat: "arms"}, {stat: "coin", amount: 30}],
     requires: [{stat: "crusader"}],
     costs: [{stat: "rations", amount: 10}]},
    {id: "woodfolk.burn", group: "Crusader", name: "Burn the Woodfolk Camp", glyph: "forge", months: 9, rank: "", each: "", path: "warrior", fromAge: 33, finishBy: 37, uses: 1, unless: "woodfolk.spare",
     gains: [{stat: "renown", amount: 2}, {stat: "zealot"}],
     requires: [{stat: "crusader"}, {stat: "arms", needed: 7}]},
    {id: "woodfolk.spare", group: "Crusader", name: "Spare the Woodfolk", glyph: "adventure", months: 9, rank: "", each: "", path: "warrior", fromAge: 33, finishBy: 37, uses: 1, unless: "woodfolk.burn",
     gains: [{stat: "lore"}, {stat: "doubts"}],
     requires: [{stat: "crusader"}, {stat: "arms", needed: 7}]},
    {id: "relicfront", group: "Crusader", name: "Bear the Relic to the Front", glyph: "relic", months: 6, rank: "", each: "", path: "warrior", fromAge: 36, finishBy: 40, uses: 1,
     gains: [{stat: "renown", amount: 2}, {stat: "relic_bearer"}],
     requires: [{stat: "crusader"}, {stat: "town.harrow", label: "The Harrow shrine, in town", needed: 3}]},
    {id: "crusade", group: "Crusader", name: "Lead the Crusade", glyph: "seal", months: 24, rank: "", each: "RATIONS UP FRONT", path: "warrior", fromAge: 42, showAge: 31, showFrom: 0, board: true, uses: 1, onlyWith: "crusader", major: true,
     gains: [{stat: "coin", amount: 300}, {stat: "crusader_king"}],
     requires: [{stat: "crusader"}, {stat: "arms", needed: 9}, {stat: "discipline", needed: 6}, {stat: "renown", needed: 8}]},
    {id: "relics", group: "Curse-breaker", name: "Gather the Relics", glyph: "relic", months: 9, rank: "", each: "", path: "mage", fromAge: 31, uses: 3,
     gains: [{stat: "lore"}, {stat: "relics"}],
     requires: [{stat: "curse_breaker"}],
     costs: [{stat: "reagents", amount: 10}, {stat: "rations", amount: 6}]},
    {id: "accounts", group: "Curse-breaker", name: "Compare the Two Accounts", glyph: "study", months: 6, rank: "", each: "", path: "mage", fromAge: 33, uses: 1,
     gains: [{stat: "lore", amount: 2}, {stat: "whole_story"}],
     requires: [{stat: "curse_breaker"}, {stat: "engines_seen", label: "Seen the lost engines, or the other account", anyOf: ["engines_seen", "other_account"]}]},
    {id: "selftest", group: "Curse-breaker", name: "Test the Working on Yourself", glyph: "magic", months: 12, rank: "", each: "", path: "mage", fromAge: 36, finishBy: 40, uses: 1,
     gains: [{stat: "arcana", amount: 2}, {stat: "working_marked"}],
     requires: [{stat: "curse_breaker"}, {stat: "arcana", needed: 6}],
     costs: [{stat: "vit", amount: 15}, {stat: "vitmax", amount: 5}]},
    {id: "seal", group: "Curse-breaker", name: "Break the First Seal", glyph: "magic", months: 24, rank: "", each: "RATIONS UP FRONT", path: "mage", fromAge: 42, showAge: 31, showFrom: 0, board: true, uses: 1, onlyWith: "curse_breaker", major: true,
     gains: [{stat: "first_seal"}],
     requires: [{stat: "curse_breaker"}, {stat: "arcana", needed: 8}, {stat: "lore", needed: 9}, {stat: "relics", needed: 3}, {stat: "whole_story"}],
     costs: [{stat: "reagents", amount: 20}]},
    // Each element bound is a spell of his: the third and the fourth are ones a fight can use
    // (expeditiontable.pg's `walkTechniques`); the first two wait for what a fight cannot do yet
    {id: "bind", group: "Spellwright", name: "Bind an Element", glyph: "magic", months: 9, rank: "", each: "", path: "mage", fromAge: 31, uses: 4,
     gains: [{stat: "arcana"}, {stat: "elements"}],
     requires: [{stat: "spellwright"}],
     costs: [{stat: "reagents", amount: 6}],
     after: [{uses: 1, effects: [{stat: "stoneskin_bound"}], entry: "Stone skin is bound"}, {uses: 2, effects: [{stat: "galestep_bound"}], entry: "Gale step is bound"},
             {uses: 3, effects: [{stat: "firebolt2_bound"}], entry: "The second firebolt is bound"}, {uses: 4, effects: [{stat: "chain_bound"}], entry: "Chain lightning is bound"}]},
    {id: "write", group: "Spellwright", name: "Write the Spell Down", glyph: "quill", months: 6, rank: "", each: "", path: "mage", fromAge: 33, uses: 4,
     gains: [{stat: "spells_written"}],
     requires: [{stat: "spellwright"}, {stat: "elements", label: "An element bound"}],
     costs: [{stat: "coin", amount: 10}]},
    {id: "spell.sell", group: "Spellwright", name: "Sell a Spell to the Keep", glyph: "gold", months: 3, rank: "", each: "", path: "mage", fromAge: 36, finishBy: 39, uses: 1, unless: "spell.keep",
     gains: [{stat: "coin", amount: 80}, {stat: "court_mage"}],
     requires: [{stat: "spellwright"}, {stat: "spells_written", label: "A spell written down"}]},
    {id: "spell.keep", group: "Spellwright", name: "Keep the Spells Secret", glyph: "academy", months: 3, rank: "", each: "", path: "mage", fromAge: 36, finishBy: 39, uses: 1, unless: "spell.sell",
     gains: [{stat: "arcana"}, {stat: "sealed_library"}],
     requires: [{stat: "spellwright"}, {stat: "spells_written", label: "A spell written down"}]},
    {id: "grand", group: "Spellwright", name: "Forge the Grand Working", glyph: "magic", months: 24, rank: "", each: "RATIONS UP FRONT", path: "mage", fromAge: 42, showAge: 31, showFrom: 0, board: true, uses: 1, onlyWith: "spellwright", major: true,
     gains: [{stat: "grand_working"}],
     requires: [{stat: "spellwright"}, {stat: "arcana", needed: 9}, {stat: "elements", label: "Elements bound", needed: 3}],
     costs: [{stat: "reagents", amount: 30}]},
    {id: "markstudy", group: "Assassin", name: "Study the Mark", glyph: "town", months: 3, rank: "", each: "A LEAD", path: "thief", fromAge: 31, uses: 3,
     gains: [{stat: "marks_studied"}],
     requires: [{stat: "assassin"}]},
    {id: "kill.guild", group: "Assassin", name: "Kill the Guild Master", glyph: "skull", months: 9, rank: "", each: "", path: "thief", fromAge: 32, uses: 1,
     gains: [{stat: "coin", amount: 80}, {stat: "kills"}],
     requires: [{stat: "assassin"}, {stat: "stealth", needed: 7}, {stat: "marks_studied", label: "A mark studied"}],
     costs: [{stat: "favors", amount: 1}]},
    {id: "kill.captain", group: "Assassin", name: "Kill the Captain", glyph: "skull", months: 9, rank: "", each: "", path: "thief", fromAge: 32, fromMonths: 4, uses: 1,
     gains: [{stat: "coin", amount: 80}, {stat: "kills"}],
     requires: [{stat: "assassin"}, {stat: "stealth", needed: 7}, {stat: "marks_studied", label: "Marks studied", needed: 2}],
     costs: [{stat: "favors", amount: 1}]},
    {id: "kill.magister", group: "Assassin", name: "Kill the Magister", glyph: "skull", months: 9, rank: "", each: "", path: "thief", fromAge: 32, fromMonths: 8, uses: 1,
     gains: [{stat: "coin", amount: 80}, {stat: "kills"}],
     requires: [{stat: "assassin"}, {stat: "stealth", needed: 7}, {stat: "marks_studied", label: "Marks studied", needed: 3}],
     costs: [{stat: "favors", amount: 1}]},
    {id: "refuse", group: "Assassin", name: "Refuse the Lord's Contract", glyph: "seal", months: 1, rank: "", each: "", path: "thief", fromAge: 36, finishBy: 38, uses: 1,
     gains: [{stat: "own_counsel"}],
     requires: [{stat: "assassin"}],
     costs: [{stat: "coin", amount: 40}]},
    {id: "lordsblood", group: "Assassin", name: "The Lord's Blood", glyph: "skull", months: 24, rank: "", each: "", path: "thief", fromAge: 42, showAge: 31, showFrom: 0, uses: 1, onlyWith: "assassin", major: true,
     gains: [{stat: "coin", amount: 400}, {stat: "regicide"}],
     requires: [{stat: "assassin"}, {stat: "stealth", needed: 9, eased: {flag: "own_counsel", needed: 8}}, {stat: "guile", needed: 7}, {stat: "kills", label: "Contracts kept", needed: 2}],
     costs: [{stat: "favors", amount: 3}]},
    {id: "farroads", group: "Adventurer", name: "Walk the Far Roads", glyph: "adventure", months: 12, rank: "", each: "", path: "thief", fromAge: 31, uses: 3,
     gains: [{stat: "dex"}, {stat: "lore"}, {stat: "far_walks"}],
     requires: [{stat: "adventurer"}],
     costs: [{stat: "rations", amount: 12}]},
    {id: "drawmap", group: "Adventurer", name: "Draw the Map", glyph: "quill", months: 3, rank: "", each: "", path: "thief", fromAge: 33, uses: 3,
     gains: [{stat: "maps_drawn"}],
     requires: [{stat: "adventurer"}, {stat: "far_walks", label: "A far road walked"}]},
    {id: "porters", group: "Adventurer", name: "Hire the Porters", glyph: "work", months: 1, rank: "", each: "HALF AGAIN, EVERY WALK", path: "thief", fromAge: 35, finishBy: 38, uses: 1,
     gains: [{stat: "porters"}],
     requires: [{stat: "adventurer"}],
     costs: [{stat: "coin", amount: 50}]},
    {id: "firstcity", group: "Adventurer", name: "Find the First City", glyph: "relic", months: 24, rank: "", each: "", path: "thief", fromAge: 42, showAge: 31, showFrom: 0, uses: 1, onlyWith: "adventurer", major: true,
     gains: [{stat: "coin", amount: 200}, {stat: "first_city"}],
     requires: [{stat: "adventurer"}, {stat: "dex", needed: 10}, {stat: "lore", needed: 5}, {stat: "far_walks", label: "Far roads walked", needed: 3}],
     costs: [{stat: "rations", amount: 20}]},

    // What is left to an old man, whatever he was: nothing closes it, and it asks nothing. Listed
    // a year before his prime ends, so its last months, too short for any other work, are never
    // without something to do
    {id: "tales", group: "Old age", name: "Tell Tales at the Inn", glyph: "town", months: 2, rank: "", each: "RATIONS UP FRONT", path: "", board: true, fromAge: lastAge - 1, finishBy: anyAge,
     gains: [{stat: "coin", amount: 2}],
     requires: [],
     bonus: [{stat: "town.inn", fromAge: 26}]},
    {id: "garden", group: "Old age", name: "Tend a Garden", glyph: "work", months: 3, rank: "", each: "", path: "", fromAge: lastAge - 1, fromMonths: 4, finishBy: anyAge,
     gains: [{stat: "rations", amount: 4}],
     requires: []},
    {id: "teach", group: "Old age", name: "Teach the Young", glyph: "academy", months: 4, rank: "", each: "", path: "", fromAge: lastAge - 1, fromMonths: 8, finishBy: anyAge,
     gains: [{stat: "coin", amount: 6}],
     requires: [],
     bonus: [{stat: "town.chapel", needed: 3, more: [{stat: "coin", amount: 4}]}]},

    // The tests' story (storytable.pg's `trial`, lifescene.cc): listed for no life but one that
    // holds `test.stories`. Its months are the story's, and it feeds him as a class's board does
    {id: "story.trial", group: "A story", name: "Sit the Trial", glyph: "study", months: 4, rank: "", each: "RATIONS UP FRONT", path: "", board: true,
     fromAge: 6, finishBy: anyAge, showFrom: 0, uses: 1, onlyWith: "test.stories", story: "trial",
     gains: [],
     requires: []}
]

// The walks outside the town, one a zone, made from expeditiontable.pg: a row of the Adventure
// group like any other, with its months up front (the way there, the stay and the way back) and
// what it asks. Beginning one opens the on-site screen (`zone`); the months run once he is home.
// It is listed two years before he may go, locked: what it asks is something to plan toward
// (a zone may ask to be hidden until he has what it asks: its `showFrom`, as an activity's).
// The group stands right under his work on the Life page, before the market's rows of the table
var walkRows = []

for (var z = 0; z < len(walkZones); z++)
{
    var zone = walkZones[z]
    var studies = statOf(character, "know.study." + zone.id)

    // What a lead gives of it: the zone is his from a younger age with that flag (its `sooner`)
    var sooner = []

    if (has(zone, "sooner"))
    {
        sooner = [{stat: zone.sooner.flag, fromAge: zone.sooner.fromAge}]
    }

    push(walkRows, {id: "walk." + zone.id, group: "Adventure", name: zone.name, glyph: zone.glyph, months: walkMonths(zone, studies, statOf(character, "roads_known")), rank: "",
                    each: toUpperCase(zone.kind) + " · " + toString(walkStay(zone, studies)) + " DAYS ON SITE", path: "",
                    fromAge: zone.fromAge, showAge: lookup(zone, "showAge", zone.fromAge - 2), showFrom: lookup(zone, "showFrom", 0), showAfter: lookup(zone, "showAfter", 0), zone: zone.id, about: zone.opens,
                    gains: [], requires: entriesCopied(zone.requires), bonus: sooner})
}

var tabled = activities
var walksPlaced = false

// What he gathers by hand stands right after the last of the Work rows. Each is a copy, with its
// own lists, as a row is written to on every run and the table it comes from is not
var lastWork = -1

for (var t = 0; t < len(tabled); t++)
{
    if (tabled[t].group == "Work")
    {
        lastWork = t
    }
}

var scavenges = entriesCopied(scavengeRows)

for (var s = 0; s < len(scavenges); s++)
{
    scavenges[s].gains = entriesCopied(scavenges[s].gains)
    scavenges[s].requires = entriesCopied(scavenges[s].requires)
}

var storeCopies = entriesCopied(storeRows)

for (var s = 0; s < len(storeCopies); s++)
{
    storeCopies[s].gains = entriesCopied(storeCopies[s].gains)
    storeCopies[s].requires = entriesCopied(storeCopies[s].requires)
    storeCopies[s].costs = entriesCopied(storeCopies[s].costs)
}

// A familiar is bound to him for life, one row a kind: it costs what the kind's bind asks and
// fills a slot: while no slot is free, no bind row is listed. The first known kind waits for the
// second scavenge, so it comes once he has worked the land twice; a kind he has not learned is
// not listed. The row says what the creature eats and makes, its tile in short and its gloss in a
// sentence, so that the upkeep is known before he binds it.
var bindCopies = []
var firstKind = true

for (var k = 0; k < len(familiarKinds); k++)
{
    var kind = familiarKinds[k]
    var kindRequires = [{stat: "slot", label: "A free slot", needed: 1, slot: true}]

    var bindRow = {id: "bind." + kind.id, group: "Familiars", name: "Bind " + kind.name, glyph: kind.glyph, months: 1, rank: "", each: upkeepCaption(kind), path: "",
                   fromAge: 7,
                   about: kind.about + " Bound for life: he cannot send it away. " + upkeepSentence(kind),
                   gains: [{stat: "fam." + kind.id}],
                   costs: entriesCopied(kind.bind),
                   requires: kindRequires}

    if (kind.known and firstKind)
    {
        push(kindRequires, {stat: "scavenged", needed: 2})
        firstKind = false
    }

    // A kind that is not his has no row: it waits for what the world learns of it ("know.fam.<id>").
    // A level of the town that teaches it makes it his as well (lib.pg's `kindKnown`), and its row
    // is the same one
    if (not kindKnown(character, kind))
    {
        bindRow.onlyWith = "know.fam." + kind.id
    }

    push(bindCopies, bindRow)
}

// A bound familiar can be taught twice in a life: each lesson costs a month of what the kind eats
// and raises by one what each of that kind makes of the first thing it makes (the stat
// "more.<stat>", which lib.pg's `feedFamiliars` adds to the yield). Its gloss says so in words.
var trainCopies = []

for (var k = 0; k < len(familiarKinds); k++)
{
    var teach = familiarKinds[k]

    push(trainCopies, {id: "train." + teach.id, group: "Familiars", name: teach.train, glyph: teach.glyph, months: 2, rank: "", each: "MAKES MORE", path: "",
                       fromAge: 7, uses: 2, onlyWith: "fam." + teach.id,
                       about: "He shows " + teach.name + " a better way to its work. " + lessonSentence(teach),
                       gains: [{stat: "more." + teach.makes[0].stat}],
                       costs: entriesCopied(teach.eats),
                       requires: []})
}

for (var k = 0; k < len(trainCopies); k++)
{
    push(bindCopies, trainCopies[k])
}

// What the stash keeps of a basic (the stat "stash.<id>", the world's: what lives before him
// held at their death) is drawn on the spot, as much as he has room for and no more. A row for
// each basic the stash has some of. Full, he has no room: the row asks room for one, and its room
// closes it. Its caption says what the stash holds; what a draw takes is its price, named as taken
// from the stash, so the two are not read as one.
// Once the town is his, the stash is drawn at the storehouse (towntable.pg): the row has its
// `place`, and stands on the Town page under it. Before, it has none and stands on the Life page,
// as a row with a place would have no row at all until the town is known.
var drawCopies = []

for (var b = 0; b < len(basicResources); b++)
{
    var drawn = basicResources[b]
    var kept = statOf(character, "stash." + drawn.id)
    var take = roomFor(character, drawn.id)

    if (kept < take)
    {
        take = kept
    }

    if (take < 1)
    {
        take = 1
    }

    var drawRow = {id: "draw." + drawn.id, group: "The stash", name: "Take " + toLowerCase(drawn.name) + " from the stash", glyph: drawn.glyph, months: 0, rank: "", each: toString(kept) + " IN THE STASH", path: "",
                      fromAge: 6, finishBy: anyAge, onlyWith: "stash." + drawn.id,
                      about: "What the lives before him kept of it at their death. He takes as much as he has room for, and the rest stays for the lives after him.",
                      gains: [{stat: drawn.id, amount: take}],
                      costs: [{stat: "stash." + drawn.id, amount: take, name: drawn.name + " from the stash"}],
                      requires: []}

    if (statOf(character, "town_known") > 0)
    {
        drawRow.place = "storehouse"
    }

    push(drawCopies, drawRow)
}

// And berries dried keep as rations, at home, with or without the town: three to a ration, a
// little more than they would buy sold (three berries sell for 0.6 coin, a ration costs about
// 0.8). It stands with what he gathers by hand, so that a sprite's berries feed him before he has
// a market to sell them at. Its row waits for his first berries (`onlyWith`: no line of the
// tooltip asks for them besides its cost).
var drying = {id: "dry.berries", group: "Scavenge", name: "Dry berries", glyph: "trade", months: 0, rank: "", each: "INTO RATIONS", path: "",
              trade: "make",
              finishBy: anyAge, onlyWith: "berries",
              about: "Spread on a cloth in the sun for a week, they keep through the winter.",
              gains: [{stat: "rations", amount: 1}], requires: [],
              costs: [{stat: "berries", amount: 3}]}

activities = []

for (var t = 0; t < len(tabled); t++)
{
    if (not walksPlaced and tabled[t].group == "Market")
    {
        for (var w = 0; w < len(walkRows); w++)
        {
            push(activities, walkRows[w])
        }

        walksPlaced = true
    }

    push(activities, tabled[t])

    if (t == lastWork)
    {
        for (var s = 0; s < len(scavenges); s++)
        {
            push(activities, scavenges[s])
        }

        push(activities, drying)

        for (var s = 0; s < len(storeCopies); s++)
        {
            push(activities, storeCopies[s])
        }

        for (var s = 0; s < len(bindCopies); s++)
        {
            push(activities, bindCopies[s])
        }

        for (var s = 0; s < len(drawCopies); s++)
        {
            push(activities, drawCopies[s])
        }
    }
}

if (not walksPlaced)
{
    for (var w = 0; w < len(walkRows); w++)
    {
        push(activities, walkRows[w])
    }
}

// What a walk brings home to sell is sold at the market, a lot at a time, while he holds any
for (var w = 0; w < len(walkItems); w++)
{
    var thing = walkItems[w]

    if (thing.kind == "sold")
    {
        push(activities, {id: "sell." + thing.id, group: "Market", name: "Sell " + toLowerCase(thing.name), glyph: "gold", months: 0, rank: "", each: "AT THE MARKET", path: "",
                          finishBy: anyAge, showFrom: 100, place: "market", trade: "sell",
                          gains: [{stat: "coin", amount: thing.coin}],
                          requires: [{stat: thing.id, label: thing.name + " to sell"}],
                          costs: [{stat: thing.id, amount: thing.lot}]})
    }
}

// The basics the market trades: a lot sold for its coin (berries already sell above, with what a
// walk brings home), and water, firewood and stone bought a lot for its price once the town is
// known
for (var b = 0; b < len(basicResources); b++)
{
    var basic = basicResources[b]

    if (lookup(basic, "lot", 0) > 0)
    {
        push(activities, {id: "sell." + basic.id, group: "Market", name: "Sell " + toLowerCase(basic.name), glyph: "gold", months: 0, rank: "", each: "AT THE MARKET", path: "",
                          finishBy: anyAge, showFrom: 100, place: "market", trade: "sell",
                          gains: [{stat: "coin", amount: basic.coin}],
                          requires: [{stat: basic.id, label: basic.name + " to sell"}],
                          costs: [{stat: basic.id, amount: basic.lot}]})

        if (lookup(basic, "price", 0) > 0)
        {
            push(activities, {id: "buy." + basic.id, group: "Market", name: "Buy " + toLowerCase(basic.name), glyph: basic.glyph, months: 0, rank: "", each: "AT THE MARKET", path: "",
                              finishBy: anyAge, showFrom: 100, place: "market", trade: "buy",
                              gains: [{stat: basic.id, amount: basic.lot}],
                              requires: [{stat: "town_known", label: "The town"}],
                              costs: [{stat: "coin", amount: basic.price}]})
        }
    }
}

// And wortleaf is what a remedy is made of
push(activities, {id: "brew.remedy", group: "Market", name: "Brew a remedy", glyph: "vitality", months: 0, rank: "", each: "FROM WORTLEAF", path: "",
                  finishBy: anyAge, showFrom: 100, place: "market", trade: "make",
                  gains: [{stat: "remedy", amount: 1}],
                  requires: [{stat: "wortleaf", label: "Wortleaf to brew"}],
                  costs: [{stat: "wortleaf", amount: 2}, {stat: "water", amount: 1}]})

// What a fight spends: a fire flask mixed of firewood a walk brought home, and the chapel's oil
push(activities, {id: "brew.flask", group: "Market", name: "Mix a fire flask", glyph: "magic", months: 0, rank: "", each: "FROM FIREWOOD", path: "",
                  finishBy: anyAge, showFrom: 100, place: "market", trade: "make",
                  about: "Firewood burned down to tar in a clay bottle, and a rag to light it. Thrown in a fight, it burns whatever it breaks on, hide or no hide.",
                  gains: [{stat: "flask", amount: 1}],
                  requires: [{stat: "firewood", label: "Firewood to mix"}],
                  costs: [{stat: "firewood", amount: 2}, {stat: "coin", amount: 2}]})

push(activities, {id: "buy.oil", group: "Market", name: "Buy blessed oil", glyph: "relic", months: 0, rank: "", each: "FROM THE CHAPEL", path: "",
                  finishBy: anyAge, showFrom: 100, place: "market", trade: "buy", onlyWith: "walked.millpond",
                  about: "A small flask the chapel blesses for travellers. On a blade, every blow of the fight is holy.",
                  gains: [{stat: "oil", amount: 1}],
                  requires: [{stat: "town_known", label: "The town"}],
                  costs: [{stat: "coin", amount: 4}]})

// What the smithy forges of resources (economytable.pg's `gearPieces`), a piece once a life: it
// stands on the Town page under the smithy once the smithy has the level the piece asks, shut
// while he lacks what it is made of. A piece whose forge names `onlyWith` waits for that stat as
// well (the warded charm, for the Marsh's workings). Each is a copy, with its own lists
for (var g = 0; g < len(gearPieces); g++)
{
    var piece = gearPieces[g]
    var forgeRow = {id: "forge." + piece.id, group: "Market", name: "Forge " + toLowerCase(piece.name), glyph: piece.glyph, months: piece.forge.months, rank: "", each: "AT THE SMITHY", path: "",
                    finishBy: anyAge, showFrom: 100, uses: 1, place: "smithy",
                    about: piece.about,
                    gains: [{stat: "gear." + piece.id, amount: 1}],
                    requires: [{stat: "town.smithy", label: "The smithy, level " + toString(piece.forge.smithy), needed: piece.forge.smithy}],
                    costs: entriesCopied(piece.forge.costs)}

    if (has(piece.forge, "onlyWith"))
    {
        forgeRow.onlyWith = piece.forge.onlyWith
    }

    push(activities, forgeRow)
}

// The works that raise a place of the town, one a level, made from towntable.pg: the scene lists
// them on the Town page, under the places. Their months and their costs are what a life gives the town: the coin a
// level asks, less what earlier lives left to the place (its fund), and what else it takes
for (var t = 0; t < len(townPlaces); t++)
{
    var place = townPlaces[t]

    for (var l = 0; l < len(place.levels); l++)
    {
        var step = place.levels[l]
        var asked = []
        var coin = levelCoin(step, character) - statOf(character, "fund." + place.id)

        if (coin > 0)
        {
            push(asked, {stat: "coin", amount: coin})
        }

        var also = listOf(step, "costs")

        // (and of what else was left to the place: "fund.<place>.<thing>")
        for (var c = 0; c < len(also); c++)
        {
            var need = also[c].amount - statOf(character, "fund." + place.id + "." + also[c].stat)

            if (need > 0)
            {
                push(asked, {stat: also[c].stat, amount: need})
            }
        }

        var says = "FOR THE TOWN"

        if (lookup(step, "years", 0) > 0)
        {
            says = "COSTS " + toString(step.years) + " YEARS"
        }

        push(activities, {id: "raise." + place.id + "." + toString(l + 1), group: "The town", name: step.work, glyph: place.glyph, months: step.months, rank: "", each: says, path: "",
                          finishBy: anyAge, raises: place.id, level: l + 1, years: lookup(step, "years", 0),
                          gains: [], requires: [], costs: asked})
    }
}

// Whether he is one of any path yet
var committed = false

for (var p = 0; p < len(paths); p++)
{
    if (statOf(character, paths[p].flag) > 0)
    {
        committed = true
    }
}

var lived = monthOf(age)

// The rations a month eats, his own and his familiars', fed or not, as resources.pg counts them:
// what a fed work gives up front lasts that much less with familiars bound
var rationsEaten = economyKnobs.rationsAMonth

for (var fe = 0; fe < len(familiarKinds); fe++)
{
    var eater = familiarKinds[fe]

    for (var fm = 0; fm < len(eater.eats); fm++)
    {
        if (eater.eats[fm].stat == "rations")
        {
            rationsEaten = rationsEaten + statOf(character, "fam." + eater.id) * eater.eats[fm].amount
        }
    }
}

// The terms done in this life, of every activity: what a first life's list grows by
var termsDone = 0

for (var k : done)
{
    termsDone = termsDone + done[k]
}

// The table by id, now that it is whole: what a row says of another (the event it is shut by,
// what it follows, a window's activity) is looked up here rather than searched for. The first of
// an id, as a search would find it
var activityById = {}

for (var ai = 0; ai < len(activities); ai++)
{
    if (not contain(activityById, activities[ai].id))
    {
        activityById[activities[ai].id] = activities[ai]
    }
}

// The events he has stood by in this life (lib.pg's `lifeEvents`: he holds the flag of each
// since the month resources.pg settled it), and what each has shut: the id of a row -> the line
// of its event. Read from the whole table, before the forecast narrows it to its activity.
// `warnsOf` is what the answers of each event say ahead of it
var barredBy = {}
var warnsOf = {}

// The answers of each event, by its id, in the table's order: gathered once rather than searched
// for in the whole table by every event
var answersOf = {}

for (var w = 0; w < len(activities); w++)
{
    var answering = lookup(activities[w], "event", "")

    if (answering != "")
    {
        if (not contain(answersOf, answering))
        {
            answersOf[answering] = []
        }

        push(answersOf[answering], activities[w])
    }
}

for (var e = 0; e < len(lifeEvents); e++)
{
    var ev = lifeEvents[e]
    var answers = 0

    // Its answers: each brings one of the flags the event is answered by, and is over before
    // the month the event is settled
    var answerRows = lookup(answersOf, ev.id, [])

    for (var w = 0; w < len(answerRows); w++)
    {
        var answer = answerRows[w]

        answers = answers + 1

        var brings = false

        for (var g = 0; g < len(answer.gains); g++)
        {
            for (var f = 0; f < len(ev.answered); f++)
            {
                if (answer.gains[g].stat == ev.answered[f])
                {
                    brings = true
                }
            }
        }

        if (not brings)
        {
            push(errors, "activity " + answer.id + ": brings none of the flags the event " + ev.id + " is answered by")
        }

        if (lookup(answer, "finishBy", lastAge) * 12 + lookup(answer, "finishMonths", 0) >= ev.settledAt * 12 + ev.settledMonths)
        {
            push(errors, "activity " + answer.id + ": may end after the event " + ev.id + " is settled")
        }
    }

    if (answers == 0)
    {
        push(errors, "event " + ev.id + ": no activity answers it")
    }

    // What it shuts, by name, for the glosses of its answers; shut for good once he stood by
    var lost = []

    for (var s = 0; s < len(ev.shuts); s++)
    {
        var shutRow = lookup(activityById, ev.shuts[s], {id: ""})

        if (shutRow.id == "")
        {
            push(errors, "event " + ev.id + ": unknown activity " + ev.shuts[s])
        }
        else
        {
            push(lost, shutRow.name)
        }

        if (statOf(character, ev.stood) > 0)
        {
            barredBy[ev.shuts[s]] = ev.said
        }
    }

    var warns = "Leave " + ev.name + " unanswered, and "

    if (has(ev, "loses"))
    {
        warns = warns + ev.loses + "."
    }
    else if (len(lost) > 1)
    {
        warns = warns + namesText(lost) + " are closed to him for this life."
    }
    else
    {
        warns = warns + namesText(lost) + " is closed to him for this life."
    }

    warnsOf[ev.id] = warns
}

// Whether a way into a class can still be begun (a last resort is not one of them; nor is one
// the events he stood by have shut), and whether he is at one now
var waysLeft = false
var entering = false

for (var w = 0; w < len(activities); w++)
{
    var way = activities[w]

    if (lookup(way, "enters", false))
    {
        if (way.id == running)
        {
            entering = true
        }

        if (not lookup(way, "lastResort", false) and (lived + way.months) <= (lookup(way, "finishBy", lastAge) * 12))
        {
            waysLeft = true
        }
    }
}

// The forecast asks after one activity: only that one is shaped. The table whole, as it is
// written, stays in `tabledAll`: for what one activity says of another (its `unless`)
var tabledAll = activities

// What doing each activity closes, by its id: the names of the rows whose `unless` names it, in
// the table's order. Read off once a run: asked of every row about every other, it was most of
// the run (a `closedBy` for each pair)
var shutNames = {}

for (var cr = 0; cr < len(tabledAll); cr++)
{
    var closerRow = tabledAll[cr]

    if (contain(closerRow, "unless"))
    {
        var closerIds = asList(closerRow.unless)
        var closerSeen = {}

        for (var cu = 0; cu < len(closerIds); cu++)
        {
            var closedId = closerIds[cu]

            if (not contain(closerSeen, closedId))
            {
                closerSeen[closedId] = true

                if (not contain(shutNames, closedId))
                {
                    shutNames[closedId] = []
                }

                push(shutNames[closedId], closerRow.name)
            }
        }
    }
}

if (activityId != "")
{
    var shaped = []

    for (var i = 0; i < len(activities); i++)
    {
        if (activities[i].id == activityId)
        {
            push(shaped, activities[i])
        }
    }

    activities = shaped
}

// What each activity still asks of this character
for (var i = 0; i < len(activities); i++)
{
    var a = activities[i]
    var locked = false

    // How often it was done, and what repetition has made of it
    var count = lookup(done, a.id, 0)
    var uses = lookup(a, "uses", 0)
    var steps = listOf(a, "after")

    // An amount left out is 1: of what it brings and takes, and of what its steps do
    amountsOf(a, "gains")

    for (var s = 0; s < len(steps); s++)
    {
        var step = steps[s]

        amountsOf(step, "gains")
        amountsOf(step, "effects")

        if (count >= step.uses)
        {
            if (has(step, "rank"))
            {
                a.rank = step.rank
            }

            if (has(step, "months"))
            {
                a.months = step.months
            }

            if (has(step, "gains"))
            {
                a.gains = step.gains
            }
        }
    }

    // What a stat he holds, or the town, makes of it: every step that holds, in order (what their
    // `more` add, adds up). Its gloss says each step on a part or a skill of his, held or not,
    // against the work as it is without them
    var bonuses = listOf(a, "bonus")
    var plainMonths = a.months
    var plainGains = a.gains

    a.steps = []

    for (var b = 0; b < len(bonuses); b++)
    {
        var better = bonuses[b]

        amountsOf(better, "gains")

        var stepLine = bonusStepLabel(bonuses, b, plainMonths, plainGains)

        if (stepLine != "")
        {
            push(a.steps, {label: stepLine, reached: statOf(character, better.stat) >= lookup(better, "needed", 1)})
        }

        if (statOf(character, better.stat) >= lookup(better, "needed", 1))
        {
            for (var f = 0; f < len(bonusFields); f++)
            {
                if (has(better, bonusFields[f]))
                {
                    a[bonusFields[f]] = better[bonusFields[f]]
                }
            }

            // And what it adds to what the term brings: a copy, the table's own gains are left
            var more = amountsOf(better, "more")

            if (len(more) > 0)
            {
                var brought = []

                for (var g = 0; g < len(a.gains); g++)
                {
                    push(brought, {stat: a.gains[g].stat, amount: a.gains[g].amount})
                }

                for (var m = 0; m < len(more); m++)
                {
                    var added = false

                    for (var g = 0; g < len(brought); g++)
                    {
                        if (brought[g].stat == more[m].stat)
                        {
                            brought[g].amount = brought[g].amount + more[m].amount
                            added = true
                        }
                    }

                    if (not added)
                    {
                        push(brought, {stat: more[m].stat, amount: more[m].amount})
                    }
                }

                a.gains = brought
            }
        }
    }

    // How often it can be done: read after the steps above, which may give it more
    uses = lookup(a, "uses", 0)

    var requires = []

    // What the table writes, kept as written for the tools: eased and anyOf are still on it
    a.needs = a.requires

    // Too young for it: the age is the first thing it asks
    // (what is done in town, at one of its places or for one of them, is his from the day he
    // has its page: his sixth year takes him to the market)
    var youngest = 7

    if (lookup(a, "place", "") != "" or lookup(a, "raises", "") != "")
    {
        youngest = 6
    }

    a.fromAge = lookup(a, "fromAge", youngest)
    a.finishBy = lookup(a, "finishBy", lastAge)

    // To the month: the months past the birthday each of the two is counted from
    var fromMonth = a.fromAge * 12 + lookup(a, "fromMonths", 0)
    var byMonth = a.finishBy * 12 + lookup(a, "finishMonths", 0)

    if (lived < fromMonth)
    {
        push(requires, {stat: "age", needed: a.fromAge})
    }

    for (var r = 0; r < len(a.requires); r++)
    {
        push(requires, a.requires[r])
    }

    // What it costs: asked before, taken when it begins. A copy: each says what he holds of it
    var costs = entriesCopied(amountsOf(a, "costs"))

    for (var c = 0; c < len(costs); c++)
    {
        var cost = costs[c]
        cost.label = statShortName(cost.stat)
        // (under its own name when the row gives one: what a draw takes from the stash)
        cost.name = lookup(cost, "name", statName(cost.stat))
        // (and what he holds of it, for the gloss to say on the cost's own line: the requirement it
        // makes stays the rules' own, and keeps the row locked while he is short)
        cost.held = statOf(character, cost.stat)
        push(requires, {stat: cost.stat, needed: cost.amount, cost: true})
    }

    // What it would bring to a store already full: asked as room for one more
    for (var g = 0; g < len(a.gains); g++)
    {
        var gain = a.gains[g]
        gain.label = statShortName(gain.stat)
        gain.name = statName(gain.stat)

        // A count the rules keep for themselves is gained, and shown nowhere (lib.pg's `hiddenStats`)
        gain.hidden = statHidden(gain.stat)

        // Whether the stat has a limit at all: no store of his is known here, and one only raises a limit
        if (gain.amount > 0 and limitOf({}, gain.stat) > 0)
        {
            push(requires, {stat: gain.stat, room: true})
        }
    }

    a.requires = requires
    a.costs = costs
    a.board = lookup(a, "board", false)

    // What feeds him gives the rations of its months as it begins: what his months at it eat, or
    // what its row says it gives
    var given = lookup(a, "upFront", -1)
    a.upFront = 0

    if (a.board and a.months > 0)
    {
        a.upFront = a.months * economyKnobs.rationsAMonth

        if (given >= 0)
        {
            a.upFront = given
        }
    }

    // How long they last as things stand, with what he holds: said only when it is short of the work
    a.upFrontLasts = 0

    if (a.upFront > 0)
    {
        var lasts = monthsFed(statOf(character, "rations") + a.upFront, rationsEaten)

        if (lasts < a.months)
        {
            a.upFrontLasts = lasts
        }
    }

    a.enters = lookup(a, "enters", false)
    a.opens = lookup(a, "opens", "")
    a.featured = lookup(a, "featured", false)
    a.major = lookup(a, "major", false)
    a.about = lookup(a, "about", "")

    // What doing it closes for this life, said before he does it: the rows whose `unless` names it
    a.caution = ""

    var shuts = lookup(shutNames, a.id, [])

    if (len(shuts) > 0)
    {
        var verb = " is"

        if (len(shuts) > 1)
        {
            verb = " are"
        }

        a.caution = "Once this is done, " + namesText(shuts) + verb + " closed to him for this life."

        // One of a choice itself: it is said as one
        if (has(a, "unless"))
        {
            a.caution = "One or the other: once this is done, " + namesText(shuts) + verb + " closed to him for this life."
        }
    }

    // An answer to an event says after it what leaving the event unanswered shuts, and what a
    // second one stood by would
    a.event = lookup(a, "event", "")

    if (a.event != "")
    {
        if (not has(warnsOf, a.event))
        {
            push(errors, "activity " + a.id + ": unknown event " + a.event)
        }
        else
        {
            if (a.caution != "")
            {
                a.caution = a.caution + " "
            }

            a.caution = a.caution + warnsOf[a.event]
        }
    }

    a.place = lookup(a, "place", "")
    a.trade = lookup(a, "trade", "")
    a.goto = lookup(a, "goto", "")
    a.raises = lookup(a, "raises", "")
    a.zone = lookup(a, "zone", "")
    a.story = lookup(a, "story", "")
    a.level = lookup(a, "level", 0)
    a.yearMonths = lookup(a, "years", 0) * 12
    a.done = count
    a.uses = uses
    a.after = steps
    a.left = -1
    a.spent = false

    a.tally = "DONE " + toString(count)

    if (uses > 0)
    {
        a.left = clamp(uses - count, 0, uses)
        a.spent = count >= uses
        a.tally = a.tally + " · " + toString(a.left) + " LEFT"
    }

    // Begun now, its term would come too late
    a.closed = (lived + a.months) > byMonth

    // The months he still has to begin it, said on its row once they are few. Nothing is said of
    // what no age closes, nor of what is closed already
    var toBegin = byMonth - a.months - lived

    a.until = ""
    a.urgent = false

    // And the months themselves, for the tile to count down: -1 for what does not close, or
    // closes only with his prime and not soon. What a door of its own closes says so all along
    a.closesIn = -1

    // (a row may say from how few months its own closing is said: its `closingShown`)
    var said = a.finishBy < lastAge or toBegin <= closingShown

    if (has(a, "closingShown"))
    {
        said = toBegin <= a.closingShown
    }

    if (a.finishBy < anyAge and not a.closed and said)
    {
        a.closesIn = toBegin

        if (toBegin < 0)
        {
            a.closesIn = 0
        }
    }

    if (a.finishBy < anyAge and not a.closed and toBegin <= closingShown)
    {
        // The date of the last month he may begin it: it does not move as the months pass
        var closing = world + toBegin

        a.until = "CLOSES " + toString(closing % 12 + 1) + "/" + toString(toInt(floor(closing / 12)))
        a.urgent = toBegin <= closingUrgent

        if (toBegin == 0)
        {
            a.until = "CLOSES THIS MONTH"
        }
    }

    // An answer to an event of his life is said in red all the while it can be given: an event
    // comes once, and goes
    if (a.event != "")
    {
        a.urgent = true
    }

    // A path's activities are his once he is one of it; the way in, until he is one of any
    a.pathOpen = true

    if (a.path != "")
    {
        if (pathFlagOf(paths, a.path) == "")
        {
            push(errors, "activity " + a.id + ": unknown path " + a.path)
        }

        if (a.enters)
        {
            a.pathOpen = not committed

            // The last resort is for who missed the others: not while one is still his to take,
            // nor while he is on his way into one
            // (but with the stat that makes it a way like the others: a deserter's Greenwood)
            if (lookup(a, "lastResort", false) and (waysLeft or entering) and statOf(character, lookup(a, "firstWith", "")) <= 0)
            {
                a.pathOpen = false
            }
        }
        else
        {
            a.pathOpen = statOf(character, pathFlagOf(paths, a.path)) > 0
        }
    }

    // What the screen reads: flat records, the table's eased and anyOf already weighed
    var asked = []

    // How near he is: each requirement's share of what it asks, costs, room and age left out
    var shares = 0
    var counted = 0

    // A bind with no slot free to put it in: its row waits, unlisted, for a slot to come
    var noSlot = false

    for (var q = 0; q < len(a.requires); q++)
    {
        var req = a.requires[q]

        if (not has(req, "label"))
        {
            req.label = statName(req.stat)
        }

        // Asking for a stat with no number is asking that he holds it
        req.needed = lookup(req, "needed", 1)
        req.current = statOf(character, req.stat)

        // The terms of another activity, done in this life
        if (startsWith(req.stat, "done."))
        {
            req.current = lookup(done, substring(req.stat, 5, strlen(req.stat)), 0)
        }

        if (req.stat == "age")
        {
            req.current = toInt(floor(lived / 12))

            // Of the age, and not yet of the month
            if (lived < fromMonth)
            {
                locked = true
            }
        }

        if (has(req, "eased"))
        {
            // One, or a list of them: the least of those whose flag he holds high enough
            var easings = req.eased

            if (typeOf(easings) != "array")
            {
                easings = [req.eased]
            }

            for (var e = 0; e < len(easings); e++)
            {
                if (statOf(character, easings[e].flag) >= lookup(easings[e], "at", 1) and easings[e].needed < req.needed)
                {
                    req.needed = easings[e].needed
                }
            }
        }

        // And what makes it ask more: a flag he would rather not hold
        if (has(req, "raised"))
        {
            if (statOf(character, req.raised.flag) > 0 and req.raised.needed > req.needed)
            {
                req.needed = req.raised.needed
            }
        }

        if (has(req, "anyOf"))
        {
            req.current = 0

            for (var f = 0; f < len(req.anyOf); f++)
            {
                // A stat or flag he holds, or "done.<activity id>": that activity done in this life
                var held = statOf(character, req.anyOf[f])

                if (startsWith(req.anyOf[f], "done."))
                {
                    held = lookup(done, substring(req.anyOf[f], 5, strlen(req.anyOf[f])), 0)
                }

                if (held > 0)
                {
                    req.current = 1
                }
            }
        }

        if (lookup(req, "room", false))
        {
            req.label = "Room for " + statName(req.stat)
            req.current = roomFor(character, req.stat)
        }

        // A slot to bind a familiar in: what is free of the life's own and what its standing and calling add
        if (lookup(req, "slot", false))
        {
            req.current = freeSlots(character)

            if (req.current < req.needed)
            {
                noSlot = true
            }
        }

        if (req.current < req.needed)
        {
            locked = true
        }

        if (req.stat != "age" and not lookup(req, "cost", false) and not lookup(req, "room", false) and not lookup(req, "slot", false) and req.needed > 0)
        {
            shares = shares + toInt(floor(clamp(req.current, 0, req.needed) * 100 / req.needed))
            counted = counted + 1
        }

        push(asked, {stat: req.stat, label: req.label, current: req.current, needed: req.needed, room: lookup(req, "room", false), cost: lookup(req, "cost", false)})
    }

    a.requires = asked

    a.reach = 100

    if (counted > 0)
    {
        a.reach = toInt(floor(shares / counted))
    }

    // Too young for its row, or too far from what it asks: no row yet
    var showMonth = fromMonth

    if (has(a, "showAge"))
    {
        showMonth = a.showAge * 12
    }

    a.showAge = lookup(a, "showAge", a.fromAge)
    a.showFrom = lookup(a, "showFrom", reachShown)

    // What is shown one at a time, in every life
    a.showAfter = lookup(a, "showAfter", 0)

    a.listed = a.pathOpen and not a.spent and not a.closed and lived >= showMonth and a.reach >= a.showFrom and termsDone >= a.showAfter

    if (noSlot)
    {
        a.listed = false
    }

    // One or the other: the one he did not take has no row once the other is done
    if (has(a, "unless"))
    {
        var closers = asList(a.unless)

        for (var u = 0; u < len(closers); u++)
        {
            if (lookup(done, closers[u], 0) > 0)
            {
                a.listed = false
            }
        }
    }

    // What is for who holds a stat has no row without it
    if (has(a, "onlyWith"))
    {
        if (statOf(character, a.onlyWith) <= 0)
        {
            a.listed = false
        }
    }

    // A second calling is for a man whose prime runs on past thirty: none once his old age has begun
    if (lookup(a, "longPrime", false) and lastAge <= shortAge)
    {
        a.listed = false
    }

    // What is for who does not hold a stat yet has no row once he does
    if (has(a, "whileNot"))
    {
        if (statOf(character, a.whileNot) > 0)
        {
            a.listed = false
        }
    }

    // What teaches a kind of familiar has no row once the kind is his, however it came
    if (has(a, "whileUnknown"))
    {
        var taught = kindById(a.whileUnknown)

        if (kindKnown(character, taught))
        {
            a.listed = false
        }
    }

    // A work that raises a place: for who knows the town, while the place is one level below
    if (a.raises != "")
    {
        if (statOf(character, "town_known") <= 0 or statOf(character, "town." + a.raises) != a.level - 1)
        {
            a.listed = false
        }

        // And a place that is not on his page yet has no work to show either
        if (not placeShown(byId(townPlaces, a.raises), character, lived, done, lives))
        {
            a.listed = false
        }
    }

    // What comes after another has no row until that one is behind him (or shut by an event)
    if (has(a, "follows"))
    {
        var befores = asList(a.follows)

        for (var b = 0; b < len(befores); b++)
        {
            if (not contain(activityById, befores[b]))
            {
                push(errors, "activity " + a.id + ": follows unknown activity " + befores[b])
            }
            else if (not behindHim(activityById, befores[b], done, lived, lastAge) and not has(barredBy, befores[b]))
            {
                a.listed = false
            }
        }
    }

    // A work he never took leaves the list at its age: not the one he is at for the first time
    if (has(a, "idleBy"))
    {
        if (count == 0 and a.id != running and lived >= a.idleBy * 12)
        {
            a.listed = false
        }
    }

    // What the events he stood by have shut: the rows each of them names
    a.barred = lookup(barredBy, a.id, "")

    if (a.barred != "")
    {
        a.listed = false
    }

    a.locked = locked
}
