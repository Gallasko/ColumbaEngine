    {id: "silence", group: "The Hidden Hand", name: "Buy Silence", glyph: "gold", months: 0, rank: "", each: "", path: "thief", fromAge: 22, uses: 1,
     gains: [{stat: "heat_reduced", amount: 1}],
     requires: [{stat: "guild_enemy", needed: 1}],
     costs: [{stat: "coin", amount: 40}]},
    {id: "plan", group: "The Hidden Hand", name: "Plan the Bellmoor Job", glyph: "time", months: 12, rank: "", each: "", path: "thief", fromAge: 23, uses: 1,
     gains: [{stat: "great_job_planned", amount: 1}],
     requires: [{stat: "guild_ledgers", needed: 1}, {stat: "guile", needed: 6}],
     costs: [{stat: "favors", amount: 2}]},
    {id: "crew", group: "The Hidden Hand", name: "Gather the Crew", glyph: "guild", months: 12, rank: "", each: "", path: "thief", fromAge: 24, uses: 1,
     gains: [{stat: "crew_ready", amount: 1}],
     requires: [{stat: "great_job_planned", needed: 1}],
     costs: [{stat: "favors", amount: 3}, {stat: "coin", amount: 25}]},
    {id: "vault", group: "The Hidden Hand", name: "Empty the Bellmoor Vault", glyph: "gold", months: 24, rank: "", each: "MEALS PROVIDED", path: "thief", board: true, fromAge: 26, showAge: 21, showFrom: 0, uses: 1,
     gains: [{stat: "coin", amount: 200}, {stat: "master_thief", amount: 1}],
     requires: [{stat: "crew_ready", needed: 1}, {stat: "stealth", needed: 8}, {stat: "guile", needed: 7}]},

    // What is left to an old man, whatever he was: nothing closes it, and it asks nothing. Listed
    // a year before his prime ends, so its last months, too short for any other work, are never
    // without something to do
    {id: "tales", group: "Old age", name: "Tell Tales at the Inn", glyph: "town", months: 2, rank: "", each: "MEALS PROVIDED", path: "", board: true, fromAge: lastAge - 1, finishBy: anyAge,
     gains: [{stat: "coin", amount: 2}],
     requires: []},
    {id: "garden", group: "Old age", name: "Tend a Garden", glyph: "work", months: 3, rank: "", each: "", path: "", fromAge: lastAge - 1, finishBy: anyAge,
     gains: [{stat: "rations", amount: 4}],
     requires: []},
    {id: "teach", group: "Old age", name: "Teach the Young", glyph: "academy", months: 4, rank: "", each: "", path: "", fromAge: lastAge - 1, finishBy: anyAge,
     gains: [{stat: "coin", amount: 6}],
     requires: []}
]

// Whether he is one of any path yet
var committed = false

for (var p = 0; p < len(paths); p++)
{
    if (statOf(character, paths[p].flag) > 0)
    {
        committed = true
    }
}

var lived = monthOf(age)

// The forecast asks after one activity: only that one is shaped
if (activityId != "")
{
    var shaped = []

    for (var i = 0; i < len(activities); i++)
    {
        if (activities[i].id == activityId)
        {
            push(shaped, activities[i])
        }
    }

    activities = shaped
}

// What each activity still asks of this character
for (var i = 0; i < len(activities); i++)
{
    var a = activities[i]
    var locked = false

    // How often it was done, and what repetition has made of it
    var count = lookup(done, a.id, 0)
    var uses = lookup(a, "uses", 0)
    var steps = listOf(a, "after")

    for (var s = 0; s < len(steps); s++)
    {
        var step = steps[s]

        if (count >= step.uses)
        {
            if (has(step, "rank"))
            {
                a.rank = step.rank
            }

            if (has(step, "months"))
            {
                a.months = step.months
            }

            if (has(step, "gains"))
            {
                a.gains = step.gains
            }
        }
    }

    // Done well enough, the term brings more
    if (has(a, "bonus"))
    {
        if (statOf(character, a.bonus.stat) >= a.bonus.needed)
        {
            a.gains = a.bonus.gains
        }
    }

    var requires = []

    // Too young for it: the age is the first thing it asks
    a.fromAge = lookup(a, "fromAge", 7)
    a.finishBy = lookup(a, "finishBy", lastAge)

    if (lived < a.fromAge * 12)
    {
        push(requires, {stat: "age", needed: a.fromAge})
    }

    for (var r = 0; r < len(a.requires); r++)
    {
        push(requires, a.requires[r])
    }

    // What it costs: asked before, taken when it begins
    var costs = listOf(a, "costs")

    for (var c = 0; c < len(costs); c++)
    {
        var cost = costs[c]
        cost.label = statShortName(cost.stat)
        cost.name = statName(cost.stat)
        push(requires, {stat: cost.stat, needed: cost.amount, cost: true})
    }

    // What it would bring to a store already full: asked as room for one more
    for (var g = 0; g < len(a.gains); g++)
    {
        var gain = a.gains[g]
        gain.label = statShortName(gain.stat)
        gain.name = statName(gain.stat)

        if (gain.amount > 0 and limitOf(gain.stat) > 0)
        {
            push(requires, {stat: gain.stat, needed: 1, room: true})
        }
    }

    a.requires = requires
    a.costs = costs
    a.board = lookup(a, "board", false)
    a.enters = lookup(a, "enters", false)
    a.done = count
    a.uses = uses
    a.after = steps
    a.left = -1
    a.spent = false

    a.tally = "DONE " + toString(count)

    if (uses > 0)
    {
        a.left = clamp(uses - count, 0, uses)
        a.spent = count >= uses
        a.tally = a.tally + " · " + toString(a.left) + " LEFT"
    }

    // Begun now, its term would come too late
    a.closed = (lived + a.months) > (a.finishBy * 12)

    // The months he still has to begin it, said on its row once they are few. Nothing is said of
    // what no age closes, nor of what is closed already
    var toBegin = a.finishBy * 12 - a.months - lived

    a.until = ""
    a.urgent = false

    if (a.finishBy < anyAge and not a.closed and toBegin <= closingShown)
    {
        // The date of the last month he may begin it: it does not move as the months pass
        var closing = world + toBegin

        a.until = "CLOSES " + toString(closing % 12 + 1) + "/" + toString(toInt(floor(closing / 12)))
        a.urgent = toBegin <= closingUrgent

        if (toBegin == 0)
        {
            a.until = "CLOSES THIS MONTH"
        }
    }

    // A path's activities are his once he is one of it; the way in, until he is one of any
    a.pathOpen = true

    if (a.path != "")
    {
        if (pathFlagOf(paths, a.path) == "")
        {
            push(errors, "activity " + a.id + ": unknown path " + a.path)
        }

        if (a.enters)
        {
            a.pathOpen = not committed
        }
        else
        {
            a.pathOpen = statOf(character, pathFlagOf(paths, a.path)) > 0
        }
    }

    // What the screen reads: flat records, the table's eased and anyOf already weighed
    var asked = []

    // How near he is: each requirement's share of what it asks, costs, room and age left out
    var shares = 0
    var counted = 0

    for (var q = 0; q < len(a.requires); q++)
    {
        var req = a.requires[q]

        if (not has(req, "label"))
        {
            req.label = statName(req.stat)
        }

        req.current = statOf(character, req.stat)

        if (req.stat == "age")
        {
            req.current = toInt(floor(lived / 12))
        }

        if (has(req, "eased"))
        {
            if (statOf(character, req.eased.flag) > 0)
            {
                req.needed = req.eased.needed
            }
        }

        if (has(req, "anyOf"))
        {
            req.current = 0

            for (var f = 0; f < len(req.anyOf); f++)
            {
                if (statOf(character, req.anyOf[f]) > 0)
                {
                    req.current = 1
                }
            }
        }

        if (lookup(req, "room", false))
        {
            req.label = "Room for " + statName(req.stat)
            req.current = roomFor(character, req.stat)
        }

        if (req.current < req.needed)
        {
            locked = true
        }

        if (req.stat != "age" and not lookup(req, "cost", false) and not lookup(req, "room", false) and req.needed > 0)
        {
            shares = shares + toInt(floor(clamp(req.current, 0, req.needed) * 100 / req.needed))
            counted = counted + 1
        }

        push(asked, {stat: req.stat, label: req.label, current: req.current, needed: req.needed, room: lookup(req, "room", false)})
    }

    a.requires = asked

    a.reach = 100

    if (counted > 0)
    {
        a.reach = toInt(floor(shares / counted))
    }

    // Too young for its row, or too far from what it asks: no row yet
    a.showAge = lookup(a, "showAge", a.fromAge)
    a.showFrom = lookup(a, "showFrom", reachShown)

    a.listed = a.pathOpen and not a.spent and not a.closed and lived >= a.showAge * 12 and a.reach >= a.showFrom

    a.locked = locked
}
