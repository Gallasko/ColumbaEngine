     gains: [{stat: "coin", amount: 35}, {stat: "renown"}],
     requires: [{stat: "arms", needed: 5}, {stat: "discipline", needed: 3}]},
    {id: "master", group: "The Keep", name: "Train with the Master-at-Arms", glyph: "training", months: 18, rank: "", each: "MEALS PROVIDED", path: "warrior", board: true, fromAge: 19, uses: 1,
     gains: [{stat: "arms", amount: 2}, {stat: "discipline"}],
     requires: [{stat: "arms", needed: 5}, {stat: "discipline", needed: 3}, {stat: "renown", needed: 2}]},
    {id: "campaign", group: "The Keep", name: "Join the Border Campaign", glyph: "swordsmanship", months: 24, rank: "", each: "MEALS PROVIDED", path: "warrior", board: true, fromAge: 21, showAge: 16, showFrom: 0, finishBy: 26, uses: 1,
     gains: [{stat: "arms"}, {stat: "discipline"}, {stat: "vit"}, {stat: "renown", amount: 2}, {stat: "coin", amount: 50}, {stat: "veteran"}],
     requires: [{stat: "arms", needed: 6}, {stat: "discipline", needed: 4}, {stat: "renown", needed: 3}],
     costs: [{stat: "coin", amount: 10}]},
    {id: "lead", group: "The Keep", name: "Lead the Watch", glyph: "reputation", months: 18, rank: "", each: "MEALS PROVIDED", path: "warrior", board: true, fromAge: 24, uses: 1,
     gains: [{stat: "renown", amount: 2}, {stat: "discipline"}, {stat: "watch_commander"}],
     requires: [{stat: "veteran"}, {stat: "arms", needed: 7}, {stat: "discipline", needed: 5}]},
    {id: "captain", group: "The Keep", name: "Take the Captain's Chain", glyph: "seal", months: 24, rank: "", each: "MEALS PROVIDED", path: "warrior", board: true, fromAge: 26, showAge: 21, showFrom: 0, uses: 1,
     gains: [{stat: "captain"}, {stat: "coin", amount: 80}],
     requires: [{stat: "watch_commander"}, {stat: "arms", needed: 8}, {stat: "discipline", needed: 6}, {stat: "renown", needed: 7, eased: {flag: "town.gate", at: 3, needed: 6}}],
     costs: [{stat: "coin", amount: 20}]},

    {id: "scribework", group: "The Collegium", name: "Copy Paid Manuscripts", glyph: "quill", months: 6, rank: "", each: "MEALS PROVIDED", path: "mage", board: true, fromAge: 18,
     gains: [{stat: "coin", amount: 30}],
     requires: [{stat: "letters", needed: 4}]},
    {id: "study", group: "The Collegium", name: "Study at the Collegium", glyph: "academy", months: 12, rank: "", each: "MEALS PROVIDED", path: "mage", board: true, fromAge: 18,
     gains: [{stat: "lore"}, {stat: "letters"}],
     requires: [],
