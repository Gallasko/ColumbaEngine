// Chronicle rules: the activities
// -------------------------------
// Imported by windows.pg and forecast.pg, and loaded by the game through activities.pg.
// Input:  `character` (a table of stats and flags), `done` (a table: activity id -> the terms
//         already completed; an activity never done has no key).
// Output: `activities`, one table per thing the character may spend months doing, in the order
//         the Life screen lists them:
//           id, group, name, glyph, months, rank ("" or caps), each ("" or caps), path (the
//           milestone path it leads toward, "" if none), gains [{stat, amount}] (at term),
//           requires [{stat, label, current, needed}] (current: the character's),
//           locked (true while a requirement is unmet),
//           done (the terms completed), uses (0 = as often as he likes), left (-1 = no limit),
//           spent (true once a limited activity has no use left: the screen drops it),
//           tally (how often it was done and, for a limited one, what is left, as the row
//           writes it: "DONE 2", "DONE 0 · 1 LEFT"),
//           after (its steps, as below).
//
// `months: 0` is an activity done at once: it takes no time, and can be done while another runs.
//
// Optional fields of an activity:
//   costs: [{stat, amount}]
//                    what it takes from him. He must hold that much to begin (it is listed in
//                    `requires`), and it leaves with the gains (a negative entry in `gains`).
//   uses: N          it can be done N times, then it is spent.
//
// An activity that brings a stat with a limit (lib.pg's `statLimits`) asks for room for it: one
// more requirement, {stat, label "Room for Rations", current (the room left), needed 1, room
// true}, after its costs. Full, it is locked; begun with any room left, it brings all it brings,
// past the limit if need be.
//   after: [step]    what changes with repetition. A step is {uses: N, ...}:
//                      rank, months, gains   replace the activity's own once N terms are done
//                                            (the last step reached wins);
//                      effects [{stat, amount}], entry "text"
//                                            happen once, at the term that makes it N
//                                            (forecast.pg applies them).
//
// The numbers are the design mockup's placeholders for the game's balance: change them here,
// nothing in C++ moves.

import "string"
import "math"
import "algorithm"
import "lib"

var errors = []

var activities = [
    {id: "train.yard", group: "Training", name: "Train at the yard", glyph: "training", months: 6, rank: "RANK 2", each: "AT THE YARD", path: "squire",
     gains: [{stat: "str", amount: 2}, {stat: "vit", amount: 1}],
     requires: [],
     after: [{uses: 3, rank: "RANK 3", gains: [{stat: "str", amount: 3}, {stat: "vit", amount: 1}], entry: "The yard has no more to teach a beginner"}]},
    {id: "train.guard", group: "Training", name: "Spar with the guard", glyph: "swordsmanship", months: 3, rank: "", each: "AT THE GATE", path: "squire",
     gains: [{stat: "swd", amount: 1}, {stat: "dex", amount: 1}],
     requires: [{stat: "str", needed: 12}]},
    {id: "train.squire", group: "Training", name: "Squire at the keep", glyph: "swordsmanship", months: 12, rank: "", each: "", path: "squire",
     gains: [{stat: "swd", amount: 2}, {stat: "ride", amount: 2}],
     requires: [{stat: "str", needed: 18}, {stat: "swd", needed: 4}]},

    {id: "study.academy", group: "Study", name: "Read at the academy", glyph: "academy", months: 6, rank: "", each: "AT THE ACADEMY", path: "scholar",
     gains: [{stat: "int", amount: 2}],
     requires: [{stat: "int", needed: 10}]},
    {id: "study.letters", group: "Study", name: "Letters with the priest", glyph: "quill", months: 6, rank: "", each: "AT THE CHAPEL", path: "scholar",
     gains: [{stat: "letters", amount: 1}, {stat: "int", amount: 1}],
     requires: []},

    {id: "work.smithy", group: "Work", name: "Work the smithy", glyph: "forge", months: 6, rank: "", each: "AT THE SMITHY", path: "guild",
     gains: [{stat: "str", amount: 1}, {stat: "coin", amount: 24}],
     requires: []},
    {id: "work.carters", group: "Work", name: "Carry for the carters", glyph: "work", months: 3, rank: "", each: "", path: "",
     gains: [{stat: "vit", amount: 1}, {stat: "coin", amount: 9}, {stat: "rations", amount: 6}],
     requires: []},

    {id: "buy.rations", group: "Market", name: "Buy rations", glyph: "trade", months: 0, rank: "", each: "AT THE MARKET", path: "",
     gains: [{stat: "rations", amount: 6}],
     requires: [],
     costs: [{stat: "coin", amount: 5}]},

    {id: "guild.errands", group: "Guild", name: "Run the guild's errands", glyph: "guild", months: 3, rank: "", each: "", path: "guild",
     gains: [{stat: "haggle", amount: 1}],
     requires: [],
     after: [{uses: 2, effects: [{stat: "coin", amount: 5}], entry: "The guild master tips him for his trouble"}]},
    {id: "guild.letter", group: "Guild", name: "Earn the Guild's letter", glyph: "seal", months: 6, rank: "", each: "", path: "squire",
     gains: [{stat: "letter", amount: 1}],
     requires: [{stat: "haggle", needed: 2}]},

    {id: "adventure.forest", group: "Adventure", name: "Into the North Forest", glyph: "adventure", months: 3, rank: "ONCE", each: "", path: "",
     gains: [{stat: "dex", amount: 1}, {stat: "swd", amount: 1}],
     requires: [{stat: "vit", needed: 10}],
     uses: 1}
]

// What each activity still asks of this character
for (var i = 0; i < len(activities); i++)
{
    var a = activities[i]
    var locked = false

    // How often it was done, and what repetition has made of it
    var count = lookup(done, a.id, 0)
    var uses = lookup(a, "uses", 0)
    var steps = listOf(a, "after")

    for (var s = 0; s < len(steps); s++)
    {
        var step = steps[s]

        if (count >= step.uses)
        {
            if (has(step, "rank"))
            {
                a.rank = step.rank
            }

            if (has(step, "months"))
            {
                a.months = step.months
            }

            if (has(step, "gains"))
            {
                a.gains = step.gains
            }
        }
    }

    // What it costs: asked before, taken with the gains
    var costs = listOf(a, "costs")

    for (var c = 0; c < len(costs); c++)
    {
        push(a.requires, {stat: costs[c].stat, needed: costs[c].amount})
        push(a.gains, {stat: costs[c].stat, amount: 0 - costs[c].amount})
    }

    // What it would bring to a store already full: asked as room for one more
    for (var g = 0; g < len(a.gains); g++)
    {
        if (a.gains[g].amount > 0 and limitOf(a.gains[g].stat) > 0)
        {
            push(a.requires, {stat: a.gains[g].stat, needed: 1, room: true})
        }
    }

    a.done = count
    a.uses = uses
    a.after = steps
    a.left = -1
    a.spent = false

    a.tally = "DONE " + toString(count)

    if (uses > 0)
    {
        a.left = clamp(uses - count, 0, uses)
        a.spent = count >= uses
        a.tally = a.tally + " · " + toString(a.left) + " LEFT"
    }

    for (var r = 0; r < len(a.requires); r++)
    {
        var req = a.requires[r]
        req.label = statName(req.stat)
        req.current = statOf(character, req.stat)

        if (lookup(req, "room", false))
        {
            req.label = "Room for " + statName(req.stat)
            req.current = roomFor(character, req.stat)
        }

        if (req.current < req.needed)
        {
            locked = true
        }
    }

    a.locked = locked
}
