// Chronicle rules: the expeditions' zones, beasts, events and things
// -----------------------------------------------------------------
// Imported by expedition.pg (the walk itself) and by activitytable.pg (the Adventure rows of the
// Life page are made from `walkZones`, so the two never disagree). Never loaded itself.
// Input:  none.
// Output: `walkKnobs`  every figure of the rules of a walk, in one table;
//         `walkItems`  what a walk gathers, uses or brings home:
//                        {id, name, one (one of it), glyph, kind (food | remedy | sold | town | found | fight),
//                         heals?, lot?, coin?, about? (its line in the stores, for a `sold` thing: resources.pg)}
//                      He holds all of them, among his stats. `sold` is sold at the market,
//                      `lot` of it for `coin` (activitytable.pg makes its row there); `town` is
//                      what the town's places are built of (a cost of their works,
//                      towntable.pg), lost at his death but for what the place he chooses then
//                      still asks; `found` is what only a far place gives (the Marsh's bog iron,
//                      pitch and wisp-glass): held among his stores and never sold, it is what
//                      the last levels of the town ask, and it is left to a place as `town` is;
//                      `remedy` is drunk for `heals` percent of his
//                      Vitality; `food` is what a rest eats;
//         `walkZones`  one table per place he can walk to:
//                        {id, name, kind (forage | hunt), line, travel (days, one way),
//                         stayMin, stayMax (days on site: the longer one from zone knowledge 3),
//                         mobs [mob id], spots [{id (an item), ap, least, most, bonus?}], events [event id],
//                         (a spot's `bonus` is an activity row's: [{stat, needed, more [{stat, amount}]}],
//                         each step he has reached adds its `more` of the spot's item to each gathering;
//                         `scavenge: true` makes each gathering of it count one stat "scavenged"),
//                         fromAge, showAge?, showAfter?, requires [...] (as an activity's, activitytable.pg),
//                         sooner? ({flag, fromAge}: with that flag held it is his from that age),
//                         opens (what its row's gloss says of it)}
//         `walkMobs`   one table per beast:
//                        {id, name, many (several of it), pack?, lone?, rarity (common | uncommon | rare), packSize,
//                         holdsBack (a member does not attack while that many others stand; 0: none),
//                         about (a line on what it is, for its gloss in a fight),
//                         moves {move: {name, line}} (what each move of its script is called and
//                         a line on it, for the gloss of what it means to do: "hold" is the move
//                         of one that hangs back),
//                         a move may say `kind: "spell"`: it is a working, and his ward (the
//                         warded charm) takes off it what his armour takes off a bite),
//                         hp, least, most (its bite), armour (taken off each blow of the body but a
//                         pierce), ward (taken off each working), resist {type: percent} (negative:
//                         weak to it; types cut, pierce, blunt, fire, frost, storm, holy),
//                         mends? (percent of its Vitality it mends at its own turn, unless it
//                         burns), quick,
//                         verb ("bites"), script [bite | circle | maul] (cycled),
//                         demon? (true: it leaves no page of the chronicle, which every other beast does),
//                         lesson (what the first kill of it in a life teaches, a line for the log), loot [{id, chance (percent), least, most}]}
//         `walkEvents` one table per event:
//                        {id, trigger (seek | study | fight | rest | gather), weight, once (once per
//                         life: a replay skips it), title, text,
//                         options [{id, label, ap, hp, items [{id, amount}], effects [...], line}]}
//                      an effect is {kind: "seek", mob, amount} (that beast's find cost, this walk),
//                      {kind: "study", amount} (zone studies), {kind: "observe", mob, amount},
//                      or {kind: "stat", stat, amount};
//         `walkTechniques`: what a fight offers to who has learned it, besides what anyone
//         can do; `walkStances`: how he holds himself (in the rules, not on the page yet).
//
// The names and the numbers are placeholders for the game's balance and writing: change them
// here, nothing in C++ moves.
//
// The tables are `const`: a rule script's VM makes them on its first run and keeps them for the
// next ones. Nothing writes into them: a row that is written into per run is a copy (activitytable.pg's
// walk rows take their requirements through `entriesCopied`).

import "string"
import "math"
import "algorithm"

const walkKnobs = {
    daysAMonth: 30,         // A calendar month, in days: a walk blocks 2 x travel + stay, in whole months
    apPerDay: 1,            // Action points a day on site
    tickBase: 100,          // The timeline of a fight: an ordinary move holds one of speed s for 100 x tickBase / (speedFloor + s)
    speedFloor: 10,         // so that who is twice as quick acts about twice as often
    turnsPerAp: 3,          // Turns of a fight to a day
    dexStep: 10,            // One more for every ten of Dexterity
    lowHp: 50,              // Under this share of his Vitality, in percent,
    lowPenalty: 1,          // a day is one turn shorter,
    resolveHolds: 6,        // unless his Discipline is this or more
    seekCommon: 4,          // Days to find a beast, by how rare it is (a day less for each two levels of zone knowledge)
    seekUncommon: 6,
    seekRare: 16,
    packMod: -1,            // A pack is easier found
    loneMod: 1,             // and one of a pack beast alone is harder
    luckStep: 5,            // One day less for every five of Guile
    studyAp: 2,
    observeAp: 1,
    restAp: 2,
    restHeal: 40,           // Percent of his Vitality
    restItem: "rations",
    breath: 5,              // A fight's worth, full again at the next
    weaponLeast: 4,         // A strike, before his Strength and his Arms
    weaponMost: 7,
    spellLeast: 5,          // A spell's blow, before his Intelligence
    spellMost: 8,
    hitBase: 80,            // Percent: a strike against a beast as quick as he is sharp
    hitStep: 2,             // For each point between his Intelligence and its quickness
    hitLeast: 40,
    hitMost: 95,
    critBase: 5,            // Percent, one more for each two of Guile
    critPower: 150,         // Percent of the blow
    loreSees: 3,            // Lore from which a beast is known a level better than it has been seen
    loreWeak: 5,            // And a weakness found deeper, percent a point of Lore
    markTurns: 3,           // Turns of its own a mark, a wound or a broken armour lasts on a beast
    burnShare: 6,           // Percent of its Vitality a burning beast loses at its turn
    bleedShare: 5,          // And a bleeding one
    chillWeight: 125,       // A chilled beast waits that much longer, percent
    shockedTakes: 110,      // A shocked one takes every hit that much harder, percent
    sunderResist: 25,       // A sundered one has no armour and resists that much less
    poiseBlunt: 200,        // A blunt hit wears poise twice as fast,
    finisherPoise: 300,     // a finisher thrice
    staggerDelay: 100,      // A staggered beast's next turn is pushed back by an ordinary wait of its own
    bossDelay: 50,          // A boss is held by a delay half as long
    ambushBase: 50,         // Lying in wait: percent to strike first, at Stealth equal to the beasts' watch,
    ambushStep: 5,          // and that much a point of Stealth over it (or under),
    ambushLeast: 10,
    ambushMost: 90,
    ambushDelay: 50,        // and from cover the beasts are that late, percent of an ordinary wait
    trapAp: 1,              // A trap set on the walk (who learned snares): days,
    trapsMost: 2,           // how many he can watch,
    trapDamage: 6,          // and what it does to the beast it holds, past any armour
    leaderQuick: 3,         // While a leader stands, the beasts with it are that much quicker
    fleeAt: 60,             // A beast that flees goes at its turn once under this share of its Vitality
    flaskDamage: 10,        // A fire flask thrown: what it does to any beast, past its hide and what it resists
    momentumMost: 3,        // The Keep's rhythm: blows landed to fill his momentum, which a finisher spends
    braceCut: 75,           // Percent of what comes that a brace takes (a defend takes guardCut)
    reactShatter: 200,      // The Collegium's rhythm: fire and frost shatter, percent of a working's roll,
    reactFlare: 100,        // fire and storm flare on every beast standing,
    freezeDelay: 150,       // frost and storm freeze: held, and its next turn pushed back that much
    tempoPower: 15,         // The Hidden Hand's rhythm: percent more a hit for each of his on it since its last turn,
    tempoCrit: 10,          // and percent more chance of a crit
    stepDodge: 40,          // Step aside: percent more chance to step clear until his next action
    windBreath: 2,          // Second wind: breath back,
    windHeal: 10,           // and percent of his Vitality
    dodgeBase: 15,          // Percent: a bite from a beast as quick as he is
    dodgeStep: 2,           // For each point between his Dexterity and its quickness
    dodgeMost: 60,
    guardCut: 50,           // Percent a guard takes off what comes until his next turn
    potionAuto: 30,         // The stance drinks a remedy under this share of his Vitality
    sweepAuto: 3,           // And sweeps when this many stand
    rankUses: [10, 30, 60], // A technique used that often in fights rises a rank: a point of the part it trains,
    rankPower: 10,          // and that much more power a rank
    eventChance: 35,        // Percent, after an action an event waits on
    replayHp: true,
    studyLevels: [0, 3, 6, 10],     // Studies of a zone, in all, to its knowledge 1 to 4: the first visit alone gives 1
    observeLevels: [1, 2, 5, 8],    // A beast observed that often is known 1 to 4
    fightLevels: [1, 8, 20],        // Fought that often it is known 1 to 3: the fourth is by watching only
    travelCut: 25,          // Percent off the way there and back at zone knowledge 4
    roadsCut: 1,            // Days off the way there, and off the way back, for who knows the roads (`roads_known`)
    officeHeal: 2,          // Vitality a rest gives besides, to who says the office (`anselm_trust`)
    snareAp: 1,             // A snare set and lifted (`snare_set`): days,
    snareItem: "rations",   // what it catches,
    snareMost: 1,           // and how much
    brewAp: 0,              // A remedy brewed where he stands (`herbal`): days,
    brewItem: "wortleaf",   // what it is made of,
    brewTakes: 2,           // and how much of it
    scoutCut: 2,            // Days off the finding of any beast, for who scouts ahead (`adventurer`)
    portersShare: 150       // Percent of what a gathering brings, with porters hired (`porters`)
}

// `gather`: a line on the gathering of it, for the gloss of its tile on the site
const walkItems = [
    {id: "rations", name: "Rations", one: "ration", glyph: "trade", kind: "food"},
    {id: "remedy", name: "Wortleaf remedies", one: "remedy", glyph: "vitality", kind: "remedy", heals: 30},
    // What a fight spends, from the market: a flask thrown burns any beast the same, oil on his blade
    // makes his blows holy for the fight (fightlib.pg's `itemActs`)
    {id: "flask", name: "Fire flasks", one: "fire flask", glyph: "magic", kind: "fight"},
    {id: "oil", name: "Blessed oil", one: "flask of blessed oil", glyph: "relic", kind: "fight"},
    {id: "berries", name: "Berries", one: "berries", glyph: "trade", kind: "sold", gather: "Brambles along the hedge, black with fruit by late summer.", lot: 5, coin: 1},
    {id: "wortleaf", name: "Wortleaf", one: "wortleaf", glyph: "study", kind: "sold", gather: "A low grey leaf the herbwives pay for. It hides at the foot of the hedge.", lot: 2, coin: 1},
    {id: "hazel", name: "Hazelnuts", one: "hazelnuts", glyph: "trade", kind: "sold", gather: "The hazels in the old part of the hedge, that only the hedge keeper's boys know of.", lot: 4, coin: 1},
    {id: "fish", name: "Fish", one: "fish", glyph: "trade", kind: "sold", gather: "A line in the still water, and patience.", lot: 4, coin: 1},
    {id: "reeds", name: "Reeds", one: "reeds", glyph: "work", kind: "sold", gather: "Cut at the water's edge, for thatch and baskets.", lot: 5, coin: 1},
    {id: "pelts", name: "Pelts", one: "pelt", glyph: "adventure", kind: "sold", lot: 3, coin: 1},
    {id: "hides", name: "Hides", one: "hide", glyph: "adventure", kind: "sold", lot: 2, coin: 1},
    {id: "fangs", name: "Fangs", one: "fang", glyph: "relic", kind: "sold", lot: 2, coin: 1},
    {id: "antler", name: "White antlers", one: "white antler", glyph: "relic", kind: "sold", lot: 1, coin: 6},
    {id: "beetle_shell", name: "Beetle shells", one: "beetle shell", glyph: "forge", kind: "sold", lot: 2, coin: 1},
    {id: "pike_jaw", name: "The pike's jaw", one: "pike's jaw", glyph: "relic", kind: "sold", lot: 1, coin: 8},
    {id: "grey_pelt", name: "The Old Grey's pelt", one: "grey pelt", glyph: "relic", kind: "sold", lot: 1, coin: 12},
    {id: "shell_plate", name: "A plate of the Old Shell", one: "shell plate", glyph: "forge", kind: "sold", lot: 1, coin: 10},
    // A page of the chronicle: every beast he kills leaves one (but a beast with `demon: true`), and
    // the market takes them four for a coin. At two for a coin the pages lifted a walk's pay above
    // the author's rule (1.5 to 2 times plain work), so the price was lowered. `about` is its own
    // line in the stores (resources.pg)
    {id: "page", name: "Chronicle pages", one: "chronicle page", glyph: "study", kind: "sold", lot: 4, coin: 1,
     about: "What the curse made leaves a page behind it when you kill it, in a hand nobody in Bellmoor writes. The curse keeps a chronicle too."},
    {id: "firewood", name: "Firewood", one: "firewood", glyph: "work", kind: "town", gather: "Deadfall and cuttings, bundled and carried home."},
    {id: "clay", name: "Clay", one: "clay", glyph: "work", kind: "town", gather: "Dug out of the bank, heavy and wet."},
    {id: "ashwood", name: "Ash wood", one: "ash wood", glyph: "work", kind: "town", gather: "Straight ash poles, felled and trimmed."},
    {id: "stone", name: "Stone", one: "stone", glyph: "forge", kind: "town", gather: "Dressed blocks, lying where the quarrymen left them."},
    // What only Millbrook Marsh gives: no market buys it, and the town's finest work asks for it
    {id: "bog_iron", name: "Bog iron", one: "lump of bog iron", glyph: "forge", kind: "found", gather: "Rust-red lumps under the peat, where the water runs brown. The smiths of Harrow made their iron of it."},
    {id: "pitch", name: "Pitch", one: "pot of pitch", glyph: "work", kind: "found", gather: "Black and slow, it seeps from the drowned pines at the marsh's edge, and is scraped into a pot."},
    {id: "wisp_glass", name: "Wisp-glass", one: "bead of wisp-glass", glyph: "magic", kind: "found"}
]

// `lines`: what the scribe says of the place at the foot of the Adventure page, by his age (the
// first whose `until` he is under): never anything the game counts.
//
// A place opens to him a little at a time: three things to do on the first visit, one more at
// each level of zone knowledge (`ladder`: what opens at 2, 3 and 4, by a gathering's item, a
// beast's id, "<beast>*pack" for its pack, "camp" for a rest and his own trades; an entry with
// `says` is no tile of the walk but what its level opens elsewhere, as the study tile tells it),
// and a next place at 4 (its `requires` asks this one known 4 of 4). Anything the ladder does
// not name is there from the first visit, but for "camp": a place whose ladder does not name it
// has none. Mill Pond is the exception: a task of his life finds it for the world
// (`know.found.millpond`).
// A walk is months of his life like any work, and longer ones are walks of more days: what it
// brings is weighed against the work of his age for as long. Known 1 of 4 it brings about what
// his age's plain work does; known 4 of 4, worked well, one and a half to twice that, or a
// quarter more than a work that asks something of him (README, *What a walk is worth*).
const walkZones = [
    // The first walk of a life: no beast, a week, three things to pick. It is there to teach the
    // days, the record and the walk again, and a queue of it is the first thing that runs alone
    // (it asks nothing: its tile on the Life page takes him there, once he has a few terms behind him).
    // Home is a day away: nobody camps at the hedge. Known 2 of 4 it opens a task of his life,
    // the pond above the mill (activitytable.pg's `pond`), known 4 of 4 the way north to the
    // Hollow Woods
    {id: "hedgerows", name: "The Hedgerows", kind: "forage", glyph: "adventure",
     line: "The hedges at the edge of town, where every child of Bellmoor has picked.",
     lines: [{until: 12, text: "The hedge is taller than you, and gives more than it takes."},
             {until: 20, text: "You know every gap in it by now, and which ones tear a sleeve."},
             {until: 99, text: "The same hedge. The children picking at it aren't the ones you remember."}],
     travel: 1, stayMin: 7, stayMax: 9,
     mobs: [],
     // A deft boy picks more berries, a strong one carries more wood: the steps the scavenging
     // rows had before the walk took their place (economytable.pg). Each gathering of them counts
     // a scavenge, as a month of those rows did (`scavenge`: the hedge sprite waits for two)
     spots: [{id: "berries", ap: 1, least: 1, most: 3, scavenge: true, bonus: [{stat: "dex", needed: 8, more: [{stat: "berries", amount: 1}]}, {stat: "dex", needed: 12, more: [{stat: "berries", amount: 1}]}]},
             {id: "firewood", ap: 2, least: 1, most: 4, scavenge: true, bonus: [{stat: "str", needed: 8, more: [{stat: "firewood", amount: 1}]}, {stat: "str", needed: 12, more: [{stat: "firewood", amount: 1}]}]},
             {id: "wortleaf", ap: 2, least: 1, most: 3},
             {id: "hazel", ap: 1, least: 1, most: 3}],
     ladder: [{task: "pond", level: 2, says: "exploring the nearby pond, a task of your life"}, {task: "wortleaf", level: 3}, {task: "hazel", level: 4}],
     events: ["hedge.nest", "hedge.keeper"],
     fromAge: 7, showAge: 7,
     requires: [],
     opens: "Berries to sell and firewood for the town. As you learn the hedge: the pond beyond it, wortleaf and hazelnuts. No beast lives there."},

    {id: "millpond", name: "Mill Pond", kind: "forage", glyph: "adventure",
     line: "Still water above the mill. Something lives in the reeds, and it is not shy.",
     lines: [{until: 12, text: "The miller says not to go near the reeds. The miller says a great many things."},
             {until: 20, text: "The water is still, and it is never the water that moves first."},
             {until: 99, text: "You've stood at this pond for more years than you can count."}],
     travel: 4, stayMin: 24, stayMax: 30,   // Two months
     mobs: ["rat", "nestrat"],
     spots: [{id: "reeds", ap: 1, least: 1, most: 2}, {id: "fish", ap: 2, least: 1, most: 4}, {id: "clay", ap: 3, least: 1, most: 3}],
     ladder: [{task: "camp", level: 2}, {task: "fish", level: 3}, {task: "nestrat*pack", level: 3}, {task: "clay", level: 4}],
     events: ["pond.heron"],
     encounters: ["pike"],
     fromAge: 10, showFrom: 100,   // No row until he has explored the pond (activitytable.pg's `pond`): one place at a time
     sooner: {flag: "bargemen_tale", fromAge: 9},   // The bargemen's tale (activitytable.pg's `bargemen`)
     requires: [{stat: "know.found.millpond", label: "Explored the nearby pond"}],
     opens: "Reeds to sell and the first beast to fight. As you learn the pond: fish, and clay for the town."},

    {id: "hollow", name: "The Hollow Woods", kind: "hunt", glyph: "adventure",
     line: "Old oaks north of the mill road. The wolves there hunt in threes.",
     lines: [{until: 16, text: "The oaks were old when Bellmoor was a ford. They don't mind a child."},
             {until: 22, text: "The wolves know the hour you come. You're learning theirs."},
             {until: 99, text: "The wood hasn't changed. You walk it slower, and see more."}],
     travel: 15, stayMin: 45, stayMax: 60,   // Three months
     mobs: ["wolf", "boar", "stag"],
     spots: [{id: "ashwood", ap: 3, least: 1, most: 3}],
     ladder: [{task: "camp", level: 2}, {task: "boar", level: 3}, {task: "wolf*pack", level: 4}, {task: "stag", level: 4}],
     events: ["hollow.hunter", "hollow.tracks"],
     encounters: ["grey"],
     fromAge: 14,
     requires: [{stat: "know.study.hedgerows", label: "The Hedgerows known 4 of 4", needed: walkKnobs.studyLevels[3]},
                {stat: "bow_learned", label: "Learned the bow, or a lodge in town", anyOf: ["bow_learned", "town.lodge"]}, {stat: "str", needed: 8}],
     opens: "A lone wolf to hunt and ash wood for the town. As you learn the wood: the boar, the packs and the White Stag."},

    {id: "quarry", name: "The Quarry Road", kind: "forage", glyph: "forge",
     line: "The cut road to the old quarry. Nobody mends it, and the stone lies where it fell.",
     lines: [{until: 16, text: "Nobody mends the road, and everybody complains of it."},
             {until: 22, text: "The stone is free to whoever carries it, which is why it is still here."},
             {until: 99, text: "You could walk the cut road blind. The adders would rather you didn't."}],
     travel: 5, stayMin: 24, stayMax: 30,   // Two months
     mobs: ["adder", "beetle"],
     spots: [{id: "stone", ap: 3, least: 1, most: 2}, {id: "wortleaf", ap: 2, least: 1, most: 2}],
     ladder: [{task: "camp", level: 2}, {task: "wortleaf", level: 3}, {task: "beetle*pack", level: 3}],
     events: ["quarry.cart"],
     encounters: ["shell"],
     fromAge: 14,
     requires: [{stat: "know.study.millpond", label: "Mill Pond known 4 of 4", needed: walkKnobs.studyLevels[3]}],
     opens: "Stone for the town, and an adder or two under it. As you learn the road: wortleaf."},

    // A man's walk, and the Collegium's: the lights there are workings that an edge goes through
    // as through smoke, the hounds go stiff in the cold and the leech mass mends but where it
    // burns. It is where the town's last levels are found (bog iron, pitch, wisp-glass), and the
    // Lantern Mother, who keeps calling her lights, teaches the wisp
    {id: "marsh", name: "Millbrook Marsh", kind: "hunt", glyph: "magic",
     line: "Below the mill the brook loses itself in reeds and peat. Lights move there at night, and nobody follows them twice.",
     lines: [{until: 22, text: "The millers' children are told the lights are lost travellers. They are not travellers."},
             {until: 30, text: "You know which tussocks hold your weight, and which lights hold still."},
             {until: 99, text: "The marsh has taken a little more of the mill road every year you've walked it."}],
     travel: 12, stayMin: 50, stayMax: 60,   // Three months
     mobs: ["light", "hound", "leech"],
     spots: [{id: "pitch", ap: 2, least: 1, most: 3}, {id: "bog_iron", ap: 3, least: 1, most: 2}],
     ladder: [{task: "camp", level: 2}, {task: "bog_iron", level: 3}, {task: "hound*pack", level: 3}, {task: "leech", level: 4}],
     events: ["marsh.causeway"],
     encounters: ["lantern"],
     fromAge: 18,
     requires: [{stat: "know.study.quarry", label: "The Quarry Road known 4 of 4", needed: walkKnobs.studyLevels[3]}],
     opens: "Marsh lights and bog hounds to fight, and pitch for the town's last works. As you learn the marsh: bog iron, the hounds' packs and the leech mass."}
]

const walkMobs = [
    // Mill Pond: where a boy learns to fight. One rat at a time, a nest of them, and the pike
    {id: "rat", name: "Water rat", many: "water rats", pack: "", lone: "", rarity: "common", packSize: 1, holdsBack: 0,
     about: "Fat on the miller's grain, and not afraid of you.",
     hp: 14, least: 3, most: 5, armour: 0, ward: 0, quick: 5, awareness: 3, poise: 0, verb: "bites",
     moves: {bite: {name: "Bite", line: "A quick nip at whatever is nearest."},
             circle: {name: "Skitter", line: "It backs off and looks for a way round."}},
     script: ["bite", "circle"],
     lesson: "The water rat's lesson: it bites and backs off, and backs off again. Strike as it comes in.",
     loot: [{id: "hides", chance: 75, least: 1, most: 2}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "nestrat", name: "Nest rat", many: "nest rats", pack: "Rat nest", lone: "A nest rat", rarity: "common", packSize: 4, holdsBack: 0, roles: ["swarm"],
     about: "Small and many, and all of them at once. One blow ends one of them; it is the count that hurts.",
     hp: 6, least: 1, most: 3, armour: 0, ward: 0, quick: 6, awareness: 4, poise: 0, verb: "bites",
     moves: {bite: {name: "Bite", line: "Small teeth, and more of them than you can watch."},
             circle: {name: "Scatter", line: "They scatter and come back from every side."}},
     script: ["bite", "bite", "circle"],
     lesson: "The nest's lesson: a blow at every one of them is worth three at one.",
     loot: [{id: "hides", chance: 25, least: 1, most: 1}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "pike", name: "The Old Pike", many: "old pikes", pack: "", lone: "", rarity: "rare", packSize: 1, holdsBack: 0,
     about: "Older than the mill, the millers say, and longer than a man. The water goes still before it comes.",
     hp: 60, least: 6, most: 9, armour: 1, ward: 0, quick: 4, awareness: 6, poise: 20, verb: "bites", resist: {pierce: -25},
     moves: {circle: {name: "Still water", line: "The water goes flat and quiet. What comes next comes fast."},
             maul: {name: "Lunge", line: "All of it out of the water at once, jaws first."}},
     script: ["circle", "maul"],
     lesson: "The pike's lesson: when the water goes still, defend.",
     loot: [{id: "fish", chance: 100, least: 3, most: 5}, {id: "page", chance: 100, least: 1, most: 1}]},

    // The Hollow Woods: packs and a brute, a rare stag, and the wolves' leader
    {id: "wolf", name: "Wolf", many: "wolves", pack: "Wolf pack", lone: "A lone wolf", rarity: "common", packSize: 3, holdsBack: 2,
     about: "Lean and grey. It never comes alone for long.",
     hp: 16, least: 3, most: 5, armour: 1, ward: 0, quick: 9, awareness: 8, poise: 0, verb: "bites",
     moves: {bite: {name: "Bite", line: "It goes for the leg, to bring you down."},
             circle: {name: "Circle", line: "It keeps its distance and looks for an opening."},
             hold: {name: "Hang back", line: "It waits behind the others, for one of them to fall."}},
     script: ["bite", "circle", "bite"],
     lesson: "The wolf's lesson: a pack waits on its leader, and the ones behind wait for one in front to fall.",
     loot: [{id: "pelts", chance: 100, least: 1, most: 2}, {id: "fangs", chance: 40, least: 1, most: 2}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "oldgrey", name: "The Old Grey", many: "old greys", pack: "", lone: "", rarity: "rare", packSize: 1, holdsBack: 0, roles: ["leader"],
     about: "Grey to the muzzle and bigger than any wolf has a right to be. The pack goes where he goes, and is quicker for it.",
     hp: 55, least: 6, most: 9, armour: 1, ward: 0, quick: 11, awareness: 12, poise: 25, verb: "bites",
     moves: {bite: {name: "Bite", line: "It goes for the throat, and holds."},
             circle: {name: "Circle", line: "He watches, and his wolves move with him."},
             maul: {name: "Spring", line: "His whole weight, from further than a wolf can leap."}},
     script: ["bite", "circle", "maul"],
     phases: [{at: 50, line: "The Old Grey howls. The wood answers.", quick: 13, calls: {mob: "wolf", count: 1}}],
     lesson: "The Old Grey's lesson: while he stands, his wolves are quicker. Hurt him and the wood answers.",
     loot: [{id: "pelts", chance: 100, least: 1, most: 2}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "boar", name: "Boar", many: "boars", pack: "", lone: "", rarity: "uncommon", packSize: 1, holdsBack: 0, roles: ["brute"],
     about: "Old, heavy, and of the opinion that the wood is his. An edge slides off its hide.",
     hp: 32, least: 5, most: 8, armour: 2, ward: 0, quick: 5, awareness: 6, poise: 20, verb: "gores", resist: {cut: 50, blunt: -25},
     moves: {bite: {name: "Gore", line: "A sideways rip of the tusks."},
             maul: {name: "Charge", line: "Its whole weight, head down."},
             circle: {name: "Paw the ground", line: "It gathers itself. What comes next is worse."}},
     script: ["circle", "bite", "maul"],
     lesson: "The boar's lesson: an edge slides off its hide, but a hammer does not. When it paws the ground, the charge comes next.",
     loot: [{id: "hides", chance: 100, least: 1, most: 3}, {id: "fangs", chance: 40, least: 1, most: 3}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "stag", name: "White Stag", many: "white stags", pack: "", lone: "", rarity: "rare", packSize: 1, holdsBack: 0, roles: ["flees"],
     about: "White as a shroud. The Keep's hunters have followed it for years. Hurt, it does not stay.",
     hp: 30, least: 5, most: 8, armour: 1, ward: 0, quick: 14, awareness: 14, poise: 0, verb: "strikes", resist: {pierce: -25},
     moves: {bite: {name: "Antlers", line: "A lowered head and a toss."},
             circle: {name: "Wheel away", line: "It is gone between the oaks, and back from another side."}},
     script: ["circle", "circle", "bite"],
     lesson: "The White Stag's lesson: it does not stay to be killed. Hurt it, and it is gone at its next turn.",
     loot: [{id: "hides", chance: 100, least: 2, most: 3}, {id: "antler", chance: 50, least: 1, most: 1}, {id: "page", chance: 100, least: 1, most: 1}]},

    // The Quarry Road: quick adders, and shells an edge cannot open
    {id: "adder", name: "Stone adder", many: "stone adders", pack: "", lone: "", rarity: "uncommon", packSize: 1, holdsBack: 0, roles: ["skirmisher"],
     about: "The colour of the stone it sleeps on. Faster than the eye.",
