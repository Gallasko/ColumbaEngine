    {id: "light", name: "Marsh light", many: "marsh lights", pack: "Marsh lights", lone: "A marsh light", rarity: "common", packSize: 4, holdsBack: 0, roles: ["swarm", "unnatural"],
     about: "A pale flame a hand high, over water that should not hold it. An edge goes through it as through smoke; a blessing does not.",
     hp: 8, least: 4, most: 6, armour: 0, ward: 0, quick: 10, awareness: 8, poise: 0, verb: "sears", resist: {cut: 75, pierce: 75, blunt: 50, holy: -50},
     moves: {bite: {name: "Cold fire", line: "It comes close and burns without heat: a working, that a ward turns and armour does not.", kind: "spell"},
             circle: {name: "Drift", line: "It drifts off over the water, and comes back from another side."}},
     script: ["bite", "circle"],
