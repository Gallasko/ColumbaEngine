     loot: [{id: "pitch", chance: 60, least: 1, most: 2}, {id: "page", chance: 100, least: 1, most: 1}]},

    {id: "lantern", name: "The Lantern Mother", many: "lantern mothers", pack: "", lone: "", rarity: "rare", packSize: 1, holdsBack: 0, roles: ["unnatural"],
     about: "A tall grey shape over the deepest pool, holding a lamp that is not a lamp. Every light of the marsh is hers, and she calls them home.",
     hp: 80, least: 6, most: 9, armour: 0, ward: 3, quick: 8, awareness: 12, poise: 30, verb: "sears", resist: {cut: 50, pierce: 50, blunt: 25, holy: -50},
     moves: {bite: {name: "Lamplight", line: "The lamp turns on you, and its light is cold: a working.", kind: "spell"},
             circle: {name: "Lift the lamp", line: "She raises her lamp, and the marsh goes dark around it."},
             maul: {name: "Drowning light", line: "All of the lamp's light at once, as cold as the bottom of the pool: a working.", kind: "spell"}},
     script: ["bite", "circle", "maul"],
     phases: [{at: 75, line: "The Lantern Mother lifts her lamp. A light comes to it over the water.", calls: {mob: "light", count: 1}},
              {at: 50, line: "The lamp burns higher, and another light answers it.", quick: 10, calls: {mob: "light", count: 1}},
              {at: 25, line: "The lamp gutters. The last of her lights comes to it.", calls: {mob: "light", count: 1}}],
     lesson: "The Lantern Mother's lesson: she calls a light each time she is hurt. Bless the blade, or end her lights all at once.",
     loot: [{id: "pitch", chance: 100, least: 2, most: 3}, {id: "page", chance: 100, least: 1, most: 1}]},

    // A story's own (storylib.pg): no place lists them, so no walk meets them. `story`: of a
    // story only (no lesson, nothing learned of it); `level`: how well he knows it there (a story
    // walks no zone: expeditionlib.pg's `mobLevel`); `spares`: its blows always leave him one
    // Vitality, it brings nobody down; `turns`: time is called after so many of his turns, and a
    // fight neither side has lost is held (a story's test or tile may say its own).
    // The practice dummy falls in two or three turns to a boy's spark; the examination's to a mage
    // of the pass (Intelligence 12, Arcana 1, one bolt), the first in three or four turns (his
    // two bolts) and both in seven or eight, most often inside the examination's ten
    {id: "dummy", name: "Practice dummy", many: "practice dummies", pack: "Practice dummies", lone: "A practice dummy", rarity: "common", packSize: 1, holdsBack: 0,
     story: true, spares: true, level: 3, turns: 10,
     about: "Straw in sacking on a post, with an arm that swings round when it is struck.",
     hp: 16, least: 1, most: 1, armour: 0, ward: 0, quick: 2, awareness: 1, poise: 0, verb: "swings round",
     moves: {hold: {name: "Stand", line: "It stands on its post and waits to be struck."},
             bite: {name: "Swing", line: "Its arm comes round on the post: a knock, no more."}},
     script: ["hold", "hold", "bite"],
     lesson: "",
     loot: []},

    {id: "exam_dummy", name: "Examination dummy", many: "examination dummies", pack: "The examination dummies", lone: "An examination dummy", rarity: "common", packSize: 2, holdsBack: 0,
     story: true, spares: true, level: 3, turns: 10,
     about: "Oak and old leather on a post. The masters watch it, and write.",
     hp: 24, least: 1, most: 2, armour: 0, ward: 0, quick: 3, awareness: 1, poise: 0, verb: "swings round",
     moves: {hold: {name: "Stand", line: "It stands on its post, and the masters write."},
             bite: {name: "Swing", line: "Its arm comes round on the post, harder than the practice dummy's."}},
     script: ["hold", "bite"],
     lesson: "",
     loot: []},

    // The outskirts' slime (storytable.pg): a story's own and in no zone. Weak and slow, and it
    // shows what it means to do before it does it: it oozes toward him, which does nothing (a
    // `circle`, fightlib.pg's `harmless`), then slaps (its `bite`, the one blow). The panel says
    // which is coming: that is the lesson of the fight. It cannot bring him down. A boy of 6y11m
    // (Strength 5-7, Dexterity 6-7) falls on it in three to five turns with a plain strike (blow
    // 7-10, 18 Vitality: two blows or three, a miss or two more). It is the one beast that leaves
    // four pages, a sodden sheaf out of the ditch it crept from: the market's lot, so that the
    // first page a life carries home sells for its coin. Every other beast leaves one. No lesson
    {id: "slime", name: "Slime", many: "slimes", pack: "Slimes", lone: "A slime", rarity: "common", packSize: 1, holdsBack: 0,
     story: true, spares: true, level: 1, turns: 10,
     about: "A grey, shivering puddle that crept out of the ditch. It hasn't made up its mind about you yet.",
     hp: 18, least: 1, most: 3, armour: 0, ward: 0, quick: 3, awareness: 1, poise: 0, verb: "slaps",
     moves: {circle: {name: "Ooze", verb: "oozes toward you", line: "It sags toward you across the mud, slow as a spill. It does nothing else."},
             bite: {name: "Slap", line: "It heaves up a lump of itself and flings it, wet and cold."}},
     script: ["circle", "bite"],
     lesson: "",
     loot: [{id: "page", chance: 100, least: 4, most: 4}]}
]

// What a walk may meet besides one beast or a pack of it: beasts of several kinds in one fight
// (encounterlib.pg). `foes` [{mob, count}] in the order they stand; listed once the place is
// known `level` of 4, found as a beast of its `rarity` is; `boss` (bool), `gives` [{stat, amount}]
// and `lore` (a line for the life's log) are a boss's
const walkEncounters = [
    // Mill Pond's: the pike under the weir, for a boy who has learned to defend
    {id: "pike", name: "The Old Pike", line: "Under the weir, where the water is deepest. When the water goes still, it comes.",
     foes: [{mob: "pike", count: 1}], boss: true, level: 4, rarity: "rare",
     gives: [{stat: "pike_jaw", amount: 1}, {stat: "pike_slain", amount: 1}],
     lore: "The Old Pike is dead. The millers will say it was older than the mill until there is no one left who saw it."},

    // The Quarry Road's: the Old Shell, that a hammer opens
    {id: "shell", name: "The Old Shell", line: "In the deepest cut of the quarry, a shell the size of a cart. It doesn't move for a child.",
     foes: [{mob: "oldshell", count: 1}], boss: true, level: 4, rarity: "rare",
     gives: [{stat: "shell_plate", amount: 1}, {stat: "shell_slain", amount: 1}, {stat: "know.fam.mole", amount: 1}],
     lore: "Under the Old Shell, where it had lain for years, the quarry stone is carved: marks no quarryman made."},

    // The Hollow Woods': the wolves' leader, with his own
    {id: "grey", name: "The Old Grey", line: "The pack's leader, with two of his wolves.",
     foes: [{mob: "oldgrey", count: 1}, {mob: "wolf", count: 2}], boss: true, level: 4, rarity: "rare",
     gives: [{stat: "grey_pelt", amount: 1}, {stat: "grey_slain", amount: 1}, {stat: "know.fam.weaver", amount: 1}],
     lore: "The Old Grey is dead. The Hollow is quiet for a season, and the Keep's hunters drink to you."},

    // Millbrook Marsh's: the Lantern Mother over the deepest pool, with two of her lights
    {id: "lantern", name: "The Lantern Mother", line: "Over the deepest pool, a lamp held by something tall. Two lights wait by it, and more will come.",
     foes: [{mob: "lantern", count: 1}, {mob: "light", count: 2}], boss: true, level: 4, rarity: "rare",
     gives: [{stat: "wisp_glass", amount: 1}, {stat: "lantern_slain", amount: 1}, {stat: "know.fam.wisp", amount: 1}],
     lore: "The Lantern Mother's lamp lies in the pool, dark. In its glass a small light still moves, and it follows you home."}
]

