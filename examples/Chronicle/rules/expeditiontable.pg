// What a fight offers besides the four things anyone can do (strike, defend, take a remedy,
// flee): what he has learned in his life, and nothing he has not, all of it in every fight.
// `kind`: a "blow" of the body, a "spell" of the mind, a "way" (a trick or a stance that deals
// nothing). `damage`: cut, pierce, blunt, fire, frost, storm, holy, or "" for what deals nothing.
// `knows` is the flags that teach it (any one of them: what a class gives, or a work here and
// there, activitytable.pg), `where` it is learned, as its tile says. `power` and `hit` are
// against a strike's (percent of its blow, points of its chance); a spell's blow is counted from
// his Intelligence and Arcana, not from his Strength and Arms. `weight`: the time it holds him
// before his next action, percent of an ordinary move. `breath: 0` costs nothing, and says
// nothing of breath: who has learned only that is not told of it. `cool` is his actions before it
// can be used again; `all` strikes every beast standing; `holds` deals nothing, and the beast
// aimed at loses its next move (`mark`: and the element it leaves). `finisher` asks his momentum
// full and spends it (the Keep's rhythm); `opener` costs no time as the first thing he does in a
// fight; `exposes` leaves the beast exposed; `effect`: "step" (dodge far up until his next
// action), "read" (the beast known 3 of 4 for the fight), "wind" (breath back and a little
// Vitality), "brace" (a defend that keeps his momentum). `trains` is the part a technique used
// often raises (its ranks).
const walkTechniques = [
    // A boy's: what the wooden blade taught him, the edge or the point and never both
    // (activitytable.pg's `slashes` and `stabs`). A better way to strike: it costs no breath and
    // waits for nothing, and every blow that lands builds momentum
    {id: "slash", name: "Slash", kind: "blow", damage: "cut", breath: 0, cool: 0, power: 130, hit: -10, weight: 110, all: false, holds: false, trains: "str",
     knows: ["slash_learned"], where: "THE WOODEN BLADE", line: "The whole arm behind it: it bites deeper, and misses more"},
    {id: "thrust", name: "Thrust", kind: "blow", damage: "pierce", breath: 0, cool: 0, power: 90, hit: 15, weight: 70, all: false, holds: false, trains: "dex",
     knows: ["thrust_learned"], where: "THE WOODEN BLADE", line: "The point, straight and quick: it seldom misses, and goes through armour"},

    // The smithy's: who has learned to temper swings a hammer as he would at the anvil, and
    // what turns an edge does not turn a hammer
    {id: "hammer", name: "Hammer blow", kind: "blow", damage: "blunt", breath: 0, cool: 0, power: 110, hit: 0, weight: 120, all: false, holds: false, trains: "str",
     knows: ["smith_apprentice"], where: "THE SMITHY", line: "A heavy blow that no hide turns"},

    // The outskirts': what a boy who looked for wild animals picked up to fend them off, a
    // stick swung like the smith's hammer, a little slower than a strike
    {id: "stick", name: "Stick blow", kind: "blow", damage: "blunt", breath: 0, cool: 0, power: 115, hit: -5, weight: 120, all: false, holds: false, trains: "str",
     knows: ["outskirts.animals"], where: "THE OUTSKIRTS", line: "A fallen branch swung with both hands: it lands harder, and a little later"},

    // The yard's bow: a shot before the beast closes
    {id: "bow", name: "Bow shot", kind: "blow", damage: "pierce", breath: 0, cool: 0, power: 90, hit: 10, weight: 100, all: false, holds: false, opener: true, trains: "dex",
     knows: ["bow_learned"], where: "THE YARD", line: "An arrow loosed before it's on you: the first one costs no time"},

    // The Bellmoor Boys' oath: a kick where it hurts, and the beast is open
    {id: "kick", name: "Dirty kick", kind: "blow", damage: "blunt", breath: 0, cool: 2, power: 50, hit: 10, weight: 60, all: false, holds: false, exposes: 1, trains: "dex",
     knows: ["boys_sworn"], where: "THE BELLMOOR BOYS", line: "Quick and low: it leaves the beast open to your next blow"},

    // The Keep's: what its sworn men are drilled in, and what a campaign teaches. Finishers:
    // they ask three blows landed first, and spend them
    {id: "heavy", name: "Heavy cut", kind: "blow", damage: "cut", breath: 0, cool: 0, power: 200, hit: -5, weight: 150, all: false, holds: false, finisher: true, trains: "str",
     knows: ["keep_oath", "levy_served"], where: "THE KEEP", line: "A slow, full blow that spends your momentum: half of what the beast resists is gone"},
    {id: "sweep", name: "Sweep", kind: "blow", damage: "cut", breath: 0, cool: 0, power: 90, hit: 0, weight: 150, all: true, holds: false, finisher: true, trains: "str",
     knows: ["veteran"], where: "THE CAMPAIGN", line: "One blow at every beast standing, that spends your momentum"},

    // Learned here and there: the streets teach it, and so does the Hidden Hand
    {id: "feint", name: "Feint and step", kind: "blow", damage: "pierce", breath: 1, cool: 1, power: 80, hit: 20, weight: 60, all: false, holds: false, trains: "dex",
     knows: ["street_known", "hidden_hand"], where: "THE STREETS", line: "A sure blow, and you're hard to bite after it"},

    // Ways: what deals nothing and changes the fight. The smuggler's fistful of sand (he has to
    // find more sand before the next), the rooftops' quick feet, the Watch's way of taking a
    // blow, and the yard's breathing
    {id: "sand", name: "Sand in the eyes", kind: "way", damage: "", breath: 0, cool: 3, power: 0, hit: 0, weight: 60, all: false, holds: true,
     knows: ["smuggler_runner"], where: "THE SMUGGLER", line: "The beast aimed at is blinded, and loses its next move"},
    {id: "step", name: "Step aside", kind: "way", damage: "", breath: 0, cool: 2, power: 0, hit: 0, weight: 50, all: false, holds: false, effect: "step",
     knows: ["rooftop_runner", "outskirts.children"], where: "THE ROOFTOPS", line: "Light on your feet: what comes before your next action seldom finds you"},
    {id: "brace", name: "Brace", kind: "way", damage: "", breath: 0, cool: 0, power: 0, hit: 0, weight: 100, all: false, holds: false, effect: "brace", trains: "discipline",
     knows: ["watch_known"], where: "THE WATCH", line: "Feet set, shield up: most of what comes is taken, and your momentum kept"},
    {id: "wind", name: "Second wind", kind: "way", damage: "", breath: 0, cool: 4, power: 0, hit: 0, weight: 60, all: false, holds: false, effect: "wind",
     knows: ["yard_breathing"], where: "THE YARD'S BREATHING", line: "In on the step, out on the blow: breath back, and a little strength"},

    // A boy's first workings: reading a beast, a spark, a rime, and the chapel's blessing. The
    // Collegium's elemental basics teach the spark and the rime too, and a storm cantrip of the
    // same weight, the static (storytable.pg's `collegium`)
    {id: "read", name: "Read the beast", kind: "spell", damage: "", breath: 1, cool: 0, power: 0, hit: 0, weight: 60, all: false, holds: false, effect: "read",
     knows: ["letters", "outskirts.nature"], where: "YOUR LETTERS", line: "You see what it is and what it means to do"},
    {id: "spark", name: "Spark", kind: "spell", damage: "fire", breath: 1, cool: 0, power: 60, hit: 15, weight: 100, all: false, holds: false, trains: "int",
     knows: ["forbidden_read", "spark_taught"], where: "THE FORBIDDEN SHELF", line: "A small fire from nothing: it leaves the beast burning"},
    {id: "rime", name: "Rime", kind: "spell", damage: "frost", breath: 1, cool: 0, power: 60, hit: 15, weight: 100, all: false, holds: false, trains: "int",
     knows: ["mara_student", "rime_taught"], where: "MARA", line: "A breath of frost: it leaves the beast chilled, and frost on a burning beast shatters"},
    {id: "static", name: "Static", kind: "spell", damage: "storm", breath: 1, cool: 0, power: 60, hit: 15, weight: 100, all: false, holds: false, trains: "int",
     knows: ["static_taught"], where: "THE ELEMENTAL BASICS", line: "A crackle between the fingers: it leaves the beast shocked, and storm on a burning beast flares"},
    {id: "blessing", name: "Blessing", kind: "spell", damage: "holy", breath: 1, cool: 1, power: 80, hit: 15, weight: 100, all: false, holds: false, trains: "int",
     knows: ["anselm_trust"], where: "FATHER ANSELM", line: "The office said aloud: what is not of this world cannot bear it"},

    // The Collegium's: the first working of each element, taught by its course (storytable.pg's
    // `collegium`: a drop-out keeps it), and what Magister Orin shows his assistant
    {id: "firebolt", name: "Firebolt", kind: "spell", damage: "fire", breath: 2, cool: 1, power: 100, hit: 15, weight: 100, all: false, holds: false, trains: "arcana",
     knows: ["fire_course"], where: "THE FIRE COURSE", line: "A working thrown like a stone: it seldom misses, and leaves the beast burning"},
    {id: "frostbolt", name: "Frostbolt", kind: "spell", damage: "frost", breath: 2, cool: 1, power: 100, hit: 15, weight: 100, all: false, holds: false, trains: "arcana",
     knows: ["frost_course"], where: "THE FROST COURSE", line: "A working thrown like a stone: it seldom misses, and leaves the beast chilled"},
    {id: "stormbolt", name: "Stormbolt", kind: "spell", damage: "storm", breath: 2, cool: 1, power: 100, hit: 15, weight: 100, all: false, holds: false, trains: "arcana",
     knows: ["storm_course"], where: "THE STORM COURSE", line: "A working thrown like a stone: it seldom misses, and leaves the beast shocked"},
    {id: "binding", name: "Binding word", kind: "spell", damage: "", breath: 2, cool: 3, power: 0, hit: 0, weight: 100, all: false, holds: true,
     knows: ["orin_known"], where: "MAGISTER ORIN", line: "The beast aimed at is held, and loses its next move"},

    // A second calling's: what the Elemental Chair teaches, and the elements a Spellwright has
    // bound that a fight can use (activitytable.pg's `bind`: its third and its fourth)
    {id: "frostbind", name: "Frostbind", kind: "spell", damage: "", breath: 0, cool: 3, power: 0, hit: 0, weight: 100, all: false, holds: true, mark: "frost",
     knows: ["spellwright"], where: "THE ELEMENTAL CHAIR", line: "The beast aimed at is held in frost, and loses its next move"},
    {id: "firebolt2", name: "Firebolt II", kind: "spell", damage: "fire", breath: 2, cool: 1, power: 150, hit: 15, weight: 100, all: false, holds: false, trains: "arcana",
     knows: ["firebolt2_bound"], where: "THE BOUND ELEMENTS", line: "The first working, bound to you: it bites half again as deep"},
    {id: "chain", name: "Chain lightning", kind: "spell", damage: "storm", breath: 3, cool: 3, power: 90, hit: 0, weight: 120, all: true, holds: false, trains: "arcana",
     knows: ["chain_bound"], where: "THE BOUND ELEMENTS", line: "One working through every beast standing: it leaves them shocked"}
]

// `deals` and `takes` are percent of what he deals and of what he takes.
const walkStances = [
    {id: "balanced", name: "Balanced", deals: 100, takes: 100, line: "Neither more nor less"},
    {id: "aggressive", name: "Aggressive", deals: 125, takes: 125, line: "You hit harder and are hit harder"},
    {id: "cautious", name: "Cautious", deals: 80, takes: 70, line: "You hit less hard and are hit less"}
]
