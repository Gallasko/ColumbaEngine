// Chronicle rules: the builds to try a fight with
// -----------------------------------------------
// A life of each rhythm at the age it walks, as the fight matrix measures it
// (solver/matrix.pg) and as the game opens it to be played (--build <id>, LifeScene::applyBuild,
// through expedition.pg's ask "builds"): what he is, what he has learned and what he carries.
// The same table for both, so what is played is what is measured. Imported by expedition.pg and
// by solver/matrix.pg; never loaded itself.
//
// A build: {id, name, about, age, boy (a boy of an early path: the matrix's checks of childhood),
// approach (how the matrix meets a beast: open, ambush, trap), stats {stat: value}}. Every build
// carries 2 remedies, 4 rations and 5 coin, and starts whole (`vitmax` is his `vit`).

import "string"
import "algorithm"

fun withBag(stats)
{
    var held = merge({remedy: 2, rations: 4, coin: 5}, stats)

    held.vitmax = held.vit

    return held
}

// The builds as expedition.pg hands them to the game, each one flat: {id, name, about, age,
// "stat.<stat>": value, "know.visit.<zone>": 1 and "know.study.<zone>": 10 for every place}
fun buildRows()
{
    var rows = []

    for (var i = 0; i < len(testBuilds); i++)
    {
        var b = testBuilds[i]
        var row = {id: b.id, name: b.name, about: b.about, age: b.age}

        for (var k : b.stats)
        {
            row["stat." + k] = b.stats[k]
        }

        for (var z = 0; z < len(walkZones); z++)
        {
            row["know.visit." + walkZones[z].id] = 1
            row["know.study." + walkZones[z].id] = walkKnobs.studyLevels[3]
        }

        push(rows, row)
    }

    return rows
}

var testBuilds = [
    {id: "plain", name: "A plain boy", age: 14, boy: true, approach: "open",
     about: "A boy of fourteen who has learned nothing for a fight: a strike, a defend, a remedy.",
