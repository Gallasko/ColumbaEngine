    {id: "spellblade", name: "A spell-blade of the Keep", age: 25, boy: false, approach: "open",
     about: "Sworn to the Keep after leaving the Collegium: the heavy cut and the sweep, the slash, the hammer, the brace, his second wind, and a Firebolt.",
     stats: withBag({str: 16, dex: 10, int: 8, vit: 90, arms: 8, discipline: 6,
                     keep_oath: 1, veteran: 1, slash_learned: 1, smith_apprentice: 1, watch_known: 1, yard_breathing: 1,
