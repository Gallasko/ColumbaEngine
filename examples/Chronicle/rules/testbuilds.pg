     about: "Left the Collegium after its fire course: Firebolt, spark and rime, reads the beast, and three fire flasks.",
     stats: withBag({str: 8, dex: 9, int: 18, vit: 80, arcana: 2, lore: 5,
                     fire_course: 1, "dropout.collegium": 1, letters: 2, forbidden_read: 1, mara_student: 1, flask: 3})},

    // The spell-blade: a man of the Keep who had left the Collegium first, and throws a Firebolt
