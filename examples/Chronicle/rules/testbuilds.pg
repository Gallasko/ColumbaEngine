    {id: "blade", name: "A boy of the blade", age: 14, boy: true, approach: "open",
     about: "The wooden blade's slash, the smithy's hammer, the levy's heavy cut, the Watch's brace and the yard's breathing.",
     stats: withBag({str: 11, dex: 9, int: 7, vit: 65, arms: 3, discipline: 2,
                     slash_learned: 1, smith_apprentice: 1, levy_served: 1, watch_known: 1, yard_breathing: 1})},

    {id: "scholar", name: "A boy of letters", age: 15, boy: true, approach: "open",
