// Chronicle rules: a walk outside the town
// ----------------------------------------
// Loaded by the Life screen (Core/rulevm.h, Rules::walk). One script answers everything a walk
// asks: the days on site, a fight, the records kept and a record walked again. It keeps nothing
// between two runs: the walk as it stands is handed in, and handed back as the run leaves it.
//
// Input:  `age`, `character` (his stats; with them, as the town is, what the world knows:
//         "know.visit.<zone>", "know.study.<zone>", "know.observe.<mob>", "know.fights.<mob>",
//         "know.drop.<mob>.<item>"), `who` (his name),
//         `seed` (a number: the dice of a walk that begins, or of a record walked again),
//         `ask`: what is asked,
//           "enter"    a walk begins: `act.target` is the zone; with `act.kind` "story", a story
//                      begins (storytable.pg, storylib.pg): `act.target` is the story;
//           "act"      he does something: `act` is {kind, target, count}. On site: seek (target a
//                      beast, count 1 or more for its pack), observe, gather (target an item),
//                      study, rest, remedy, leave; in a story: tile (target its id, or the kind
//                      `tile.<id>` as the page sends it), leave. Before an event's card: option (target its
//                      id). In a fight: pick (target a row of the menu), target (count the
//                      beast), do, move (target a row of the menu: that move, now), auto, step,
//                      back;
//           "look"     nothing: the pages of the walk as it stands;
//           "records"  the Adventure page: the records kept and the form of a queue;
//           "begin"    a record is about to be walked again (`replay`, its id): what it takes is
//                      taken, or `blocked` says what the bag lacks;
//           "term"     he is home from it: the record is folded into him.
//         The walk as it stands: `run` {zone, mode, ap, hp, ...}, `record` (its steps),
//         `marks` (what each step used, gave, killed and taught: {step, kind, id, n}), and in a
//         fight `fight`, `foes`, `account`.
//         For the records: `recipes` (one table a record kept: {id, zone, steps, ap, hp, months,
//         walkedAt, kills}), `recipeSteps` and `recipeMarks` (their steps and marks, each with
//         its `recipe`), `walks` (the Adventure rows of the Life page: {zone, listed, locked,
//         months, until}), `queue` {recipe, count, stop, value, item}.
// Output: the walk as the run leaves it (`run`, `record`, `marks`, `fight`, `foes`, `account`);
//         `after`, the character as it leaves him; `entries`, the lines it writes in the life's
//         log; and what the pages show:
//           on site   `site` (the head, the strip and the words), `seeks`, `works`, `card` and
//                     `options` (an event), `bag`, `taken`, `home`;
//           a fight   `duel`, `menu`, `targets`, `order`, `hero`, `foe`, `preview`, `timeline` (who acts when, in time, as it stands and for each move);
//           records   `shelf`, `form`, `stops`;
//         `recipe`, the figures a finished walk is kept under (`zone` "" until it is over);
//         `builds`, asked "builds": the builds to try a fight with (testbuilds.pg), flat;
//         `site`, asked "plan" (`act.target` a story): the story's plan, flat (storylib.pg's
//         `planRow`), for the tests and the solver;
//         `blocked` ("" or what the bag lacks for a record), `stopped` ("" or why a queue ends).
//
// A step of the record: {n, kind, target, count, ap, hp, text, gave, used, figure, tone, glyph,
// once}. Everything a walk by the record needs is in the steps and their marks: it is a fold
// over them (expeditionlib.pg's `replayTerm`), with no fight fought again.

import "string"
import "math"
import "algorithm"
import "lib"
import "expeditionlib"
import "fightlib"
import "fightcalc"
import "fightpage"
import "fightauto"
import "encounterlib"
import "storylib"
import "expeditiontable"
import "storytable"
import "testbuilds"

// The gear the smithy forges, for what it adds in a fight (fightcalc.pg's `gearSum`): a table
// only, after every file of functions
import "economytable"

var errors = []
var entries = []

// The character as the walk leaves him: every stat as it is, then what the run does to it
var after = copy(character)

var site = {mode: "", screen: ""}
var seeks = []
var works = []
var card = {id: "", title: "", text: "", foot: ""}
var options = []
var bag = []
var taken = []
var home = []

var duel = {over: "", mob: ""}
var menu = []
var targets = []
var order = []
var hero = []
var foe = []
var preview = {id: ""}
var timeline = []
var gone = []

var shelf = []
var form = {recipe: ""}
var stops = []
var places = []

var recipe = {zone: ""}
var builds = []
var blocked = ""
var stopped = ""

// A story's months are run by the Life screen between two asks: his Vitality is what they left
// him, not what the last ask did (outside a fight, which no month interrupts)
if ((ask == "act" or ask == "look") and pick(run, "story", "") != "" and pick(run, "found", "") == "")
{
    run.hp = fieldHp()
    run.hpMax = mostOf(after, "vit")
}

// The builds to try a fight with (--build, testbuilds.pg): nothing else is asked with them
if (ask == "builds")
{
    builds = buildRows()
}
else if (ask == "plan")
{
    site = planRow(act.target)
}
else if (ask == "enter" and act.kind == "story")
{
    enterStory(act.target)
}
else if (ask == "enter")
{
    enterZone(act.target)
}
else if (ask == "act")
{
    walkAct(act.kind, act.target, act.count)
}
else if (ask == "begin")
{
    run = {seed: diceFrom(seed)}
    stopped = queueStops()
    blocked = lackOf(marksOf(recipeMarks, replay))

    if (stopped == "" and blocked == "")
    {
        replayBegin(marksOf(recipeMarks, replay))
    }
}
else if (ask == "term")
{
    run = {seed: diceFrom(seed)}
    replayTerm(recipeById(replay), marksOf(recipeSteps, replay), marksOf(recipeMarks, replay))
}

// The pages of a walk under way, or of a story (no zone, no beast to seek, never a record)
if ((ask == "enter" or ask == "act" or ask == "look") and (pick(run, "zone", "") != "" or pick(run, "story", "") != ""))
{
    if (pick(run, "story", "") != "")
    {
        site = storyHead()
        works = storyTiles()
        taken = storyTaken()
        home = storyHome()
        gone = goneRows()
    }
    else
    {
        site = siteHead()
        seeks = seekRows()
        works = workRows()
        taken = takenRows()
        home = homeRows()
    }

    site.screen = "site"
    bag = bagRows()

    if (run.mode == "done")
    {
        site.screen = "done"

        if (pick(run, "story", "") == "")
        {
            recipe = recipeOf()
        }
    }
    else if (run.event != "")
    {
        site.screen = "event"
        card = eventCard()
        options = optionRows()
    }
    else if (run.found != "")
    {
        site.screen = "fight"
        duel = duelHead()
        menu = menuRows()
        targets = targetRows()
        order = orderRows()
        hero = heroRows()
        foe = foeRows()
        preview = previewOf(fight.choice)
        timeline = timelineRows()
    }
}

if (ask == "records" or ask == "begin" or ask == "term")
{
    shelf = shelfRows()
    form = queueForm()
    places = placeRows()

    addFigures(form)

    if (form.recipe != "")
    {
        stops = stopRows(marksOf(recipeMarks, form.recipe))
    }
}
