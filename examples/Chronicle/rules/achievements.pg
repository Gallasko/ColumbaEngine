// Chronicle rules: the deeds worth a line, the guide of a first life, the lore of the town
// -------------------------------------------------------------------------------------
// Input:  none.
// Output: `achievements`, one table per thing the Life screen watches for:
//           {id, kind, asks [{fact, op, value}], gives [{stat, amount}], until [{fact, op, value}],
//            name, entry, say, point, hold, order}
//           kind   "deed" (the default), "guide" or "lore", as below.
//           asks   every one must hold; `fact` is a path the Life screen publishes:
//                  "stat.<key>" (a stat of the character), "done.<activity id>" (the terms
//                  completed; the town's stats too: "stat.town_known", "stat.town.<place id>"),
//                  "life.age", "life.terms" (the terms done in this life, of every
//                  activity), "life.working" (1 while he is at a work, else 0),
//                  "working.<activity id>" (1 while he is at that one; no such fact otherwise), "life.lives"
//                  (which life of the world this is), "life.town" (1 while the Town page is the one
//                  in view), "said.<guide step id>" (1 once that step has been said) or "life.guide" (the last step of the guide
//                  that ended, 0 before the first). On a walk's screens, and a story's:
//                  "walk.screen" ("site", "event" while a card waits for his answer, "fight",
//                  "done"; "" off them), "story.id" (the story he is in, "" for none),
//                  "story.day" (its day, 0 out of one), "fight.turn" (the turn of the fight under
//                  way, 0 for none), "fight.over" (1 once it is over) and "fight.acted" (1 once
//                  he has done something in it: a turn behind him, or it over, a flight too). `op`
//                  is one of ">=", ">", "<=", "<", "==".
// Every entry is reached once in a life and stays reached.
//
// A deed: {id, name, entry, asks, gives}
//           gives  what the character gains the moment it is reached.
//           entry  the line it writes in the log; `name` is what its toast and the ending say.
//
// A guide step: {id, kind: "guide", order, say, point, light, asks, until or hold, pointChosen, sayChosen}
//           The guide walks a first life (`lives` 1, the screen's to check) through its first
//           works: one step at a time, each one sentence and one thing pointed at. The sentence
//           stands on a leaf under what is pointed at, with a button to skip the guide and, for
//           a step that ends with time, one to pass it. A later life has none of it. A step is
//           neither toasted nor logged.
//           order  1, 2, 3...: its place. The step waits for the one before to have ended (the
//                  ask {fact: "life.guide", op: "==", value: order - 1} is added here), so the
//                  steps cannot come out of order. 0 is a step outside the sequence: it waits
//                  for nothing, is kept like a deed and outlives the guide.
//           say    the sentence on the guide's leaf: short, in plain and easy English, said to
//                  the player ("you").
//           point  what the hand points at: "button:begin", "tile:<activity id>",
//                  "holding:<id>" (a row of what he holds), "stat:<key>" (one of his parts),
//                  "tab:<page>" (a page's tab, by its name in small letters: "tab:town"),
//                  "place:<id>" (a place of the town, on its page),
//                  "clock", "log", or "" for nothing. What is not on the page is not pointed at:
//                  the sentence is said alone. A tile of the Life page while another page is
//                  in view has the hand on the Life tab.
//                  On a walk's screens (a story's too): "work:<tile id>" (a work of the day, the
//                  story's tile id without its "tile."), "option:<n>" (the nth answer of the
//                  card, from 0), "move:<id>" (a move of his turn in a fight: "move:strike"),
//                  "foe:<n>" (the nth beast's panel, from 0: its next move is on it), "order"
//                  (the order of the turn) or "walkbutton:do" (the button that does the work
//                  chosen). A step is said on the screens it points at: one of the Life page
//                  waits while a walk's screen is up, one of a walk's while none is (its time,
//                  for one said for a time, runs all the same).
//           untilAge
//                  optional, for a step of the sequence: it is for a boy younger than that. Once
//                  he is that old it is passed over, said or not (the steps of his sixth year:
//                  its works are closed to him at seven).
//           light  optional: what else stays lit with what is pointed at, a list with commas
//                  ("tile:scribe", "stat:dex,stat:int"): the tiles of a choice, his three parts.
//                  For a step with `pointChosen`, choosing any of the tiles lit sends the hand on.
//           world  optional, for a step outside the sequence: true, it is said once in a
//                  world, in whichever life meets it, and never again in a later one (the
//                  town's steps: any life may be the one that explores it). Without it a step
//                  is a first life's only.
//           until  the step ends when these hold; without any it ends after `hold` milliseconds
//                  (5000 when it gives none).
//           pointChosen, sayChosen
//                  for a step that points at a tile (or at a work of a walk's day): what the
//                  hand points at, and what is said, once he has chosen that tile in the list.
//                  A work is begun in two presses, the task then the button: the hand shows the
//                  first, then the second, and goes back to the tile if he lets go of it.
//                  `sayChosen` may be left out: the sentence then stays as it is.
//
// Lore: {id, kind: "lore", entry, asks}
//           entry  a line of the town's story, written in the log when its asks hold: a
//                  sentence or two, read in a narrow column. Nothing else happens: no toast, no
//                  gain. A later life reads them again, in its own order.
//
// The id of a guide step begins with "guide.", the id of a lore line with "lore.": the save and
// the analytics tell them from the deeds by it.
//
// The numbers and the words are placeholders for the game's balance and writing: change them
// here, nothing in C++ moves.

import "string"
import "math"
import "algorithm"
import "lib"

var errors = []

var achievements = [
    {id: "first.coin", name: "First wages", entry: "You held a coin of your own for the first time",
     asks: [{fact: "stat.coin", op: ">=", value: 1}],
     gives: []},
    {id: "carters.road", name: "The carters' road", entry: "Every carter on the Bell road knows you by name",
     asks: [{fact: "done.carters", op: ">=", value: 10}],
     gives: []},
    {id: "sworn", name: "Sworn", entry: "You swore your service to the Keep",
     asks: [{fact: "stat.keep_oath", op: ">=", value: 1}],
     gives: []},
    {id: "admitted", name: "Admitted", entry: "You took your place among the scholars of the Collegium",
     asks: [{fact: "stat.collegium", op: ">=", value: 1}],
     gives: []},
    {id: "trusted", name: "Trusted", entry: "The Hidden Hand counts you as one of its own",
     asks: [{fact: "stat.hidden_hand", op: ">=", value: 1}],
     gives: []},
    {id: "veteran", name: "Veteran", entry: "You came home from the border campaign",
     asks: [{fact: "stat.veteran", op: ">=", value: 1}],
     gives: []},
    {id: "captain", name: "Captain", entry: "You wear the captain's chain of Bellmoor",
     asks: [{fact: "stat.captain", op: ">=", value: 1}],
     gives: []},
    {id: "mage.of.harrow", name: "Mage of Harrow", entry: "You performed the Harrow Working",
     asks: [{fact: "stat.mage_of_harrow", op: ">=", value: 1}],
     gives: []},
    {id: "master.thief", name: "Master Thief", entry: "You emptied the Bellmoor Vault",
     asks: [{fact: "stat.master_thief", op: ">=", value: 1}],
     gives: []},
    {id: "renegade", name: "Renegade", entry: "You took to the Greenwood, past every door the town had shut",
     asks: [{fact: "stat.renegade", op: ">=", value: 1}],
     gives: []},
    {id: "wood.king", name: "King of the Greenwood", entry: "You hold the Greenwood, and the Keep leaves it be",
     asks: [{fact: "stat.wood_king", op: ">=", value: 1}],
     gives: []},

    // The guide of a first life: his sixth year, a work at a time, then the classes at seven
    {id: "guide.begin", kind: "guide", order: 1, untilAge: 7, point: "tile:glean", pointChosen: "button:begin",
     say: "Welcome! Click this task to choose it.",
     sayChosen: "Now press Begin, or double-click the task to start it. Time passes while it runs.",
     asks: [{fact: "life.terms", op: "==", value: 0}],
     until: [{fact: "life.working", op: "==", value: 1}]},
    {id: "guide.rations", kind: "guide", order: 2, untilAge: 7, point: "holding:rations", hold: 4000,
     say: "This is your food. You eat 1 ration each month, so be careful not to run out.",
     asks: [{fact: "done.glean", op: ">=", value: 1}]},
    {id: "guide.flour", kind: "guide", order: 3, untilAge: 7, point: "tile:flour", pointChosen: "button:begin",
     say: "Some tasks pay you coin. Click this one.",
     sayChosen: "Press Begin, or double-click the task.",
     asks: [],
     until: [{fact: "life.working", op: "==", value: 1}]},
    {id: "guide.coin", kind: "guide", order: 4, untilAge: 7, point: "holding:coin", hold: 4000,
     say: "This is your coin. You'll spend it at the market soon.",
     asks: [{fact: "done.flour", op: ">=", value: 1}]},
    // From here the hand stays on the task: two works begun, he knows the Begin button (the
    // author's call, 2026-10-21). The first choice: both tiles are lit
    {id: "guide.choice", kind: "guide", order: 5, untilAge: 7, point: "tile:wheel", light: "tile:scribe",
     say: "You can only do one of these two. One trains your body, the other your mind.",
     asks: [],
     until: [{fact: "life.working", op: "==", value: 1}]},
    {id: "guide.stats", kind: "guide", order: 6, untilAge: 7, point: "stat:int", light: "stat:str,stat:dex", hold: 5000,
     say: "Your stats went up! Each class needs one of them: Strength, Dexterity or Intelligence.",
     asks: [{fact: "life.terms", op: ">=", value: 3}]},
    {id: "guide.tome", kind: "guide", order: 7, untilAge: 7, point: "tile:tome",
     say: "Hover over a task to see what it gives you. This one gives you a keepsake.",
     asks: [],
     until: [{fact: "life.working", op: "==", value: 1}]},
    // Three works and the time for two: they come into the list at six years and four months
    {id: "guide.pick", kind: "guide", order: 8, untilAge: 7, point: "tile:knots", light: "tile:sacks,tile:sing",
     say: "Three tasks, but only time for two. The stopwatch shows how many months you have left to start each one.",
     asks: [{fact: "done.tome", op: ">=", value: 1}, {fact: "life.age", op: ">=", value: 6.3}],
     until: [{fact: "life.working", op: "==", value: 1}]},
    // The market, at six years and eight months: he is short of food by then, and holds the
    // coin of the flour and of the books. It waits for him to be free of the work at hand
    {id: "guide.tomarket", kind: "guide", order: 9, untilAge: 7, point: "tile:tomarket",
     say: "Food is running low, and you have coin. Go to the market.",
     asks: [{fact: "life.age", op: ">=", value: 6.6}],
     until: [{fact: "working.tomarket", op: "==", value: 1}]},
    // The town's own steps come here (below, outside the sequence): its tab, its market, its
    // places. The harvest waits for the last of them
    {id: "guide.harvest", kind: "guide", order: 10, untilAge: 7, point: "tile:harvest",
     say: "This task takes two months: the box in a task's corner says how long. Longer work gives more.",
     asks: [{fact: "said.guide.places", op: ">=", value: 1}],
     until: [{fact: "working.harvest", op: "==", value: 1}]},
    // His age, and what the game is about, said while the harvest is brought in; then the
    // classes, which come into the list the month he is seven (activitytable.pg, `showAge: 7`)
    // so that the hand has them to point at. These two are said at any age: a boy of seven who
    // let the year go by, or a save from before it, is told them and no more
    {id: "guide.clock", kind: "guide", order: 11, point: "clock", hold: 6000,
     say: "This is your age. Your goal: live to at least 30.",
     asks: []},
    // The outskirts (storytable.pg's `outskirts`), the last month of the year: its row, the one
    // work listed at six years and eleven months, then on the walk's screens the lunch, the three
    // paths, the ditch's card, and in the fight the slime, the order of the turn and Strike. Each
    // waits for what it is about to be on the screen, and ends when he has done what it asks (at
    // once if he is past it already). Strike ends on whatever he does in the fight, a flight too:
    // a boy who runs is not told to strike over its end
    {id: "guide.outskirts", kind: "guide", order: 12, untilAge: 7, point: "tile:outskirts",
     say: "Nobody has work for you this month. Click this task to go and see what's past the last houses.",
     asks: [{fact: "life.age", op: ">=", value: 6.9}],
     until: [{fact: "story.id", op: "==", value: "outskirts"}]},
    {id: "guide.lunch", kind: "guide", order: 13, untilAge: 7, point: "work:lunch", pointChosen: "walkbutton:do",
     say: "This is a story. Each day you choose one thing to do. Take your lunch first.",
     sayChosen: "Press the button to do it. You can also double-click the task.",
     asks: [{fact: "story.id", op: "==", value: "outskirts"}],
     until: [{fact: "story.day", op: ">=", value: 2}]},
    {id: "guide.paths", kind: "guide", order: 14, untilAge: 7, point: "work:children", light: "work:nature,work:animals", pointChosen: "walkbutton:do",
     say: "Each path is a different way to spend the day. Pick the one you like: it teaches you a move for later fights.",
     sayChosen: "Press the button to take this path. The other two close.",
     asks: [{fact: "story.day", op: ">=", value: 2}],
     until: [{fact: "story.day", op: ">=", value: 3}]},
    {id: "guide.ditch", kind: "guide", order: 15, untilAge: 7, point: "option:0",
     say: "Something is moving in the ditch. Click the answer to go and see.",
     asks: [{fact: "story.day", op: ">=", value: 4}],
     until: [{fact: "walk.screen", op: "==", value: "fight"}]},
    {id: "guide.slime", kind: "guide", order: 16, untilAge: 7, point: "foe:0", hold: 7000,
     say: "This is the slime. Its panel shows what it will do on its turn.",
     asks: [{fact: "walk.screen", op: "==", value: "fight"}, {fact: "fight.over", op: "==", value: 0}]},
    {id: "guide.order", kind: "guide", order: 17, untilAge: 7, point: "order", hold: 6000,
     say: "This shows who acts first, and when your next turn comes.",
     asks: [{fact: "fight.over", op: "==", value: 0}]},
    {id: "guide.strike", kind: "guide", order: 18, untilAge: 7, point: "move:strike",
     say: "Press Strike to hit it. Don't worry, you can't die in this fight.",
     asks: [{fact: "fight.over", op: "==", value: 0}],
     until: [{fact: "fight.acted", op: ">=", value: 1}]},
    {id: "guide.doors", kind: "guide", order: 19, point: "tile:keep", hold: 9000,
     say: "You're 7 now, so the town has work for you. These are the three classes: the Keep (warrior), the Collegium (mage) and the Hidden Hand (thief). You can join one at 16, so start training for it.",
     asks: [{fact: "life.age", op: ">=", value: 7}]},
    {id: "guide.rest", kind: "guide", order: 20, point: "", hold: 4000,
     say: "That's everything. Have fun!",
     asks: []},

    // Outside the sequence: said once, while he is at the work that takes from his Vitality
    // (it takes it as it begins: the months of the work are the time to say so)
    {id: "guide.vitality", kind: "guide", order: 0, point: "stat:vit", hold: 4000,
     say: "This task cost you Vitality. It comes back over time, as long as you have food.",
     asks: [{fact: "working.sacks", op: ">=", value: 1}]},
    // Said once, the month the chapel library opens to him: the first term of Learning to Read
    {id: "guide.library", kind: "guide", order: 0, point: "tile:library", hold: 6000,
     say: "You can read now! Visit the chapel library and pick a book.",
     asks: [{fact: "done.letters", op: ">=", value: 1}]},
    // Said once, the month his rations run low after his sixth year (which has its own word
    // for it): to the market for who has not been. It gives no number of months: with familiars
    // bound, three rations last less than three, and the warning over the page says how long
    {id: "guide.rations_low", kind: "guide", order: 0, point: "tile:tomarket", hold: 6000,
     say: "Food is running low. Go to the market to buy more.",
     asks: [{fact: "stat.rations", op: "<=", value: 3}, {fact: "life.age", op: ">=", value: 7}, {fact: "stat.town_known", op: "<=", value: 0}]},
    // The same once the town is known: food is bought at its market
    {id: "guide.rations_market", kind: "guide", order: 0, point: "tab:town", hold: 6000,
     say: "Food is running low. Buy rations at the market, in the Town tab.",
     asks: [{fact: "stat.rations", op: "<=", value: 3}, {fact: "life.age", op: ">=", value: 7}, {fact: "stat.town_known", op: ">=", value: 1}]},
    // The town, the month a life comes to know it: its tab, then, once he has opened it, the
    // market where his coin buys rations (it waits for him to buy some), then the places. Said
    // once in a world, in the life that first goes to the market: each waits for the one before it
    {id: "guide.town", kind: "guide", order: 0, world: true, point: "tab:town",
     say: "The town is open! Click its tab to see it.",
     asks: [{fact: "stat.town_known", op: ">=", value: 1}],
     until: [{fact: "life.town", op: "==", value: 1}]},
    {id: "guide.market", kind: "guide", order: 0, world: true, point: "tile:buy.rations", pointChosen: "button:begin",
     say: "This is the market. Your coin buys food here. Click Buy rations.",
     sayChosen: "Now press Buy. Buying takes no time.",
     asks: [{fact: "said.guide.town", op: ">=", value: 1}],
     until: [{fact: "done.buy.rations", op: ">=", value: 1}]},
    {id: "guide.places", kind: "guide", order: 0, world: true, point: "place:market", hold: 10000,
     say: "These are the places of the town. Working on them makes them better, and what you build stays for your next lives. More places open as you go.",
     asks: [{fact: "said.guide.market", op: ">=", value: 1}]},

    // The town's story, a line at a time
    {id: "lore.bell", kind: "lore", entry: "Bellmoor sits where the Bell meets the North Road. Everything that passes, passes here.",
     asks: [{fact: "life.terms", op: ">=", value: 1}]},
    {id: "lore.gates", kind: "lore", entry: "The town has three gates: the Keep's, the Collegium's, and one nobody names.",
     asks: [{fact: "done.messages", op: ">=", value: 1}]},
    {id: "lore.winter", kind: "lore", entry: "The hard winter of Year 0 took the old miller. The town remembers who fed it.",
     asks: [{fact: "stat.rations", op: "<=", value: 3}]},
    {id: "lore.orun", kind: "lore", entry: "Saint Orun was a scribe who burned his own book. The choir still sings the pages he kept.",
     asks: [{fact: "life.age", op: ">=", value: 10}]},
    {id: "lore.placed", kind: "lore", entry: "The sergeant at the gate was a carter's boy. So was the thief they never caught.",
     asks: [{fact: "life.age", op: ">=", value: 13}]},
    {id: "lore.harrow", kind: "lore", entry: "Harrow was a town once. The Collegium says the fragments are glass. They are not glass.",
     asks: [{fact: "life.age", op: ">=", value: 21}]},
    {id: "lore.thirty", kind: "lore", entry: "At thirty a man of Bellmoor is old. The town counts a life in lives.",
     asks: [{fact: "life.age", op: ">=", value: 30}]},
    {id: "lore.hand", kind: "lore", entry: "The chronicle is kept in one hand, and the hand changes.",
     asks: [{fact: "life.lives", op: ">=", value: 2}]},
    {id: "lore.carters", kind: "lore", entry: "The carters pay in coin and in bread. Half of Bellmoor learned the road on their wagons.",
     asks: [{fact: "done.carters", op: ">=", value: 2}]},
    {id: "lore.mill", kind: "lore", entry: "The mill on the Bell grinds for the Keep first, the town second, the miller last.",
     asks: [{fact: "done.mill", op: ">=", value: 1}]},
    {id: "lore.letters", kind: "lore", entry: "Father Anselm teaches letters to any boy who will sit still. Few do.",
     asks: [{fact: "stat.letters", op: ">=", value: 1}]},
    {id: "lore.classes", kind: "lore", entry: "The Keep takes the strong, the Collegium the learned. The Hidden Hand takes who it wants.",
     asks: [{fact: "life.terms", op: ">=", value: 5}]}
]

var ops = [">=", ">", "<=", "<", "=="]

// What the hand can point at: one of these places, or one of these kinds followed by a name
var pointPlaces = ["", "clock", "log", "order"]
var pointKinds = ["button:", "tile:", "holding:", "stat:", "tab:", "place:", "work:", "option:", "move:", "foe:", "walkbutton:"]

// The steps of the guide's sequence, counted to see that their orders run 1..n without a gap
var guideSteps = 0

for (var i = 0; i < len(achievements); i++)
{
    var a = achievements[i]

    // What an entry does not say reads as nothing, so every entry has every field
    a.kind = lookup(a, "kind", "deed")
    a.name = lookup(a, "name", "")
    a.entry = lookup(a, "entry", "")
    a.say = lookup(a, "say", "")
    a.point = lookup(a, "point", "")
    a.pointChosen = lookup(a, "pointChosen", "")
    a.light = lookup(a, "light", "")
    a.untilAge = lookup(a, "untilAge", 0)
    a.sayChosen = lookup(a, "sayChosen", "")
    a.order = lookup(a, "order", 0)
    a.world = lookup(a, "world", false)
    a.hold = lookup(a, "hold", 5000)
    a.gives = listOf(a, "gives")
    a.until = listOf(a, "until")

    if (a.kind != "deed" and a.kind != "guide" and a.kind != "lore")
    {
        push(errors, "achievement " + a.id + ": unknown kind " + a.kind)
    }

    // Named for what it is: the save and the analytics tell a deed by its id
    var named = "deed"

    if (startsWith(a.id, "guide."))
    {
        named = "guide"
    }

    if (startsWith(a.id, "lore."))
    {
        named = "lore"
    }

    if (named != a.kind)
    {
        push(errors, "achievement " + a.id + ": a guide step is named guide.<x>, a lore line lore.<x>, and nothing else is")
    }

    if (a.kind == "guide")
    {
        if (a.say == "")
        {
            push(errors, "guide step " + a.id + ": nothing to say")
        }

        // What it points at, and what it points at once its tile is chosen
        var hands = [a.point, a.pointChosen]

        for (var h = 0; h < len(hands); h++)
        {
            var pointed = false

            for (var p = 0; p < len(pointPlaces); p++)
            {
                if (hands[h] == pointPlaces[p])
                {
                    pointed = true
                }
            }

            for (var p = 0; p < len(pointKinds); p++)
            {
                if (startsWith(hands[h], pointKinds[p]) and strlen(hands[h]) > strlen(pointKinds[p]))
                {
                    pointed = true
                }
            }

            if (not pointed)
            {
                push(errors, "guide step " + a.id + ": unknown point " + hands[h])
            }
        }

        if (a.pointChosen != "" and not startsWith(a.point, "tile:") and not startsWith(a.point, "work:"))
        {
            push(errors, "guide step " + a.id + ": pointChosen is for a step that points at a tile, or at a work of a walk's day")
        }

        if (a.sayChosen != "" and a.pointChosen == "")
        {
            push(errors, "guide step " + a.id + ": sayChosen without a pointChosen")
        }

        if (a.world and a.order != 0)
        {
            push(errors, "guide step " + a.id + ": only a step outside the sequence is the world's")
        }

        if (a.order < 0)
        {
            push(errors, "guide step " + a.id + ": order " + toString(a.order))
        }

        // A step of the sequence waits for the one before it to have ended
        if (a.order > 0)
        {
            guideSteps = guideSteps + 1
            push(a.asks, {fact: "life.guide", op: "==", value: a.order - 1})
        }
    }

    if (a.kind == "lore")
    {
        if (a.entry == "")
        {
            push(errors, "lore " + a.id + ": nothing to write")
        }

        if (len(a.gives) > 0)
        {
            push(errors, "lore " + a.id + ": a line of lore gives nothing")
        }
    }

    for (var r = 0; r < len(a.asks); r++)
    {
        var known = false

        for (var o = 0; o < len(ops); o++)
        {
            if (ops[o] == a.asks[r].op)
            {
                known = true
            }
        }

        if (not known)
        {
            push(errors, "achievement " + a.id + ": unknown op " + a.asks[r].op)
        }
    }

    for (var u = 0; u < len(a.until); u++)
    {
        var known = false

        for (var o = 0; o < len(ops); o++)
        {
            if (ops[o] == a.until[u].op)
            {
                known = true
            }
        }

        if (not known)
        {
            push(errors, "guide step " + a.id + ": unknown op " + a.until[u].op)
        }
    }
}

// Every place of the sequence is taken once: 1, 2, ... up to the number of its steps
for (var o = 1; o <= guideSteps; o++)
{
    var taken = 0

    for (var i = 0; i < len(achievements); i++)
    {
        if (achievements[i].kind == "guide" and achievements[i].order == o)
        {
            taken = taken + 1
        }
    }

    if (taken != 1)
    {
        push(errors, "the guide has " + toString(taken) + " steps of order " + toString(o) + ": the orders run 1 to " + toString(guideSteps) + " without a gap")
    }
}
