// Chronicle rules: what he holds, and what a month does to it
// ----------------------------------------------------------
// Input:  `age` (years, at the end of the month), `character` (a table of stats and flags).
//         He eats every month, whatever he is at: a work that feeds him gave its months of
//         rations as he began it (activitytable.pg's `upFront`, forecast.pg's `atStart`).
// Output: `month`:
//           after    every stat of the character once one month has passed
//           entries  [{text, kind, figure, glyph}]: the log lines that month writes
//           hurt     [stat]: the stats a life needs (`mortal`) that this month took from
//         `warning`, "" or what he lives on that is running out, in caps and said from three
//         months of it left: "RATIONS FOR 2 MONTHS", "NO RATIONS LEFT".
//         `advice`, "" or what to do about it, as a sentence: one while it runs low, another
//         once it is gone. The screen says it once each time it changes.
//         `caps`, the most each capped stat of the character can be: [{stat, most}].
//         `rows`, one table per holding the ledger can show, in the order it lists them:
//           {id, group, groupLabel, glyph, name, tone, rate, limit, title, haste, aMonth, always}
//           tone: 0 none, 1 coin, 2 guild, 3 relic; rate: "" or "+2 / mo", what the coming
//           month does to it as things stand; limit: the most he can hold, 0 for none;
//           haste: 0, or how many times as fast it can run the months (`haste` below);
//           aMonth: what a month run faster takes of it, 0 for none (`aMonth` below);
//           always: true for a row the ledger shows from the first, at 0 too.
//         `glosses`, one table per holding, what hovering its row says:
//           {id, title, text, footnote, rows [{label, value, tone}]}
//           rows: what he holds (over its limit when it has one: "3/60"), what the month does to it and where that comes
//           from, what it brings, what it uses and how long it lasts, what running out costs.
//         `death`: "" or the line the next life opens with, when the character as he is has
//           nothing left of a stat a life needs (`mortal`).
//         `eats`: the rations a coming month eats as things stand, his own and his familiars',
//           fed or not. The solver reads it; the game does not.
//
// The familiars bound to him (the stat "fam.<id>", how many of the kind: economytable.pg's
// `familiarKinds`) eat after he has eaten, every month, at any work. Each kind is fed all or
// nothing and makes its things when fed (lib.pg's `feedFamiliars`); a hungry one makes nothing,
// and costs him nothing either. Each kind is a holding of the group FAMILIARS.
//
// A holding is a stat with a place in the ledger. Optional fields:
//   produces: [{stat, amount, per, every}]
//                                     while he holds it, every `per` of it brings `amount` of
//                                     `stat` each month. With `every` (left out, 1) it brings it
//                                     one month in `every` only, counted on the months of his life.
//   decays: N                         it loses N each month, never below 0, at any work.
//   empty: {effects [{stat, amount}], entry "text", low "text", gone "text"}
//                                     what running out costs: the entry is written the month it
//                                     reaches 0, the effects land every month it stays there.
//                                     A character who never held any is not out of it.
//                                     `low` and `gone` are optional: the `advice` while it runs
//                                     out and once it has.
//   about: "text"                     what it is, in a sentence, for its gloss.
//   ledger: false                     it has no row in the ledger and no gloss: something of the
//                                     town's (its stat is "town.<place id>", the place's level)
//                                     that works every month, whoever lives.
//   title: true                       he has it or he has not: a standing, a tie, a title. Its
//                                     row shows no figure, and its gloss says neither how many he
//                                     holds nor a limit.
//   haste: N                          it is time, counted in seconds, and the player's rather than
//                                     his: the seconds the chronicle stayed shut, up to its limit,
//                                     kept from life to life. The screen spends it to run the months
//                                     faster, up to N times as fast (a press goes ×1, ×2 ... ×N).
//                                     Its row is in the ledger from the first, held or not ("0/3600").
//   aMonth: N                         with `haste`: a month run faster takes N of it, at ×2 as at
//                                     ×N, whatever the pace of his age: seven seconds, a week of
//                                     the player's for a month of his.
// The most he can hold of a stat is lib.pg's `statLimits`: what a month produces stops at it,
// and what he already holds past it (an activity may carry him there) is left alone.
// The town's places (towntable.pg) are imported for what a level that stands adds to what a
// familiar makes (its `more`, lib.pg's `feedFamiliars`): right after lib.pg, which it imports
// again.
//
// The numbers are placeholders for the game's balance: change them here, nothing in C++ moves.

import "string"
import "math"
import "algorithm"
import "lib"
import "towntable"
import "economytable"
import "expeditiontable"

// Old age begins where his prime ends: thirty, or fifty in a town whose Inn stood the month he
// reached thirty (lib.pg's `primeStat`, settled below)
lastAge = primeEnd(character)

var errors = []

var holdings = [
    {id: "coin", group: "purse", groupLabel: "PURSE", glyph: "gold", name: "Coin", tone: 1,
     about: "What work pays him in, and what the market takes."},
    {id: "rations", group: "purse", groupLabel: "PURSE", glyph: "trade", name: "Rations", tone: 0,
     about: "Food for the month: he eats one every month, whatever he is at. Work that feeds him gives the rations of its months as he begins it. With none left, his Vitality pays for it.",
     decays: economyKnobs.rationsAMonth,
     empty: {effects: [{stat: "vit", amount: -5}], entry: "The rations ran out",
             low: "Rations are running low: buy some at the market, or take work that gives rations up front",
             gone: "No rations left: his Vitality pays. Buy some at the market, or take work that gives rations up front"}},
    // Not his: the player's. The seconds the chronicle stayed shut, spent to run the months faster
    {id: "written", group: "purse", groupLabel: "PURSE", glyph: "time", name: "Written time", tone: 0, haste: 3, aMonth: 7,
     about: "What was written while the chronicle was shut, an hour at most. Spent, it runs the months twice or three times as fast, a week of it for each month. It is kept from life to life."},
    {id: "reagents", group: "purse", groupLabel: "PURSE", glyph: "magic", name: "Reagents", tone: 0,
     about: "What a working burns. Bought at the Collegium, spent when a working begins."}
]

// What he gathers and what is made of it (economytable.pg): each held to a limit that a store
// raises, and set right after the purse so that the ledger reads them near its top. A basic's gloss
// says where it goes at his death: to the place he leaves his gift to, as much as its next level
// still asks (town.pg's `leaves`), and the rest to the stash
var basicDeath = " At his death, what a place still asks of it can be left to that place; the family's stash keeps the rest."

for (var br = 0; br < len(basicResources); br++)
{
    var basic = basicResources[br]

    push(holdings, {id: basic.id, group: "resources", groupLabel: "RESOURCES", glyph: basic.glyph, name: basic.name, tone: 0,
                    about: basic.about + basicDeath})
}

for (var mr = 0; mr < len(madeResources); mr++)
{
    var made = madeResources[mr]

    push(holdings, {id: made.id, group: "resources", groupLabel: "RESOURCES", glyph: made.glyph, name: made.name, tone: 0,
                    about: made.about})
}

// The familiars he has bound, a row a kind, after what they eat and make. Its count does not move
// by itself: binding raises it, and nothing takes one back. `creature` keeps the kind, for its gloss
for (var fk = 0; fk < len(familiarKinds); fk++)
{
    var kind = familiarKinds[fk]

    push(holdings, {id: "fam." + kind.id, group: "familiars", groupLabel: "FAMILIARS", glyph: kind.glyph, name: statName("fam." + kind.id), tone: 0,
                    about: kind.about, creature: kind})
}

// What the smithy has forged him, a row a piece: he has it or he has not. It goes with him into
// every fight, and is lost at his death like anything else he holds
for (var gp = 0; gp < len(gearPieces); gp++)
{
    var piece = gearPieces[gp]

    push(holdings, {id: "gear." + piece.id, group: "gear", groupLabel: "GEAR", glyph: piece.glyph, name: piece.name, tone: 0, title: true,
                    about: piece.about + " It is lost at his death, as the smithy keeps no piece for the next life."})
}

var standings = [
    {id: "favors", group: "standing", groupLabel: "STANDING", glyph: "guild", name: "Favors", tone: 2,
     about: "What the Hidden Hand owes him. A big job asks for them before it begins."},
    {id: "keep_oath", group: "standing", groupLabel: "STANDING", glyph: "seal", name: "Sworn to the Keep", tone: 2, title: true,
     about: "His oath to the Keep at Bellmoor: its service and its campaigns are open to him."},
    {id: "collegium", group: "standing", groupLabel: "STANDING", glyph: "academy", name: "The Collegium", tone: 2, title: true,
     about: "A place among the scholars of the Collegium, and their table."},
    {id: "hidden_hand", group: "standing", groupLabel: "STANDING", glyph: "guild", name: "The Hidden Hand", tone: 2, title: true,
     about: "The thieves of Bellmoor trust him with their work."},
    {id: "captain", group: "standing", groupLabel: "STANDING", glyph: "reputation", name: "Captain of Bellmoor", tone: 3, title: true,
     about: "The captain's chain of the Keep."},
    {id: "mage_of_harrow", group: "standing", groupLabel: "STANDING", glyph: "relic", name: "Mage of Harrow", tone: 3, title: true,
     about: "The one who performed the Harrow Working."},
    {id: "master_thief", group: "standing", groupLabel: "STANDING", glyph: "gold", name: "Master Thief", tone: 3, title: true,
     about: "The one who emptied the Bellmoor Vault."},
    {id: "renegade", group: "standing", groupLabel: "STANDING", glyph: "adventure", name: "Gone to the Greenwood", tone: 2, title: true,
     about: "He lives outside the town's law, among the outlaws of the Greenwood."},
    {id: "wood_king", group: "standing", groupLabel: "STANDING", glyph: "reputation", name: "King of the Greenwood", tone: 3, title: true,
     about: "The Greenwood answers to him, and the Keep leaves it be."},
    // What a second calling counts: each is a number he holds, that its last work asks for
    {id: "relics", group: "standing", groupLabel: "STANDING", glyph: "relic", name: "Relics", tone: 0,
     about: "Relics of the curse, gathered for the Harrow Study. The first seal asks three."},
    {id: "elements", group: "standing", groupLabel: "STANDING", glyph: "magic", name: "Elements bound", tone: 0,
     about: "The elements he has bound, each a spell of his."},
    {id: "spells_written", group: "standing", groupLabel: "STANDING", glyph: "quill", name: "Spells written down", tone: 0,
     about: "The spells he has set down for the Collegium's shelves."},
    {id: "marks_studied", group: "standing", groupLabel: "STANDING", glyph: "town", name: "Marks studied", tone: 0,
     about: "The people of Bellmoor he has watched for a contract."},
    {id: "kills", group: "standing", groupLabel: "STANDING", glyph: "skull", name: "Contracts kept", tone: 0,
     about: "The contracts he has carried out."},
    {id: "far_walks", group: "standing", groupLabel: "STANDING", glyph: "adventure", name: "Far roads walked", tone: 0,
     about: "The far roads he has walked to their end."},
    {id: "maps_drawn", group: "standing", groupLabel: "STANDING", glyph: "quill", name: "Maps drawn", tone: 0,
     about: "The far roads he has put on paper."},
    // What he was given as a boy and keeps: nothing asks for it yet
    {id: "tome", group: "keepsakes", groupLabel: "KEEPSAKES", glyph: "relic", name: "Father Anselm's tome", tone: 2, title: true,
     about: "A small book Father Anselm gave him for carrying the others. He has kept it since."},
    // And what he bought as one: the blade his practice asks for
    {id: "wooden_blade", group: "keepsakes", groupLabel: "KEEPSAKES", glyph: "swordsmanship", name: "A wooden blade", tone: 0, title: true,
     about: "A blade of ash from the market, blunt, and a hand too long for him. His practice with it is among his training."},
    // And the two small things that each open a task of his streets and of his study
    {id: "snare_wire", group: "keepsakes", groupLabel: "KEEPSAKES", glyph: "adventure", name: "A snare wire", tone: 0, title: true,
     about: "A coil of brass wire from the market. Snaring rabbits on the common is among his streets while he is young enough for it."},
    {id: "herbal_primer", group: "keepsakes", groupLabel: "KEEPSAKES", glyph: "study", name: "A herbal primer", tone: 0, title: true,
     about: "A few pages of leaves and roots from the market. Learning the herbal is among his study."},
    // The market hall (towntable.pg, the market's second level) sends a ration every three
    // months: a help, not his bread. One a month was all a month eats, and rations no longer counted
    {id: "town.market", group: "town", groupLabel: "TOWN", glyph: "trade", name: "the market hall", tone: 0, ledger: false,
     produces: [{stat: "rations", amount: 1, per: 2, every: 3}]}
]

for (var sk = 0; sk < len(standings); sk++)
{
    push(holdings, standings[sk])
}

// What a work leaves him besides a figure: whom he is known to, what he was taught, what he
// carries. Each is a holding like the others, so it has its row in the ledger once he has it
// ("Mara's pupil", "Known to the Watch"), under the name lib.pg writes it with.
var ties = ["watch_known", "street_known", "choir", "edric_support", "library_access", "night_contacts", "mara_student",
            "veteran", "watch_commander", "tourney_victor",
            "black_treatise", "orin_known", "harrow_fragments", "harrow_truth", "harrow_relic",
            "guild_clerk", "guild_ledgers", "guild_enemy", "heat_reduced", "great_job_planned", "crew_ready",
            "band", "hedges_known", "bow_learned", "yard_enthusiasm", "yard_breathing", "slash_learned", "thrust_learned",
            "forge_seen", "smith_apprentice", "roads_known", "anselm_trust", "forbidden_read", "herbal", "snare_set",
            "cutpurses_seen", "tunnel_found", "smuggler_runner", "boys_sworn", "mill_saved", "flood_hero", "flood_looted",
            "levy_served", "levy_paid", "deserter", "bargemen_tale",
            "bandit_trail", "band_broken", "captain_favour", "ordained", "demon_spoken", "engines_seen",
            "other_account", "glyphs_read", "mill_engine", "magister", "hand_marked", "freelance",
            "reagent_run", "collegium_thief", "tourney_fixed", "vey_heir", "peoples_outlaw", "feared",
            "forest_shrine", "woodfolk_guest", "barn_burned", "pardoned", "plague_stayed", "plague_shut",
            "plague_profiteer", "kingmaker", "church_candidate", "interregnum", "heir_sworn",
            "stood_flood", "stood_levy", "stood_plague", "stood_lord", "castellan", "crusader",
            "curse_breaker", "spellwright", "assassin", "adventurer", "walls_raised", "bellmoor_shield",
            "shut_gate", "wall_held", "zealot", "doubts", "relic_bearer", "crusader_king",
            "whole_story", "working_marked", "first_seal", "stoneskin_bound", "galestep_bound", "firebolt2_bound",
            "chain_bound", "court_mage", "sealed_library", "grand_working", "own_counsel", "regicide",
            "porters", "first_city",
            "fire_course", "frost_course", "storm_course", "spark_taught", "rime_taught", "static_taught", "suspected", "top_floor",
            "dropout.collegium"]

// What a walk brings home (expeditiontable.pg's `walkItems`): a remedy to drink in the field,
// what is sold at the market, what a place of the town is built of, and what only a far place
// gives. He holds all of it, and it ends with him: only what a place still asks can be left to it
// at his death (town.pg)
for (var w = 0; w < len(walkItems); w++)
{
    var thing = walkItems[w]
    var isBasic = false

    for (var bi = 0; bi < len(basicResources); bi++)
    {
        if (basicResources[bi].id == thing.id)
        {
            isBasic = true
        }
    }

    if (isBasic)
    {
        continue
    }

    if (thing.kind == "remedy")
    {
        push(holdings, {id: thing.id, group: "stores", groupLabel: "STORES", glyph: thing.glyph, name: thing.name, tone: 0,
                        about: "Drunk on a walk, in a fight or between two: it gives back a part of his Vitality."})
    }

    // (a thing with a line of its own says it in place of where it comes from: the chronicle's pages)
    if (thing.kind == "sold")
    {
        push(holdings, {id: thing.id, group: "stores", groupLabel: "STORES", glyph: thing.glyph, name: thing.name, tone: 0,
                        about: lookup(thing, "about", "Brought home from a walk.") + " The market buys it."})
    }

    if (thing.kind == "town")
    {
        push(holdings, {id: thing.id, group: "stores", groupLabel: "STORES", glyph: thing.glyph, name: thing.name, tone: 0,
                        about: "Brought home from a walk. The places of the town are built of it. At his death, what a place still asks of it can be left to that place; the rest is lost."})
    }

    if (thing.kind == "found")
    {
        push(holdings, {id: thing.id, group: "stores", groupLabel: "STORES", glyph: thing.glyph, name: thing.name, tone: 0,
                        about: "Found only in the far places, and no market buys it. The town's finest works ask for it. At his death, what a place still asks of it can be left to that place; the rest is lost."})
    }

    if (thing.kind == "fight")
    {
        push(holdings, {id: thing.id, group: "stores", groupLabel: "STORES", glyph: thing.glyph, name: thing.name, tone: 0,
                        about: "Carried on a walk, and used in a fight: it is a move of his while he holds one."})
    }
}

// What fights have taught him: the rank of a technique used often, and the lesson of the first
// kill of each kind of beast in this life (fightlib.pg)
for (var rk = 0; rk < len(walkTechniques); rk++)
{
    var ranked = walkTechniques[rk]

    push(holdings, {id: "rank." + ranked.id, group: "fights", groupLabel: "IN A FIGHT", glyph: "swordsmanship", name: ranked.name + ", rank", tone: 0,
                    about: "Used often in fights: each rank a little stronger, and a point of what it trains."})
}

for (var lk = 0; lk < len(walkMobs); lk++)
{
    var taughtBy = walkMobs[lk]

    push(holdings, {id: "lesson." + taughtBy.id, group: "fights", groupLabel: "IN A FIGHT", glyph: "study", name: "Lesson: " + toLowerCase(taughtBy.name), tone: 0, title: true,
                    about: lookup(taughtBy, "lesson", "The first one he killed in this life: he knows it better.")})
}

for (var t = 0; t < len(ties); t++)
{
    push(holdings, {id: ties[t], group: "ties", groupLabel: "TIES", glyph: "reputation", name: statName(ties[t]), tone: 0, title: true})
}

// What comes back with time: a stat under its cap (lib.pg's `statCaps`) gains `amount` every
// `every` months, counted in the stat "<stat>rest". A month that took from it mends nothing and
// starts the count again.
// `quick`: with that stat at `needed` or more it mends every `every` months instead (the
// family's room at the inn, towntable.pg).
var mending = [
    {stat: "vit", amount: 5, every: 2, quick: {stat: "town.inn", needed: 3, every: 1}}
]

// Old age: from `fromAge` on, the most a stat can be (its cap) falls by `amount` every `every`
// months, and the stat with it, so nothing mends it back. It is not a hurt (`month.hurt`): the
// years take it, the page does not stop for it.
var aging = [
    {stat: "vit", fromAge: lastAge, amount: 5, every: 2}
]

// What a life cannot go on without: with none of it left the life ends, and a new one begins.
// `aged` is the line of a life that ended in its old age.
var mortal = [
    {stat: "vit", entry: "The last life ended, his vitality spent", aged: "The last life ended in old age, its chronicle written"}
]

var lived = monthOf(age)

// Every stat as it is, then the month on top
var after = {}

for (var k : character)
{
    after[k] = character[k]
}

// What the month changes, by stat: the rates come from it
var change = {}

var entries = []

// What each holding makes this month: {stat, name, amount}
var yields = []

// What is about to run out of what a life hangs on, "" for nothing: the first holding that says so
var warning = ""

// And what to do about it, "" when the holding gives no word for it
var advice = ""

// What his familiars eat a month, by stat, fed or not: what he lives on runs out that much sooner,
// and the warning, the gloss and the `eats` count it with his own
var familiarsEat = {}

for (var fe = 0; fe < len(familiarKinds); fe++)
{
    var eater = familiarKinds[fe]
    var count = statOf(character, "fam." + eater.id)

    for (var fr = 0; fr < len(eater.eats); fr++)
    {
        var meal = eater.eats[fr]

        familiarsEat[meal.stat] = lookup(familiarsEat, meal.stat, 0) + count * meal.amount
    }
}

for (var i = 0; i < len(holdings); i++)
{
    var h = holdings[i]
    var held = statOf(character, h.id)

    var produces = listOf(h, "produces")

    for (var p = 0; p < len(produces); p++)
    {
        var product = produces[p]

        if (product.per <= 0)
        {
            push(errors, "holding " + h.id + ": produces " + product.stat + " per " + toString(product.per))
        }
        else
        {
            var made = toInt(floor(held / product.per)) * product.amount
            var pace = lookup(product, "every", 1)

            if (made != 0)
            {
                // Its month or not, the gloss of what it brings says where that comes from
                if (lived % pace == 0)
                {
                    shiftIn(after, change, product.stat, made)
                }

                push(yields, {stat: product.stat, name: h.name, amount: made, every: pace})
            }
        }
    }

    var decays = lookup(h, "decays", 0)

    // What a life hangs on is said to be running out from three months of it left, his familiars'
    // share counted with his own. It lasts the months that feed them all (lib.pg's `monthsFed`).
    // The month it is gone is written once they have eaten
    if (decays > 0 and has(character, h.id) and held > 0 and has(h, "empty") and warning == "")
    {
        var uses = lookup(familiarsEat, h.id, 0) + decays

        if (uses > 0)
        {
            var lasts = monthsFed(held, uses)

            if (lasts == 1)
            {
                warning = toUpperCase(h.name) + " FOR 1 MONTH"
            }
            else if (lasts <= 3)
            {
                warning = toUpperCase(h.name) + " FOR " + toString(lasts) + " MONTHS"
            }

            if (warning != "")
            {
                advice = lookup(h.empty, "low", "")
            }
        }
    }

    if (decays > 0 and has(character, h.id))
    {
        if (held > 0)
        {
            shiftIn(after, change, h.id, 0 - decays)
        }
        else if (has(h, "empty"))
        {
            for (var e = 0; e < len(h.empty.effects); e++)
            {
                var effect = h.empty.effects[e]
                shiftIn(after, change, effect.stat, effect.amount)
            }

            if (warning == "")
            {
                warning = "NO " + toUpperCase(h.name) + " LEFT"
                advice = lookup(h.empty, "gone", "")
            }
        }
    }
}

// He has eaten: his familiars eat after him, and what they took and made is in the rates with the
// rest
var hungry = []
var fed = feedFamiliars(after, hungry)

for (var fs : fed)
{
    change[fs] = lookup(change, fs, 0) + fed[fs]
}

// What he held and has no more of once they have all eaten ran out this month, whoever ate the
// last of it: written once, ahead of the familiars that went hungry
for (var ro = 0; ro < len(holdings); ro++)
{
    var gone = holdings[ro]

    if (has(gone, "empty") and lookup(gone, "decays", 0) > 0 and statOf(character, gone.id) > 0 and statOf(after, gone.id) == 0)
    {
        push(entries, {text: gone.empty.entry, kind: "loss", figure: "", glyph: gone.glyph})
    }
}

for (var hu = 0; hu < len(hungry); hu++)
{
    push(entries, hungry[hu])
}

// The rations a coming month eats: his own and all his familiars'
var eats = lookup(familiarsEat, "rations", 0)

for (var he = 0; he < len(holdings); he++)
{
    if (holdings[he].id == "rations")
    {
        eats = eats + lookup(holdings[he], "decays", 0)
    }
}

// A month that took from what a life needs: the screen says so
var hurt = []

for (var m = 0; m < len(mortal); m++)
{
    if (lookup(change, mortal[m].stat, 0) < 0)
    {
        push(hurt, mortal[m].stat)
    }
}

for (var r = 0; r < len(mending); r++)
{
    var mend = mending[r]

    if (capOf(mend.stat) != "" and has(character, mend.stat))
    {
        var most = mostOf(character, mend.stat)
        var rest = mend.stat + "rest"
        var rested = 0
        var every = mend.every

        if (has(mend, "quick"))
        {
            if (statOf(character, mend.quick.stat) >= mend.quick.needed)
            {
                every = mend.quick.every
            }
        }

        // A character from before the cap takes what he has as his most
        after[capOf(mend.stat)] = most

        if (lookup(change, mend.stat, 0) >= 0 and after[mend.stat] < most)
        {
            rested = lookup(character, rest, 0) + 1

            if (rested >= every)
            {
                shiftIn(after, change, mend.stat, mend.amount)
                rested = 0

                if (after[mend.stat] > most)
                {
                    after[mend.stat] = most
                }
            }
        }

        after[rest] = rested
    }
}

// The month he reaches thirty settles where his old age begins, for the rest of this life: an Inn
// raised after it is for the lives after his (lib.pg's `primeStat`)
if (lived >= shortAge * 12 and statOf(character, primeStat) <= 0)
{
    after[primeStat] = lastAge
}

for (var o = 0; o < len(aging); o++)
{
    var old = aging[o]
    var since = lived - old.fromAge * 12

    if (capOf(old.stat) != "" and has(character, old.stat) and since > 0 and since % old.every == 0)
    {
        var most = mostOf(after, old.stat) - old.amount

        if (most < 0)
        {
            most = 0
        }

        after[capOf(old.stat)] = most

        if (after[old.stat] > most)
        {
            shiftIn(after, change, old.stat, most - after[old.stat])
        }
    }
}

// The events of a life (lib.pg's `lifeEvents`): the month one is settled, who holds none of its
// answers has stood by. He holds that from then on, the count of them goes up, and the log says
// what it shut
for (var e = 0; e < len(lifeEvents); e++)
{
    var ev = lifeEvents[e]

    if (lived == ev.settledAt * 12 + ev.settledMonths and statOf(character, ev.stood) <= 0 and not holdsAny(character, ev.answered))
    {
        after[ev.stood] = 1
        after[stoodBy] = statOf(after, stoodBy) + 1

        push(entries, {text: ev.said, kind: "loss", figure: "", glyph: ""})
    }
}

var month = {after: after, entries: entries, hurt: hurt}

var caps = []

for (var c : statCaps)
{
    if (has(character, c))
    {
        push(caps, {stat: c, most: mostOf(character, c)})
    }
}

var rows = []

for (var j = 0; j < len(holdings); j++)
{
    var h = holdings[j]
    var delta = lookup(change, h.id, 0)
    var rate = ""

    if (delta != 0)
    {
        rate = signed(delta) + " / mo"
    }

    if (lookup(h, "ledger", true))
    {
        push(rows, {id: h.id, group: h.group, groupLabel: h.groupLabel, glyph: h.glyph, name: h.name, tone: h.tone, rate: rate, limit: limitOf(character, h.id), title: lookup(h, "title", false), haste: lookup(h, "haste", 0), aMonth: lookup(h, "aMonth", 0), always: lookup(h, "haste", 0) > 0})
    }
}

// What hovering a holding says: the figures behind its row
var glosses = []

for (var g = 0; g < len(holdings); g++)
{
    var h = holdings[g]
    var held = statOf(character, h.id)
    var limit = limitOf(character, h.id)
    var delta = lookup(change, h.id, 0)
    var footnote = ""

    // A row's tone says which way its figure goes: "" plain, "gain", "loss", "time", "muted"
    // What he holds, over the most he can hold when there is one: "3/60"
    var holds = toString(held)

    if (limit > 0)
    {
        holds = holds + "/" + toString(limit)
    }

    var haste = lookup(h, "haste", 0)
    var notes = [{label: "Held", value: holds, tone: ""}]

    // Time, in seconds: how many months it runs faster, at whatever speed
    var aMonth = lookup(h, "aMonth", 0)

    if (haste > 0 and aMonth > 0)
    {
        push(notes, {label: "A month takes", value: toString(aMonth) + " s", tone: "time"})
        push(notes, {label: "Runs faster", value: toString(held / aMonth) + " mo", tone: "time"})
    }

    if (delta != 0)
    {
        var way = "gain"

        if (delta < 0)
        {
            way = "loss"
        }

        push(notes, {label: "This month", value: signed(delta), tone: way})
    }

    for (var y = 0; y < len(yields); y++)
    {
        if (yields[y].stat == h.id)
        {
            var way = "gain"

            if (yields[y].amount < 0)
            {
                way = "loss"
            }

            var often = " / mo"

            if (yields[y].every > 1)
            {
                often = " / " + toString(yields[y].every) + " mo"
            }

            push(notes, {label: "From " + yields[y].name, value: signed(yields[y].amount) + often, tone: way})
        }
    }

    var produces = listOf(h, "produces")

    for (var p = 0; p < len(produces); p++)
    {
        var product = produces[p]
        var label = "Each brings " + statName(product.stat)

        if (product.per > 1)
        {
            label = "Every " + toString(product.per) + " bring " + statName(product.stat)
        }

        push(notes, {label: label, value: signed(product.amount) + " / mo", tone: "gain"})
        footnote = "A GENERATOR: IT WORKS EVERY MONTH HE HOLDS IT"
    }

    var decays = lookup(h, "decays", 0)

    if (decays > 0)
    {
        // His own and his familiars'; it lasts while it feeds them all, as the warning counts it
        var share = lookup(familiarsEat, h.id, 0)
        var uses = share + decays

        push(notes, {label: "A month uses", value: toString(uses), tone: "loss"})

        if (share > 0)
        {
            push(notes, {label: "His familiars eat", value: toString(share) + " / mo", tone: "loss"})
        }

        if (held > 0 and uses > 0)
        {
            push(notes, {label: "Lasts", value: fmtMonths(monthsFed(held, uses)), tone: "time"})
        }

        if (has(h, "empty"))
        {
            for (var e = 0; e < len(h.empty.effects); e++)
            {
                var effect = h.empty.effects[e]
                var way = "gain"

                if (effect.amount < 0)
                {
                    way = "loss"
                }

                push(notes, {label: "With none, " + statName(effect.stat), value: signed(effect.amount) + " / mo", tone: way})
            }

            if (held <= 0 and has(character, h.id))
            {
                footnote = "NONE LEFT: HE PAYS FOR IT EVERY MONTH"
            }
        }
    }

    if (limit > 0 and held >= limit)
    {
        footnote = "FULL: WHAT BRINGS MORE IS CLOSED TO HIM"

        if (haste > 0)
        {
            footnote = "FULL: NO MORE IS WRITTEN UNTIL SOME IS SPENT"
        }
    }

    // A familiar: what each one eats and makes a month, with what he has learned of its yield,
    // and that it is his for life
    if (has(h, "creature"))
    {
        var creature = h.creature

        for (var ce = 0; ce < len(creature.eats); ce++)
        {
            push(notes, {label: "Each eats " + statName(creature.eats[ce].stat), value: signed(0 - creature.eats[ce].amount) + " / mo", tone: "loss"})
        }

        for (var cm = 0; cm < len(creature.makes); cm++)
        {
            var makes = creature.makes[cm]

            push(notes, {label: "Each makes " + statName(makes.stat), value: signed(makes.amount + statOf(character, "more." + makes.stat)) + " / mo", tone: "gain"})
        }

        push(notes, {label: "Bound to him", value: "For life", tone: "muted"})
        footnote = "FED, IT MAKES EVERY MONTH; HUNGRY, IT MAKES NOTHING"
    }

    // A title is had or not: nothing to count, no limit to state
    if (lookup(h, "title", false))
    {
        notes = []
        footnote = ""
    }

    if (lookup(h, "ledger", true))
    {
        push(glosses, {id: h.id, title: h.name, text: lookup(h, "about", ""), footnote: footnote, rows: notes})
    }
}

// The character as he is: a life with nothing left of what it needs is over
var death = ""

// Who fell to a boss on a walk does not come home (encounterlib.pg's `bossOutcome`)
if (has(character, "fell") and statOf(character, "fell") > 0)
{
    death = "The last life ended on a walk, in a fight he chose"
}

for (var m = 0; m < len(mortal); m++)
{
    if (death == "" and has(character, mortal[m].stat) and statOf(character, mortal[m].stat) <= 0)
    {
        death = mortal[m].entry

        if (lived >= lastAge * 12)
        {
            death = mortal[m].aged
        }
    }
}
