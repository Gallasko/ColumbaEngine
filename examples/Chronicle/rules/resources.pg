// Chronicle rules: what he holds, and what a month does to it
// ----------------------------------------------------------
// Input:  `age` (years, at the end of the month), `character` (a table of stats and flags),
//         `board` (true when the month is spent at an activity that feeds him:
//         activitytable.pg's `board`).
// Output: `month`:
//           after    every stat of the character once one month has passed
//           entries  [{text, kind, figure, glyph}]: the log lines that month writes
//           hurt     [stat]: the stats a life needs (`mortal`) that this month took from
//         `warning`, "" or what he lives on that is running out, in caps and said from three
//         months of it left: "RATIONS FOR 2 MONTHS", "NO RATIONS LEFT".
//         `advice`, "" or what to do about it, as a sentence: one while it runs low, another
//         once it is gone. The screen says it once each time it changes.
//         `caps`, the most each capped stat of the character can be: [{stat, most}].
//         `rows`, one table per holding the ledger can show, in the order it lists them:
//           {id, group, groupLabel, glyph, name, tone, rate, limit, title}
//           tone: 0 none, 1 coin, 2 guild, 3 relic; rate: "" or "+2 / mo", what the coming
//           month does to it as things stand; limit: the most he can hold, 0 for none.
//         `glosses`, one table per holding, what hovering its row says:
//           {id, title, text, footnote, rows [{label, value, tone}]}
//           rows: what he holds (over its limit when it has one: "3/60"), what the month does to it and where that comes
//           from, what it brings, what it uses and how long it lasts, what running out costs.
//         `death`: "" or the line the next life opens with, when the character as he is has
//           nothing left of a stat a life needs (`mortal`).
//
// A holding is a stat with a place in the ledger. Optional fields:
//   produces: [{stat, amount, per, every}]
//                                     while he holds it, every `per` of it brings `amount` of
//                                     `stat` each month. With `every` (left out, 1) it brings it
//                                     one month in `every` only, counted on the months of his life.
//   decays: N                         it loses N each month, never below 0. Not in a month at
//                                     board: he is fed, and running out costs nothing either.
//   empty: {effects [{stat, amount}], entry "text", low "text", gone "text"}
//                                     what running out costs: the entry is written the month it
//                                     reaches 0, the effects land every month it stays there.
//                                     A character who never held any is not out of it.
//                                     `low` and `gone` are optional: the `advice` while it runs
//                                     out and once it has.
//   about: "text"                     what it is, in a sentence, for its gloss.
//   ledger: false                     it has no row in the ledger and no gloss: something of the
//                                     town's (its stat is "town.<place id>", the place's level)
//                                     that works every month, whoever lives.
//   title: true                       he has it or he has not: a standing, a tie, a title. Its
//                                     row shows no figure, and its gloss says neither how many he
//                                     holds nor a limit.
// The most he can hold of a stat is lib.pg's `statLimits`: what a month produces stops at it,
// and what he already holds past it (an activity may carry him there) is left alone.
//
// The numbers are placeholders for the game's balance: change them here, nothing in C++ moves.

import "string"
import "math"
import "algorithm"
import "lib"

var errors = []

var holdings = [
    {id: "coin", group: "purse", groupLabel: "PURSE", glyph: "gold", name: "Coin", tone: 1,
     about: "What work pays him in, and what the market takes."},
    {id: "rations", group: "purse", groupLabel: "PURSE", glyph: "trade", name: "Rations", tone: 0,
     about: "Food for the month. With none left, his Vitality pays for it. Work that feeds him leaves them be.",
     decays: 1,
     empty: {effects: [{stat: "vit", amount: -1}], entry: "The rations ran out",
             low: "Rations are running low: help in the kitchen, or take work with meals",
             gone: "No rations left: his Vitality pays. Help in the kitchen, or take work with meals"}},
    {id: "reagents", group: "purse", groupLabel: "PURSE", glyph: "magic", name: "Reagents", tone: 0,
     about: "What a working burns. Bought at the Collegium, spent when a working begins."},
    {id: "favors", group: "standing", groupLabel: "STANDING", glyph: "guild", name: "Favors", tone: 2,
     about: "What the Hidden Hand owes him. A big job asks for them before it begins."},
    {id: "keep_oath", group: "standing", groupLabel: "STANDING", glyph: "seal", name: "Sworn to the Keep", tone: 2, title: true,
     about: "His oath to the Keep at Bellmoor: its service and its campaigns are open to him."},
    {id: "collegium", group: "standing", groupLabel: "STANDING", glyph: "academy", name: "The Collegium", tone: 2, title: true,
     about: "A place among the scholars of the Collegium, and their table."},
    {id: "hidden_hand", group: "standing", groupLabel: "STANDING", glyph: "guild", name: "The Hidden Hand", tone: 2, title: true,
     about: "The thieves of Bellmoor trust him with their work."},
    {id: "captain", group: "standing", groupLabel: "STANDING", glyph: "reputation", name: "Captain of Bellmoor", tone: 3, title: true,
     about: "The captain's chain of the Keep."},
    {id: "mage_of_harrow", group: "standing", groupLabel: "STANDING", glyph: "relic", name: "Mage of Harrow", tone: 3, title: true,
     about: "The one who performed the Harrow Working."},
    {id: "master_thief", group: "standing", groupLabel: "STANDING", glyph: "gold", name: "Master Thief", tone: 3, title: true,
     about: "The one who emptied the Bellmoor Vault."},
    {id: "renegade", group: "standing", groupLabel: "STANDING", glyph: "adventure", name: "Gone to the Greenwood", tone: 2, title: true,
     about: "He lives outside the town's law, among the outlaws of the Greenwood."},
    {id: "wood_king", group: "standing", groupLabel: "STANDING", glyph: "reputation", name: "King of the Greenwood", tone: 3, title: true,
     about: "The Greenwood answers to him, and the Keep leaves it be."},
    // The market hall (towntable.pg, the market's second level) sends a ration every three
    // months: a help, not his bread. One a month was all a month eats, and rations no longer counted
    {id: "town.market", group: "town", groupLabel: "TOWN", glyph: "trade", name: "the market hall", tone: 0, ledger: false,
     produces: [{stat: "rations", amount: 1, per: 2, every: 3}]}
]

// What a work leaves him besides a figure: whom he is known to, what he was taught, what he
// carries. Each is a holding like the others, so it has its row in the ledger once he has it
// ("Mara's pupil", "Known to the Watch"), under the name lib.pg writes it with.
var ties = ["watch_known", "street_known", "choir", "edric_support", "library_access", "night_contacts", "mara_student",
            "veteran", "watch_commander", "tourney_victor",
            "black_treatise", "orin_known", "harrow_fragments", "harrow_truth", "harrow_relic",
            "guild_clerk", "guild_ledgers", "guild_enemy", "heat_reduced", "great_job_planned", "crew_ready",
            "band"]

for (var t = 0; t < len(ties); t++)
{
    push(holdings, {id: ties[t], group: "ties", groupLabel: "TIES", glyph: "reputation", name: statName(ties[t]), tone: 0, title: true})
}

// What comes back with time: a stat under its cap (lib.pg's `statCaps`) gains `amount` every
// `every` months, counted in the stat "<stat>rest". A month that took from it mends nothing and
// starts the count again.
// `quick`: with that stat at `needed` or more it mends every `every` months instead (the
// family's room at the inn, towntable.pg).
var mending = [
    {stat: "vit", amount: 1, every: 2, quick: {stat: "town.inn", needed: 3, every: 1}}
]

// Old age: from `fromAge` on, the most a stat can be (its cap) falls by `amount` every `every`
// months, and the stat with it, so nothing mends it back. It is not a hurt (`month.hurt`): the
// years take it, the page does not stop for it.
var aging = [
    {stat: "vit", fromAge: lastAge, amount: 1, every: 2}
]

// What a life cannot go on without: with none of it left the life ends, and a new one begins.
// `aged` is the line of a life that ended in its old age.
var mortal = [
    {stat: "vit", entry: "The last life ended, his vitality spent", aged: "The last life ended in old age, its chronicle written"}
]

var lived = monthOf(age)

// Every stat as it is, then the month on top
var after = {}

for (var k : character)
{
    after[k] = character[k]
}

// What the month changes, by stat: the rates come from it
var change = {}

var entries = []

// What each holding makes this month: {stat, name, amount}
var yields = []

// What is about to run out of what a life hangs on, "" for nothing: the first holding that says so
var warning = ""

// And what to do about it, "" when the holding gives no word for it
var advice = ""

for (var i = 0; i < len(holdings); i++)
{
    var h = holdings[i]
    var held = statOf(character, h.id)

    var produces = listOf(h, "produces")

    for (var p = 0; p < len(produces); p++)
    {
        var product = produces[p]

        if (product.per <= 0)
        {
            push(errors, "holding " + h.id + ": produces " + product.stat + " per " + toString(product.per))
        }
        else
        {
            var made = toInt(floor(held / product.per)) * product.amount
            var pace = lookup(product, "every", 1)

            if (made != 0)
            {
                // Its month or not, the gloss of what it brings says where that comes from
                if (lived % pace == 0)
                {
                    shiftIn(after, change, product.stat, made)
                }

                push(yields, {stat: product.stat, name: h.name, amount: made, every: pace})
            }
        }
    }

    var decays = lookup(h, "decays", 0)

    if (decays > 0 and has(character, h.id) and not board)
    {
        if (held > 0)
        {
            shiftIn(after, change, h.id, 0 - decays)

            if (after[h.id] == 0 and has(h, "empty"))
            {
                push(entries, {text: h.empty.entry, kind: "loss", figure: "", glyph: h.glyph})
            }

            // What a life hangs on is said to be running out from three months of it left
            if (has(h, "empty") and warning == "")
            {
                var lasts = toInt(floor((held + decays - 1) / decays))

                if (lasts == 1)
                {
                    warning = toUpperCase(h.name) + " FOR 1 MONTH"
                }
                else if (lasts <= 3)
                {
                    warning = toUpperCase(h.name) + " FOR " + toString(lasts) + " MONTHS"
                }

                if (warning != "")
                {
                    advice = lookup(h.empty, "low", "")
                }
            }
        }
        else if (has(h, "empty"))
        {
            for (var e = 0; e < len(h.empty.effects); e++)
            {
                var effect = h.empty.effects[e]
                shiftIn(after, change, effect.stat, effect.amount)
            }

            if (warning == "")
            {
                warning = "NO " + toUpperCase(h.name) + " LEFT"
                advice = lookup(h.empty, "gone", "")
            }
        }
    }
}

// A month that took from what a life needs: the screen says so
var hurt = []

for (var m = 0; m < len(mortal); m++)
{
    if (lookup(change, mortal[m].stat, 0) < 0)
    {
        push(hurt, mortal[m].stat)
    }
}

for (var r = 0; r < len(mending); r++)
{
    var mend = mending[r]

    if (capOf(mend.stat) != "" and has(character, mend.stat))
    {
        var most = mostOf(character, mend.stat)
        var rest = mend.stat + "rest"
        var rested = 0
        var every = mend.every

        if (has(mend, "quick"))
        {
            if (statOf(character, mend.quick.stat) >= mend.quick.needed)
            {
                every = mend.quick.every
            }
        }

        // A character from before the cap takes what he has as his most
        after[capOf(mend.stat)] = most

        if (lookup(change, mend.stat, 0) >= 0 and after[mend.stat] < most)
        {
            rested = lookup(character, rest, 0) + 1

            if (rested >= every)
            {
                shiftIn(after, change, mend.stat, mend.amount)
                rested = 0

                if (after[mend.stat] > most)
                {
                    after[mend.stat] = most
                }
            }
        }

        after[rest] = rested
    }
}

for (var o = 0; o < len(aging); o++)
{
    var old = aging[o]
    var since = lived - old.fromAge * 12

    if (capOf(old.stat) != "" and has(character, old.stat) and since > 0 and since % old.every == 0)
    {
        var most = mostOf(after, old.stat) - old.amount

        if (most < 0)
        {
            most = 0
        }

        after[capOf(old.stat)] = most

        if (after[old.stat] > most)
        {
            shiftIn(after, change, old.stat, most - after[old.stat])
        }
    }
}

var month = {after: after, entries: entries, hurt: hurt}

var caps = []

for (var c : statCaps)
{
    if (has(character, c))
    {
        push(caps, {stat: c, most: mostOf(character, c)})
    }
}

var rows = []

for (var j = 0; j < len(holdings); j++)
{
    var h = holdings[j]
    var delta = lookup(change, h.id, 0)
    var rate = ""

    if (delta != 0)
    {
        rate = signed(delta) + " / mo"
    }

    if (lookup(h, "ledger", true))
    {
        push(rows, {id: h.id, group: h.group, groupLabel: h.groupLabel, glyph: h.glyph, name: h.name, tone: h.tone, rate: rate, limit: limitOf(h.id), title: lookup(h, "title", false)})
    }
}

// What hovering a holding says: the figures behind its row
var glosses = []

for (var g = 0; g < len(holdings); g++)
{
    var h = holdings[g]
    var held = statOf(character, h.id)
    var limit = limitOf(h.id)
    var delta = lookup(change, h.id, 0)
    var footnote = ""

    // A row's tone says which way its figure goes: "" plain, "gain", "loss", "time", "muted"
    // What he holds, over the most he can hold when there is one: "3/60"
    var holds = toString(held)

    if (limit > 0)
    {
        holds = holds + "/" + toString(limit)
    }

    var notes = [{label: "Held", value: holds, tone: ""}]

    if (delta != 0)
    {
        var way = "gain"

        if (delta < 0)
        {
            way = "loss"
        }

        push(notes, {label: "This month", value: signed(delta), tone: way})
    }

    for (var y = 0; y < len(yields); y++)
    {
        if (yields[y].stat == h.id)
        {
            var way = "gain"

            if (yields[y].amount < 0)
            {
                way = "loss"
            }

            var often = " / mo"

            if (yields[y].every > 1)
            {
                often = " / " + toString(yields[y].every) + " mo"
            }

            push(notes, {label: "From " + yields[y].name, value: signed(yields[y].amount) + often, tone: way})
        }
    }

    var produces = listOf(h, "produces")

    for (var p = 0; p < len(produces); p++)
    {
        var product = produces[p]
        var label = "Each brings " + statName(product.stat)

        if (product.per > 1)
        {
            label = "Every " + toString(product.per) + " bring " + statName(product.stat)
        }

        push(notes, {label: label, value: signed(product.amount) + " / mo", tone: "gain"})
        footnote = "A GENERATOR: IT WORKS EVERY MONTH HE HOLDS IT"
    }

    var decays = lookup(h, "decays", 0)

    if (decays > 0)
    {
        push(notes, {label: "A month uses", value: toString(decays), tone: "loss"})

        if (held > 0)
        {
            push(notes, {label: "Lasts", value: fmtMonths(toInt(floor((held + decays - 1) / decays))), tone: "time"})
        }

        if (has(h, "empty"))
        {
            for (var e = 0; e < len(h.empty.effects); e++)
            {
                var effect = h.empty.effects[e]
                var way = "gain"

                if (effect.amount < 0)
                {
                    way = "loss"
                }

                push(notes, {label: "With none, " + statName(effect.stat), value: signed(effect.amount) + " / mo", tone: way})
            }

            if (held <= 0 and has(character, h.id))
            {
                footnote = "NONE LEFT: HE PAYS FOR IT EVERY MONTH"
            }
        }

        if (board)
        {
            footnote = "MEALS PROVIDED: THIS MONTH USES NONE"
        }
    }

    if (limit > 0 and held >= limit)
    {
        footnote = "FULL: WHAT BRINGS MORE IS CLOSED TO HIM"
    }

    // A title is had or not: nothing to count, no limit to state
    if (lookup(h, "title", false))
    {
        notes = []
        footnote = ""
    }

    if (lookup(h, "ledger", true))
    {
        push(glosses, {id: h.id, title: h.name, text: lookup(h, "about", ""), footnote: footnote, rows: notes})
    }
}

// The character as he is: a life with nothing left of what it needs is over
var death = ""

for (var m = 0; m < len(mortal); m++)
{
    if (death == "" and has(character, mortal[m].stat) and statOf(character, mortal[m].stat) <= 0)
    {
        death = mortal[m].entry

        if (lived >= lastAge * 12)
        {
            death = mortal[m].aged
        }
    }
}
