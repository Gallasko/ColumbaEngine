// Chronicle rules: shared helpers
// -------------------------------
// Pure functions and the stat tables: no state, no ecs, no events. Imported by the other rule
// scripts, first.
//
// Every function of the rules is declared here, ahead of the tables. A function is a constant of
// the script that declares it, and its index must fit in a byte: declared after the 256th
// constant (the activity table alone holds more), it does not compile. An import is compiled into
// the importing script, so a function after `import "activitytable"` is past it too. The
// functions read the tables below by name, when they are called.
//
// The tables are `const`: a rule script's VM makes them on its first run and keeps them for the
// next ones. Nothing writes into them: a row that is written into per run is a copy (activitytable.pg's
// walk rows take their requirements through `entriesCopied`).

import "string"
import "math"
import "algorithm"

fun clamp(v, lo, hi)
{
    if (v < lo)
    {
        return lo
    }

    if (v > hi)
    {
        return hi
    }

    return v
}

// 1 -> "1st", 2 -> "2nd", 11 -> "11th", 21 -> "21st"
fun ordinal(n)
{
    var lastTwo = n % 100
    var last = n % 10
    var suffix = "th"

    if (lastTwo < 11 or lastTwo > 13)
    {
        if (last == 1)
        {
            suffix = "st"
        }
        else if (last == 2)
        {
            suffix = "nd"
        }
        else if (last == 3)
        {
            suffix = "rd"
        }
    }

    return toString(n) + suffix
}

// The whole months lived at `age`, counted from birth: an age is a sum of twelfths, and the
// nearest month is the one meant.
fun monthOf(age)
{
    return toInt(floor(age * 12 + 0.5))
}

// Whole months from one age to another: never negative.
fun monthsBetween(fromAge, toAge)
{
    if (toAge <= fromAge)
    {
        return 0
    }

    return toInt(floor((toAge - fromAge) * 12 + 0.001))
}

// How many attempts of `cost` months fit in `open` months.
fun monthsToAttempts(open, cost)
{
    if (cost <= 0)
    {
        return 0
    }

    return toInt(floor(open / cost))
}

// +1, −2 (a real minus, U+2212)
fun signed(n)
{
    if (n < 0)
    {
        return "−" + toString(0 - n)
    }

    return "+" + toString(n)
}

fun fmtMonths(n)
{
    return toString(n) + " mo"
}

// The months `held` of a thing lasts at `uses` a month, counted while every mouth that eats it is
// fed: he eats first, so a month that feeds him and not his familiars is not counted. A month
// that feeds him alone is still one, so what he holds lasts at least that.
fun monthsFed(held, uses)
{
    var months = toInt(floor(held / uses))

    if (months < 1 and held > 0)
    {
        months = 1
    }

    return months
}

// 0 -> "no", 1 -> "one", ... 12 -> "twelve"; beyond, the figure.
fun numberWord(n)
{
    var words = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"]

    if (n >= 0 and n < len(words))
    {
        return words[n]
    }

    return toString(n)
}

// 1 -> "first", 17 -> "seventeenth", 21 -> "twenty-first", 40 -> "fortieth", 43 -> "forty-third"
fun ordinalWord(n)
{
    var units = ["", "first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth",
                 "eleventh", "twelfth", "thirteenth", "fourteenth", "fifteenth", "sixteenth", "seventeenth", "eighteenth", "nineteenth"]
    var tensOrdinal = ["", "", "twentieth", "thirtieth", "fortieth", "fiftieth", "sixtieth", "seventieth", "eightieth", "ninetieth"]
    var tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]

    if (n <= 0 or n >= 100)
    {
        return ordinal(n)
    }

    if (n < 20)
    {
        return units[n]
    }

    var t = toInt(floor(n / 10))
    var u = n % 10

    if (u == 0)
    {
        return tensOrdinal[t]
    }

    return tens[t] + "-" + units[u]
}

// An age as the head writes it: one decimal ("17.5").
fun ageText(age)
{
    var months = monthOf(age)
    var whole = toInt(floor(months / 12))
    var tenth = toInt(floor((months % 12) * 10 / 12))

    return toString(whole) + "." + toString(tenth)
}

// The season a month of his year falls in (0 = the month he was born, in the winter).
fun seasonOf(month)
{
    var seasons = ["WINTER", "WINTER", "WINTER", "SPRING", "SPRING", "SPRING", "SUMMER", "SUMMER", "SUMMER", "AUTUMN", "AUTUMN", "AUTUMN"]

    return seasons[clamp(month, 0, 11)]
}

fun capitalised(word)
{
    if (strlen(word) == 0)
    {
        return word
    }

    return toUpperCase(substring(word, 0, 1)) + substring(word, 1, strlen(word))
}

// Whether a text begins with another.
fun startsWith(text, prefix)
{
    if (strlen(text) < strlen(prefix))
    {
        return false
    }

    return substring(text, 0, strlen(prefix)) == prefix
}

// `lookup(table, key, fallback)`, the field or the fallback when the table has none, is the
// algorithm module's (a native): the rules look names up hundreds of thousands of times a run,
// and a function of their own around `contain` was a fifth of the activities' run.

// Whether a table holds a key at all.
fun has(table, key)
{
    return contain(table, key)
}

// A list field of a table, empty when the table has none.
fun listOf(table, key)
{
    return lookup(table, key, [])
}

// A [{stat, amount}] field of a table, empty when the table has none: each entry is given the
// amount it leaves out, 1. The entries are the table's own, so every later reader finds it.
fun amountsOf(table, key)
{
    var list = lookup(table, key, [])

    for (var i = 0; i < len(list); i++)
    {
        list[i].amount = lookup(list[i], "amount", 1)
    }

    return list
}

// A list of tables, each copied (one level deep): what a row may write into without touching the
// table it was made from, such as the requirements of a zone a `const` keeps from run to run
fun entriesCopied(list)
{
    var out = []

    for (var i = 0; i < len(list); i++)
    {
        var copy = {}

        for (var k : list[i])
        {
            copy[k] = list[i][k]
        }

        push(out, copy)
    }

    return out
}

fun statName(stat)
{
    return lookup(statNames, stat, stat)
}

fun statShortName(stat)
{
    return lookup(statShort, stat, toUpperCase(stat))
}

// Whether a stat is a count the rules keep for themselves (`hiddenStats`): a tile, a gloss and
// the log leave it out of what a work brings.
fun statHidden(stat)
{
    for (var h = 0; h < len(hiddenStats); h++)
    {
        if (hiddenStats[h] == stat)
        {
            return true
        }
    }

    return false
}

// A stat of a character, 0 when it has none.
fun statOf(character, stat)
{
    return lookup(character, stat, 0)
}

// The most of a stat he can hold, 0 when it has no limit. A store he has (the stat "store.<stat>")
// raises a limit that is there; it gives none to a stat without one.
fun limitOf(character, stat)
{
    var base = lookup(statLimits, stat, 0)

    if (base > 0)
    {
        var store = statOf(character, "store." + stat)

        if (store > 0)
        {
            base = base + store
        }
    }

    return base
}

// How much more of a stat he can take in, 0 when it is full. Only for a stat with a limit.
fun roomFor(character, stat)
{
    var limit = limitOf(character, stat)

    return clamp(limit - statOf(character, stat), 0, limit)
}

// The kind of familiar with an id, an empty table when there is none.
fun kindById(id)
{
    for (var k = 0; k < len(familiarKinds); k++)
    {
        if (familiarKinds[k].id == id)
        {
            return familiarKinds[k]
        }
    }

    return {}
}

// The levels of the town that stand, every place's in towntable.pg's order and each place's
// first first: a level stands once the place is raised to it ("town.<id>" in `character`). What
// a level gives the economy (its `slots`, `teaches`, `stash` and `more`) is read from these.
// Only for a script that imports towntable.pg.
fun levelsReached(character)
{
    var reached = []

    for (var t = 0; t < len(townPlaces); t++)
    {
        var place = townPlaces[t]
        var at = clamp(statOf(character, "town." + place.id), 0, len(place.levels))

        for (var l = 0; l < at; l++)
        {
            push(reached, place.levels[l])
        }
    }

    return reached
}

// What the levels of the town that stand add to each familiar's yield of a stat: the `amount`
// of each of their `more` that names it.
fun moreFromTown(character, stat)
{
    var more = 0
    var reached = levelsReached(character)

    for (var r = 0; r < len(reached); r++)
    {
        var given = listOf(reached[r], "more")

        for (var m = 0; m < len(given); m++)
        {
            if (given[m].stat == stat)
            {
                more = more + given[m].amount
            }
        }
    }

    return more
}

// The most of any one thing the stash keeps between lives: its own, and what the levels of the
// town that stand add to it (their `stash`).
fun stashMost(character)
{
    var most = economyKnobs.stashMost
    var reached = levelsReached(character)

    for (var r = 0; r < len(reached); r++)
    {
        most = most + lookup(reached[r], "stash", 0)
    }

    return most
}

// Whether the stash holds anything: a stat "stash.<id>" above none in `character`.
fun holdsStash(character)
{
    for (var key : character)
    {
        if (startsWith(key, "stash.") and statOf(character, key) > 0)
        {
            return true
        }
    }

    return false
}

// How many familiars he can keep: the life's own slots, what his standing and calling add, and
// what the levels of the town that stand add (their `slots`), from his first day.
fun slotsOf(character)
{
    var slots = economyKnobs.baseSlots

    for (var g = 0; g < len(slotGivers); g++)
    {
        var giver = slotGivers[g]

        if (statOf(character, giver.stat) >= lookup(giver, "needed", 1))
        {
            slots = slots + giver.slots
        }
    }

    var reached = levelsReached(character)

    for (var r = 0; r < len(reached); r++)
    {
        slots = slots + lookup(reached[r], "slots", 0)
    }

    return slots
}

// How many familiars are bound to him, of every kind.
fun boundCount(character)
{
    var count = 0

    for (var k = 0; k < len(familiarKinds); k++)
    {
        count = count + statOf(character, "fam." + familiarKinds[k].id)
    }

    return count
}

// The slots he has left, 0 when he is full (or holds more than the slots he has).
fun freeSlots(character)
{
    var free = slotsOf(character) - boundCount(character)

    if (free < 0)
    {
        free = 0
    }

    return free
}

// Whether a kind is his to bind: known from the start, learned in this world, or taught by a
// level of the town that stands (its `teaches`), for as long as it stands.
fun kindKnown(character, kind)
{
    if (kind.known or statOf(character, "know.fam." + kind.id) > 0)
    {
        return true
    }

    var reached = levelsReached(character)

    for (var r = 0; r < len(reached); r++)
    {
        if (lookup(reached[r], "teaches", "") == kind.id)
        {
            return true
        }
    }

    return false
}

// A stat said as a number of things, in caps: "1 RATION", "4 BERRIES". One says the thing once
// (a basic's `one`), more say its name; rations, reagents and coin are no resource of the table.
fun thingsWord(stat, amount)
{
    var word = toUpperCase(stat)

    if (stat == "rations")
    {
        word = "RATIONS"

        if (amount == 1)
        {
            word = "RATION"
        }
    }
    else if (stat == "reagents")
    {
        word = "REAGENTS"

        if (amount == 1)
        {
            word = "REAGENT"
        }
    }
    else if (stat == "coin")
    {
        word = "COIN"
    }
    else
    {
        for (var b = 0; b < len(basicResources); b++)
        {
            if (basicResources[b].id == stat)
            {
                word = toUpperCase(basicResources[b].name)

                if (amount == 1)
                {
                    word = toUpperCase(basicResources[b].one)
                }
            }
        }

        for (var m = 0; m < len(madeResources); m++)
        {
            if (madeResources[m].id == stat)
            {
                word = toUpperCase(madeResources[m].name)

                if (amount == 1)
                {
                    word = toUpperCase(madeResources[m].one)
                }
            }
        }
    }

    return toString(amount) + " " + word
}

// Words joined with commas.
fun listedWords(words)
{
    var text = ""

    for (var w = 0; w < len(words); w++)
    {
        if (w > 0)
        {
            text = text + ", "
        }

        text = text + words[w]
    }

    return text
}

// What a step of a work brings or takes, as a line of its gloss says it: a thing in plain words
// ("+3 berries", "+2 coin"), a part or a skill by its name ("+1 Renown"), and a flag by its name
// alone ("Victor of the tourney").
fun stepGainWords(stat, amount)
{
    var thing = stat == "coin" or stat == "rations" or stat == "reagents"

    for (var b = 0; b < len(basicResources); b++)
    {
        if (basicResources[b].id == stat)
        {
            thing = true
        }
    }

    for (var m = 0; m < len(madeResources); m++)
    {
        if (madeResources[m].id == stat)
        {
            thing = true
        }
    }

    var sign = "+"
    var count = amount

    if (amount < 0)
    {
        sign = "−"
        count = 0 - amount
    }

    if (thing)
    {
        return sign + toLowerCase(thingsWord(stat, count))
    }

    var counted = stat == "favors"

    for (var p = 0; p < len(partsAndSkills); p++)
    {
        if (partsAndSkills[p] == stat)
        {
            counted = true
        }
    }

    if (counted)
    {
        return sign + toString(count) + " " + statName(stat)
    }

    return statName(stat)
}

// What a step brings of a thing the work already brings, as a receipt: all of it, then where it
// comes from ("+9 berries (base +6, bonus +3)"). What the work does not bring is said alone
fun bonusGainWords(stat, base, bonus)
{
    if (base <= 0 or bonus <= 0)
    {
        return stepGainWords(stat, bonus)
    }

    return stepGainWords(stat, base + bonus) + " (base +" + toString(base) + ", bonus +" + toString(bonus) + ")"
}

// The line of a work's gloss for the step `s` of its `bonus`: what one of his parts or skills
// (`partsAndSkills`) would make of it, "With Strength 8: +6 firewood (base +4, bonus +2)", "With
// Dexterity 9: 2 months instead of 3". What the town or a flag makes of a work is said where they are: "" for those steps.
// `plainMonths` and `plainGains` are the work's own, before any step. Every step on that stat up
// to this one adds its `more` (activitytable.pg applies them all), so the line says all he brings
// once he has it, and not the step's share.
fun bonusStepLabel(steps, s, plainMonths, plainGains)
{
    var step = steps[s]
    var shown = false

    for (var p = 0; p < len(partsAndSkills); p++)
    {
        if (partsAndSkills[p] == step.stat)
        {
            shown = true
        }
    }

    if (not shown)
    {
        return ""
    }

    var needed = lookup(step, "needed", 1)
    var said = []

    if (has(step, "months"))
    {
        var unit = " months"

        if (step.months == 1)
        {
            unit = " month"
        }

        push(said, toString(step.months) + unit + " instead of " + toString(plainMonths))
    }

    // What it brings in place of the work's own: what that adds to them
    var gained = listOf(step, "gains")

    for (var g = 0; g < len(gained); g++)
    {
        var before = 0

        for (var o = 0; o < len(plainGains); o++)
        {
            if (plainGains[o].stat == gained[g].stat)
            {
                before = before + plainGains[o].amount
            }
        }

        var added = lookup(gained[g], "amount", 1) - before

        if (added != 0 and not statHidden(gained[g].stat))
        {
            push(said, bonusGainWords(gained[g].stat, before, added))
        }
    }

    // What it adds to them, with what the steps below it on the same stat add
    var moreOf = {}
    var order = []

    for (var o = 0; o < len(steps); o++)
    {
        if (steps[o].stat == step.stat and lookup(steps[o], "needed", 1) <= needed)
        {
            var more = listOf(steps[o], "more")

            for (var m = 0; m < len(more); m++)
            {
                if (not contain(moreOf, more[m].stat))
                {
                    moreOf[more[m].stat] = 0
                    push(order, more[m].stat)
                }

                moreOf[more[m].stat] = moreOf[more[m].stat] + lookup(more[m], "amount", 1)
            }
        }
    }

    for (var m = 0; m < len(order); m++)
    {
        var base = 0

        for (var o = 0; o < len(plainGains); o++)
        {
            if (plainGains[o].stat == order[m])
            {
                base = base + plainGains[o].amount
            }
        }

        push(said, bonusGainWords(order[m], base, moreOf[order[m]]))
    }

    return "With " + statName(step.stat) + " " + toString(needed) + ": " + listedWords(said)
}

// What a kind eats and makes a month, in caps for a tile: "EATS 1 RATION · MAKES 4 BERRIES".
fun upkeepCaption(kind)
{
    var eats = []
    var makes = []

    for (var e = 0; e < len(kind.eats); e++)
    {
        push(eats, thingsWord(kind.eats[e].stat, kind.eats[e].amount))
    }

    for (var m = 0; m < len(kind.makes); m++)
    {
        push(makes, thingsWord(kind.makes[m].stat, kind.makes[m].amount))
    }

    // (what eats nothing says so: the first kinds cost a young life no food)
    if (len(eats) == 0)
    {
        return "EATS NOTHING · MAKES " + listedWords(makes)
    }

    return "EATS " + listedWords(eats) + " · MAKES " + listedWords(makes)
}

// Words joined with commas, and the last two with "and": "3 berries, 2 water and 1 firewood".
fun joinedWithAnd(words)
{
    var text = ""

    for (var w = 0; w < len(words); w++)
    {
        if (w > 0 and w == len(words) - 1)
        {
            text = text + " and "
        }
        else if (w > 0)
        {
            text = text + ", "
        }

        text = text + words[w]
    }

    return text
}

// What a kind eats and makes a month, as a sentence for the row that binds it, in the words of
// its tile's caption: "It eats 1 ration a month, and makes 4 berries."
fun upkeepSentence(kind)
{
    var eats = []
    var makes = []

    for (var e = 0; e < len(kind.eats); e++)
    {
        push(eats, toLowerCase(thingsWord(kind.eats[e].stat, kind.eats[e].amount)))
    }

    for (var m = 0; m < len(kind.makes); m++)
    {
        push(makes, toLowerCase(thingsWord(kind.makes[m].stat, kind.makes[m].amount)))
    }

    if (len(eats) == 0)
    {
        return "It eats nothing, and makes " + joinedWithAnd(makes) + " a month."
    }

    return "It eats " + joinedWithAnd(eats) + " a month, and makes " + joinedWithAnd(makes) + "."
}

// What one lesson adds to each of a kind, as a sentence: "Each sprite makes 1 berry more a month."
fun lessonSentence(kind)
{
    return "Each " + kind.one + " makes " + toLowerCase(thingsWord(kind.makes[0].stat, 1)) + " more a month."
}

// What his death puts into the stash, in words: of each basic resource, what he holds less what
// a gift leaves to a place (`leaves`, [{stat, amount}]), and no more than the stash still has room
// for under `most`. "1 berry, 25 water, 12 stone", or "" when none of it goes in.
fun stashWords(character, leaves, most)
{
    var parts = []

    for (var b = 0; b < len(basicResources); b++)
    {
        var id = basicResources[b].id
        var left = statOf(character, id)

        for (var l = 0; l < len(leaves); l++)
        {
            if (leaves[l].stat == id)
            {
                left = left - leaves[l].amount
            }
        }

        var room = most - statOf(character, "stash." + id)

        if (left > room)
        {
            left = room
        }

        if (left > 0)
        {
            push(parts, toLowerCase(thingsWord(id, left)))
        }
    }

    return listedWords(parts)
}

// The most a stat can ever be, 0 when it has no ceiling.
fun ceilingOf(stat)
{
    return lookup(statCeilings, stat, 0)
}

// A stat raised by `amount`, never past its ceiling; what already stood past it is left alone.
fun raised(current, stat, amount)
{
    var now = current + amount
    var most = ceilingOf(stat)

    if (amount > 0 and most > 0 and now > most)
    {
        now = most

        if (current > most)
        {
            now = current
        }
    }

    return now
}

// The stat holding the most a stat can be, "" when it has no cap.
fun capOf(stat)
{
    return lookup(statCaps, stat, "")
}

// The most a stat of a character can be: its cap, or what it is when the character has none yet.
fun mostOf(character, stat)
{
    return lookup(character, capOf(stat), statOf(character, stat))
}

// Whether a place of the town (towntable.pg) is on the Town page for this character, `lived`
// months old, with the terms he has `done` (activity id -> terms) in the life of the world that
// `lives` counts: one that was raised, was left coin or was seen by a life before stays there;
// else its `shows` says what brings it (an age, a flag he holds, an activity he has done, a life
// of the world, a stash that holds anything; all of those it gives. None: from the start).
fun placeShown(place, character, lived, done, lives)
{
    if (statOf(character, "town." + place.id) > 0 or statOf(character, "fund." + place.id) > 0 or statOf(character, "seen." + place.id) > 0)
    {
        return true
    }

    var shows = lookup(place, "shows", {})

    if (lived < lookup(shows, "fromAge", 0) * 12)
    {
        return false
    }

    if (has(shows, "flag"))
    {
        if (statOf(character, shows.flag) <= 0)
        {
            return false
        }
    }

    if (has(shows, "done"))
    {
        if (lookup(done, shows.done, 0) <= 0)
        {
            return false
        }
    }

    if (lives < lookup(shows, "lives", 1))
    {
        return false
    }

    if (lookup(shows, "stash", false))
    {
        if (not holdsStash(character))
        {
            return false
        }
    }

    return true
}

// The table of a list with that id, {id: ""} when there is none.
fun byId(list, id)
{
    for (var i = 0; i < len(list); i++)
    {
        if (list[i].id == id)
        {
            return list[i]
        }
    }

    return {id: ""}
}

// The age his prime ends at, in the town this character lives in (see `longAge`). Settled for
// the rest of his life the month he reaches thirty (`primeStat`): an Inn raised after it moves the
// old age of the lives after his, not his.
fun primeEnd(character)
{
    var settled = statOf(character, primeStat)

    if (settled > 0)
    {
        return settled
    }

    if (statOf(character, "town." + callingPlace) >= 1)
    {
        return longAge
    }

    return shortAge
}

// Whether a level of a place is the one that ends his prime at fifty (the calling place's first,
// `primeEnd`) and he is past it: his old age began at thirty, and what it gives is for the lives
// after his. The town says so in its `later` and `laterNote` (towntable.pg, `levelGives`).
fun primeGoneBy(place, l, character)
{
    var settled = statOf(character, primeStat)

    return place.id == callingPlace and l == 0 and settled > 0 and settled < longAge
}

// What a level of a place gives, in one line, as its gloss says it: its `gives`, or its `later`
// to a man past the prime it would have given him (`primeGoneBy`).
fun levelGives(place, l, character)
{
    var level = place.levels[l]

    if (primeGoneBy(place, l, character))
    {
        return lookup(level, "later", level.gives)
    }

    return level.gives
}

// And what its tile says: its `note`, or its `gives` without one; its `laterNote` past that prime.
fun levelNote(place, l, character)
{
    var level = place.levels[l]

    if (primeGoneBy(place, l, character))
    {
        return lookup(level, "laterNote", levelGives(place, l, character))
    }

    return lookup(level, "note", level.gives)
}

// A field that is one thing or a list of them, as a list.
fun asList(value)
{
    if (typeOf(value) == "array")
    {
        return value
    }

    return [value]
}

// Whether a row of the activity table is closed once that activity is done: its `unless`, one id
// or several.
fun closedBy(row, id)
{
    if (not contain(row, "unless"))
    {
        return false
    }

    var ids = asList(row.unless)

    for (var i = 0; i < len(ids); i++)
    {
        if (ids[i] == id)
        {
            return true
        }
    }

    return false
}

// Whether a character holds any of a list of stats.
fun holdsAny(character, stats)
{
    for (var i = 0; i < len(stats); i++)
    {
        if (statOf(character, stats[i]) > 0)
        {
            return true
        }
    }

    return false
}

// Whether a row of the activity table can no longer be begun by who has lived `lived` months: its
// term would fall after its `finishBy` (`last` when it gives none), to the month.
fun tooLate(row, lived, last)
{
    return (lived + row.months) > (lookup(row, "finishBy", last) * 12 + lookup(row, "finishMonths", 0))
}

// Whether an activity of the table is behind him: done once in this life, or closed to him for
// good (too late for it, or one of its `unless` done). What a row's `follows` waits for: nothing
// waits forever on what he missed. An id the table does not have is behind no one. `rowsById` is
// the table by id (activitytable.pg's `activityById`).
fun behindHim(rowsById, id, done, lived, last)
{
    if (lookup(done, id, 0) > 0)
    {
        return true
    }

    var row = lookup(rowsById, id, {id: ""})

    if (row.id == "")
    {
        return false
    }

    if (tooLate(row, lived, last))
    {
        return true
    }

    if (contain(row, "unless"))
    {
        var closers = asList(row.unless)

        for (var i = 0; i < len(closers); i++)
        {
            if (lookup(done, closers[i], 0) > 0)
            {
                return true
            }
        }
    }

    return false
}

// "A", "A and B", "A, B and C"
fun namesText(names)
{
    var out = ""

    for (var i = 0; i < len(names); i++)
    {
        if (i > 0 and i == len(names) - 1)
        {
            out = out + " and "
        }
        else if (i > 0)
        {
            out = out + ", "
        }

        out = out + names[i]
    }

    return out
}

// The coin a level of a place asks of this character (towntable.pg): what it writes, or less
// with the flag its `cheaper` names, {flag, coin}.
fun levelCoin(step, character)
{
    if (contain(step, "cheaper"))
    {
        if (statOf(character, step.cheaper.flag) > 0)
        {
            return step.cheaper.coin
        }
    }

    return step.coin
}

// The flag that makes him one of a path (activitytable.pg's `paths`), "" for none.
fun pathFlagOf(paths, path)
{
    return lookup(byId(paths, path), "flag", "")
}

// What the milestone `id` asks, every path; nothing for none.
fun asksOf(milestones, id)
{
    for (var i = 0; i < len(milestones); i++)
    {
        if (milestones[i].id == id)
        {
            return milestones[i].asks
        }
    }

    return []
}

// A month's change to one stat: `after` (every stat once the month has passed) moves by
// `amount`, never below 0 and, upward, never past the stat's limit (or past where he already stood
// over it); `change` keeps what each stat really moved, for the rates.
fun shiftIn(after, change, stat, amount)
{
    var now = lookup(after, stat, 0) + amount

    if (now < 0)
    {
        amount = amount - now
        now = 0
    }

    var limit = limitOf(after, stat)

    if (limit > 0 and amount > 0 and now > limit)
    {
        // Up to the limit, or where he already stood past it
        var top = now - amount

        if (top < limit)
        {
            top = limit
        }

        amount = amount - (now - top)
        now = top
    }

    after[stat] = now
    change[stat] = lookup(change, stat, 0) + amount
}

// The familiars bound to him eat and make their month, once he has eaten his: each kind in the
// order of economytable.pg's `familiarKinds`, so that what one makes can feed a later one the same
// month. A kind is fed all or nothing: when `after` holds what all of them eat, they take it and
// make their things, and each `more.<stat>` he has learned adds that much to each one's yield, as
// does the `more` of a level of the town that stands (`moreFromTown`), up to the limit. When it does not, they take nothing and make nothing, and `entries` says they
// went hungry: their hunger costs him nothing. Returns what each stat moved, for the rates.
fun feedFamiliars(after, entries)
{
    var moved = {}

    for (var k = 0; k < len(familiarKinds); k++)
    {
        var bound = familiarKinds[k]
        var n = statOf(after, "fam." + bound.id)

        if (n > 0)
        {
            var fed = true

            for (var e = 0; e < len(bound.eats); e++)
            {
                if (statOf(after, bound.eats[e].stat) < n * bound.eats[e].amount)
                {
                    fed = false
                }
            }

            if (fed)
            {
                for (var t = 0; t < len(bound.eats); t++)
                {
                    shiftIn(after, moved, bound.eats[t].stat, 0 - n * bound.eats[t].amount)
                }

                for (var m = 0; m < len(bound.makes); m++)
                {
                    var stat = bound.makes[m].stat

                    shiftIn(after, moved, stat, n * bound.makes[m].amount + (statOf(after, "more." + stat) + moreFromTown(after, stat)) * n)
                }
            }
            else
            {
                push(entries, {text: capitalised(bound.name) + " went hungry", kind: "loss", figure: "", glyph: bound.glyph})
            }
        }
    }

    return moved
}

// A walk outside the town (expeditiontable.pg): the days on site, the days of the way there, and
// the months it blocks, for a zone studied that often. The Life page's row and the walk itself
// read the same three, so they never disagree. A zone studied to its third level is stayed in
// longer; to its fourth, the way is shorter. Who knows the roads (`roads`: 1, a carter's boy) is
// there, and home, a day sooner.
fun walkStay(zone, studies)
{
    if (studies >= walkKnobs.studyLevels[2])
    {
        return zone.stayMax
    }

    return zone.stayMin
}

fun walkTravel(zone, studies, roads)
{
    var days = zone.travel

    if (studies >= walkKnobs.studyLevels[3])
    {
        days = clamp(toInt(floor(zone.travel * (100 - walkKnobs.travelCut) / 100)), 1, zone.travel)
    }

    if (roads > 0)
    {
        days = clamp(days - walkKnobs.roadsCut, 1, days)
    }

    return days
}

fun walkMonths(zone, studies, roads)
{
    var span = 2 * walkTravel(zone, studies, roads) + walkStay(zone, studies)

    return clamp(toInt(ceil(toFloat(span) / toFloat(walkKnobs.daysAMonth))), 1, span)
}

// "Open 22 more months. One attempt fits; two do not."
fun openNote(monthsLeft, attempts)
{
    var note = "Open " + toString(monthsLeft) + " more month"

    if (monthsLeft != 1)
    {
        note = note + "s"
    }

    note = note + ". "

    if (attempts == 0)
    {
        return note + "No attempt fits."
    }

    if (attempts == 1)
    {
        note = note + "One attempt fits; "
    }
    else
    {
        note = note + capitalised(numberWord(attempts)) + " attempts fit; "
    }

    return note + numberWord(attempts + 1) + " do not."
}

// The age his prime is written up to: the last milestone (milestonetable.pg), the latest an
// activity may finish by unless it says otherwise (activitytable.pg's `finishBy`), and where old
// age begins (resources.pg's `aging`). The life goes on past it, until it has nothing left.
var lastAge = 30

// A second calling: when the Inn stands in his town (its first level, towntable.pg) by the month
// he reaches thirty, a man of thirty is not old (`primeStat`). His prime runs to `longAge`, and old age begins there. A script that reads
// `lastAge` and has the character sets it first, after its imports (an import of this file
// writes the 30 again): `lastAge = primeEnd(character)`.
var shortAge = 30
var longAge = 50
var callingPlace = "inn"

// Where his old age begins, settled for this life: the month he reaches `shortAge`, resources.pg
// writes `primeEnd` as the town is then (fifty with the Inn standing, thirty without) among his
// stats, and `primeEnd` reads it from there on. It is his, not the world's: a new life is born
// without it. An Inn raised after it takes nothing back from his old age, nor reopens the works
// it closed.
var primeStat = "prime_end"

// The `finishBy` of what an old man may still do: no age closes it.
var anyAge = 200

// The events of a life: each comes in every life, at its age, with most of a year to answer it. Its
// answers are the rows of activitytable.pg whose `event` names it, and each brings one of the
// flags of `answered`. The month it is settled (`settledAt` years and `settledMonths`: the month
// after the last of its answers could end), who holds none of them has stood by, and that is
// paid for: he holds `stood` from then on (resources.pg writes it, and `said` in the log), the
// rows of `shuts` are shut to him for this life (one each way a life may go, and none of them
// the only way to anything), and the glosses of its answers say so ahead (the names of what it
// shuts, or its `loses` when they are too many to name). A life that was never that month old
// has not stood by: one begun later, or a save from before the events.
const lifeEvents = [
    {id: "flood", name: "the Flood", settledAt: 12, settledMonths: 0, stood: "stood_flood",
     answered: ["mill_saved", "flood_hero", "flood_looted"],
     shuts: ["watch", "keys", "boys"],
     said: "The Flood came and went, and he stood by: the Watch, Father Anselm and the Bellmoor Boys have no use for him"},
    {id: "levy", name: "the Levy", settledAt: 16, settledMonths: 0, stood: "stood_levy",
     answered: ["levy_served", "levy_paid", "deserter"],
     shuts: ["edric", "mara", "night"],
     said: "The Levy mustered without him, and without his coin: Sergeant Edric, Mara and the night market want no one the Lord's clerk is looking for"},
    {id: "plague", name: "the Plague Year", settledAt: 24, settledMonths: 0, stood: "stood_plague",
     answered: ["plague_stayed", "plague_shut", "plague_profiteer"],
     shuts: ["raid", "exam", "summons", "pardon"],
     said: "The plague year went by, and he chose nothing: the raid, the Magister's examination, Vey's summons and the Lord's pardon go to others"},
    {id: "lord", name: "the succession", settledAt: 28, settledMonths: 0, stood: "stood_lord",
     answered: ["kingmaker", "church_candidate", "interregnum", "heir_sworn"],
     shuts: ["tales", "teach", "gates.open", "gates.close", "relicfront", "selftest", "spell.sell", "spell.keep", "refuse", "porters"],
     loses: "the inn wants no tale of his, no pupil is sent to him, and the moment of his calling passes him by",
     said: "The old Lord died and he took no side, not even a knee: the inn wants no tale of his, no pupil is sent to him, and the moment of his calling goes to another"}
]

// The events he has stood by are counted (the stat `stoodBy`). The count shuts nothing: an event
// stood by costs the rows it names and no more, never a class nor a second calling
var stoodBy = "stood_by"

// A no-break space (U+00A0, between the quotes): what joins an amount to its stat in a log figure
// ("+1 str"), so a figure that wraps breaks between two gains and never inside one.
var noBreak = " "

// The counts the rules keep for themselves (`statHidden`): a work gains them as it gains the rest,
// but no tile, gloss or log line shows them as something it brings. What asks for one may still
// name it, under its name below: the requirement says why a row has opened.
const hiddenStats = ["scavenged"]

