// The most of a stat he can hold at once. A stat not listed has no limit. The limit closes
// what would bring more (activitytable.pg) and stops what a month produces (resources.pg); an
// activity begun with room left may still carry him past it.
var statLimits = {
    rations: 60
}

// The most a stat can ever be: what a term brings stops there (forecast.pg). Unlike a limit it
// closes nothing, the rest of what the term brings still comes. Parts stop at 30, skills at 10;
// renown, favors and what he holds have none.
var statCeilings = {
    str: 30,
    dex: 30,
    int: 30,
    vit: 30,
    vitmax: 30,
    arms: 10,
    discipline: 10,
    letters: 10,
    lore: 10,
    arcana: 10,
    stealth: 10,
    guile: 10
}

// A stat that is spent and comes back has a cap: the stat holding the most it can be. What
// takes from the stat leaves the cap alone, what raises the stat for good raises both
// (forecast.pg), and it mends toward the cap with time (resources.pg's `mending`).
var statCaps = {
    vit: "vitmax"
}
