// Chronicle rules: the stories, scenes played day by day
// -----------------------------------------------------
// Imported by expedition.pg, with the tables, after every file of functions (storylib.pg plays
// them). Never loaded itself.
// Input:  none.
// Output: `walkStories`  one table per story, a walk of days that is played once in a life (never
//                        a record, never walked again, never on the Adventure page):
//           {id, name, glyph, unit ("day": the word for one step), days (how many the scene lasts),
//            months (what the row's time is: they fall due as the days pass, storylib.pg's
//            `endDay`), row (the activity id that opens it),
//            "class" ("" or the path it enters: "mage"), dropout ("" or the flag a failure sets),
//            marks? [{id, name}] (what the page calls a mark of the scene; its id otherwise),
//            stages [{"from", to, title, text}] (spans of days, for the head of the page),
//            tiles [{id, name, about, glyph?,
//                    days: [from, to] (the days it may be offered),
//                    cost? (days it takes, 1 when none),
//                    fee? [{stat, amount}] (paid the day it is taken; shut while he cannot),
//                    needs? [{mark | stat, at, asks?} | {anyOf [mark | stat | "tile.<id>"], asks}]
//                           (what must hold: a mark of the scene or a stat or flag of his life at
//                           `at` or more ("done.<id>": the terms of that work done in this life),
//                           or any one of `anyOf`; shown shut till then, the need's `asks` said,
//                           in words),
//                    "not"? [mark | stat | "tile.<id>"] (what must not hold: a mark, a flag, a
//                           tile already taken; while one holds it is not shown),
//                    onlyWith? [mark | stat | "tile.<id>"] (what must all hold for it to be
//                           shown at all: not shut, simply not there till then),
//                    most? (how many times it may be taken in the scene; 0 or none: no end),
//                    gives? [{mark, amount} | {stat, amount} | {item, amount} | {hp, amount}
//                            | {fight (the beast's id), count? (1), turns? (the beast's), auto?,
//                               wins? [...gifts given if he wins...]}]
//                           (a stat lands on him when it is taken; one with `said` is a flag,
//                           said by its name and that word, "Firebolt learned", never "+1".
//                           A gift with `when` [{mark |
//                           stat, at}] lands once all of it holds, the gifts before it counted,
//                           and only while he has none of it: what a course teaches, given the
//                           day its days add up. A fight is fought with what
//                           he knows that day, a story's beast (expeditiontable.pg's `story`
//                           ones) or any; `auto`: on its own, told in a line of the record, else
//                           on the fight screen, the day ending when he is back from it. Lost
//                           or fled, it takes nothing the scene gave, and nobody is carried home),
//                    line (the record's line for the day)}],
//            cards [{id, day (the day it opens; 0: when its `when` holds),
//                    when? [{mark | stat, at}] (all must hold: a card of day 0 opens the first
//                           day they do; a card of a day opens on it only if they hold then, and
//                           is missed for good if they do not),
//                    title, text,
//                    options [{id, label, needs? [{mark | stat, at, asks?}] (shown shut till met),
//                              "not"? [mark | stat | "tile.<id>"] (not shown while one holds),
//                              fee? [{stat, amount}], gives? [...as a tile's...],
//                              line (the record's line), ends? ("" | "dropout": the scene ends
//                              there, and he drops out)}]}]
//                        (a scene of the story: up to four answers; each card opens once.
//                         It opens at the start of its day, a `when` card before the day's);
//            events [{id, trigger ("day": at the start of a day), weight, days: [from, to],
//                     once, title, text, options [...as walkEvents' (expeditiontable.pg)...]}]
//                        (the story's own chance meetings, drawn in place of a zone's);
//            tests [{id, day, kind ("card" | "fight"), title, text,
//                    score [{stat | mark | flag, times (what each point counts), at? (with it, the
//                           term counts `times` once when the stat or mark is at `at` or more;
//                           a flag counts `times` when he holds it)}],
//                    options [{id, label, needs? (not shown till met: an answer for who holds
//                              it), adds? (to the score), swap? {"from", to, times?} (a term read
//                              as another stat or mark), gives?, line}],
//                    mob, count, turns, reaction, practised (a fight's: its answer is fought by
//                           hand, `count` of the beast `mob`, time called after `turns` of his
//                           turns; it scores 10 for each beaten, `reaction` if an element set
//                           another off, and `practised` for each day on the dummies: the
//                           mark "practised"),
//                    behind? (what the masters say of him while this test would fall under its
//                           floor, the lowest grade's: in words)}]
//                        (sat on their days, in order; sitting one is the day's work);
//            grades [{id ("fail" | "pass" | "merit" | "distinction"), floors? {<test id>: n} (each
//                     test's score at n or more), total? (all the scores together at it or more),
//                     gives [...as a tile's...], line? (the life's log)}]
//                        (from the lowest up: the last one reached is his; a fail drops him out);
//            gate? {day, courses [mark...], least, card, behind?}
//                        (the curriculum: on `day`, before the tests, the marks of `courses`
//                         together must come to `least`, or the card opens, and the tests never
//                         do: he is sent away. Before then, while they are fewer than `least`
//                         spread over the days before `day`, the standing says `behind`, in
//                         words, and no line that promises a pass),
//            standing [{at, line, passes?}] (how he stands, in words, over what he would score if he sat
//                     the tests today, counting only what he has done: the last line reached is
//                     said, never a figure. A card test is counted by its plain answer (no
//                     answer of his own); a fight test at its days on the dummies, and one beast
//                     beaten while he knows a way to harm it. While the curriculum is behind its
//                     pace, or a test would fall under its floor, a line that `passes` (promises
//                     a pass) is not said, nor above the lowest: the gate's `behind` is, or the
//                     test's, else the highest line under it that promises nothing),
//            plan {tiles [tile id...], cards {<card>: <answer>}, tests {<test>: <answer>}}}
//                        (the solver's way through it, and the tests': each day the first of
//                         `tiles` not yet spent that is offered and open that day, else the
//                         first tile open; each card and test answered as it says, a chance
//                         meeting by its first answer, a fight by his stance. Asked "plan",
//                         expedition.pg hands it flat, with the fees its tiles ask:
//                         storylib.pg's `planRow`. The solver begins a story with them in hand)
//
// `from`, `not` and `class` are words of the language: as keys they are written in quotes, and
// read as `stage["from"]`, `tile["not"]`, `story["class"]`.
//
// The tables are `const`: a rule script's VM makes them on its first run and keeps them for the
// next ones. Nothing writes into them.

const walkStories = [
    // The Collegium's term (activitytable.pg's `collegium`): sixteen days for its 24 months. The
    // first weeks taste of everything, each course paid at its door (the coin the row once asked
    // up front: about 35 for a full curriculum); two days of the elemental lectures by the
    // seventh bring the fork of the elements, else he stays on the basics. A course followed long
    // enough teaches its working there and then, and a drop-out keeps it. The fourteenth is the
    // last day of study; the curriculum is counted for the fifteenth (six days of courses), the
    // theory sat that day and the practical, two dummies by his own hand, on the sixteenth. The
    // theory reads what his childhood gave him. A pass makes him a mage (the row's `enters`)
    {id: "collegium", name: "The Collegium", glyph: "academy", unit: "day", days: 16, months: 24, row: "collegium", "class": "mage", dropout: "dropout.collegium",
     marks: [{id: "elemental", name: "Elemental lectures"}, {id: "familiar", name: "Familiar studies"}, {id: "revised", name: "Days of revision"},
             {id: "courses", name: "The curriculum"}, {id: "course", name: "Days on his element"}, {id: "practised", name: "Days on the dummies"},
             {id: "course.fire", name: "The fire course"}, {id: "course.frost", name: "The frost course"}, {id: "course.storm", name: "The storm course"},
             {id: "course.basic", name: "The elemental basics"}],
     stages: [{"from": 1, to: 6, title: "The first weeks", text: "Every lecture hall is open to him, and every master asks his fee at the door."},
              {"from": 7, to: 13, title: "The chosen course", text: "The masters expect a student to have chosen his element by now, and to keep to it."},
              {"from": 14, to: 16, title: "The examinations", text: "The lecture halls are shut. What is left is the library, the yard, and the masters' long table."}],
     tiles: [{id: "lectures", name: "Elemental lectures", about: "Fire, frost and storm from first principles, by a master who has said it all before.", days: [1, 6], cost: 1,
              fee: [{stat: "coin", amount: 3}], gives: [{mark: "elemental", amount: 1}, {mark: "courses", amount: 1}], line: "Heard the elemental lectures"},
             {id: "familiar", name: "Familiar studies", about: "What the small spirits are, what they eat, and what they will do for whoever feeds them.", days: [1, 13], cost: 1,
              fee: [{stat: "coin", amount: 3}], gives: [{mark: "familiar", amount: 1}, {mark: "courses", amount: 1}], line: "Sat through the familiar studies"},
             {id: "library", name: "The library", about: "Long tables, chained books, and a librarian who notices who comes back.", days: [1, 14], cost: 1,
              gives: [{mark: "revised", amount: 1}], line: "Read in the library"},
             {id: "scriptorium", name: "Copy for the scriptorium", about: "The Collegium pays its students to copy what it sells. It teaches nothing the masters will ask.", days: [1, 13], cost: 1,
              gives: [{stat: "coin", amount: 3}], line: "Copied for the scriptorium"},
             {id: "rest", name: "A day's rest", about: "Sleep, a walk by the river, and nothing written down.", days: [1, 14], cost: 1,
              gives: [{hp: 10}], line: "Rested a day"},

             // His element, for who chose one on the seventh day: its working is his once he has
             // followed it long enough. The basics for who chose none, or was given no choice
             {id: "fire", name: "The fire course", about: "The working of fire, taught to the few who chose it. Followed long enough, the first working is his.", days: [7, 13], cost: 1,
              onlyWith: ["course.fire"], fee: [{stat: "coin", amount: 3}],
              gives: [{mark: "course", amount: 1}, {mark: "courses", amount: 1}, {stat: "fire_course", amount: 1, said: "learned", when: [{mark: "course", at: 2}]}],
              line: "Followed the fire course"},
             {id: "frost", name: "The frost course", about: "The working of frost, taught to the few who chose it. Followed long enough, the frost bolt is his.", days: [7, 13], cost: 1,
              onlyWith: ["course.frost"], fee: [{stat: "coin", amount: 3}],
              gives: [{mark: "course", amount: 1}, {mark: "courses", amount: 1}, {stat: "frost_course", amount: 1, said: "learned", when: [{mark: "course", at: 2}]}],
              line: "Followed the frost course"},
             {id: "storm", name: "The storm course", about: "The working of storm, taught to the few who chose it. Followed long enough, the storm bolt is his.", days: [7, 13], cost: 1,
              onlyWith: ["course.storm"], fee: [{stat: "coin", amount: 3}],
              gives: [{mark: "course", amount: 1}, {mark: "courses", amount: 1}, {stat: "storm_course", amount: 1, said: "learned", when: [{mark: "course", at: 2}]}],
              line: "Followed the storm course"},
             {id: "basics", name: "The elemental basics", about: "A little of each element, for who keeps to no one of them. Followed long enough, the three cantrips are his.", days: [7, 13], cost: 1,
              "not": ["course.fire", "course.frost", "course.storm"], fee: [{stat: "coin", amount: 3}],
              gives: [{mark: "elemental", amount: 1}, {mark: "courses", amount: 1},
                      {stat: "spark_taught", amount: 1, said: "learned", when: [{mark: "elemental", at: 4}]}, {stat: "rime_taught", amount: 1, said: "learned", when: [{mark: "elemental", at: 4}]},
                      {stat: "static_taught", amount: 1, said: "learned", when: [{mark: "elemental", at: 4}]}],
              line: "Followed the elemental basics"},

             // The binding hall teaches the kind of familiar the world does not know yet: the well
             // imp, or for who knows it the kitchen brownie. Once
             {id: "binding", name: "The binding hall", about: "Where the Collegium binds its familiars. A student of the familiar studies may watch, and learn how the well imp is bound.", days: [7, 13], cost: 1,
              needs: [{mark: "familiar", at: 3, asks: "ASKS MORE OF THE FAMILIAR STUDIES"}], "not": ["know.fam.imp"], most: 1, fee: [{stat: "coin", amount: 3}],
              gives: [{stat: "know.fam.imp", amount: 1, said: "learned"}], line: "Learned in the binding hall how the well imp is bound"},
             {id: "hearthbinding", name: "The binding hall", about: "Where the Collegium binds its familiars. A student of the familiar studies may watch, and learn how the kitchen brownie is bound.", days: [7, 13], cost: 1,
              needs: [{mark: "familiar", at: 3, asks: "ASKS MORE OF THE FAMILIAR STUDIES"}], onlyWith: ["know.fam.imp"], "not": ["tile.binding", "know.fam.brownie"], most: 1,
              fee: [{stat: "coin", amount: 3}], gives: [{stat: "know.fam.brownie", amount: 1, said: "learned"}], line: "Learned in the binding hall how the kitchen brownie is bound"},

             // The dummies, for who has a working to throw at them (fought on its own)
             {id: "practice", name: "Practise on the dummies", about: "Straw and sacking in the yard, and a working thrown at it until it is thrown well.", days: [7, 14], cost: 1,
              needs: [{anyOf: ["fire_course", "frost_course", "storm_course", "spark_taught", "rime_taught", "static_taught", "forbidden_read", "mara_student", "anselm_trust"],
                       asks: "ASKS A WORKING HE CAN THROW"}],
              gives: [{fight: "dummy", auto: true, wins: [{mark: "practised", amount: 1}]}], line: "Practised on the dummies"}],

     // The fork of the elements, for who heard the elemental lectures twice by the seventh day;
     // and the masters sending away who has not followed enough of the curriculum
     cards: [{id: "course", day: 7, when: [{mark: "elemental", at: 2}], title: "The choice of an element",
              text: "The master of the first year reads out the courses of the spring. Each student is to give his name to one element, or to none, and to keep to it.",
              options: [{id: "fire", label: "Give his name to fire", gives: [{mark: "course.fire", amount: 1}], line: "Gave his name to the fire course"},
                        {id: "frost", label: "Give his name to frost", gives: [{mark: "course.frost", amount: 1}], line: "Gave his name to the frost course"},
                        {id: "storm", label: "Give his name to storm", gives: [{mark: "course.storm", amount: 1}], line: "Gave his name to the storm course"},
                        {id: "basic", label: "Keep to the basics of all three", gives: [{mark: "course.basic", amount: 1}], line: "Kept to the elemental basics"}]},
             {id: "sent_away", day: 0, title: "Sent away",
              text: "The masters have looked for his name on the lists of their lecture halls, and found it too seldom. He is not to sit before them.",
              options: [{id: "go", label: "Gather his things", ends: "dropout", line: "Sent away from the Collegium before its examinations"}]}],

     // Its chance meetings: none costs a day but by his choice, and the first answer of each costs
     // no day (the fever's costs him Vitality: going down to the halls with it)
     events: [{id: "notes", trigger: "day", weight: 1, days: [2, 13], once: false, title: "A second-year's notes",
               text: "A second-year has last year's notes, in a hand nobody else can read. The masters, he says, ask the same things every year.",
               options: [{id: "leave", label: "Leave him to them", ap: 0, hp: 0, items: [], effects: [], line: "He left the second-year to his notes"},
                         {id: "copy", label: "Copy them by candlelight", ap: 0, hp: -6, items: [], effects: [], gives: [{mark: "revised", amount: 1}],
                          line: "Copied a second-year's notes by candlelight"}]},
              {id: "fever", trigger: "day", weight: 1, days: [3, 12], once: false, title: "Fever in the dormitory",
               text: "Half the dormitory has it, and this morning so does he. The bell for the first lecture is ringing.",
               options: [{id: "go", label: "Go down all the same", ap: 0, hp: -10, items: [], effects: [], line: "Went down to the halls with the fever on him"},
                         {id: "bed", label: "Keep to his bed", ap: 1, hp: 0, items: [], effects: [], line: "A day in bed with the fever"}]},
              {id: "errand", trigger: "day", weight: 1, days: [2, 13], once: false, title: "A master's errand",
               text: "A master on the stair puts a crate of books in his arms, for the top floor. He is to leave it at the door, and not to knock.",
               options: [{id: "leave", label: "Leave it at the door", ap: 0, hp: 0, items: [], effects: [], line: "Left a crate of books at the top floor's door"},
                         {id: "read", label: "Read a little on the stairs", ap: 0, hp: -2, items: [], effects: [{kind: "stat", stat: "lore", amount: 1}],
                          line: "Read on the stairs what was meant for the top floor"}]}],

     // The theory: his wits, twice his revision, his days of courses, and what his childhood gave
     // him. From the old tome his lore counts three times in place of his wits (more, for whose
     // lore three times over is more than his wits: five lore against wits under fifteen, six
     // against wits under eighteen); the forbidden shelf counts for much, and he is suspected of
     // it; the Church fathers count a little, safely
     tests: [{id: "theory", day: 15, kind: "card", title: "The theory",
              text: "A long table, five masters behind it, and the questions read out one after another from a list nobody else has seen.",
              score: [{stat: "int", times: 1}, {mark: "revised", times: 2}, {mark: "courses", times: 1}, {stat: "letters", at: 3, times: 2},
                      {flag: "tome", times: 2}, {flag: "library_access", times: 2}, {flag: "mara_student", times: 2}, {flag: "forbidden_read", times: 2},
                      {flag: "anselm_trust", times: 2}, {stat: "done.chronicle", at: 1, times: 2}],
              options: [{id: "taught", label: "Answer what was taught", line: "Sat the theory"},
                        {id: "tome", label: "Answer from the old tome", needs: [{stat: "tome", at: 1}], swap: {"from": "int", to: "lore", times: 3},
                         line: "Sat the theory from Father Anselm's tome"},
                        {id: "shelf", label: "Answer from the forbidden shelf", needs: [{stat: "forbidden_read", at: 1}], adds: 6,
                         gives: [{stat: "suspected", amount: 1, said: "by the masters"}], line: "Sat the theory from what the forbidden shelf had taught him"},
                        {id: "fathers", label: "Cite the Church fathers", needs: [{stat: "anselm_trust", at: 1}], adds: 3,
                         line: "Sat the theory on the Church fathers"}],
              behind: "The masters think him behind in his books."},
             {id: "practical", day: 16, kind: "fight", title: "The practical",
              text: "Two dummies stand in the sand of the yard. The masters along the wall have their pens ready, and will call time when they have seen enough.",
              mob: "exam_dummy", count: 2, turns: 10, reaction: 5, practised: 3,
              options: [{id: "face", label: "Face the dummies", line: "Faced the examination dummies"}],
              behind: "The masters think him behind with the workings."}],

     // Either examination below its floor is a fail, whatever the other; above, the two together
     grades: [{id: "fail", floors: {}, total: 0, gives: [], line: "Failed the Collegium's examinations"},
              {id: "pass", floors: {theory: 24, practical: 10}, total: 0,
               gives: [{stat: "collegium", amount: 1}, {stat: "arcana", amount: 1}, {stat: "lore", amount: 1}],
               line: "Passed the Collegium's examinations"},
              {id: "merit", floors: {theory: 24, practical: 10}, total: 45,
               gives: [{stat: "collegium", amount: 1}, {stat: "arcana", amount: 2}, {stat: "lore", amount: 1}],
               line: "Passed the Collegium's examinations with merit"},
              {id: "distinction", floors: {theory: 24, practical: 10}, total: 70,
               gives: [{stat: "collegium", amount: 1}, {stat: "arcana", amount: 2}, {stat: "lore", amount: 1}, {stat: "top_floor", amount: 1}],
               line: "Passed the Collegium's examinations with distinction"}],

     // How he stands, in words, over what he would score today, counting only what he has done:
     // the two examinations together, the theory by its plain answer, the practical by his days
     // on the dummies and one dummy broken while he has a way to harm it. The last three promise
     // a pass, at the floors, the merit and the distinction, and are not said while either
     // examination would fall under its floor, or the curriculum is behind: the masters say which
     standing: [{at: 0, line: "The masters do not know his name."},
                {at: 24, line: "The masters think him behind."},
                {at: 34, line: "The masters expect him to pass.", passes: true},
                {at: 45, line: "The masters think well of him.", passes: true},
                {at: 70, line: "The masters speak of him on the top floor.", passes: true}],

     // Six days of courses, the lectures, the familiar studies and his element together; who is
     // behind their pace hears it from the second day
     gate: {day: 15, courses: ["courses"], least: 6, card: "sent_away", behind: "The masters seldom see him in their lecture halls."},

     // The solver's way (and the tests'): the lectures, the familiar studies, the fire course,
     // the binding hall, a day on the dummies and one in the library: 36 coin in fees
     plan: {tiles: ["lectures", "lectures", "lectures", "familiar", "familiar", "familiar", "fire", "fire", "fire", "fire", "fire",
                    "binding", "hearthbinding", "practice", "library"],
            cards: {course: "fire"},
            tests: {theory: "taught", practical: "face"}}},

    // The outskirts (activitytable.pg's `outskirts`): the last month before he is seven, four days
    // for its one month, played by every life. His lunch first, the six rations he has not got
    // after the harvest; then one of three ways out of the town, each with the flavour of a basic
    // class (the thief's, the mage's, the warrior's): a point of its part and a first move of his
    // for life (expeditiontable.pg's `step`, `read` and `stick` know its flag); the day after, a
    // small thing of that way; and on the last day the ditch, where the slime is fought by hand.
    // It spares him: beaten, it leaves his first page; lost or fled, he goes home without it, and
    // the story ends all the same. A way is no class: no door reads it
    {id: "outskirts", name: "The Outskirts", glyph: "adventure", unit: "day", days: 4, months: 1, row: "outskirts", "class": "", dropout: "",
     marks: [],
     stages: [{"from": 1, to: 1, title: "Noon at the mill", text: "The harvest is in, and for a month nobody has work for him. The miller's wife has his bread wrapped and ready."},
              {"from": 2, to: 2, title: "The edge of the town", text: "Past the last houses the lanes give out: the green, the commons, the hedges, and the long ditch by the North Road."},
              {"from": 3, to: 3, title: "Further out", text: "He knows his way now, and goes a little further than he did yesterday."},
              {"from": 4, to: 4, title: "The ditch", text: "The ditch along the North Road holds water, nettles, and today something else."}],
     tiles: [{id: "lunch", name: "Take your lunch", about: "Bread and cheese in a cloth, and more of it put by at home for the month.", days: [1, 1], cost: 1,
              gives: [{stat: "rations", amount: 6}], line: "Took his lunch from the mill"},

             // The three ways out of the town: one, and the others are gone
             {id: "children", name: "Speak to the children of your age", about: "The boys and girls of the lanes, who run everywhere and are never caught. They teach him to get out of the way.", days: [2, 2], cost: 1,
              "not": ["tile.nature", "tile.animals"], gives: [{stat: "dex", amount: 1}, {stat: "outskirts.children", amount: 1, said: "learned"}],
              line: "Ran with the children of the lanes"},
             {id: "nature", name: "Study nature", about: "What lives under the hedges and in the long grass, and what it does next. He learns to watch before he moves.", days: [2, 2], cost: 1,
              "not": ["tile.children", "tile.animals"], gives: [{stat: "int", amount: 1}, {stat: "outskirts.nature", amount: 1, said: "learned"}],
              line: "Watched what lives under the hedges"},
             {id: "animals", name: "Look for wild animals", about: "Foxes, hares, the stray dogs of the commons. He picks up a stick, in case.", days: [2, 2], cost: 1,
              "not": ["tile.children", "tile.nature"], gives: [{stat: "str", amount: 1}, {stat: "outskirts.animals", amount: 1, said: "learned"}],
              line: "Went looking for wild animals, a stick in his hand"},

             // Each way's fork, the day after: two small things of that way, for who took it
             {id: "chase", name: "Play at chase on the green", about: "Round the well, through the washing, over the churchyard wall. Nobody catches him twice.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.children"], "not": ["tile.tales"], gives: [{stat: "dex", amount: 1}], line: "Played at chase on the green"},
             {id: "tales", name: "Listen to the older boys' tales", about: "Harrow, the Old Grey, the door under the mill. Half of it is lies, and he remembers all of it.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.children"], "not": ["tile.chase"], gives: [{stat: "lore", amount: 1}], line: "Listened to the older boys' tales"},
             {id: "beetles", name: "Watch the beetles under the stones", about: "Lift a stone, and they run. Lift it slowly, and they do not.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.nature"], "not": ["tile.wortleaf"], gives: [{stat: "int", amount: 1}], line: "Watched the beetles under the stones"},
             {id: "wortleaf", name: "Pick wortleaf by the ditch", about: "A herbwife on the road shows him the grey leaf, and how it is crushed. Two remedies, for a scraped knee or worse.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.nature"], "not": ["tile.beetles"], gives: [{item: "remedy", amount: 2}], line: "Picked wortleaf by the ditch"},
             {id: "tracks", name: "Follow the tracks to the stream", about: "Prints in the mud, and further on, more of them. The stream is further than he thought.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.animals"], "not": ["tile.crows"], gives: [{stat: "str", amount: 1}], line: "Followed the tracks to the stream"},
             {id: "crows", name: "Throw stones at the crows", about: "They sit on the gate and laugh at him, until one stone does not miss.", days: [3, 3], cost: 1,
              onlyWith: ["outskirts.animals"], "not": ["tile.tracks"], gives: [{stat: "dex", amount: 1}], line: "Threw stones at the crows"}],

     // The last day's: the slime, fought by hand (expeditiontable.pg's `slime`)
     cards: [{id: "ditch", day: 4, title: "Something in the ditch",
              text: "Something grey shivers in the water of the ditch, and creeps up the bank toward him. It has no face, and it has noticed him.",
              options: [{id: "go", label: "Stand his ground", gives: [{fight: "slime"}], line: "Stood his ground against the thing in the ditch"}]}],
     events: [],
     tests: [],
     grades: [],
     standing: [{at: 0, line: "Nobody will look for him before supper."}],

     // The solver's way (and the tests'): the warrior's, the wild animals and their tracks
     plan: {tiles: ["lunch", "animals", "tracks"], cards: {ditch: "go"}, tests: {}}},

    // The tests' story (test/chronicle/story.cc): no row of the game opens it (its row,
    // `story.trial`, is hidden, for the tests only). Four days for four months: a lecture for a
    // coin, the library for nothing, an advanced course from the third day for who was taught
    // twice, an early tile of the first two days only, a tile taken once, the practice dummy
    // for who knows a working (fought on its own), and a book copied in two days. Then its
    // scenes, a rumour, the examination of the fourth day and its grades; who fails it or is
    // sent away is a drop-out of it.
    {id: "trial", name: "The trial", glyph: "study", unit: "day", days: 4, months: 4, row: "story.trial", "class": "", dropout: "dropout.trial",
     marks: [{id: "taught", name: "Lectures heard"}, {id: "revised", name: "Days in the library"}, {id: "deep", name: "The advanced course"},
            {id: "practised", name: "Days on the dummy"}],
     stages: [{"from": 1, to: 2, title: "The first days", text: "Everything is new, and every door is open to him."},
              {"from": 3, to: 4, title: "The last days", text: "What he has heard lets him follow more."}],
     tiles: [{id: "lecture", name: "Hear a lecture", about: "A master reads, the students write it down.", days: [1, 4], cost: 1,
              fee: [{stat: "coin", amount: 1}], gives: [{mark: "taught", amount: 1}], line: "Heard a lecture"},
             {id: "library", name: "Read in the library", about: "The books are free to who sits with them.", days: [1, 4], cost: 1,
              gives: [{mark: "revised", amount: 1}], line: "Read in the library"},
             {id: "advanced", name: "Follow the advanced course", about: "For who has heard the lectures.", days: [3, 4], cost: 1,
              needs: [{mark: "taught", at: 2, asks: "ASKS THE LECTURES HEARD"}], fee: [{stat: "coin", amount: 1}],
              gives: [{mark: "deep", amount: 1}], line: "Followed the advanced course"},
             {id: "early", name: "Walk the halls", about: "The first days only, while all is new.", days: [1, 2], cost: 1,
              line: "Walked the halls"},
             {id: "once", name: "Meet the dean", about: "He sees each of them once.", days: [1, 4], cost: 1, most: 1,
              gives: [{stat: "renown", amount: 1}], line: "Met the dean"},
             {id: "practice", name: "Practise on the dummy", about: "A working tried on straw and sacking, in the yard.", days: [1, 4], cost: 1,
              needs: [{stat: "forbidden_read", at: 1, asks: "ASKS A WORKING HE KNOWS"}],
              gives: [{fight: "dummy", auto: true, wins: [{mark: "practised", amount: 1}]}], line: "Practised on the dummy"},
             {id: "copy", name: "Copy a book", about: "Two days at a desk, and the copy is his.", days: [1, 3], cost: 2,
              line: "Copied a book"}],
     // The third day's question, four answers that each set a mark; a master who notices him once
     // he has read two days; and the masters sending him away, the gate's card
     cards: [{id: "crossroads", day: 3, title: "The masters' question",
              text: "A master stops him at the door of the hall. Which of the four arts, he asks, will he give his last days to?",
              options: [{id: "a", label: "The art of numbers", gives: [{mark: "a", amount: 1}], line: "He chose the art of numbers"},
                        {id: "b", label: "The art of letters", gives: [{mark: "b", amount: 1}], line: "He chose the art of letters"},
                        {id: "c", label: "The art of the stars", gives: [{mark: "c", amount: 1}], line: "He chose the art of the stars"},
                        {id: "d", label: "The art of healing", gives: [{mark: "d", amount: 1}], line: "He chose the art of healing"}]},
             {id: "noticed", day: 0, when: [{mark: "revised", at: 2}], title: "A master in the library",
              text: "An old master has seen him at the same table two days running. He nods, and says nothing.",
              options: [{id: "bow", label: "Bow, and read on", line: "A master noticed him in the library"}]},
             {id: "sent_away", day: 0, title: "Sent away",
              text: "The masters have looked for him in the halls and not found him there. He has not heard enough to sit before them.",
              options: [{id: "go", label: "Gather his things", ends: "dropout", line: "Sent away before the tests"}]}],
     events: [{id: "rumour", trigger: "day", weight: 1, days: [1, 4], once: false, title: "A rumour in the halls",
               text: "Two students whisper that the masters ask the same questions every year.",
               options: [{id: "listen", label: "Listen", ap: 0, hp: 0, items: [], effects: [], line: "He listened to the rumour"},
                         {id: "pass", label: "Walk on", ap: 0, hp: 0, items: [], effects: [], line: "He left them to their whispers"}]}],
     // The examination on the last day: what he knows and twice the days he read. From the old
     // tome, what the tome taught counts in place of his wits
     tests: [{id: "exam", day: 4, kind: "card", title: "The examination",
              text: "The masters sit in a row behind a long table, and ask.",
              score: [{stat: "int", times: 1}, {mark: "revised", times: 2}],
              options: [{id: "plain", label: "Answer what was taught", line: "Sat the examination"},
                        {id: "tome", label: "Answer from the old tome", needs: [{stat: "tome", at: 1}], swap: {"from": "int", to: "lore"},
                         line: "Sat the examination from the old tome"}]}],
     grades: [{id: "fail", floors: {}, total: 0, gives: [], line: "Failed the trial's examination"},
              {id: "pass", floors: {exam: 14}, total: 14, gives: [{stat: "trialled", amount: 1}], line: "Passed the trial's examination"},
              {id: "merit", floors: {exam: 14}, total: 18, gives: [{stat: "trialled", amount: 1}, {stat: "lore", amount: 1}],
               line: "Passed the trial's examination with merit"}],
     // How he stands, in words, over what he would score if he sat today (never said in figures)
     standing: [{at: 0, line: "The masters would find little in him yet."},
                {at: 13, line: "He would hold his own before the masters."},
                {at: 15, line: "The masters would look on him kindly."},
                {at: 18, line: "He is among the best of his year."}],
     // Who has heard no lecture is sent away before the examination
     gate: {day: 4, courses: ["taught"], least: 1, card: "sent_away"},
     plan: {}},

    // The tests' fight story (story.cc): no row opens it. Three days: the fire working taught,
    // a day idled, a bout with a wolf (fought by hand, and he may lose it), a boast that brings a
    // challenge (a card whose answer is a fight), then the practical of the second day, two
    // examination dummies fought by hand; no grade
    {id: "drill", name: "The drill yard", glyph: "swordsmanship", unit: "day", days: 3, months: 3, row: "", "class": "", dropout: "",
     marks: [{id: "practised", name: "Days on the dummy"}, {id: "braved", name: "Bouts fought"}, {id: "boasted", name: "Boasts made"}],
     stages: [{"from": 1, to: 3, title: "The yard", text: "Posts, straw and sand, and the masters along the wall."}],
     tiles: [{id: "fire", name: "Learn the fire working", about: "A master shows him how the fire is thrown.", days: [1, 1], cost: 1,
              gives: [{stat: "fire_course", amount: 1, said: "learned"}], line: "Learned the fire working"},
             {id: "idle", name: "Watch the others", about: "Nothing asked of him today.", days: [1, 3], cost: 1, line: "Watched the others"},
             {id: "bout", name: "Spar with the wolf", about: "The keeper's wolf, on a long chain.", days: [1, 1], cost: 1,
              gives: [{mark: "braved", amount: 1}, {stat: "renown", amount: 1}, {fight: "wolf"}], line: "Sparred with the wolf"},
             {id: "boast", name: "Boast in the yard", about: "Someone will want to see it.", days: [1, 1], cost: 1,
              gives: [{mark: "boasted", amount: 1}], line: "Boasted in the yard"}],
     cards: [{id: "challenge", day: 0, when: [{mark: "boasted", at: 1}], title: "A challenge",
              text: "An older student points at the practice dummy, and waits.",
              options: [{id: "accept", label: "Show him", gives: [{fight: "dummy"}], line: "Took the challenge"}]}],
     events: [],
     tests: [{id: "practical", day: 2, kind: "fight", title: "The practical",
              text: "Two dummies stand in the sand. The masters along the wall have their pens ready.",
              mob: "exam_dummy", count: 2, turns: 10, reaction: 5, practised: 2,
              options: [{id: "face", label: "Face the dummies", line: "Faced the examination dummies"}]}],
     standing: [{at: 0, line: "The masters watch him, and say nothing."}],
     grades: [],
     plan: {}}
]
