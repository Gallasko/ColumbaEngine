// Chronicle rules: the milestones of a life
// -----------------------------------------
// Imported by forecast.pg, and loaded by the game through milestones.pg.
// Input:  `age` (years, a number), `world` (months since the world's Year 0: its calendar, which
//         runs on from life to life and which no death rewinds).
// Output: `milestones`, every milestone {age, id, label, passed, entry, asks}, where `asks` lists
//         what each path asks at it: [{path, stat, label, needed}] (the doors of
//         activitytable.pg it opens onto), and `entry` is "" or the line the log writes when he
//         reaches it. The last one is lib.pg's `lastAge`: his prime ends there and old age
//         begins (resources.pg's `aging`), the life goes on;
//         `next`, the first milestone after `age`: {id, label, age, in} with `in` the whole
//         months to it; past the last one: {id: "", label: "", age: -1, in: -1};
//         `headline`, the page's head at `age`: {ageText ("17.5"), subtitle ("THE SEVENTEENTH
//         YEAR · SPRING · BELLMOOR"), ageNote ("years · 6 mo to the eighteenth", or "years"
//         past the last milestone), ageUnit (what follows his whole years: "YEARS 10 MONTHS OLD",
//         "YEARS 1 MONTH OLD", "YEARS OLD" on his birthday), date ("YEAR 10", the world's), dateNote ("MONTH 7 · SUMMER ·
//         BELLMOOR": the month of that year, 1 to 12, and its season)}.

import "string"
import "math"
import "algorithm"
import "lib"

var errors = []

var milestoneTable = [
    {age: 7, id: "childhood", label: "Childhood", entry: "", asks: []},
    {age: 13, id: "apprenticeship", label: "Apprenticeship", entry: "", asks: []},
    {age: 16, id: "path", label: "Choose a path", entry: "", asks: [
        {path: "warrior", stat: "str", label: "Strength", needed: 12},
        {path: "warrior", stat: "arms", label: "Arms", needed: 3},
        {path: "warrior", stat: "discipline", label: "Discipline", needed: 2},
        {path: "mage", stat: "int", label: "Intelligence", needed: 12},
        {path: "mage", stat: "letters", label: "Letters", needed: 3},
        {path: "mage", stat: "lore", label: "Lore", needed: 2},
        {path: "thief", stat: "dex", label: "Dexterity", needed: 12},
        {path: "thief", stat: "stealth", label: "Stealth", needed: 2},
        {path: "thief", stat: "guile", label: "Guile", needed: 2}
    ]},
    {age: 21, id: "proving", label: "The proving", entry: "", asks: [
        {path: "warrior", stat: "arms", label: "Arms", needed: 6},
        {path: "warrior", stat: "discipline", label: "Discipline", needed: 4},
        {path: "warrior", stat: "renown", label: "Renown", needed: 3},
        {path: "mage", stat: "lore", label: "Lore", needed: 6},
        {path: "mage", stat: "arcana", label: "Arcana", needed: 3},
        {path: "thief", stat: "stealth", label: "Stealth", needed: 6},
        {path: "thief", stat: "guile", label: "Guile", needed: 5},
        {path: "thief", stat: "favors", label: "Favors", needed: 3}
    ]},
    {age: 26, id: "mastery", label: "Mastery", entry: "", asks: [
        {path: "warrior", stat: "arms", label: "Arms", needed: 8},
        {path: "warrior", stat: "discipline", label: "Discipline", needed: 6},
        {path: "warrior", stat: "renown", label: "Renown", needed: 7},
        {path: "mage", stat: "arcana", label: "Arcana", needed: 6},
        {path: "mage", stat: "lore", label: "Lore", needed: 7},
        {path: "mage", stat: "discipline", label: "Discipline", needed: 4},
        {path: "thief", stat: "stealth", label: "Stealth", needed: 8},
        {path: "thief", stat: "guile", label: "Guile", needed: 7}
    ]},
    {age: lastAge, id: "old", label: "Old age", entry: "His thirtieth year: old age begins, and his strength leaves him", asks: []}
]

// Counted in whole months, so an age that is a sum of twelfths reaches its milestone on time
var lived = monthOf(age)
var milestones = []
var next = {id: "", label: "", age: -1, in: -1}

for (var i = 0; i < len(milestoneTable); i++)
{
    var m = milestoneTable[i]

    push(milestones, {age: m.age, id: m.id, label: m.label, passed: m.age * 12 <= lived, entry: m.entry, asks: m.asks})

    if (m.age * 12 > lived and next.age < 0)
    {
        next = {id: m.id, label: m.label, age: m.age, in: m.age * 12 - lived}
    }
}

var place = "BELLMOOR"
var year = toInt(floor(lived / 12))
var monthOfYear = lived % 12

var headline = {
    ageText: ageText(age),
    subtitle: "THE " + toUpperCase(ordinalWord(year)) + " YEAR · " + seasonOf(monthOfYear) + " · " + place,
    ageNote: "years"
}

if (next.age > 0)
{
    headline.ageNote = "years · " + toString(next.in) + " mo to the " + ordinalWord(next.age)
}

// His age past the whole years: the months of the year he is in
headline.ageUnit = "YEARS OLD"

if (monthOfYear == 1)
{
    headline.ageUnit = "YEARS 1 MONTH OLD"
}

if (monthOfYear > 1)
{
    headline.ageUnit = "YEARS " + toString(monthOfYear) + " MONTHS OLD"
}

// The world's date: its year from 0, the month of that year from 1, and the month's season
var worldYear = toInt(floor(world / 12))
var worldMonth = world % 12

headline.date = "YEAR " + toString(worldYear)
headline.dateNote = "MONTH " + toString(worldMonth + 1) + " · " + seasonOf(worldMonth) + " · " + place
