// Chronicle rules: the town's places and their levels
// ----------------------------------------------------
// Imported by town.pg (what the Town page shows), by activitytable.pg (the works that raise a
// place are made from this table, so the two never disagree) and by resources.pg (what a level
// adds to a familiar's month). Never loaded itself.
// Input:  none.
// Output: `townPlaces`, one table per place of Bellmoor a life can raise:
//           {id, name, glyph, about, shows, levels [level]}
//         in the order the Town page shows them.
//         `shows` is optional: what brings the place onto the page. Without it, the place is
//         there from the day the town is known. {flag: "x"}: once he holds that flag (what a
//         work of his class gives: "veteran", "captain", "collegium"). {done: "id"}: once he has
//         done a term of that activity. {lives: N}: from the Nth life of the world. {fromAge: N}:
//         once he is that old. {stash: true}: once the stash holds anything (a "stash.<id>" of
//         `character` above none; the stash is no stat of his, so it is weighed from those keys
//         and never asked as a flag). Several: all of them.
//         A place a life has seen stays seen: the Life screen keeps it with the town, and hands
//         it back in `character` as "seen.<id>". So does a place that was raised, or left coin.
//         A first look at the town is two places, the Market and the Mill: enough to learn what
//         a place is. The others are found by living (lib.pg's `placeShown` weighs it, for the
//         page and for the works): the day one comes, its first work comes with it, under the
//         places, and that work is how it is built.
//         A place has a level, 0 (not built) to the number of its `levels`. It is the world's,
//         not the life's: the Life screen hands it to every script in `character` as the stat
//         "town.<id>", with "town_known" (1 once a life has explored the town) and "fund.<id>"
//         (the coin lives have left to the place at their death, counted toward its next level).
//         An `amount` left out is 1 (lib.pg's `amountsOf`, applied at the end of this file).
//         A level is what a life gives the town, and what the town gives back:
//           work    the name of the work that raises the place to this level
//           built   what stands there once it is done, as the log names it
//           months  the months the work takes: time he does not spend on himself
//           coin    the coin it costs when it begins, less the place's fund: a small part of the
//                   price, never below none (a fund larger than it asks no coin, and the rest of
//                   the fund pays for nothing else)
//           costs   [{stat, amount}]: what else it takes from him when it begins, for good, less
//                   what lives before him left the place of it ("fund.<id>.<stat>"). A level is
//                   paid mainly in resources: the first in basics (economytable.pg's
//                   `basicResources`), about 20 of the two its place leans on; the second about
//                   40 of them and 2 gems; the third about 80, 4 gems and one thing found on a
//                   walk (expeditiontable.pg's `walkItems`). None asks more than one life can
//                   hold: 80 stone is its limit with every store raised, and clay, which no store
//                   raises, is never asked past 20. A stat of his may be asked too (Strength,
//                   Renown...), and the lodge still asks what his walks bring for the town
//                   (firewood, ash wood, clay, stone)
//           years   optional: years of his life given at once when it begins, on top of its months
//           cheaper optional {flag, coin}: the coin it costs a life that holds the flag, in
//                   place of `coin` (lib.pg's `levelCoin`: who saved the mill mends its wheel
//                   for nothing)
//           gives   what this level gives, in one line, as its gloss says it (and its tile, without
//                   a `note`)
//           note    optional: the same, short enough for the tile's three lines (148 px, in caps):
//                   what the tile says in place of `gives`
//           start   optional [{stat, amount}]: what a new life is born with for it (town.pg's
//                   `start`), every later life and never the first of a world
//           slots   optional N: N more familiar slots for every life, from his first day, while
//                   the level stands (lib.pg's `slotsOf`)
//           teaches optional "<kind id>": that kind of familiar (economytable.pg's
//                   `familiarKinds`) is his to bind while the level stands, as if the world had
//                   learned it (lib.pg's `kindKnown`); its study is no longer offered
//           stash   optional N: the stash keeps N more of each thing between lives (lib.pg's
//                   `stashMost`, which town.pg's `stash` says)
//           more    optional [{stat, amount}]: each familiar that makes that stat makes `amount`
//                   more of it a month, as a lesson he taught it would (lib.pg's `feedFamiliars`)
//           lore    the line the log writes when the level is reached
//           later, laterNote  the Inn's first level alone: its `gives` and `note` to a man whose
//                   old age began at thirty without it (lib.pg's `primeGoneBy`): what it moves is
//                   the old age of the lives after his
//         The rule for what a level gives: it saves the next life time, and never gives a class
//         for free. How each gift reaches the rules is said where it does: a `bonus` step or an
//         `eased` requirement of activitytable.pg, a holding of resources.pg, or `start`,
//         `slots`, `teaches`, `stash` and `more` here: what a level gives the economy (lib.pg's
//         `levelsReached` lists the levels that stand, and its functions read these fields off
//         them). `gives` says each of them in words, by hand.
//
// The numbers and the words are placeholders for the game's balance and writing: change them
// here, nothing in C++ moves.
//
// The tables are `const`: a rule script's VM makes them on its first run and keeps them for the
// next ones. Nothing writes into them: a row that is written into per run is a copy (activitytable.pg's
// walk rows take their requirements through `entriesCopied`).

import "string"
import "math"
import "algorithm"
import "lib"

const townPlaces = [
    // From the day the town is known: the two places a child of Bellmoor has grown up around
    {id: "market", name: "The Market", glyph: "trade", about: "Where coin becomes bread. What is bought on the spot is bought here.",
     levels: [
        {work: "Endow the Market Stall", built: "The market stall", months: 6, coin: 5, costs: [{stat: "berries", amount: 20}, {stat: "firewood", amount: 20}],
         gives: "Buy rations brings 8 rations, not 6",
         lore: "A stall of his own name stands on the square. It weighs fair."},
        {work: "Build the Market Hall", built: "The market hall", months: 9, coin: 15, costs: [{stat: "berries", amount: 40}, {stat: "firewood", amount: 40}, {stat: "gems", amount: 2}, {stat: "guile"}],
         gives: "The hall sends 1 ration every 3 months, and every sprite brings 1 more berry", note: "1 ration every 3 months, +1 berry a sprite", more: [{stat: "berries", amount: 1}],
         lore: "The hall keeps a share for the family that built it."},
        {work: "Grant the Market Charter", built: "The market charter", months: 12, coin: 35, costs: [{stat: "berries", amount: 80}, {stat: "firewood", amount: 80}, {stat: "gems", amount: 4}, {stat: "pelts"}],
         gives: "A sword and a horse are sold at the market",
         lore: "With a charter, the far merchants come: steel and horses with them."}
     ]},
    {id: "mill", name: "The Mill", glyph: "work", about: "Where he was born. The town's bread starts here.",
     levels: [
        {work: "Mend the Mill Wheel", built: "The mended wheel", months: 6, coin: 5, costs: [{stat: "stone", amount: 20}, {stat: "water", amount: 20}], cheaper: {flag: "mill_saved", coin: 0},
         gives: "Help at the Mill pays 4 more coin",
         lore: "The wheel turns true again. The miller's boys are paid in more than flour."},
        {work: "Raise the Mill Loft", built: "The mill loft", months: 9, coin: 10, costs: [{stat: "stone", amount: 40}, {stat: "water", amount: 40}, {stat: "gems", amount: 2}],
         gives: "Every life has a slot for one more familiar", slots: 1,
         lore: "The loft keeps a dry corner for every child of the mill, and for whatever he has bound."},
        {work: "Set the Great Millstones", built: "The great millstones", months: 12, coin: 30, costs: [{stat: "stone", amount: 80}, {stat: "water", amount: 80}, {stat: "gems", amount: 4}, {stat: "pike_jaw"}, {stat: "str"}],
         gives: "A new life starts with 1 more Strength", start: [{stat: "str"}],
         lore: "He gave his back to the great stones. The boys who turn them grow strong."}
     ]},

    // With his own hands: the forge, once he has worked a term at it
    {id: "smithy", name: "The Smithy", glyph: "forge", shows: {done: "smithy"}, about: "The forge by the river, loud from dawn.",
     levels: [
        {work: "Add a Second Bellows", built: "The second bellows", months: 6, coin: 5, costs: [{stat: "firewood", amount: 20}, {stat: "stone", amount: 20}],
         gives: "Work the Smithy opens at age 8, not 9, a stone mole can be bound, and the smithy forges an iron blade and a leather jerkin", note: "The smithy at 8, the mole, and gear forged", teaches: "mole",
         lore: "A small boy can work the second bellows."},
        {work: "Forge the Practice Blades", built: "The practice blades", months: 9, coin: 15, costs: [{stat: "firewood", amount: 40}, {stat: "stone", amount: 40}, {stat: "gems", amount: 2}],
         gives: "A new life starts with Arms 1, and the smithy forges a warded charm", note: "Arms 1 at birth, and a warded charm", start: [{stat: "arms"}],
         lore: "Children of the town play with blunt steel before they can read."},
        {work: "Build the Great Forge", built: "The great forge", months: 12, coin: 40, costs: [{stat: "firewood", amount: 80}, {stat: "stone", amount: 80}, {stat: "gems", amount: 4}, {stat: "shell_plate"}],
         gives: "Work the Smithy pays 6 more coin",
         lore: "The great forge takes orders from the Keep itself."}
     ]},

    // With the Keep: the yard to a veteran of the border, the gate to its captain
    {id: "yard", name: "The Yard", glyph: "training", shows: {flag: "veteran"}, about: "The training yard under the Keep's wall.",
     levels: [
        {work: "Stock the Yard with Blades", built: "The yard's racks", months: 6, coin: 5, costs: [{stat: "firewood", amount: 20}, {stat: "clay", amount: 20}],
         gives: "The yard lends a wooden blade: no boy has to buy one", note: "The yard lends a wooden blade",
         lore: "No boy waits for a wooden blade any more."},
        {work: "Lay the Yard's Sand", built: "The sanded yard", months: 9, coin: 15, costs: [{stat: "firewood", amount: 40}, {stat: "clay", amount: 20}, {stat: "gems", amount: 2}, {stat: "str"}],
         gives: "The Keep asks Strength 11, not 12",
         lore: "The sergeants say a boy of the sanded yard is worth one more year."},
        {work: "House the Sergeant", built: "The sergeant's house", months: 12, coin: 35, costs: [{stat: "firewood", amount: 80}, {stat: "clay", amount: 20}, {stat: "gems", amount: 4}, {stat: "hides"}],
         gives: "Sergeant Edric trains boys from age 12",
         lore: "Edric lives by the yard now, and starts them younger."}
     ]},
    {id: "gate", name: "The Watch Gate", glyph: "gate", shows: {flag: "captain"}, about: "The north gate, where the Watch stands.",
     levels: [
        {work: "Mend the Gatehouse Roof", built: "The gatehouse roof", months: 6, coin: 5, costs: [{stat: "stone", amount: 20}, {stat: "firewood", amount: 20}],
         gives: "A new life starts known to the Watch", start: [{stat: "watch_known"}],
         lore: "The Watch does not forget who kept the rain off them."},
        {work: "Build the Road Posts", built: "The road posts", months: 9, coin: 15, costs: [{stat: "stone", amount: 40}, {stat: "firewood", amount: 40}, {stat: "gems", amount: 2}],
         gives: "Patrol the North Road gives its rations up front", note: "North Road patrols: rations up front",
         lore: "There is a fire and a pot at every post on the North Road."},
        {work: "Raise the Gate Tower", built: "The gate tower", months: 12, coin: 35, costs: [{stat: "stone", amount: 80}, {stat: "firewood", amount: 80}, {stat: "gems", amount: 4}, {stat: "fangs"}, {stat: "renown"}],
         gives: "The Captain's Chain asks Renown 6, not 7",
         lore: "The tower bears the town's name, not his. The Keep remembers anyway."}
     ]},

    // With the Collegium: the chapel the day he is taken in, its gate once he has served Magister
    // Orin, the road once he has been to Harrow
    {id: "chapel", name: "The Chapel", glyph: "study", shows: {flag: "collegium"}, about: "Father Anselm's chapel, and the only school in Bellmoor.",
     levels: [
        {work: "Glaze the Chapel Windows", built: "The chapel windows", months: 6, coin: 5, costs: [{stat: "water", amount: 20}, {stat: "clay", amount: 20}], cheaper: {flag: "plague_stayed", coin: 0},
         gives: "Learn Your Letters takes 4 months, not 6",
         lore: "There is light to read by now, even in winter."},
        {work: "Give the Chapel a Primer", built: "The chapel primer", months: 9, coin: 10, costs: [{stat: "water", amount: 40}, {stat: "clay", amount: 20}, {stat: "gems", amount: 2}, {stat: "letters"}],
         gives: "A new life starts with Letters 1, and a well imp can be bound", note: "Letters 1 at birth, and the well imp", start: [{stat: "letters"}], teaches: "imp",
         lore: "He copied out the primer himself. Children learn their letters from his hand."},
        {work: "Found the Almshouse", built: "The almshouse", months: 0, coin: 15, costs: [{stat: "water", amount: 80}, {stat: "clay", amount: 20}, {stat: "gems", amount: 4}, {stat: "antler"}], years: 2,
         gives: "Teach the Young pays 4 more coin",
         lore: "Two years of his life went into its walls. The old teach there, and are kept."}
     ]},
    {id: "collegium", name: "The Collegium Gate", glyph: "academy", shows: {flag: "orin_known"}, about: "The gate of the scholars, shut to most of the town.",
     levels: [
        {work: "Open a Reagent Counter", built: "The reagent counter", months: 6, coin: 5, costs: [{stat: "water", amount: 20}, {stat: "berries", amount: 20}],
         gives: "Buy reagents is sold to every class",
         lore: "The scholars sell at the gate what they used to keep inside."},
        {work: "Endow a Reading Desk", built: "The reading desk", months: 9, coin: 20, costs: [{stat: "water", amount: 40}, {stat: "berries", amount: 40}, {stat: "gems", amount: 2}, {stat: "int"}],
         gives: "Every life has a slot for one more familiar", slots: 1,
         lore: "One desk at the gate is free to the town's children. The book chained to it tells how to keep two creatures where one was kept."},
        {work: "Fund a Town Scholarship", built: "The town scholarship", months: 12, coin: 45, costs: [{stat: "water", amount: 80}, {stat: "berries", amount: 80}, {stat: "gems", amount: 4}, {stat: "wisp_glass"}],
         gives: "The Collegium asks Intelligence 11, not 12",
         lore: "One child of Bellmoor is taken each year on promise alone."}
     ]},
    {id: "harrow", name: "The Harrow Road", glyph: "relic", shows: {flag: "harrow_truth"}, about: "The old road east, to what is left of Harrow.",
     levels: [
        {work: "Clear the Harrow Road", built: "The cleared road", months: 9, coin: 10, costs: [{stat: "stone", amount: 20}, {stat: "clay", amount: 20}], cheaper: {flag: "woodfolk_guest", coin: 5},
         gives: "The works of Harrow show what they ask from the start", note: "Harrow's works show what they ask",
         lore: "The road is open as far as the first ruins."},
        {work: "Build the Waystation", built: "The waystation", months: 12, coin: 25, costs: [{stat: "stone", amount: 40}, {stat: "clay", amount: 20}, {stat: "gems", amount: 2}],
         gives: "Expedition to Harrow takes 12 months, not 18",
         lore: "Half the way is under a roof now."},
        {work: "Raise the Harrow Shrine", built: "The Harrow shrine", months: 18, coin: 50, costs: [{stat: "stone", amount: 80}, {stat: "clay", amount: 20}, {stat: "gems", amount: 4}, {stat: "bog_iron"}, {stat: "vit", amount: 10}, {stat: "vitmax", amount: 10}],
         gives: "A new life starts holding the Harrow relic", start: [{stat: "harrow_relic"}],
         lore: "The shrine cost him his health. What it holds is passed down."}
     ]},

    // With the lives: the inn, where the tale of the one before is told, from the second of a world
    {id: "inn", name: "The Inn", glyph: "town", shows: {lives: 2}, about: "The Bell and Barrel, where every tale ends up.",
     levels: [
        {work: "Carve the Storyteller's Chair", built: "The storyteller's chair", months: 6, coin: 5, costs: [{stat: "firewood", amount: 20}, {stat: "berries", amount: 20}],
         gives: "Old age begins at 50, not 30; Tell Tales at the Inn opens at age 26, and the stash keeps 50 more of each thing", note: "Old at 50, tales at 26, stash +50", stash: 50,
         later: "Old age begins at 50, not 30, for the lives after his: his own has begun. Tell Tales at the Inn opens at age 26, and the stash keeps 50 more of each thing",
         laterNote: "Old at 50 for the lives after his, stash +50",
         lore: "The chair by the fire is for whoever has a tale, young or old."},
        {work: "Hang the Book of Names", built: "The book of names", months: 9, coin: 10, costs: [{stat: "firewood", amount: 40}, {stat: "berries", amount: 40}, {stat: "gems", amount: 2}],
         gives: "A new life is told how the last one ended",
         lore: "The inn keeps a book. Every life of the family has a line in it."},
        {work: "Keep a Room at the Inn", built: "The family's room", months: 12, coin: 20, costs: [{stat: "firewood", amount: 80}, {stat: "berries", amount: 80}, {stat: "gems", amount: 4}, {stat: "grey_pelt"}],
         gives: "Vitality mends every month, not every second month", note: "Vitality mends every month",
         lore: "A bed, a fire and a door that locks: he mends faster there."}
     ]},

    // With the stash: the storehouse, once a life before him has left it anything (from the second
    // life of a world, in practice). What is drawn from the stash is drawn there (activitytable.pg's
    // draw rows), and each of its levels makes the stash keep more of each thing
    {id: "storehouse", name: "The Storehouse", glyph: "work", shows: {stash: true}, about: "Where the family keeps what one life leaves the next.",
     levels: [
        {work: "Raise the Storehouse", built: "The storehouse", months: 6, coin: 5, costs: [{stat: "stone", amount: 20}, {stat: "clay", amount: 20}],
         gives: "The stash keeps 100 more of each thing", stash: 100,
         lore: "Four walls and a roof over what the family keeps. None of it is left to the rain now."},
        {work: "Dig the Storehouse Cellar", built: "The storehouse cellar", months: 9, coin: 10, costs: [{stat: "stone", amount: 40}, {stat: "firewood", amount: 40}, {stat: "clay", amount: 20}, {stat: "gems", amount: 2}],
         gives: "The stash keeps 200 more of each thing", stash: 200,
         lore: "A cellar under the storehouse, cool and dry. The family's stores go down twice as deep."},
        {work: "Bind the Storehouse Doors in Iron", built: "The iron doors", months: 12, coin: 20, costs: [{stat: "stone", amount: 80}, {stat: "firewood", amount: 80}, {stat: "clay", amount: 20}, {stat: "gems", amount: 4}, {stat: "bog_iron"}],
         gives: "The stash keeps 400 more of each thing", stash: 400,
         lore: "Iron on the doors, and a lock the smith made for no other. What is kept there is kept."}
     ]},

    // With his walks: the lodge, once he has walked the Hollow Woods. It is built of what walks
    // bring back for the town (expeditiontable.pg's `town` things): he holds them like anything
    // else, and what its next level still asks can be left to it at his death
    {id: "lodge", name: "The Hunters' Lodge", glyph: "adventure", shows: {done: "walk.hollow"}, about: "A roof at the wood's edge, for whoever goes after the wolves.",
     levels: [
        {work: "Raise the Hunters' Lodge", built: "The hunters' lodge", months: 6, coin: 5, costs: [{stat: "firewood", amount: 20}, {stat: "ashwood", amount: 10}],
         gives: "The Hollow Woods are open to every life, bow or no bow", note: "The Hollow Woods open to every life",
         lore: "A boy with no bow may go north now: the lodge lends him one, and counts the arrows."},
        {work: "Hang the Lodge's Racks", built: "The lodge's racks", months: 6, coin: 10, costs: [{stat: "ashwood", amount: 20}, {stat: "clay", amount: 15}],
         gives: "In a fight a day lasts one turn longer, and every mole digs 1 more stone", note: "Fight days a turn longer, +1 stone a mole", more: [{stat: "stone", amount: 1}],
         lore: "Spears on the racks, dry and straight. A man who is not mending his gear fights longer."},
        {work: "Keep the Lodge's Hounds", built: "The lodge's hounds", months: 9, coin: 20, costs: [{stat: "stone", amount: 30}, {stat: "ashwood", amount: 20}],
         gives: "Every beast is found a day sooner",
         lore: "The hounds know the Hollow Woods better than any man of Bellmoor. They are not modest about it."}
     ]}
]

// An amount left out is 1: of what a level takes, of what it starts a new life with, and of what
// it adds to a familiar's yield
for (var t = 0; t < len(townPlaces); t++)
{
    for (var l = 0; l < len(townPlaces[t].levels); l++)
    {
        amountsOf(townPlaces[t].levels[l], "costs")
        amountsOf(townPlaces[t].levels[l], "start")
        amountsOf(townPlaces[t].levels[l], "more")
    }
}
