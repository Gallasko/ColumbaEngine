// Chronicle rules: a fight of a walk
// ----------------------------------
// The functions of expedition.pg that are a fight's. Imported by expedition.pg only, after
// expeditionlib.pg, whose helpers they call. They read and write expedition.pg's globals by name:
// the fight as it stands (`fight`, `foes`, `account`), the walk it is part of (`run`, `record`,
// `marks`) and the character as it leaves him (`after`).
//
// A fight is turns. Each turn he acts once and every beast standing acts once, the quicker side
// first. Every so many turns a day of the stay is gone (expeditionlib.pg's `turnsPerAp`), and the
// fight's line in the record counts them. Nothing here knows a beast by name: what a beast does
// is its `script`, in expeditiontable.pg.

import "string"
import "math"
import "algorithm"

fun stanceOf(id)
{
    for (var i = 0; i < len(walkStances); i++)
    {
        if (walkStances[i].id == id)
        {
            return walkStances[i]
        }
    }

    return walkStances[0]
}

fun techOf(id)
{
    for (var i = 0; i < len(walkTechniques); i++)
    {
        if (walkTechniques[i].id == id)
        {
            return walkTechniques[i]
        }
    }

    return {id: ""}
}

fun standing()
{
    var count = 0

    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].alive > 0)
        {
            count = count + 1
        }
    }

    return count
}

fun firstStanding()
{
    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].alive > 0)
        {
            return i
        }
    }

    return 0
}

// The beast the nth foe is
fun foeMob(n)
{
    return mobOf(foes[n].id)
}

// The kinds of beast the fight holds, each once, in the order they stand
fun fightKinds()
{
    var kinds = []
    var seen = {}

    for (var i = 0; i < len(foes); i++)
    {
        if (pick(seen, foes[i].id, 0) == 0)
        {
            seen[foes[i].id] = 1
            push(kinds, foes[i].id)
        }
    }

    return kinds
}

// How many of a kind lie dead: a beast that ran is not one
fun killedOf(id)
{
    var n = 0

    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].id == id and foes[i].alive <= 0 and pick(foes[i], "fled", 0) == 0)
        {
            n = n + 1
        }
    }

    return n
}

// The quickness of the quickest beast still standing
fun quickestFoe()
{
    var most = 0

    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].alive > 0)
        {
            var mob = foeMob(i)

            most = larger(most, mob.quick)
        }
    }

    return most
}

// What the fight is called: the encounter's name, or the beast's, its pack's or a lone one of it
fun fightName()
{
    if (pick(fight, "enc", "") != "")
    {
        var enc = encounterOf(fight.enc)

        return enc.name
    }

    return foundName(foeMob(0), fight.count)
}

// Whether the nth beast attacks this turn: of a pack that holds back, only the first so many
// of its kind standing do, and the others wait for one to fall
fun attacks(mob, n)
{
    if (foes[n].alive <= 0)
    {
        return false
    }

    if (mob.holdsBack <= 0)
    {
        return true
    }

    var ahead = 0

    for (var i = 0; i < n; i++)
    {
        if (foes[i].alive > 0 and foes[i].id == foes[n].id)
        {
            ahead = ahead + 1
        }
    }

    return ahead < mob.holdsBack
}

// What the nth beast does next: its script's move, or "hold" for one that hangs back
fun moveOf(mob, n)
{
    if (not attacks(mob, n))
    {
        return "hold"
    }

    var script = foeScript(n)

    return script[foes[n].at % len(script)]
}

// What a move of a beast is called, and a line on it: {name, line}
fun moveInfo(mob, move)
{
    var told = pick(mob.moves, move, 0)

    if (typeOf(told) == "table")
    {
        return told
    }

    return {name: capitalised(move), line: ""}
}

// Whether a move draws no blood: the one that circles, and the one that hangs back
fun harmless(move)
{
    return move == "circle" or move == "hold"
}

// Whether he knows what a move does to him: once it has been used on him, or once he has
// watched the beast enough (two of four). What does nothing is plain to see
fun moveKnown(mob, move)
{
    return harmless(move) or mobLevel(run.zone, mob) >= 2 or mine("know.move." + mob.id + "." + move) > 0
}

// A line of the account. `by` says whose blow it tells ("hero", `n` the beast it was aimed at; or
// "foe", `n` its place; "" for what is no blow): the page fills that one's bar before it writes
// the line. `hp` is his Vitality in the field once the line has happened, and `left` what is left
// of the beast a blow of his landed on, in percent (-1 for none): the page moves the rules with
// the lines, not all at the end
fun say(text, figure, kind)
{
    push(account, {turn: toString(fight.turn), text: text, figure: figure, kind: kind, by: pick(fight, "by", ""), n: pick(fight, "byN", 0),
                   hp: runOf("hp"), left: pick(fight, "left", -1), missed: pick(fight, "missed", 0)})
}

fun foeName(mob, n, count)
{
    if (count <= 1)
    {
        return mob.name
    }

    var which = ["First", "Second", "Third", "Fourth"]

    return which[n % 4] + " " + toLowerCase(mob.name)
}

fun foundName(mob, count)
{
    if (count > 1)
    {
        return mob.pack
    }

    if (mob.packSize > 1)
    {
        return mob.lone
    }

    return mob.name
}

// A fight begins with what was found: its line in the record is open from here, and counts the days
fun beginFight()
{
    // What was found, kind by kind: one beast, a pack of it, or an encounter of several kinds.
    // Each foe is its own beast, named among those of its kind
    var groups = foundGroups()

    foes = []

    for (var g = 0; g < len(groups); g++)
    {
        var mob = mobOf(groups[g].mob)

        for (var i = 0; i < groups[g].count; i++)
        {
            push(foes, {n: len(foes), id: mob.id, name: foeName(mob, i, groups[g].count), hp: mob.hp, hpMax: mob.hp, at: i % len(mob.script), alive: 1, held: 0,
                             poise: pick(mob, "poise", 0), mark: "", markTurns: 0, exposed: 0, bleeding: 0, sundered: 0, delays: 0})
        }
    }

    var count = len(foes)

    fight = {mob: run.found, enc: encounterIdOf(run.found), count: count, turn: 1, turns: 0, ticks: 0, since: 0, breath: breathMost(), stance: pick(run, "stance", "balanced"), momentum: 0,
             guarding: 0, feinted: 0, target: 0, auto: 0, over: "", hpStart: runOf("hp"), bitten: 0, choice: "strike", spoils: "", lowSaid: 0,
             by: "", byN: 0, left: -1, reactions: 0}

    for (var i = 0; i < len(walkTechniques); i++)
    {
        fight["cool." + walkTechniques[i].id] = 0
    }

    account = []

    openStep("fight", run.found, count, 0, "Fighting", "swordsmanship")

    if (bossFight())
    {
        var line = lastStep()

        line.once = 1
    }

    var opening = fightName()

    if (count > 1 and fight.enc == "")
    {
        opening = opening + ": " + wordOf(count) + " of them"
    }

    push(account, {turn: "", text: opening, figure: "", kind: "note"})

    // Everyone starts an ordinary wait away from his first action: a beast quicker than he is
    // acts before he does
    fight.heroWait = waitFor(100, heroSpeed())

    for (var i = 0; i < len(foes); i++)
    {
        foes[i].wait = waitFor(100, foeSpeed(i))
        foes[i].delays = 0
    }

    // How he met it: from cover, seen first, or into his traps (encounterlib.pg)
    openFight()

    advance()

    if (runOf("downed") > 0)
    {
        endFight("lost")
    }
}

// A day of the stay gone to the fight
fun tickDay(text)
{
    var step = lastStep()

    step.ap = step.ap + 1
    fight.ticks = fight.ticks + 1
    fight.since = 0
    run.ap = larger(0, runOf("ap") - 1)
    run.spent = runOf("spent") + 1

    push(account, {turn: "", text: text, figure: "1 D", kind: "time"})
}

// Why a choice of the menu cannot be made now: "" when it can
fun choiceShort(choice)
{
    if (choice == "strike" or choice == "guard" or choice == "retreat")
    {
        return ""
    }

    if (choice == "ration")
    {
        return "ONLY AT REST"
    }

    if (choice == "remedy")
    {
        if (held("remedy") < 1)
        {
            return "NONE IN THE BAG"
        }

        return ""
    }

    if (startsWith(choice, "stance."))
    {
        return ""
    }

    if (startsWith(choice, "tech."))
    {
        var tech = techOf(substring(choice, 5))

        if (tech.id == "")
        {
            return "NO SUCH BLOW"
        }

        if (not knowsTech(tech))
        {
            return "LEARNED AT " + tech.where
        }

        if (pick(fight, "cool." + tech.id, 0) > 0)
        {
            return "READY IN " + toUpperCase(counted(fight["cool." + tech.id], "turn", "turns"))
        }

        if (fight.breath < tech.breath)
        {
            return "ASKS " + toString(tech.breath) + " BREATH"
        }

        if (pick(tech, "finisher", false) and pick(fight, "momentum", 0) < walkKnobs.momentumMost)
        {
            return "ASKS " + toString(walkKnobs.momentumMost) + " MOMENTUM"
        }

        return ""
    }

    if (startsWith(choice, "item."))
    {
        var item = substring(choice, 5)

        if (item != "flask" and item != "oil")
        {
            return "NO SUCH CHOICE"
        }

        if (held(item) < 1)
        {
            return "NONE IN THE BAG"
        }

        return ""
    }

    return "NO SUCH CHOICE"
}

// One blow of his at the nth beast
// (it returns what it dealt: 0 for a miss)
fun blow(n, techId, hitMod, name)
{
    var foe = foes[n]

    if (foe.alive <= 0)
    {
        return 0
    }

    fight.byN = n

    if (not chance(hitChance(n, hitMod, kindOf(techId))))
    {
        // A blow that found nothing: the page says so over the one it was meant for
        fight.missed = 1
        say(name + " at the " + toLowerCase(foe.name) + ": a miss", "—", "note")
        fight.missed = 0
        return 0
    }

    var range = hitRange(n, techId)
    var dealt = rollBetween(range[0], range[1])
    var text = name + " hits the " + toLowerCase(foe.name)

    // An exposed beast takes his next hit as a crit
    if (pick(foe, "exposed", 0) > 0 or chance(critChance() + walkKnobs.tempoCrit * pick(foe, "hits", 0)))
    {
        var hard = hitRangeOf(n, techId, true)

        foe.exposed = 0

        dealt = share(rollBetween(hard[0], hard[1]), walkKnobs.critPower)
        text = name + " hits the " + toLowerCase(foe.name) + " hard"
    }

    foe.hp = larger(0, foe.hp - dealt)

    if (foe.hp <= 0)
    {
        foe.alive = 0
        text = text + ", and it falls"
    }

    fight.left = wholeOf(foe.hp * 100, larger(1, foe.hpMax))
    say(text, toString(dealt), "gain")
    fight.left = -1

    // A beast hurt enough changes (expeditiontable.pg's `phases`)
    checkPhase(n)

    // What it leaves: a working its element, any hit a little of its poise
    if (foe.alive > 0)
    {
        if (kindOf(techId) == "spell")
        {
            applyMark(n, damageOf(techId))
        }

        wearPoise(n, dealt, damageOf(techId), finisherOf(techId))
    }

    // One more of his hits on it before its own turn: the next bites harder
    foe.hits = pick(foe, "hits", 0) + 1

    return dealt
}

fun heroActs(choice)
{
    // A guard, a feint, a step aside last until his next action
    fight.guarding = 0
    fight.bracing = 0
    fight.feinted = 0
    fight.stepped = 0

    if (choice == "guard")
    {
        // A defend taken on a blow costs the rhythm a point of momentum
        fight.guarding = 1
        fight.momentum = larger(0, pick(fight, "momentum", 0) - 1)
        say("You guard", "", "note")
        return
    }

    if (choice == "remedy")
    {
        take("remedy", 1)

        var mended = shiftHp(share(runOf("hpMax"), itemOf("remedy").heals))

        fight.momentum = larger(0, pick(fight, "momentum", 0) - 1)
        say("You take a wortleaf remedy", "+" + toString(mended), "gain")
        return
    }

    if (startsWith(choice, "tech."))
    {
        techActs(techOf(substring(choice, 5)))
        return
    }

    if (startsWith(choice, "item."))
    {
        itemActs(substring(choice, 5))
        return
    }

    fight.by = "hero"

    if (blow(fight.target, "strike", 0, "Strike") > 0)
    {
        buildMomentum()
    }

    fight.by = ""
}

// A thing of his bag used in the fight: a fire flask thrown, or blessed oil on his blade. Like a
// defend, it costs the rhythm a point of momentum
fun itemActs(id)
{
    take(id, 1)

    fight.momentum = larger(0, pick(fight, "momentum", 0) - 1)
    fight.by = "hero"

    if (id == "flask")
    {
        var aimed = fight.target

        pureHit(aimed, walkKnobs.flaskDamage, "Fire flask")

        if (foes[aimed].alive > 0)
        {
            applyMark(aimed, "fire")
        }
    }
    else
    {
        fight.oil = 1
        say("You oil your blade with the chapel's blessing: your blows are holy", "", "gain")
    }

    fight.by = ""
}

// A technique used: counted, and every so many uses it rises a rank, a little stronger, and
// the part it trains a point higher. Only a fight fought counts: a record walked again fights none
fun usedTech(tech)
{
    var uses = mine("uses." + tech.id) + 1

    after["uses." + tech.id] = uses

    var rank = reached(uses, walkKnobs.rankUses)

    if (rank > mine("rank." + tech.id))
    {
        after["rank." + tech.id] = rank

        var trains = pick(tech, "trains", "")

        if (trains != "")
        {
            var before = mine(trains)

            after[trains] = raised(before, trains, 1)

            if (mine(trains) > before)
            {
                run["grew." + trains] = runOf("grew." + trains) + 1
            }

            push(entries, {text: tech.name + ": rank " + toString(rank), kind: "gain", figure: "+1 " + statName(trains), glyph: "training"})
        }
        else
        {
            push(entries, {text: tech.name + ": rank " + toString(rank), kind: "gain", figure: "", glyph: "training"})
        }
    }
}

// A blow that lands builds his momentum, up to its most
fun buildMomentum()
{
    fight.momentum = smaller(walkKnobs.momentumMost, pick(fight, "momentum", 0) + 1)
}

// A technique of his, done: what it costs, then what it does
fun techActs(tech)
{
    var effect = pick(tech, "effect", "")
    var bound = foes[fight.target]
    var landed = 0

    usedTech(tech)

    fight.by = "hero"
    fight.breath = fight.breath - tech.breath
    fight["cool." + tech.id] = tech.cool + 1

    if (tech.holds)
    {
        // Nothing is dealt: the beast aimed at loses the next move it would have made
        if (holdFoe(fight.target, 100))
        {
            say(tech.name + ": the " + toLowerCase(bound.name) + " is held", "", "gain")
        }
        else
        {
            // Held before, or a boss: only slowed, and less each time
            say(tech.name + ": the " + toLowerCase(bound.name) + " is slowed", "", "gain")
        }

        if (pick(tech, "mark", "") != "")
        {
            applyMark(fight.target, tech.mark)
        }
    }
    else if (effect == "step")
    {
        fight.stepped = 1
        say("You step aside, light on your feet", "", "note")
    }
    else if (effect == "read")
    {
        fight["read." + toString(fight.target)] = 1
        say("You read the " + toLowerCase(bound.name) + ": what it is, and what it means to do", "", "note")
    }
    else if (effect == "wind")
    {
        var before = fight.breath

        fight.breath = smaller(breathMost(), fight.breath + walkKnobs.windBreath)

        var mended = shiftHp(share(runOf("hpMax"), walkKnobs.windHeal))

        say("You find your second wind", "+" + toString(fight.breath - before) + " breath, +" + toString(mended), "gain")
    }
    else if (effect == "brace")
    {
        fight.guarding = 1
        fight.bracing = 1
        say("You brace", "", "note")
    }
    else if (tech.all)
    {
        for (var i = 0; i < len(foes); i++)
        {
            if (blow(i, tech.id, tech.hit, tech.name) > 0)
            {
                landed = 1
            }
        }
    }
    else
    {
        if (blow(fight.target, tech.id, tech.hit, tech.name) > 0)
        {
            landed = 1

            if (pick(tech, "exposes", 0) > 0 and bound.alive > 0)
            {
                bound.exposed = 1
            }
        }
    }

    // The Keep's rhythm: a finisher spends his momentum, another blow that lands builds it
    if (pick(tech, "finisher", false))
    {
        fight.momentum = 0
    }
    else if (tech.kind == "blow" and landed > 0)
    {
        buildMomentum()
    }

    if (tech.id == "feint")
    {
        fight.feinted = 1
    }

    fight.by = ""
}

// ---- the timeline: who acts when -------------------------------------------------------------------
//
// Every one in the fight waits some time between two of his actions, and speed shortens it: who
// is twice as quick acts about twice as often. A move has a weight, percent of an ordinary one:
// a quick move costs less time before his next action, a heavy one more.

// The time a move of `weight` holds one of `speed` before his next action
fun waitFor(weight, speed)
{
    return wholeOf(weight * walkKnobs.tickBase, walkKnobs.speedFloor + larger(0, speed))
}

fun heroSpeed()
{
    return mine("dex")
}

fun foeSpeed(n)
{
    var speed = foeField(n, "quick", 0)

    // While their leader stands, the others are quicker
    if (ledBy(n))
    {
        speed = speed + walkKnobs.leaderQuick
    }

    return speed
}

// Whether a beast is of a role (expeditiontable.pg's `roles`)
fun hasRole(mob, role)
{
    var roles = pick(mob, "roles", [])

    for (var i = 0; i < len(roles); i++)
    {
        if (roles[i] == role)
        {
            return true
        }
    }

    return false
}

// Whether another foe standing leads the nth
fun ledBy(n)
{
    for (var i = 0; i < len(foes); i++)
    {
        if (i != n and foes[i].alive > 0)
        {
            var other = foeMob(i)

            if (hasRole(other, "leader"))
            {
                return true
            }
        }
    }

    return false
}

// The moves a foe cycles: its own once a phase has changed them, else its beast's
fun foeScript(n)
{
    return foeField(n, "script", [])
}

// What is left of his wait, and of a beast's (a fight saved before the timeline has none: an
// ordinary wait)
fun heroWait()
{
    return pick(fight, "heroWait", waitFor(100, heroSpeed()))
}

fun foeWait(n)
{
    return pick(foes[n], "wait", waitFor(100, foeSpeed(n)))
}

// The weight of a choice of his menu
fun moveWeight(choice)
{
    if (choice == "item.oil")
    {
        return 60
    }

    if (startsWith(choice, "tech."))
    {
        var tech = techOf(substring(choice, 5))

        // An opener costs no time as the first thing he does in a fight
        if (pick(tech, "opener", false) and fight.turn == 1)
        {
            return 0
        }

        return pick(tech, "weight", 100)
    }

    return 100
}

// Time goes by: every wait is that much shorter
fun elapse(t)
{
    fight.heroWait = heroWait() - t

    for (var i = 0; i < len(foes); i++)
    {
        foes[i].wait = foeWait(i) - t
    }
}

// Who acts next: -1 for him, else the beast's place. He goes first on a tie, then the beasts in
// their order
fun nextActor()
{
    var best = -1
    var at = heroWait()

    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].alive > 0 and foeWait(i) < at)
        {
            best = i
            at = foeWait(i)
        }
    }

    return best
}

// The beasts act, one after the other as their time comes, until it is his turn again
fun advance()
{
    for (var guard = 0; guard < 40; guard++)
    {
        if (runOf("downed") > 0 or standing() == 0)
        {
            return
        }

        var n = nextActor()

        if (n < 0)
        {
            return
        }

        elapse(foeWait(n))
        foeTurn(n)
    }
}

// One beast's turn on the timeline: the move its script is at (nothing for one that hangs back,
// and one held loses it), then it waits its time again
fun foeTurn(i)
{
    var mob = foeMob(i)
    var foe = foes[i]
    var move = moveOf(mob, i)

    // Its own turn: the run of his hits on it is over
    foe.hits = 0

    // What burns or bleeds it hurts it first, and may end it
    if (foe.alive > 0 and not tickFoe(i))
    {
        return
    }

    // One that does not stay to be killed: hurt, it is gone at its turn
    if (foe.alive > 0 and pick(foe, "held", 0) == 0 and hasRole(mob, "flees") and foe.hp * 100 < walkKnobs.fleeAt * foe.hpMax)
    {
        foe.alive = 0
        foe.fled = 1
        say("The " + toLowerCase(foe.name) + " bolts", "", "loss")
        return
    }

    if (foe.alive > 0 and move != "hold" and runOf("downed") == 0 and pick(foe, "held", 0) > 0)
    {
        // Held by a word: its move is lost, and it is free again
        foe.held = 0
        say("The " + toLowerCase(foe.name) + " strains against the word", "", "note")
    }
    else if (foe.alive > 0 and move != "hold" and runOf("downed") == 0)
    {
        foe.at = (foe.at + 1) % len(foeScript(i))

        if (move == "circle")
        {
            // (in its own word when its move has one: the slime oozes)
            var circling = moveInfo(mob, move)

            say("The " + toLowerCase(foe.name) + " " + pick(circling, "verb", "circles"), "", "note")
        }
        else if (chance(dodgeChance(i)))
        {
            after["know.move." + mob.id + "." + move] = 1
            fight.by = "foe"
            fight.byN = i
            fight.missed = 1
            say("The " + toLowerCase(foe.name) + " " + mob.verb + ": you step clear", "—", "note")
            fight.missed = 0
            fight.by = ""
        }
        else
        {
            after["know.move." + mob.id + "." + move] = 1
            fight.by = "foe"
            fight.byN = i

            var range = biteRange(mob, move)
            var dealt = rollBetween(range[0], range[1])

            // One that spares (a story's dummy) leaves him one Vitality, whatever it deals
            if (pick(mob, "spares", false))
            {
                dealt = smaller(dealt, runOf("hp") - 1)
            }

            var taken = 0 - shiftHp(0 - dealt)

            // (only a beast that spares: on a walk, the blow that brings him down at one is a blow)
            if (taken <= 0 and pick(mob, "spares", false))
            {
                // It spared him all of it: a knock, no more
                say("The " + toLowerCase(foe.name) + " " + mob.verb + ": it barely touches you", "—", "note")
            }
            else
            {
                fight.bitten = fight.bitten + 1

                // What was seen of it is known from here on, whatever else is
                var low = mine("know.low." + mob.id)

                if (low == 0 or taken < low)
                {
                    after["know.low." + mob.id] = taken
                }

                if (taken > mine("know.high." + mob.id))
                {
                    after["know.high." + mob.id] = taken
                }

                say("The " + toLowerCase(foe.name) + " " + mob.verb, "−" + toString(taken), "loss")
            }

            fight.by = ""
        }
    }

    // A chilled beast is slower to come again
    foe.wait = waitFor(100, foeSpeed(i))

    if (pick(foe, "mark", "") == "frost")
    {
        foe.wait = share(foe.wait, walkKnobs.chillWeight)
    }
}

// The fight is over: its line in the record is written, with what it took and what it gave
fun endFight(outcome)
{
    var mob = foeMob(0)
    var kinds = fightKinds()
    var step = lastStep()

    // (a story's fight is its day's work, its turns no days: storylib.pg)
    var story = pick(run, "story", "") != ""

    // A day begun is a day spent
    if (fight.since > 0 and not story)
    {
        tickDay("The fight ends in a day begun: a day gone · " + toString(fight.since) + " of " + toString(turnsPerAp()) + " turns")
    }

    // A beast known through and through costs a day less, never less than one
    if (mobLevel(run.zone, mob) >= 4 and fight.ticks > 1 and not story)
    {
        fight.ticks = fight.ticks - 1
        step.ap = step.ap - 1
        run.ap = runOf("ap") + 1
        run.spent = runOf("spent") - 1
        push(account, {turn: "", text: "You know the beast: a day spared", figure: "+1 D", kind: "gain"})
    }

    fight.over = outcome
    run["cost." + run.found] = fight.ticks

    for (var k = 0; k < len(kinds); k++)
    {
        run["cost." + kinds[k]] = fight.ticks

        // (nothing is learned of a story's own beast: a dummy is no beast of the world)
        if (not pick(mobOf(kinds[k]), "story", false))
        {
            learn("fights." + kinds[k], 1)
            after["fought." + kinds[k]] = 1
        }
    }

    var hurt = "not touched once"

    if (fight.bitten > 0)
    {
        if (mob.verb == "bites")
        {
            hurt = "bitten " + timesWord(fight.bitten)
        }
        else
        {
            hurt = "struck " + timesWord(fight.bitten)
        }
    }

    var length = counted(fight.turns, "turn", "turns")
    var what = toLowerCase(fightName())

    if (outcome == "won")
    {
        var killed = 0

        for (var k = 0; k < len(kinds); k++)
        {
            if (killedOf(kinds[k]) > 0)
            {
                push(marks, {step: len(record), kind: "kill", id: kinds[k], n: killedOf(kinds[k])})
                killed = killed + killedOf(kinds[k])
            }
        }

        // The first of a kind he kills in this life is a lesson about it
        for (var k = 0; k < len(kinds); k++)
        {
            var taught = mobOf(kinds[k])

            if (killedOf(kinds[k]) > 0 and mine("lesson." + kinds[k]) == 0 and not pick(taught, "story", false))
            {
                after["lesson." + kinds[k]] = 1
                push(entries, {text: pick(taught, "lesson", "The first " + toLowerCase(taught.name) + " you've killed: you know it better now"), kind: "gain", figure: "", glyph: "study"})
            }
        }

        for (var f = 0; f < len(foes); f++)
        {
            var slain = foeMob(f)

            if (foes[f].alive <= 0 and pick(foes[f], "fled", 0) == 0)
            {
                for (var l = 0; l < len(slain.loot); l++)
                {
                    var drop = slain.loot[l]

                    if (chance(drop.chance))
                    {
                        loot(drop.id, rollBetween(drop.least, drop.most) + skinBonus(drop.id))
                        after["know.drop." + slain.id + "." + drop.id] = 1
                    }
                }
            }
        }

        step.text = "You killed it · " + length + ", " + hurt

        if (fight.count > 1)
        {
            step.text = "You killed all " + wordOf(fight.count) + " · " + length + ", " + hurt
        }

        if (killed == 0)
        {
            step.text = "It got away · " + length + ", " + hurt
        }
        else if (killed < fight.count)
        {
            step.text = "You killed " + wordOf(killed) + ", the rest got away · " + length + ", " + hurt
        }

        fight.spoils = step.gave

        if (fight.spoils == "")
        {
            fight.spoils = "Nothing worth carrying"
        }

        push(account, {turn: "", text: "It is over. " + step.text, figure: "", kind: "milestone"})
    }
    else if (outcome == "fled")
    {
        step.text = "You fled " + what + " · " + length + ", " + hurt
        step.tone = "loss"
        fight.spoils = "No loot: you left the field"
        push(account, {turn: "", text: "You break off and run", figure: "", kind: "loss"})
    }
    else if (outcome == "held")
    {
        step.text = "You held " + what + " till time was called · " + length + ", " + hurt
        fight.spoils = "Neither side fell"
        push(account, {turn: "", text: "Time is called, and neither side has fallen", figure: "", kind: "note"})
    }
    else
    {
        step.text = "You were brought down by " + what + " · " + length
        step.tone = "loss"
        fight.spoils = "You are carried home"
        push(account, {turn: "", text: "You go down. Someone finds you", figure: "", kind: "loss"})
    }

    // A boss: beaten for the life, fled from, or his death (encounterlib.pg)
    bossOutcome(outcome)

    closeStep()

    // A story's: its own words, and nobody is carried home (storylib.pg)
    if (story)
    {
        storyFightEnd(outcome, length, hurt)
    }
}

// One turn: his choice, the beasts' moves, and the day it may end
fun resolve(choice)
{
    if (startsWith(choice, "stance."))
    {
        var stance = stanceOf(substring(choice, 7))

        // A stance is taken at once, and the turn is still his
        if (fight.stance != stance.id)
        {
            fight.stance = stance.id
            run.stance = stance.id
            say("You stand " + toLowerCase(stance.name), "", "note")
        }

        fight.choice = "strike"

        return
    }

    var why = choiceShort(choice)

    if (why != "")
    {
        run.refused = why
        return
    }

    if (choice == "retreat")
    {
        endFight("fled")
        return
    }

    // His action, at his time: then he waits what the move weighs
    elapse(heroWait())
    heroActs(choice)
    fight.heroWait = waitFor(moveWeight(choice), heroSpeed())

    for (var i = 0; i < len(walkTechniques); i++)
    {
        var key = "cool." + walkTechniques[i].id

        if (pick(fight, key, 0) > 0)
        {
            fight[key] = fight[key] - 1
        }
    }

    fight.turns = fight.turns + 1
    fight.since = fight.since + 1

    if (runOf("downed") > 0)
    {
        endFight("lost")
        return
    }

    if (standing() == 0)
    {
        endFight("won")
        return
    }

    // (a story's fight is its day's work: no day of it goes by turns)
    var story = pick(run, "story", "") != ""

    if (fight.since >= turnsPerAp() and not story)
    {
        tickDay(capitalised(wordOf(fight.since)) + " turns: a day gone to this fight")
    }

    // The beasts whose time comes before his next action act now
    advance()

    if (runOf("downed") > 0)
    {
        endFight("lost")
        return
    }

    if (standing() == 0)
    {
        endFight("won")
        return
    }

    // Time called (a story's fight: storylib.pg), and neither side is down: it is held
    if (runOf("fightMost") > 0 and fight.turns >= runOf("fightMost"))
    {
        endFight("held")
        return
    }

    if (turnsPerAp() < walkKnobs.turnsPerAp and fight.lowSaid == 0 and not story)
    {
        fight.lowSaid = 1
        push(account, {turn: "", text: "Under half vitality: days now pass in " + toString(turnsPerAp()) + " turns", figure: "", kind: "time"})
    }

    fight.turn = fight.turn + 1

    if (foes[fight.target].alive <= 0)
    {
        fight.target = firstStanding()
    }

    // A blow that cannot be made again is not left chosen
    if (choiceShort(fight.choice) != "")
    {
        fight.choice = "strike"
    }
}

// What he asks of the fight: a row of the menu looked at, a beast aimed at, the turn played,
// the fight handed to his stance or taken back, and the way back to the woods once it is over
fun fightAct(kind, target, count)
{
    if (pick(fight, "mob", "") == "")
    {
        run.refused = "There is no fight"
        return
    }

    if (fight.over != "")
    {
        // A story's: back to its day, which ends now (storylib.pg)
        if (kind == "back" and pick(run, "story", "") != "")
        {
            storyFightBack(false)
        }
        else if (kind == "back")
        {
            run.found = ""
            run.foundCount = 0
            foes = []
            account = []
            fight = {over: "", mob: ""}

            if (runOf("downed") == 0)
            {
                maybeEvent("fight")
            }
        }

        return
    }

    if (kind == "pick")
    {
        fight.choice = target
    }
    else if (kind == "target")
    {
        if (count >= 0 and count < len(foes))
        {
            if (foes[count].alive > 0)
            {
                fight.target = count
            }
        }
    }
    else if (kind == "auto")
    {
        fight.auto = 1 - fight.auto
    }
    else if (kind == "do")
    {
        resolve(fight.choice)
    }
    else if (kind == "move")
    {
        // A button of the menu pressed: that move, now
        fight.choice = target
        resolve(target)
        fight.choice = "strike"
    }
    else if (kind == "step")
    {
        resolve(autoChoice())
    }
}

