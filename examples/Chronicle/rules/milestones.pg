// Chronicle rules: the milestones of a life
// -----------------------------------------
// Input:  `age` (years, a number).
// Output: `milestones`, every milestone {age, id, label, passed, asks}, where `asks` lists what
//         each path asks at it: [{path, stat, label, needed}];
//         `next`, the first milestone after `age`: {id, label, age, in} with `in` the whole
//         months to it; past the last one: {id: "", label: "", age: -1, in: -1};
//         `headline`, the page's head at `age`: {ageText ("17.5"), subtitle ("THE SEVENTEENTH
//         YEAR · SPRING · BELLMOOR"), ageNote ("years · 6 mo to the eighteenth", or "years"
//         past the last milestone)}.

import "string"
import "math"
import "algorithm"
import "lib"

var errors = []

var milestoneTable = [
    {age: 7, id: "childhood", label: "Childhood", asks: []},
    {age: 14, id: "apprenticeship", label: "Apprenticeship", asks: []},
    {age: 18, id: "path", label: "Choose a path", asks: [
        {path: "squire", stat: "str", label: "Strength", needed: 18},
        {path: "squire", stat: "swd", label: "Swordsmanship", needed: 4},
        {path: "squire", stat: "letter", label: "The Guild's letter", needed: 1},
        {path: "scholar", stat: "int", label: "Intelligence", needed: 12},
        {path: "scholar", stat: "letters", label: "Letters", needed: 3},
        {path: "guild", stat: "haggle", label: "Haggling", needed: 3},
        {path: "guild", stat: "coin", label: "Coin", needed: 40}
    ]},
    {age: 25, id: "journeyman", label: "Journeyman", asks: []},
    {age: 40, id: "elder", label: "Elder", asks: []},
    {age: 43, id: "end", label: "The end", asks: []}
]

var milestones = []
var next = {id: "", label: "", age: -1, in: -1}

for (var i = 0; i < len(milestoneTable); i++)
{
    var m = milestoneTable[i]

    push(milestones, {age: m.age, id: m.id, label: m.label, passed: m.age <= age, asks: m.asks})

    if (m.age > age and next.age < 0)
    {
        next = {id: m.id, label: m.label, age: m.age, in: monthsBetween(age, m.age)}
    }
}

var place = "BELLMOOR"
var year = toInt(floor(age + 0.001))
var monthOfYear = monthsBetween(year, age)

var headline = {
    ageText: ageText(age),
    subtitle: "THE " + toUpperCase(ordinalWord(year)) + " YEAR · " + seasonOf(monthOfYear) + " · " + place,
    ageNote: "years"
}

if (next.age > 0)
{
    headline.ageNote = "years · " + toString(next.in) + " mo to the " + ordinalWord(next.age)
}
