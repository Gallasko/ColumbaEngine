// Chronicle rules: the doors that close
// -------------------------------------
// Input:  `age` (years), `character` (a table of stats and flags), `done` (activity id -> terms
//         completed, read by activitytable.pg), `world`, `lives` and `running` (activitytable.pg's:
//         the world's month, which life of the world this is, the activity he is at).
// Output: `windows`, one table per age-limited chance:
//         {id, name, from, to, state, note, attempts}
//         A door is an activity's: it opens at the activity's `fromAge` and its last chance is a
//         term that ends by its `finishBy`, the door's `to`. A door of a path is listed while
//         the activity's path is open to him (activitytable.pg's `pathOpen`), and once he has
//         been through it: the way into his own path stays on his clock.
//         state: "upcoming" before `from`, "open" while one term still fits before `to`,
//         "closed" after, once he has been through it (its activity spent) or once an event he
//         stood by has shut it (its activity `barred`), or once he left it (a door with `left`,
//         whose activity's `whileNot` he holds: the Collegium's drop-out): a closed door stays
//         listed for the rest of the life. The note says
//         what still fits, in attempts of the window's activity, never in percentages; before
//         the door opens it names what the door asks.

// The game asks for the activities and the doors in one run of this script (`activities` is
// activitytable.pg's, shaped for the same character). lib.pg comes with activitytable.pg, and
// `errors` is its list: what it refused is told here too.

import "string"
import "math"
import "algorithm"
import "activitytable"

var windowTable = [
    {activity: "choir", name: "The choir",
     asks: "Asks a boy who has his letters.", closed: "The choir takes boys until 12. That door is shut."},
    {activity: "watch", name: "The Watch",
     asks: "Asks Strength 8 of a boy who will carry.", closed: "The Watch wants its carriers young. That door is shut."},
    {activity: "boys", name: "The Bellmoor Boys",
     asks: "Asks Dexterity 8 and quick feet.", closed: "The Bellmoor Boys grew up. That door is shut."},
    {activity: "keep", name: "The Keep",
     asks: "Asks Strength 14, Arms 3, Discipline 2, and 10 coin.", closed: "The Keep swears in no one past 20. That door is shut."},
    {activity: "collegium", name: "The Collegium",
     asks: "Asks Intelligence 12, Letters 3, Lore 2, and coin for its first days: the fees of its courses are paid as he follows them.", closed: "The Collegium admits no one past 20. That door is shut.",
     left: "He left the Collegium, and it does not take back who left it. That door is shut."},
    {activity: "hand", name: "The Hidden Hand",
     asks: "Asks Dexterity 14, Stealth 2, Guile 2, a friend on the street, and 15 coin.", closed: "The Hidden Hand stopped asking. That door is shut."},
    {activity: "campaign", name: "The border campaign",
     asks: "Asks Arms 6, Discipline 4 and Renown 3.", closed: "The campaign marched without him. That door is shut."},
    {activity: "harrow", name: "The ruins at Harrow",
     asks: "Asks Lore 6, Arcana 3 and the Harrow fragments.", closed: "Harrow was picked clean. That door is shut."},
    {activity: "rob", name: "The Counting House",
     asks: "Asks Stealth 6, Guile 5 and 3 Favors.", closed: "The Counting House changed its locks. That door is shut."}
]

// `lived`, the months of his life so far, is activitytable.pg's
var windows = []

for (var i = 0; i < len(windowTable); i++)
{
    var w = windowTable[i]
    var a = lookup(activityById, w.activity, {id: ""})

    if (a.id == "" or a.months <= 0)
    {
        push(errors, "window " + w.activity + ": unknown activity")
    }
    else if (a.pathOpen or a.spent)
    {
        var state = "open"
        var note = ""
        var attempts = 0
        var last = a.finishBy * 12

        // It opens the month its row does: some birthdays' work comes a few months into the year
        var opens = a.fromAge * 12 + lookup(a, "fromMonths", 0)

        if (a.barred != "" and not a.spent)
        {
            // Shut by an event he stood by, before its age or in it: the door says which
            state = "closed"
            note = a.barred + "."
        }
        else if (lookup(w, "left", "") != "" and lookup(a, "whileNot", "") != "" and statOf(character, a.whileNot) > 0)
        {
            // He left it (its drop-out flag, the row's `whileNot`): it does not take him back
            state = "closed"
            note = w.left
        }
        else if (lived < opens)
        {
            state = "upcoming"
            note = w.asks
            attempts = monthsToAttempts(last - opens, a.months)
        }
        else if (a.spent)
        {
            state = "closed"
            note = "He has been through that door."
        }
        else if (lived + a.months > last)
        {
            state = "closed"
            note = w.closed
        }
        else
        {
            attempts = monthsToAttempts(last - lived, a.months)
            note = openNote(last - lived, attempts)
        }

        // `from` is a keyword: the key is written by index
        var door = {id: a.id, name: w.name, to: a.finishBy, state: state, note: note, attempts: attempts}
        door["from"] = a.fromAge

        push(windows, door)
    }
}
