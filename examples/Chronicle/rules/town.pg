// Chronicle rules: the town, as its page shows it
// -----------------------------------------------
// Input:  `age` (years), `character` (a table of stats and flags, with the town in it:
//         "town_known", "town.<place id>" its level, "fund.<place id>" the coin left to it,
//         "seen.<place id>" 1 once a life has had it on its page),
//         `done` (activity id -> the terms completed in this life) and `lives` (the lives of
//         the world, this one counted): what brings a place onto the page may be either.
//         `world` (handed as to every script; not read here).
// Output: `places`, one table per place of towntable.pg, in its order:
//           {id, name, glyph, about, level, most (the most its level can be),
//            shown   whether it is on the Town page for him: lib.pg's `placeShown`. The page
//                    grows with what he does; a place once shown stays shown
//            gives   "" at level 0, else what its level gives, in one line
//            given [{level, built, gives}]: every level reached, the first first. A level
//                    adds to the ones before it: the gloss lists them all, the tile says the last
//            tiers [{level, built, gives, reached}]: every level the place has, reached or not, the
//                    first first: the gloss lists them all, what he has raised and what is still to raise
//            line    what its tile says: that, or the level's shorter `note` (towntable.pg), in
//                    caps, or "NOT YET BUILT"
//            tale    "" or the line the log writes when its level is reached (the level's `lore`)
//            built   "" or what stands there at its level, as the log names it
//            fund    the coin left to it, counted toward its next level
//            nextWork   "" at its last level, else the id of the activity that raises it
//                       (activitytable.pg makes it from the same table: "raise.<id>.<level>")
//            nextName, nextMonths, nextCoin (less the fund, never below 0), nextYears,
//            nextCosts  what the next level asks, in one line: "6 mo · 5 coin · 20 Stone · 20 Water"
//            nextTime   its months and years alone, as nextCosts says them ("6 mo"): the gloss says
//                       the time, then each thing it takes once, a gap a line
//            nextGives  what it will give
//            nextLocked true while he cannot pay for it
//            gaps [{stat, label, current, needed}]: what it takes from him, against what he has
//            leaves [{stat, amount}], leaveLine ("20 stone, 12 water, 1 gem"): what he holds of what
//                    the next level still asks, left to the place with his coin if it is the one
//                    he chooses at his death ("fund.<id>.<thing>" in `character`, counted toward
//                    what the level asks as the coin is). Only things can be left: the basic and
//                    made resources (economytable.pg) and what his walks bring (expeditiontable.pg's
//                    `walkItems`); a part, a skill or a standing (Renown) cannot
//            spends [{stat, amount}]: what the fund pays of the next level, "coin" for its coin
//                    ("fund.<id>") and each thing it asks ("fund.<id>.<thing>"), no more than the
//                    level asks of it. The Life screen takes that much from the fund when the
//                    level is reached; what is over stays for the level after
//            stashLine  "" or what goes into the stash if it is the one he chooses (below)}
//         `start`, [{stat, amount}]: what a new life is born with for the town as it stands
//         (the `start` of every level reached). The Life screen adds them to a life that is not
//         the first of its world.
//         `opened`, the line the log and a toast say the month a life comes to know the town.
//         `raisedLine`, what follows a level's `built` in the line the log writes for it.
//         `epitaphLine`, "" or what a new life's log says before how the last one ended: the
//         inn tells it from its second level.
//         `fundLine`, what the gloss of a place writes before the coin left to it.
//         `foundLine`, what follows a place's name in the line said the month it comes onto the page.
//         `gift`, the gift a life may make at its death: {stat (what of his is left to a place:
//         it joins the place's fund), before and after (the ending's line around the amount),
//         plain and chosen (what the ending's button says without a gift, and with one), things (the
//         ending's line when he holds no coin, only things a place can use)}.
//         `stash`, [{stat, most}]: what the stash keeps of his at his death, a basic resource
//         (economytable.pg's `basicResources`) each, and the most of it it keeps. What he holds
//         of it then, less what his gift leaves to a place, joins what earlier lives kept
//         ("stash.<id>" in `character`), up to that most.
//         `stashLine`, "" or the ending's sentence of what his death puts into the stash with no
//         gift: "His stores go to the family's stash: 25 water, 12 stone." Each place has its own
//         `stashLine`, the same with his gift left to it (what it takes of the basics left out).
//         (`none` is a word of the language, and cannot name a field.)
//
// No function here: lib.pg holds them all, ahead of every table (see there why).

import "string"
import "math"
import "algorithm"
import "lib"
import "towntable"
import "economytable"
import "expeditiontable"

var errors = []


var opened = "He has been to the market: the Town page is open"
var raisedLine = " stands in Bellmoor: the town will keep it"
var fundLine = "Left to it by those before him"
var foundLine = " is his to raise now: it has come onto the Town page"
var epitaphLine = ""
var gift = {stat: "coin", before: "LEAVE HIS ", after: " COIN TO", things: "LEAVE WHAT A PLACE CAN USE TO", plain: "Begin a new life", chosen: "Leave it, and begin a new life"}

// What the ending says of the stash, before what goes into it
var stashSaid = "His stores go to the family's stash: "

if (statOf(character, "town.inn") >= 2)
{
    epitaphLine = "At the inn they still tell of the one before him. "
}

// The most of any one thing the stash keeps: what each place's stash line and `stash` say
var mostKept = stashMost(character)

var places = []
var start = []

for (var t = 0; t < len(townPlaces); t++)
{
    var place = townPlaces[t]
    var most = len(place.levels)
    var level = clamp(statOf(character, "town." + place.id), 0, most)
    var fund = statOf(character, "fund." + place.id)

    var shown = {id: place.id, name: place.name, glyph: place.glyph, about: place.about, level: level, most: most,
                 shown: placeShown(place, character, monthOf(age), done, lives),
                 gives: "", line: "NOT YET BUILT", tale: "", built: "", fund: fund,
                 nextWork: "", nextName: "", nextMonths: 0, nextCoin: 0, nextYears: 0, nextCosts: "", nextTime: "", nextGives: "", nextLocked: false,
                 gaps: [], given: [], tiers: [], leaves: [], spends: [], leaveLine: "", stashLine: ""}

    // What it gives is what every level reached gives: none takes the place of the one before
    for (var l = 0; l < level; l++)
    {
        push(shown.given, {level: l + 1, built: place.levels[l].built, gives: levelGives(place, l, character)})
    }

    // And every level it has, the ones still to raise with them
    for (var l = 0; l < most; l++)
    {
        push(shown.tiers, {level: l + 1, built: place.levels[l].built, gives: levelGives(place, l, character), reached: l < level})
    }

    if (level > 0)
    {
        var reached = place.levels[level - 1]

        shown.gives = levelGives(place, level - 1, character)
        shown.line = toUpperCase(levelNote(place, level - 1, character))
        shown.tale = reached.lore
        shown.built = reached.built
    }

    // What a new life is born with: every level reached, not the last alone
    for (var l = 0; l < level; l++)
    {
        var given = listOf(place.levels[l], "start")

        for (var g = 0; g < len(given); g++)
        {
            push(start, {stat: given[g].stat, amount: given[g].amount})
        }
    }

    if (level < most)
    {
        var next = place.levels[level]
        var coin = clamp(levelCoin(next, character) - fund, 0, next.coin)
        var asks = ""

        // What the fund pays of it: no more coin than the level asks. The Life screen takes that much
        // from the fund when the level is reached, and what is over stays for the next level
        var paid = clamp(fund, 0, levelCoin(next, character))

        if (paid > 0)
        {
            push(shown.spends, {stat: "coin", amount: paid})
        }

        shown.nextWork = "raise." + place.id + "." + toString(level + 1)
        shown.nextName = next.work
        shown.nextMonths = next.months
        shown.nextCoin = coin
        shown.nextYears = lookup(next, "years", 0)
        shown.nextGives = levelGives(place, level, character)

        if (next.months > 0)
        {
            asks = fmtMonths(next.months)
        }

        if (shown.nextYears > 0)
        {
            if (asks != "")
            {
                asks = asks + " · "
            }

            asks = asks + toString(shown.nextYears) + " years of his life"
        }

        // Its time alone, for the gloss: the things it takes are its gaps, a line each
        shown.nextTime = asks

        if (coin > 0)
        {
            if (asks != "")
            {
                asks = asks + " · "
            }

            asks = asks + toString(coin) + " coin"
            push(shown.gaps, {stat: "coin", label: statName("coin"), current: statOf(character, "coin"), needed: coin})

            if (statOf(character, "coin") < coin)
            {
                shown.nextLocked = true
            }
        }

        var also = listOf(next, "costs")

        for (var c = 0; c < len(also); c++)
        {
            // The most a stat can be goes with the stat: said once, under the stat's name
            var isCap = false

            for (var k : statCaps)
            {
                if (statCaps[k] == also[c].stat)
                {
                    isCap = true
                }
            }

            // What lives before him left the place of it counts toward what it asks, as their coin does
            var need = clamp(also[c].amount - statOf(character, "fund." + place.id + "." + also[c].stat), 0, also[c].amount)
            var spent = clamp(statOf(character, "fund." + place.id + "." + also[c].stat), 0, also[c].amount)

            if (spent > 0)
            {
                push(shown.spends, {stat: also[c].stat, amount: spent})
            }

            // Whether it is a thing: a basic or a made resource (economytable.pg) or what a walk
            // brings (expeditiontable.pg's `walkItems`), and what one of it is called ("1 Pelt",
            // "1 Gem"): a thing asked once is named once, as `thingsWord` counts the basics
            var thing = false
            var once = ""

            for (var w = 0; w < len(walkItems); w++)
            {
                if (walkItems[w].id == also[c].stat)
                {
                    thing = true
                    once = walkItems[w].one
                }
            }

            for (var b = 0; b < len(basicResources); b++)
            {
                if (basicResources[b].id == also[c].stat)
                {
                    thing = true
                    once = basicResources[b].one
                }
            }

            for (var m = 0; m < len(madeResources); m++)
            {
                if (madeResources[m].id == also[c].stat)
                {
                    thing = true
                    once = madeResources[m].one
                }
            }

            var named = statName(also[c].stat)

            if (need == 1 and once != "")
            {
                named = capitalised(once)
            }

            if (not isCap and need > 0)
            {
                asks = asks + " · " + toString(need) + " " + named
                push(shown.gaps, {stat: also[c].stat, label: statName(also[c].stat), current: statOf(character, also[c].stat), needed: need})
            }

            if (statOf(character, also[c].stat) < need)
            {
                shown.nextLocked = true
            }

            // And what he holds of it would be left to the place at his death, no more than it
            // still asks, if it is a thing. A part, a skill or a standing of his (Strength, Renown)
            // ends with him. What the place does not take of the basics goes into the stash
            // (`stash`, below); the rest is lost with him
            var given = 0

            if (thing)
            {
                given = clamp(statOf(character, also[c].stat), 0, need)
            }

            if (given > 0)
            {
                push(shown.leaves, {stat: also[c].stat, amount: given})

                // Named as the ledger names it: a basic or gems as the stash's line counts them
                // ("1 gem"), anything else by its name, or by what one of it is called ("1 pelt")
                var counted = toString(given) + " " + toLowerCase(statName(also[c].stat))

                if (given == 1 and once != "")
                {
                    counted = "1 " + once
                }

                for (var b = 0; b < len(basicResources); b++)
                {
                    if (basicResources[b].id == also[c].stat)
                    {
                        counted = toLowerCase(thingsWord(also[c].stat, given))
                    }
                }

                for (var m = 0; m < len(madeResources); m++)
                {
                    if (madeResources[m].id == also[c].stat)
                    {
                        counted = toLowerCase(thingsWord(also[c].stat, given))
                    }
                }

                if (shown.leaveLine != "")
                {
                    shown.leaveLine = shown.leaveLine + ", "
                }

                shown.leaveLine = shown.leaveLine + counted
            }
        }

        shown.nextCosts = asks
    }

    // What goes into the stash at his death if he leaves his gift to this place: the rest of
    // what he holds of the basics, once it has taken what it asks
    var stashed = stashWords(character, shown.leaves, mostKept)

    if (stashed != "")
    {
        shown.stashLine = stashSaid + stashed + "."
    }

    push(places, shown)
}

// And with no gift: what the ending says after the story of his life
var stashLine = ""
var stashedAll = stashWords(character, [], mostKept)

if (stashedAll != "")
{
    stashLine = stashSaid + stashedAll + "."
}

// What the stash keeps at his death, of each basic resource, and the most it keeps of each: what
// he holds then, less what his gift left to a place, goes into it for the lives after him. Every
// basic is kept, up to the same most: economytable.pg's `economyKnobs`, and what the levels of the
// town that stand add to it (lib.pg's `stashMost`).
var stash = []

for (var b = 0; b < len(basicResources); b++)
{
    push(stash, {stat: basicResources[b].id, most: mostKept})
}
