<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>Chronicle</title>
  <style>
    html, body { margin: 0; height: 100%; overflow: hidden; background: #ece0c8; }

    /* The canvas is the whole frame. SDL follows this box: the game is resized to it, never scaled.
       Black behind it, always: the engine leaves an alpha under 1 on every blended pixel (the edge of
       a glyph, a wash), and the browser lets what is behind the canvas through there. On a light
       ground the text comes out faded; on black it comes out as drawn. */
    #canvas { display: block; width: 100vw; height: 100vh; outline: none; background: #000; }

    /* A phone. The frame is the part of the page the browser's bars leave (dvh), not the whole
       of it, or the bottom of the game is under them. A finger on the canvas is the game's: no
       scroll, no pinch, no zoom on a double tap (two taps begin a task), no selection, no flash. */
    @supports (height: 100dvh) { #canvas { height: 100dvh; } }

    #canvas { touch-action: none; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }

    /* Over the canvas until the game is there */
    #status {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      padding: 24px; text-align: center; pointer-events: none; background: #ece0c8;
      font: 18px/1.5 Georgia, "Times New Roman", serif; color: #2b2219;
    }
    #status[hidden] { display: none; }

    /* The way out of a frame the game cannot run in */
    #own-tab {
      display: inline-block; margin-top: 16px; padding: 8px 20px; pointer-events: auto;
      border: 1px solid #2b2219; color: #2b2219; text-decoration: none;
    }
    #own-tab:hover, #own-tab:focus { background: #2b2219; color: #ece0c8; }
    #own-tab[hidden] { display: none; }

    /* The bug report's dialog, over the game (the game opens it, LifeScene::showReport): the game's
       leaf on its scrim, in its colours by day and by candle. It is the page's own, so that its box
       takes several lines and raises a phone's keyboard; while it is up no key, click or touch of it
       reaches the game. */
    #report {
      --vellum: #ece0c8; --folio: #f6eddb; --worn: #ded0b2; --ink: #2b2219; --muted: #675842;
      --ruled: #806a4a; --hair: #cbb894; --vermilion: #9e2b25; --on-vermilion: #f8efdd; --scrim: rgba(43, 34, 25, 0.58);
      position: fixed; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center;
      padding: 16px; box-sizing: border-box; background: var(--scrim);
      font: 16px/1.5 Georgia, "Times New Roman", serif; color: var(--ink);
    }
    #report.candle {
      --vellum: #17140f; --folio: #201b14; --worn: #100d09; --ink: #eadfc8; --muted: #a3927a;
      --ruled: #7a6c58; --hair: #352d23; --vermilion: #e2766a; --on-vermilion: #2a100c; --scrim: rgba(0, 0, 0, 0.68);
    }
    #report[hidden] { display: none; }
    #report .leaf {
      width: 100%; max-width: 560px; max-height: 100%; overflow: auto; box-sizing: border-box;
      padding: 20px 24px; background: var(--folio); border: 1px solid var(--ruled); border-radius: 4px;
    }
    #report h2 { margin: 0 0 12px; font-size: 26px; line-height: 1.2; font-weight: 600; }
    #report textarea {
      display: block; width: 100%; box-sizing: border-box; min-height: 120px; resize: vertical; padding: 8px 10px;
      font: 16px/1.4 Georgia, "Times New Roman", serif; color: var(--ink); background: var(--worn);
      border: 1px solid var(--ruled); border-radius: 3px; outline: none;
    }
    #report textarea:focus { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
    #report textarea::placeholder { color: var(--muted); opacity: 1; }
    #report .note { margin: 10px 0 0; font-size: 14px; line-height: 1.45; color: var(--muted); }
    #report .seen { display: flex; gap: 12px; align-items: flex-start; margin-top: 12px; }
    #report .seen[hidden] { display: none; }
    #report .seen img { display: block; max-width: 45%; max-height: 120px; border: 1px solid var(--hair); }
    #report .seen span { font-size: 13px; line-height: 1.4; color: var(--muted); font-style: italic; }
    #report .line { min-height: 20px; margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: var(--vermilion); }
    #report .buttons { display: flex; justify-content: flex-end; gap: 12px; margin-top: 12px; }
    #report button {
      min-width: 88px; height: 36px; padding: 0 16px; border-radius: 4px; cursor: pointer;
      font: 600 15px/1 Georgia, "Times New Roman", serif;
    }
    #report .quiet { background: var(--folio); color: var(--ink); border: 1px solid var(--ruled); }
    #report .seal { background: var(--vermilion); color: var(--on-vermilion); border: 1px solid var(--vermilion); }
    #report button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
    #report button:disabled { opacity: 0.45; cursor: default; }

    /* A phone: the leaf to the window's sides, and room above the keyboard */
    @media (max-width: 599px) {
      #report { padding: 12px; align-items: flex-start; }
      #report .leaf { padding: 16px; }
      #report h2 { font-size: 22px; }
      #report textarea { min-height: 96px; }
      #report .seen img { max-height: 90px; }
    }
  </style>
</head>
<body>
  <canvas id="canvas" tabindex="0"></canvas>
  <div id="status">
    <div>
      <div id="line">Chronicle is loading...</div>
      <a id="own-tab" target="_blank" rel="noopener" hidden>Play Chronicle in its own tab</a>
    </div>
  </div>

  <div id="report" hidden role="dialog" aria-modal="true" aria-labelledby="report-title">
    <div class="leaf">
      <h2 id="report-title">Report a bug</h2>
      <textarea id="report-words" rows="5" maxlength="2000" placeholder="What happened? What did you expect?" aria-label="What happened? What did you expect?"></textarea>
      <p class="note">A picture of the screen, your save and the game's recent messages are sent with your words.</p>
      <div class="seen" id="report-seen" hidden>
        <img id="report-thumb" alt="The screen as it was when you pressed the button">
        <span>The screen as it was when you pressed the button.</span>
      </div>
      <p class="line" id="report-line" aria-live="polite"></p>
      <div class="buttons">
        <button type="button" class="quiet" id="report-cancel">Cancel</button>
        <button type="button" class="seal" id="report-send">Send</button>
      </div>
    </div>
  </div>

  <script>
    // The bug report's dialog. The game shows it (open), says how a send went (result) and shuts it
    // (close); what is pressed is left in `pressed` ("send\n<words>", "cancel\n<words>") for the
    // game to take on its next pass (LifeScene::pollReport). Nothing typed or clicked in it reaches
    // the game: SDL listens on the window and the canvas, and every event stops here. While it is
    // up it is modal: the Tab key goes round its own controls, the canvas cannot take the focus,
    // and a key whose target is anywhere else is stopped at the window before SDL hears it.
    window.chronicleReport = (function () {
      var root = document.getElementById('report');
      var words = document.getElementById('report-words');
      var seen = document.getElementById('report-seen');
      var thumb = document.getElementById('report-thumb');
      var line = document.getElementById('report-line');
      var send = document.getElementById('report-send');
      var cancel = document.getElementById('report-cancel');
      var canvas = document.getElementById('canvas');
      var limited = false;

      var api = { pressed: null };

      function isOpen() { return !root.hidden; }

      // What Tab goes round, in order: the box, Cancel, and Send while it can be pressed
      function controls() {
        return [words, cancel, send].filter(function (c) { return !c.disabled; });
      }

      // The canvas out of reach while the dialog is up, and back after
      function holdCanvas(held) {
        if (!canvas) return;

        if (held) {
          canvas.setAttribute('tabindex', '-1');
          canvas.inert = true;
        } else {
          canvas.inert = false;
          canvas.setAttribute('tabindex', '0');
        }
      }

      function hide() {
        if (root.hidden) return;

        root.hidden = true;
        say('');
        holdCanvas(false);

        if (canvas) canvas.focus();
      }

      function press(what) {
        api.pressed = what + '\n' + words.value;
      }

      function say(text) {
        line.textContent = text || '';
      }

      api.open = function (screen, text, said, isLimited, candle) {
        api.pressed = null;   // Nothing pressed before it opened is this one's
        root.classList.toggle('candle', !!candle);
        if (text) words.value = text;
        limited = !!isLimited;
        send.disabled = limited;
        say(said);

        if (screen) {
          thumb.src = screen;
          seen.hidden = false;
        } else {
          thumb.removeAttribute('src');
          seen.hidden = true;
        }

        root.hidden = false;
        holdCanvas(true);
        words.focus();
      };

      api.result = function (kind, said, isLimited) {
        if (kind === 'sent') {
          words.value = '';
          api.close();
          return;
        }

        limited = !!isLimited;
        send.disabled = limited;
        say(said);
      };

      // The game shuts it: what was pressed is taken already, or no one's (the scene left)
      api.close = function () {
        api.pressed = null;
        hide();
      };

      api.isOpen = isOpen;

      send.addEventListener('click', function () {
        if (send.disabled) return;

        press('send');
        send.disabled = true;
        say('Sending...');
      });

      // Cancel shuts it here at once; the game takes the press on its next pass
      cancel.addEventListener('click', function () {
        press('cancel');
        hide();
      });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'Tab') {
          // Round its own controls, never out of it
          var list = controls();
          var at = list.indexOf(document.activeElement);
          var next = event.shiftKey ? (at <= 0 ? list.length - 1 : at - 1) : (at < 0 || at >= list.length - 1 ? 0 : at + 1);

          event.preventDefault();
          list[next].focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          cancel.click();
        } else if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
          event.preventDefault();
          send.click();
        }

        event.stopPropagation();
      });

      // A press on the dialog that is not on one of its controls (the scrim, the note, the picture)
      // leaves the focus where it was, in the dialog
      root.addEventListener('mousedown', function (event) {
        if (controls().indexOf(event.target) < 0)
          event.preventDefault();
      });

      // The focus come out of it anyway is brought back to the box
      document.addEventListener('focusin', function (event) {
        if (isOpen() && !root.contains(event.target))
          words.focus();
      });

      // A key whose target is not in the dialog (the page, the canvas) is stopped at the window, in
      // the capture phase, before SDL's listeners on the window and the document hear it
      ['keydown', 'keyup', 'keypress'].forEach(function (kind) {
        window.addEventListener(kind, function (event) {
          if (!isOpen() || root.contains(event.target))
            return;

          event.stopPropagation();
          event.preventDefault();

          if (kind === 'keydown')
            words.focus();
        }, true);
      });

      ['keyup', 'keypress', 'mousedown', 'mouseup', 'mousemove', 'click', 'dblclick', 'wheel', 'contextmenu',
       'pointerdown', 'pointerup', 'pointermove', 'touchstart', 'touchmove', 'touchend', 'touchcancel'].forEach(function (kind) {
        root.addEventListener(kind, function (event) { event.stopPropagation(); });
      });

      return api;
    })();
  </script>

  <script>
    // The last 300 lines the page and the module print, kept for a bug report. Installed before the
    // module starts; the Release build's engine logs compile to nothing, so the console is what is left.
    window.chronicleConsole = [];
    (function () {
      var LIMIT = 300;

      // The ring never throws: a bad argument or a missing console method cannot break a print
      function keep(kind, args) {
        try {
          var text = Array.prototype.map.call(args, function (a) {
            if (typeof a === 'string') return a;
            try { return JSON.stringify(a); } catch (e) {}
            try { return String(a); } catch (e) { return '?'; }
          }).join(' ');

          window.chronicleConsole.push('[' + kind + '] ' + text);
          if (window.chronicleConsole.length > LIMIT)
            window.chronicleConsole.splice(0, window.chronicleConsole.length - LIMIT);
        } catch (e) {}
      }

      function noop() {}

      function raw(method) {
        return typeof method === 'function' ? method : noop;
      }

      window.chronicleRaw = { log: raw(console.log), warn: raw(console.warn) };   // Unwrapped, so a print is kept once

      ['log', 'info', 'warn', 'error'].forEach(function (kind) {
        var original = console[kind];

        if (typeof original !== 'function')
          return;

        console[kind] = function () {
          keep(kind, arguments);
          return original.apply(console, arguments);
        };
      });

      window.chronicleKeep = keep;
    })();
  </script>

  <script>
    // Written when the page is packed (make ChronicleWeb). A build with threads only starts on a
    // cross-origin isolated page; a build without them (-DWEB_THREADS=OFF) starts anywhere.
    var NEEDS_THREADS = @CHRONICLE_WEB_NEEDS_THREADS@;

    // Published next to Chronicle.js, Chronicle.wasm and Chronicle.data, asked for under the stamp
    // of their build: a browser that kept a file of the build before never pairs it with a new one
    var STAMP = '?v=@CHRONICLE_WEB_STAMP@';
    var GLUE = 'Chronicle.js' + STAMP;

    var statusBox = document.getElementById('status');   // Not 'status': that name is the window's own
    var line = document.getElementById('line');
    var ownTab = document.getElementById('own-tab');
    var canvas = document.getElementById('canvas');

    function say(text) {
      line.textContent = text;
      statusBox.hidden = text === '';
    }

    var Module = {
      canvas: canvas,

      // The module's stdout and stderr, kept in the ring and still sent to the console
      print: function () { window.chronicleKeep('print', arguments); window.chronicleRaw.log.apply(console, arguments); },
      printErr: function () { window.chronicleKeep('printErr', arguments); window.chronicleRaw.warn.apply(console, arguments); },

      mainScriptUrlOrBlob: GLUE,

      // The .wasm and the .data, beside the script
      locateFile: function (path, folder) {
        return folder + path + STAMP;
      },

      // "Downloading data... (done/total)" while the pack comes in, then '' when everything is there
      setStatus: function (text) {
        var progress = /\((\d+(?:\.\d+)?)\/(\d+)\)/.exec(text);

        if (progress)
          say('Chronicle is loading... ' + Math.round(100 * progress[1] / progress[2]) + '%');
        else
          say(text === '' ? '' : 'Chronicle is loading...');
      },

      onAbort: function (what) {
        say('Chronicle stopped: ' + what);
      }
    };

    function canStart() {
      return NEEDS_THREADS === false || self.crossOriginIsolated;
    }

    canvas.addEventListener('contextmenu', function (event) { event.preventDefault(); });
    canvas.addEventListener('pointerdown', function () { canvas.focus(); });

    // Threads are only given to a cross-origin isolated page
    if (canStart()) {
      var glue = document.createElement('script');

      glue.src = GLUE;
      glue.onerror = function () { say('Chronicle could not be loaded: Chronicle.js is missing.'); };

      document.body.appendChild(glue);
    } else if (window.self !== window.top) {
      // Framed by a page that is not isolated itself: no header of ours can change that, but
      // the same address opened as its own tab can be
      say('Chronicle cannot run inside this frame: the browser gives it no threads here.');

      ownTab.href = location.href;
      ownTab.hidden = false;
    } else {
      say('Chronicle cannot start here: this page is not cross-origin isolated, so the browser gives it no threads (SharedArrayBuffer).');
    }
  </script>
</body>
</html>
