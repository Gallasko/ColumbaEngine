// matmul.pg -- naive O(n^3) square-matrix multiplication, flat 1-D storage.
// The hot multiply kernel lives in a function so loop counters and accumulator
// are locals (cheap stack slots). Init is outside the timed region.

fun makeMatrix(n, offset)
{
    var m = [];
    var i = 0;
    while (i < n * n)
    {
        m[i] = ((i + offset) % 17) * 1.0;
        i = i + 1;
    }
    return m;
}

fun zeroMatrix(n)
{
    var m = [];
    var i = 0;
    while (i < n * n)
    {
        m[i] = 0.0;
        i = i + 1;
    }
    return m;
}

fun multiply(A, B, C, n)
{
    var i = 0;
    while (i < n)
    {
        var j = 0;
        while (j < n)
        {
            var s = 0.0;
            var k = 0;
            while (k < n)
            {
                s = s + A[i * n + k] * B[k * n + j];
                k = k + 1;
            }
            C[i * n + j] = s;
            j = j + 1;
        }
        i = i + 1;
    }
}

var n = count;
var A = makeMatrix(n, 0);
var B = makeMatrix(n, 7);
var C = zeroMatrix(n);

var t0 = now();
multiply(A, B, C, n);
var elapsed = now() - t0;

print(elapsed);
