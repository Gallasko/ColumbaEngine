// table_lookup.pg -- N inserts of (i -> i*2) into an empty table, then N
// sequential lookups summing the values. Only the lookup loop is timed,
// and it lives in a function so the loop counter and accumulator are
// locals (no per-iteration global hash lookups).

fun buildTable(n)
{
    var d = [];
    var i = 0;
    while (i < n)
    {
        d[i] = i * 2;
        i = i + 1;
    }
    return d;
}

fun sumLookup(d, n)
{
    var total = 0;
    var i = 0;
    while (i < n)
    {
        total = total + d[i];
        i = i + 1;
    }
    return total;
}

var d = buildTable(count);

var t0 = now();
var total = sumLookup(d, count);
var elapsed = now() - t0;

print(elapsed);
