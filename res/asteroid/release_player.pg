// Handle key release events - set key states to 0

if (event.values.key == "Left")
{
    sysData["keyLeft"] = 0
}
else if (event.values.key == "Right")
{
    sysData["keyRight"] = 0
}
else if (event.values.key == "Up")
{
    sysData["keyUp"] = 0
}
else if (event.values.key == "Down")
{
    sysData["keyDown"] = 0
}
else if (event.values.key == "Space")
{
    sysData["keySpace"] = 0
}
